<?xml version="1.0" encoding="utf-8" ?>

<!--
	The deliverables of a project, pushed by the Deliverables tile of the project cockpit.
	
	A deliverable is a specification, a prototype or a report: the type Deliverable is abstract. The
	user chooses the kind first, then "New deliverable" creates a draft of that kind and opens the
	create dialog. The command declares the creation in its access without a type: the type of the
	reference ProjectScope#deliverables is the abstract Deliverable, so the command is offered where
	at least one kind may be created in the project. The kind chooser offers only the kinds the user
	may create there (canCreate): a project administrator creates every kind, a project member
	specifications only.
	
	"Create baseline" records the deliverables of the project in their current versions: it creates a
	baseline of the project whose historic reference Baseline#deliverables refers to them. Once the
	baseline is committed, the command says so and offers to show it: "Show baseline" leads to
	baselines.view.xml, the display target of a baseline, with the new baseline selected. There the
	baselines are listed and their reviewers are entered.
	
	The deliverable selected in the table is edited in the last pane: its estimate, the readers of
	its estimate and its sections. What a baseline shows of them to its reviewers is described in
	baselines.view.xml.
	
	Below, the deliverables are edited in place in a composition table of the project. Its Add button
	stands for the concrete kinds of the abstract Deliverable the user may create in the project: with
	several of them it opens a menu to choose the kind from, with a single one it adds a row of that
	kind directly.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="kind"/>
		<channel name="deliverable"/>
	</channels>

	<split-panel orientation="vertical">
		<panes>
			<pane>
				<panel>
					<title>
						<en>Deliverables</en>
						<de>Liefergegenstände</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							inputs="project, kind"
							placement="TOOLBAR"
						>
							<label>
								<en>New deliverable</en>
								<de>Neuer Liefergegenstand</de>
							</label>
							<access>
								<create
									in="$project"
									reference="tl.demo.projectManagement:ProjectScope#deliverables"
								/>
							</access>
							<executability>
								<disabled-if expr="if($kind == null, #('Choose the kind of the deliverable first.'@en, 'Wählen Sie zuerst die Art des Liefergegenstands.'@de))"/>
							</executability>
							<execute-script function="new($kind, context: $project, transient: true)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-deliverable.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							image="css:bi bi-bookmark-check"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Create baseline</en>
								<de>Abnahmestand anlegen</de>
							</label>
							<access>
								<create
									in="$project"
									reference="tl.demo.projectManagement:ProjectScope#baselines"
								/>
							</access>
							<executability>
								<disabled-if expr="if($project == null || $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`).isEmpty(), #('The project has no deliverables.'@en, 'Das Projekt hat keine Liefergegenstände.'@de))"/>
							</executability>
							<with-transaction>
								<execute-script function="{ baseline = new(`tl.demo.projectManagement:Baseline`, $project, transient: false); $baseline.set(`tl.demo.projectManagement:Baseline#name`, 'Baseline ' + dateFormat('yyyy-MM-dd HH:mm').format(now())); $baseline.set(`tl.demo.projectManagement:Baseline#deliverables`, $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`)); $project.add(`tl.demo.projectManagement:ProjectScope#baselines`, $baseline); $baseline; }"/>
								<with-result as="baseline">
									<confirm expr="#('The baseline &quot;{0}&quot; was created.'@en, 'Der Abnahmestand „{0}“ wurde angelegt.'@de).fill($baseline.get(`tl.demo.projectManagement:Baseline#name`))">
										<title>
											<en>Baseline created</en>
											<de>Abnahmestand angelegt</de>
										</title>
										<confirm-label>
											<en>Show baseline</en>
											<de>Abnahmestand anzeigen</de>
										</confirm-label>
										<cancel-label>
											<en>Close</en>
											<de>Schließen</de>
										</cancel-label>
									</confirm>
									<show-object value="baseline"/>
								</with-result>
							</with-transaction>
						</generic-command>
					</commands>
					<fields>
						<value-input
							inputs="project"
							options="[`tl.demo.projectManagement:Specification`, `tl.demo.projectManagement:Prototype`, `tl.demo.projectManagement:Report`].filter(t -> $project != null &amp;&amp; $project.canCreate(`tl.demo.projectManagement:ProjectScope#deliverables`, $t))"
							type="tl.model:TLClass"
							value="kind"
						>
							<label>
								<en>Kind</en>
								<de>Art</de>
							</label>
						</value-input>
					</fields>
					<table
						observed-types="tl.demo.projectManagement:Deliverable"
						selection="deliverable"
						types="tl.demo.projectManagement:Deliverable"
					>
						<columns>
							<column attribute="name"/>
							<computed-column name="kind"
								type="tl.core:String"
							>
								<label>
									<en>Kind</en>
									<de>Art</de>
								</label>
								<value>$row.type().label()</value>
							</computed-column>
						</columns>
						<inputs>
							<input channel="project"/>
						</inputs>
						<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`))</rows>
					</table>
				</panel>
			</pane>
			<pane>
				<panel>
					<title>
						<en>Edit deliverables</en>
						<de>Liefergegenstände bearbeiten</de>
					</title>
					<form
						input="project"
						with-inset="true"
					>
						<composition-table attribute="deliverables">
							<columns>
								<column attribute="name"/>
								<computed-column name="kind"
									type="tl.core:String"
								>
									<label>
										<en>Kind</en>
										<de>Art</de>
									</label>
									<value>$row.type().label()</value>
								</computed-column>
							</columns>
						</composition-table>
					</form>
				</panel>
			</pane>
			<pane>
				<panel>
					<title>
						<en>Selected deliverable</en>
						<de>Gewählter Liefergegenstand</de>
					</title>
					<form
						input="deliverable"
						with-inset="true"
					>
						<field attribute="name"/>
						<field attribute="estimate"/>
						<field attribute="estimateReaders"/>
						<composition-table attribute="sections">
							<columns>
								<column attribute="name"/>
								<column attribute="text"/>
							</columns>
						</composition-table>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>