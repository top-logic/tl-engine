<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/TestTLScriptSecurity.model.xml"/>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="TestTLScriptSecurity.ProjectReader"/>
					<role name="TestTLScriptSecurity.ProjectResponsible"/>
					<role name="TestTLScriptSecurity.PathReader"/>
					<role name="TestTLScriptSecurity.PathViewer"/>
					<role name="TestTLScriptSecurity.NoteWriter"/>
					<role name="TestTLScriptSecurity.PathWriter"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="TestTLScriptSecurity:Project">
						<!-- Both roles may read; only the responsible may write and delete. -->
						<grant
							inherit="true"
							operation="Read"
							roles="TestTLScriptSecurity.ProjectResponsible, TestTLScriptSecurity.ProjectReader"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
						<grant
							inherit="true"
							operation="Delete"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:Employee">
						<!-- The responsible may create employees (create condition 1). -->
						<grant
							inherit="true"
							operation="Create"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:ProjectTask">
						<!-- A task follows the project its assignee is responsible for. -->
						<access-parent>
							<script expr="t -> $t.get(`TestTLScriptSecurity:ProjectTask#assignee`).referers(`TestTLScriptSecurity:Project#responsible`)"/>
						</access-parent>
					</class>
					<class name="TestTLScriptSecurity:ExternalEmployee">
						<!-- The create right inherited from Employee is withdrawn: nobody may create an
							external employee, even where creating an employee is allowed. -->
						<revoke
							operation="Create"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:UnsecuredData"
						without-security="true"
					>
						<!-- No grant at all: access is nevertheless allowed for everybody (type
							without security), also for objects of the specialization
							UnsecuredDataSub. -->
					</class>
					<part name="TestTLScriptSecurity:Project#secret">
						<!-- Present grant with no roles: reading and writing this attribute is denied
							for every role (only a bypassing super-user is unaffected). -->
						<grant operation="Read"/>
						<grant operation="Write"/>
					</part>
					<class name="TestTLScriptSecurity:PathC">
						<!-- The reader of a C reads it completely. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
					</class>
					<class name="TestTLScriptSecurity:PathNote">
						<!-- A note writer may create notes in a B (Create implies Discover on the container B). -->
						<grant
							operation="Create"
							roles="TestTLScriptSecurity.NoteWriter"
						/>
					</class>
					<!-- The path role reads only the structure attributes; by R2 that implies Discover. -->
					<part name="TestTLScriptSecurity:PathRoot#as">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
					<part name="TestTLScriptSecurity:PathA#bs">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
					<part name="TestTLScriptSecurity:PathB#cs">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
						<!-- The path writer may replace the cs of a B. -->
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</part>
					<class name="TestTLScriptSecurity:PathHome">
						<!-- By the class rights alone, whoever discovers a home may read it. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
					</class>
					<singleton name="TestTLScriptSecurity#HOME">
						<!-- The singleton additionally grants Write without Read. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</singleton>
					<singleton name="TestTLScriptSecurity#OFFICE">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.ProjectReader"
						/>
					</singleton>
					<part name="TestTLScriptSecurity:PathOffice#title">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
				</security-config>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule
							id="740b6ea4-adac-41e3-b5f8-53a75906c356"
							meta-element="TestTLScriptSecurity:Project"
							role="TestTLScriptSecurity.ProjectResponsible"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Project#responsible"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="f8459b10-d13b-406a-9d7b-7550d5eb0dd8"
							meta-element="TestTLScriptSecurity:Project"
							role="TestTLScriptSecurity.ProjectReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Project#members"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c01"
							meta-element="TestTLScriptSecurity:PathC"
							role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathC#readers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c02"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.NoteWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#writers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c06"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.PathWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#editors"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c07"
							meta-element="TestTLScriptSecurity:PathHome"
							role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathHome#readers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c08"
							meta-element="TestTLScriptSecurity:PathHome"
							role="TestTLScriptSecurity.PathWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathHome#editors"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c09"
							meta-element="TestTLScriptSecurity:PathOffice"
							role="TestTLScriptSecurity.PathViewer"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathOffice#viewers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c0a"
							meta-element="TestTLScriptSecurity:PathOffice"
							role="TestTLScriptSecurity.NoteWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathOffice#writers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c03"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c04"
							meta-element="TestTLScriptSecurity:PathA"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathA#bs"/>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c05"
							meta-element="TestTLScriptSecurity:PathRoot"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathRoot#as"/>
								<step attribute="TestTLScriptSecurity:PathA#bs"/>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
					</rules>
				</role-rules>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/TestTLScriptSecurityMeta.xml"/>
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
