<?xml version="1.0" encoding="utf-8" ?>

<!--
	Edits one role parent rule of the model based access definition. The rule channel carries
	the configuration the opening command produced - an empty rule for the selected type or a copy
	of a rule already in effect - and the configuration form writes the entries straight into it. Save hands that configuration to the editor, which stores it in the
	application configuration, and marks the pending channel: the stored definition differs from the
	running one until the coverage display applies it.
	
	Save first checks the form (check-config-form): a mandatory value missing, a constraint failing
	or an entry the field rejected - a script that does not parse - is put on its field and keeps
	the dialog open; while such a problem is on display, Save is disabled (config-form-valid).
-->
<view>
	<channels>
		<channel name="rule"/>
		<channel name="pending"/>
	</channels>
	<window width="800px">
		<title>
			<en>Role parent rule</en>
			<de>Regel für das Rollenelternobjekt</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-check-lg"
				input="rule"
				placement="BUTTON_BAR"
			>
				<label>
					<en>Save</en>
					<de>Speichern</de>
				</label>
				<executability>
					<config-form-valid/>
				</executability>
				<check-config-form/>
				<action class="com.top_logic.layout.view.admin.SecurityDefinitionAction"
					mode="SAVE_ROLE_PARENT_RULE"
				/>
				<write-channel name="pending"/>
				<close-dialog/>
			</generic-command>
		</commands>
		<inset>
			<config-form
				input="rule"
				withEditMode="false"
			/>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>