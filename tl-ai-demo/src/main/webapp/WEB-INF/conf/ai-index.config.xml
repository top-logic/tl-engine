<?xml version="1.0" encoding="utf-8" ?>

<!--
	Hybrid search over the demo's events and sessions (tl-ai-index, issue #902).

	Albert gets index.search and index.similar and finds an event by what it is about, also in
	another language: "Gibt es eine Veranstaltung zur Kühlkette für Impfstoffe?" finds the English
	"Cold Chain Logistics Forum 2027", whose text shares no word with the question.

	The meaning side runs the model snowflake-arctic-embed-m-v2.0 in this JVM. Put model_int8.onnx and
	tokenizer.json from its official repository into %AI_INDEX_MODEL_DIR% (by default
	%VAR_PATH%/models/snowflake-arctic-embed-m-v2.0, or the directory in the environment variable
	tl_ai_index_model_dir) - see tl-ai-index/README.md for the commands and checksums. Without the
	files the demo starts all the same and the index searches words only.

	The demo's root account reads everything, so there is no scope rule here; tl-ai-index/README.md
	shows one.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<module key="com.top_logic.tl.ai.index.AiIndexService$Module" value="true"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.tl.ai.index.AiIndexService">
			<instance class="com.top_logic.tl.ai.index.AiIndexService">
				<embedder class="com.top_logic.tl.ai.index.onnx.OnnxEmbedder"
					model-dir="%AI_INDEX_MODEL_DIR%"
					model-file="model_int8.onnx"
					pooling="CLS"
					dimensions="768"
					query-prefix="query: "
					threads="2"
				/>
				<types>
					<type name="demo.events:Event">
						<text attribute="name"/>
						<text attribute="description"/>
						<keywords>
							<keyword name="status" script="e -> $e.get(`demo.events:Event#status`)"/>
						</keywords>
					</type>
					<type name="demo.events:Session">
						<text attribute="name"/>
						<text attribute="description"/>
					</type>
				</types>
			</instance>
		</config>

		<config service-class="com.top_logic.tl.ai.core.agent.TopLogicAgentDefinitions">
			<instance>
				<agents>
					<agent name="TL_SingleAgent">
						<tools>
							<tool name="index.search"/>
							<tool name="index.similar"/>
						</tools>
					</agent>
				</agents>
			</instance>
		</config>
	</services>
</application>
