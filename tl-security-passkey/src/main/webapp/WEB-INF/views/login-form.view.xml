<?xml version="1.0" encoding="utf-8" ?>

<!--
	Overlay contributing the login with a passkey alone to the credentials form of tl-layout-view
	(WEB-INF/views/login-form.view.xml): a same-path overlay placing the passkey button in the group
	of the other ways to log in (<stack id="login-alternatives">), right after the single sign-on
	buttons (<login-methods id="login-methods">), below "or", as wide as they are. The form is
	shared by the login dialog and the login page, so both offer it.
-->
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<form config:ref="credentials">
		<stack config:ref="login-alternatives">
			<passkey-login id="passkey-login"
				config:position="after"
				config:reference="login-methods"
				image="css:bi bi-key"
			>
				<label>
					<en>Sign in with passkey</en>
					<de>Mit Passkey anmelden</de>
				</label>
			</passkey-login>
		</stack>
	</form>
</view>