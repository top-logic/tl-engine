<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="count"/>
	</channels>

	<sidebar>
		<section id="section"
			icon="css:bi bi-star"
		>
			<label>
				<en>Section</en>
			</label>
			<group id="g"
				expanded="false"
				label="Group"
			>
				<nav-item id="inner"
					badge="count"
					label="Inner"
				>
					<view-ref view="sidebar-item-content.view.xml"/>
				</nav-item>
				<section id="innerSection">
					<nav-item id="innerItem"
						label="Inner item"
					>
						<panel/>
					</nav-item>
				</section>
			</group>
		</section>
		<nav-item id="top"
			hidden="true"
			label="Top"
		>
			<panel/>
		</nav-item>
		<section id="empty"/>
		<command-item id="cmdHidden">
			<action class="com.top_logic.layout.view.command.GenericViewCommand"
				inputs="count"
				label="Without input not offered"
			>
				<executability>
					<null-input-hidden/>
				</executability>
			</action>
		</command-item>
		<command-item id="cmdDisabled">
			<action class="com.top_logic.layout.view.command.GenericViewCommand"
				inputs="count"
				label="Without input out of reach"
			>
				<executability>
					<null-input-disabled/>
				</executability>
			</action>
		</command-item>
	</sidebar>
</view>