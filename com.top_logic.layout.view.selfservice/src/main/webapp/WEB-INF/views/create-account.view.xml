<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient AccountCreation model (user name, names, password) bound to the form. -->
		<channel name="model"/>
		<!-- The invitation being accepted (set by CheckInvitationCodeAction). -->
		<channel name="invitation"/>
		<!-- Whether the authentication device of the new account manages passwords. -->
		<channel name="passwords"/>
	</channels>
	<window
		resizable="false"
		width="400px"
	>
		<title>
			<en>Create account</en>
			<de>Konto anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field
				attribute="userName"
				readonly="true"
			/>
			<field attribute="givenName"/>
			<field attribute="surname"/>
			<switch input="passwords">
				<case test="$passwords">
					<field attribute="newPassword"/>
					<field attribute="newPasswordConfirm"/>
				</case>
			</switch>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Create account</en>
						<de>Konto anlegen</de>
					</label>
					<store-form-state>
						<with-result>
							<accept-invitation/>
						</with-result>
					</store-form-state>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
