<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog in which a visitor registers an account without invitation: the e-mail address and, if
	the self-registration requires it (registrationCaptcha()), a captcha. request-registration-code
	mails a verification code and opens the code dialog; the account dialog follows
	(check-verification-code, create-own-account).
-->
<view>
	<channels>
		<!-- Transient RegistrationRequest model (the e-mail address) bound to the form. -->
		<channel name="model"/>
		<!-- The solution of the captcha, written by the captcha element. -->
		<channel name="captcha"/>
		<!-- Whether the self-registration requires a captcha. -->
		<derived-channel name="captchaRequired">
			<expr><![CDATA[registrationCaptcha()]]></expr>
		</derived-channel>
	</channels>
	<window
		resizable="false"
		width="400px"
	>
		<title>
			<en>Register</en>
			<de>Registrieren</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<text>
				<label>
					<en>Enter your e-mail address. We will send a confirmation code to this address. Afterwards, you choose your name and password.</en>
					<de>Geben Sie Ihre E-Mail-Adresse ein. Wir schicken Ihnen einen Bestätigungscode an diese Adresse. Anschließend legen Sie Ihren Namen und Ihr Passwort fest.</de>
				</label>
			</text>
			<field attribute="email"/>
			<switch input="captchaRequired">
				<case test="$captchaRequired">
					<captcha payload="captcha"/>
				</case>
			</switch>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Send code</en>
						<de>Code senden</de>
					</label>
					<store-form-state>
						<with-result>
							<request-registration-code/>
						</with-result>
					</store-form-state>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>