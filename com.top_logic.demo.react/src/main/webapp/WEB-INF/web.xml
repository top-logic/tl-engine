<?xml version="1.0" encoding="ISO-8859-1" ?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd"
  version="3.0"
>
    <display-name>TopLogic React Demo</display-name>

    <context-param>
        <param-name>websocket.endpoints</param-name>
        <param-value>com.top_logic.demo.react.websocket.EchoEndpoint</param-value>
    </context-param>

    <listener>
         <listener-class>com.top_logic.element.ElementStartStop</listener-class>
    </listener>

    <listener>
         <listener-class>com.top_logic.util.WebSocketEndpointListener</listener-class>
    </listener>

</web-app>
