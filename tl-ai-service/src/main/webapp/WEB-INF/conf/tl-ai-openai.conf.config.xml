<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance>
				<modules>
					<module name="tl-ai-openai" />
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<!-- AI Service for AI/LLM API integration -->
					<module key="com.top_logic.ai.service.AIService$Module" value="true"/>
					<!-- Tool Registry for managing AI tool providers -->
					<module key="com.top_logic.ai.service.tools.registry.ToolRegistry$Module" value="true"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.service.tools.registry.ToolRegistry">
			<instance class="com.top_logic.ai.service.tools.registry.ToolRegistry">
				<tool-factories>
					<!-- TLScript Reference Tool - provides function listing and documentation -->
					<factory name="script-doc">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.help.TLScriptReferenceTool"
						/>
					</factory>
					<factory name="script-exec">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.script.TLScriptTool"
						/>
					</factory>
					<factory name="model-annotation-definitions">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.AnnotationDefinitionExplorerTool"
						/>
					</factory>
					<factory name="model-instances">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.InstanceBrowserTool"
						/>
					</factory>
					<factory name="model-annotation-browser">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.ModelAnnotationBrowserTool"
						/>
					</factory>
					<factory name="model-browser">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.ModelBrowserTool"
						/>
					</factory>
					<factory name="model-search">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.ModelSearchTool"
						/>
					</factory>
					<factory name="model-analysis">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.TypeAnalysisTool"
						/>
					</factory>
					<factory name="config-schema">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.config.ConfigSchemaTool"
						/>
					</factory>
					<factory name="layout-templates">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.layout.LayoutTemplateTool"
						/>
					</factory>
					<factory name="model-modification">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.service.tools.model.ModelEditorTool"
						/>
					</factory>

					<!-- Example configuration with ReflectiveToolFactory:
					<factory name="mytools">
						<implementation class="com.top_logic.ai.service.tools.registry.ReflectiveToolFactory"
							tool-class="com.example.MyToolClass"
						/>
					</factory>
					-->

					<!-- Example configuration with ScriptToolFactory:
					<factory name="scripttools">
						<implementation class="com.top_logic.ai.service.tools.registry.ScriptToolFactory">
							<tools>
								<tool name="add"
									description="Adds two numbers together">
									<parameters>
										<parameter name="a"
											type="number"
											description="First number"
										/>
										<parameter name="b"
											type="number"
											description="Second number"
										/>
									</parameters>
									<implementation>
										$a + $b
									</implementation>
								</tool>
							</tools>
						</implementation>
					</factory>

					Tools from factories will be accessible as "factoryName.toolName"
					-->
				</tool-factories>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.service.AIService">
			<instance class="com.top_logic.ai.service.AIService"
				default-model="gpt-4o"
			>
				<factories>
					<!-- OpenAI models factory -->
					<factory
						class="com.top_logic.ai.service.providers.OpenAIChatModelFactory"
						models="gpt-4o, gpt-4o-mini, gpt-3.5-turbo"
						api-key="%OPENAI_API_KEY%"
						base-url="https://api.openai.com/v1"
						max-pool-size="10"
						max-idle-models="5"
					/>
					<!-- Anthropic Claude models factory -->
					<factory
						class="com.top_logic.ai.service.providers.AnthropicChatModelFactory"
						models="claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5-20251001"
						api-key="%ANTHROPIC_API_KEY%"
						base-url="https://api.anthropic.com/v1"
						max-pool-size="10"
						max-idle-models="5"
					/>
					<!-- Mistral AI models factory -->
					<factory
						class="com.top_logic.ai.service.providers.MistralChatModelFactory"
						api-key="%MISTRAL_API_KEY%"
						base-url="https://api.mistral.ai/v1"
						max-pool-size="10"
						max-idle-models="5"
					/>
				</factories>
			</instance>
		</config>
	</services>
</application>
