<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a tl.demo.projectManagement:Ticket inside a ProjectScope.
	
	"model" carries the transient Ticket (bound by the opening command, which presets its milestone);
	"container" is bound to the project. The Create button persists the ticket with
	<persist-transient> and adds it to ProjectScope#tickets of the container - the link is made from
	the container side, since the composite back-reference is derived and cannot be set. The created
	ticket is written to "selection" so it becomes selected.
	
	The Create button binds its input to the draft ("model"): its intrinsic rule offers it only
	while the user may create a ticket in the container.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="container"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>New Ticket</en>
			<de>Neues Ticket</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="title"/>
			<field attribute="description"/>
			<field attribute="milestone"/>
			<field attribute="assignee"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<persist-transient
						container="container"
						reference="tickets"
					>
						<write-channel name="selection"/>
						<close-dialog/>
					</persist-transient>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>