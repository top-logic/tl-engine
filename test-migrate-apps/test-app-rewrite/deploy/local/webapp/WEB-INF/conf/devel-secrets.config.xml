<?xml version="1.0" encoding="utf-8" ?>

<!--
	Secrets of the local development deployment: a system property or environment variable named
	like the secret takes precedence, otherwise the file named like the secret in the folder
	deploy/local/secrets of this project delivers it. The folder lies outside the web application
	and is therefore never packaged. Its relative path is resolved against the working directory,
	the project directory when the application is started from Maven or Eclipse - like the
	development database ./tmp/h2.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.credential.SecretStoreService">
			<instance class="com.top_logic.basic.credential.SecretStoreService">
				<store class="com.top_logic.basic.credential.ChainSecretStore">
					<stores>
						<env-store/>
						<directory-store directory="./deploy/local/secrets"/>
					</stores>
				</store>
			</instance>
		</config>
	</services>
</application>
