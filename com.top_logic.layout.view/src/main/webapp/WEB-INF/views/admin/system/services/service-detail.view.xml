<?xml version="1.0" encoding="utf-8" ?>

<!--
	Detail frame of the services drill-down (see ../services.view.xml): the configuration of one
	service, read-only until Edit, stored by Save.
	- The module channel holds the service; it is the parameter the frame was pushed with. The
	navPath channel is the stack's path, the services channel the snapshot the covered overview
	table displays, both bound by the enclosing tile-stack. Every command here writes a new
	snapshot to the services channel: the overview table follows it, and the derived channels
	reading the state of the service (active, changed, stored) take services as input, so they are
	computed again as well.
	- The config channel is filled with an editable copy of the configuration of the service when
	the frame is built (serviceConfiguration). The config-form edits it; Save runs the
	ServiceConfigurationAction, which stores the working copy in the application and marks the
	service as changed until it is restarted. The form then shows the stored copy. "Reset to
	default" removes the stored configuration and writes the configuration that is now effective
	to the config channel.
	- A service whose configuration cannot be edited (no configuration, or an implementation
	refusing a configuration changed in the application) shows its configuration in a form that
	does not offer Edit, or the message that it has none.
	- While the stored configuration differs from the one the service was started with, a notice
	asks to restart it; Restart (offered while the service runs) applies it.
-->
<view>
	<channels>
		<channel name="module"/>
		<channel name="navPath"/>
		<channel name="services"/>
		<derived-channel name="depth"
			expr="$navPath.size()"
			inputs="navPath"
		/>
		<derived-channel name="label"
			expr="serviceLabel($module)"
			inputs="module"
		/>
		<derived-channel name="editable"
			expr="serviceConfigurationEditable($module)"
			inputs="module"
		/>
		<derived-channel name="active"
			expr="serviceActive($module)"
			inputs="module, services"
		/>
		<derived-channel name="changed"
			expr="serviceConfigurationChanged($module)"
			inputs="module, services"
		/>
		<derived-channel name="stored"
			expr="serviceConfigurationStored($module)"
			inputs="module, services"
		/>
		<channel name="config"
			init="serviceConfiguration($module)"
			inputs="module"
		/>
	</channels>

	<panel
		fill="true"
		with-inset="true"
	>
		<title>
			<en>Service</en>
			<de>Dienst</de>
		</title>
		<title-content>
			<text input="label"/>
		</title-content>
		<commands>
			<generic-command
				image="css:bi bi-arrow-left"
				inputs="depth"
				placement="TOOLBAR"
			>
				<label>
					<en>Back</en>
					<de>Zurück</de>
				</label>
				<executability>
					<visible-if expr="$depth > 0"/>
				</executability>
				<navigate-pop/>
			</generic-command>
			<generic-command
				image="css:bi bi-arrow-repeat"
				inputs="active"
				placement="TOOLBAR"
			>
				<label>
					<en>Restart</en>
					<de>Neustart</de>
				</label>
				<executability>
					<visible-if expr="$active == true"/>
				</executability>
				<action class="com.top_logic.layout.view.admin.system.ServiceLifecycleAction"
					mode="RESTART"
					selection="module"
				>
					<with-result>
						<write-channel name="services"/>
					</with-result>
				</action>
			</generic-command>
			<generic-command
				image="css:bi bi-arrow-counterclockwise"
				inputs="stored, module"
				placement="TOOLBAR"
			>
				<label>
					<en>Reset to default</en>
					<de>Auf Standard zurücksetzen</de>
				</label>
				<executability>
					<visible-if expr="$stored == true"/>
				</executability>
				<confirm expr="#('Remove the configuration stored in the application and use the configuration of the application files again?'@en, 'Die in der Anwendung gespeicherte Konfiguration entfernen und wieder die Konfiguration der Anwendungsdateien verwenden?'@de)"/>
				<action class="com.top_logic.layout.view.admin.system.ServiceConfigurationAction"
					mode="RESET"
					module="module"
				>
					<with-result>
						<write-channel name="services"/>
					</with-result>
				</action>
				<execute-script function="serviceConfiguration($module)">
					<with-result>
						<write-channel name="config"/>
					</with-result>
				</execute-script>
			</generic-command>
		</commands>
		<alert
			inputs="changed"
			severity="warning"
			visible-if="$changed == true"
		>
			<message>
				<en>The stored configuration differs from the running one. Restart the service to apply it.</en>
				<de>Die gespeicherte Konfiguration weicht von der laufenden ab. Starten Sie den Dienst neu, um sie zu übernehmen.</de>
			</message>
		</alert>
		<visible-if
			expr="$editable == true"
			input="editable"
		>
			<config-form input="config">
				<save-action>
					<action class="com.top_logic.layout.view.admin.system.ServiceConfigurationAction"
						mode="SAVE"
						module="module"
					>
						<with-result>
							<write-channel name="services"/>
						</with-result>
					</action>
				</save-action>
			</config-form>
		</visible-if>
		<visible-if
			expr="$editable != true"
			input="editable"
		>
			<config-form input="config">
				<noModelMessage>
					<en>This service has no configuration.</en>
					<de>Dieser Dienst hat keine Konfiguration.</de>
				</noModelMessage>
				<edit-executability>
					<visible-if expr="false"/>
				</edit-executability>
			</config-form>
		</visible-if>
	</panel>
</view>