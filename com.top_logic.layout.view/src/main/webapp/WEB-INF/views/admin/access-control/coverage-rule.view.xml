<?xml version="1.0" encoding="utf-8" ?>

<!--
	Shows the security parent rule proposed by the coverage analysis for one type, as the XML that
	belongs into the access manager configuration. The content channel receives the rendered rule
	from the command that opens the dialog.
-->
<view>
	<channels>
		<channel name="content"/>
	</channels>
	<window width="800px">
		<title>
			<en>Proposed rule</en>
			<de>Vorgeschlagene Regel</de>
		</title>
		<html input="content"/>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>