<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestViewModelAccess">
			<types>
				<class name="Project">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="secret"
							type="tl.core:String"
						/>
						<property name="budget"
							type="tl.core:String"
						/>
						<property name="classified"
							type="tl.core:String"
						/>
						<property name="approved"
							type="tl.core:Boolean"
						/>
						<property name="rating"
							type="tl.core:String"
						/>
						<property name="code"
							type="tl.core:String"
						>
							<annotations>
								<visibility value="read-only"/>
							</annotations>
						</property>
						<property name="keywords"
							multiple="true"
							type="tl.core:String"
						>
							<annotations>
								<config-type value="STRING_SET"/>
								<storage-algorithm>
									<string-set-storage/>
								</storage-algorithm>
							</annotations>
						</property>
						<property name="place"
							type="tl.core:String"
						>
							<annotations>
								<free-entry/>
							</annotations>
						</property>
						<property name="count"
							type="tl.core:Long"
						>
							<annotations>
								<free-entry/>
							</annotations>
						</property>
						<reference name="responsible"
							type="tl.accounts:Person"
						/>
						<reference name="viewer"
							type="tl.accounts:Person"
						/>
						<reference name="sponsor"
							type="Category"
						/>
						<reference name="category"
							type="Category"
						/>
						<reference name="topic"
							type="Category"
						>
							<annotations>
								<free-entry create="text -> self -> new(`TestViewModelAccess:Category`, transient: true)..set(`TestViewModelAccess:Category#name`, $text)"/>
							</annotations>
						</reference>
						<reference name="categories"
							multiple="true"
							type="Category"
						/>
						<reference name="tasks"
							composite="true"
							multiple="true"
							ordered="true"
							type="Task"
						/>
						<reference name="steps"
							composite="true"
							multiple="true"
							ordered="true"
							type="Step"
						/>
						<reference name="deliverables"
							composite="true"
							multiple="true"
							ordered="true"
							type="Deliverable"
						/>
						<reference name="archive"
							composite="true"
							multiple="true"
							ordered="true"
							type="Archive"
						/>
					</attributes>
				</class>

				<class name="Task">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="number"
							type="tl.core:Long"
						>
							<annotations>
								<default-value>
									<provider class="com.top_logic.element.structured.util.SequenceDefaultProvider"
										sequence-name="TestViewModelAccess_Task_number"
									/>
								</default-value>
							</annotations>
						</property>
						<property name="note"
							type="tl.core:String"
						/>
						<property name="label"
							type="tl.core:String"
						>
							<annotations>
								<value-normalizer>
									<trim/>
									<lower-case/>
								</value-normalizer>
							</annotations>
						</property>
						<property name="secret"
							type="tl.core:String"
						>
							<annotations>
								<default-value>
									<default-by-expression value="context -> 'hidden'"/>
								</default-value>
							</annotations>
						</property>
						<reference name="createdIn"
							type="Project"
						>
							<annotations>
								<default-value>
									<default-by-expression value="context -> $context"/>
								</default-value>
							</annotations>
						</reference>
					</attributes>
				</class>

				<class name="Step">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="note"
							type="tl.core:String"
						/>
						<property name="secret"
							type="tl.core:String"
						/>
						<reference name="substeps"
							composite="true"
							multiple="true"
							ordered="true"
							type="Step"
						/>
						<reference name="predecessor"
							type="Step"
						/>
						<reference name="items"
							composite="true"
							multiple="true"
							ordered="true"
							type="Item"
						/>
						<reference name="lockedItems"
							composite="true"
							multiple="true"
							ordered="true"
							type="Item"
						/>
					</attributes>
				</class>

				<class name="Item">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							mandatory="true"
							type="tl.core:String"
						/>
					</attributes>
				</class>

				<class name="Category">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<reference name="reader"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<class name="Deliverable"
					abstract="true"
				>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
				</class>

				<class name="Spec">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="Deliverable"/>
					</generalizations>
				</class>

				<class name="Plan">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="Deliverable"/>
					</generalizations>
				</class>

				<class name="Archive"
					abstract="true"
				>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
				</class>

				<class name="ArchiveEntry">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="Archive"/>
					</generalizations>
				</class>

				<class name="Empty"
					abstract="true"
				>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
				</class>
			</types>
		</module>
	</modules>
</model>