<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="com.top_logic.layout.view.agent.AgentAccess$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>

		<!--
			The permissions of an access token for the user interface. Both act only in the session
			the token was issued from, which AgentSessionBinding registers with AgentAccess when the
			token is created; operating includes observing.
		-->
		<config service-class="com.top_logic.element.accesstoken.AccessTokenPermissions">
			<instance>
				<permissions>
					<permission name="ui-observe"
						label="class.com.top_logic.layout.view.agent.I18NConstants.PERMISSION_UI_OBSERVE"
					>
						<session-binding class="com.top_logic.layout.view.agent.AgentSessionBinding"/>
					</permission>
					<permission name="ui-act"
						implies="ui-observe"
						label="class.com.top_logic.layout.view.agent.I18NConstants.PERMISSION_UI_ACT"
					>
						<session-binding class="com.top_logic.layout.view.agent.AgentSessionBinding"/>
					</permission>
				</permissions>
			</instance>
		</config>

		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance>
				<modules>
					<module name="tl-layout-view-agent"/>
				</modules>
			</instance>
		</config>

		<!--
			Admits an agent that presents an access token with a permission for the user interface,
			issued from a running session. With no authenticator registered, only browsers reach the
			agent endpoint.
		-->
		<config service-class="com.top_logic.layout.view.agent.AgentAccess">
			<instance class="com.top_logic.layout.view.agent.AgentAccess">
				<authenticators>
					<access-token/>
				</authenticators>
			</instance>
		</config>
	</services>
</application>