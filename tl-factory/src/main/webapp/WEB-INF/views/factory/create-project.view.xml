<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog creating a project: the form edits the draft in "model". Creating stores the project and
	starts building its workspace in the background; the new project is written to "selection".
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
	</channels>
	<window width="520px">
		<title>
			<en>Create application</en>
			<de>Anwendung anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="groupId"/>
			<field attribute="artifactId"/>
			<field attribute="engineVersion"/>
			<commands>
				<generic-command key="ENTER"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<persist-transient>
						<with-result as="project">
							<write-channel name="selection"
								value="project"
							/>
							<close-dialog/>
							<execute-script function="factoryCreateWorkspace($project)"/>
						</with-result>
					</persist-transient>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>