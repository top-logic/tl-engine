<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog creating a member of the tenant in "tenant": the form edits the transient input in "model",
	the account and its role. Creating makes the account and the membership in one transaction
	(factoryCreateMember) and writes the new account to "selection".
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="tenant"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>Create member</en>
			<de>Mitglied anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="login"/>
			<field attribute="firstName"/>
			<field attribute="lastName"/>
			<field attribute="email"/>
			<field attribute="password"/>
			<field attribute="role"/>
			<commands>
				<generic-command key="ENTER"
					inputs="model, tenant"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<execute-script function="factoryCreateMember($tenant, $model.get(`tl.factory.input:NewMember#role`), $model.get(`tl.factory.input:Account#login`), $model.get(`tl.factory.input:Account#firstName`), $model.get(`tl.factory.input:Account#lastName`), $model.get(`tl.factory.input:Account#email`), $model.get(`tl.factory.input:Account#password`))">
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</execute-script>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>