<?xml version="1.0" encoding="utf-8" ?>

<!--
	The account administration. A same-path overlay addresses the panels "list-panel" and
	"detail-panel", the table "table" and the form "form" by their ids, and the commands of the
	list panel by their names (new-account, delete-account, reset-password, expire-password,
	require-mfa, reset-mfa). The commands follow the account in the channel "selectedAccount".
-->
<view>
	<channels>
		<channel name="selectedAccount"/>
		<!--
			The last login of every account, read once when the view is opened, so that the column
			of the table looks each row up instead of querying per row.
		-->
		<derived-channel name="lastLogins"
			expr="accountLastLogins()"
		/>
		<!--
			Whether an authenticator app is set up for the selected account: shown in its form, while
			the secret itself is never displayed.
		-->
		<derived-channel name="mfaConfigured"
			expr="$selectedAccount != null and $selectedAccount.get(`tl.accounts:Person#mfaSecret`) != null"
			inputs="selectedAccount"
			observed-types="tl.accounts:Person"
		/>
	</channels>
	<split-panel id="main"
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane id="list"
				min-size="200"
				size="40"
				unit="%"
			>
				<panel id="list-panel">
					<title>
						<en>Accounts</en>
						<de>Konten</de>
					</title>
					<commands>
						<generic-command name="new-account"
							image="css:bi bi-plus-lg"
							placement="TOOLBAR"
						>
							<label>
								<en>New</en>
								<de>Neu</de>
							</label>
							<execute-script function="new(`tl.admin:NewAccount`, transient: true)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="admin/access-control/create-account.view.xml"
									>
										<bind
											channel="selection"
											to="selectedAccount"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command name="delete-account"
							clique="more"
							image="css:bi bi-trash"
							inputs="selectedAccount"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if($selectedAccount == currentUser(), #('A user cannot delete himself.'@en, 'Ein Benutzer kann sich nicht selber löschen.'@de), null)"/>
								<disabled-if expr="if($selectedAccount.get(`tl.accounts:Person#admin`), #('An administrator cannot be deleted.'@en, 'Ein Administrator kann nicht gelöscht werden.'@de), null)"/>
							</executability>
							<confirm expr="#('Delete account {0}?'@en, 'Konto {0} löschen?'@de).fill($selectedAccount.get(`tl.accounts:Person#name`))"/>
							<delete-object/>
							<write-channel name="selectedAccount"
								clear="true"
							/>
						</generic-command>
						<generic-command name="reset-password"
							clique="more"
							image="css:bi bi-key"
							inputs="selectedAccount"
							placement="TOOLBAR"
						>
							<label>
								<en>Reset password</en>
								<de>Passwort zurücksetzen</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedAccount"
									type="tl.accounts:Person"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<execute-script function="new(`tl.admin:PasswordReset`, transient: true)..set(`tl.admin:PasswordReset#account`, $selectedAccount)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="admin/access-control/reset-password.view.xml"
									/>
								</with-result>
							</execute-script>
						</generic-command>
						<!--
							Expires the selected account's password, forcing the change-password
							step on that account's next login.
						-->
						<generic-command name="expire-password"
							clique="more"
							image="css:bi bi-hourglass-split"
							inputs="selectedAccount"
							placement="TOOLBAR"
						>
							<label>
								<en>Expire password</en>
								<de>Passwort ablaufen lassen</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedAccount"
									type="tl.accounts:Person"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<expire-password/>
						</generic-command>
						<!--
							Marks the selected account as MFA-required with no secret, forcing the
							MFA-enrollment step on that account's next login.
						-->
						<generic-command name="require-mfa"
							clique="more"
							image="css:bi bi-shield-lock"
							inputs="selectedAccount"
							placement="TOOLBAR"
						>
							<label>
								<en>Require MFA (enroll)</en>
								<de>MFA verlangen (Einrichtung)</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedAccount"
									type="tl.accounts:Person"
								/>
							</access>
							<executability>
								<null-input-disabled/>
							</executability>
							<enable-mfa/>
						</generic-command>
						<!--
							Removes the authenticator app of the selected account, for a user who lost
							the device it ran on. The account keeps its MFA requirement: one required
							to use a second factor sets up a new one at its next login, one that chose
							it logs in with the password alone and may set one up again.
						-->
						<generic-command name="reset-mfa"
							clique="more"
							image="css:bi bi-shield-x"
							inputs="selectedAccount"
							placement="TOOLBAR"
						>
							<label>
								<en>Reset MFA</en>
								<de>MFA zurücksetzen</de>
							</label>
							<access>
								<operation name="Write"
									object="$selectedAccount"
									type="tl.accounts:Person"
								/>
							</access>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if($selectedAccount.get(`tl.accounts:Person#mfaSecret`) == null, #('The account has no authenticator app set up.'@en, 'Für das Konto ist keine Authenticator-App eingerichtet.'@de), null)"/>
							</executability>
							<confirm expr="#('Remove the authenticator app of this account? The user must set up their authenticator app again.'@en, 'Die Authenticator-App dieses Kontos entfernen? Der Benutzer muss seine Authenticator-App neu einrichten.'@de)"/>
							<reset-mfa/>
						</generic-command>
					</commands>
					<table id="table"
						observed-types="tl.accounts:Person"
						selection="selectedAccount"
						types="tl.accounts:Person"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="locked"/>
							<computed-column name="lastLogin"
								inputs="lastLogins"
								type="tl.core:DateTime"
							>
								<label>
									<en>Last login</en>
									<de>Letzte Anmeldung</de>
								</label>
								<value>$lastLogins[$row]</value>
							</computed-column>
						</columns>
						<rows>all(`tl.accounts:Person`)</rows>
						<export download-name="#('Accounts'@en, 'Konten'@de)">
							<sheet-name>
								<en>Accounts</en>
								<de>Konten</de>
							</sheet-name>
						</export>
					</table>
				</panel>
			</pane>
			<pane id="detail"
				size="60"
				unit="%"
			>
				<panel id="detail-panel">
					<title>
						<en>Account</en>
						<de>Konto</de>
					</title>
					<form id="form"
						input="selectedAccount"
						with-inset="true"
					>
						<group>
							<label>
								<en>Login</en>
								<de>Login</de>
							</label>
							<field attribute="name"/>
							<field attribute="firstName"/>
							<field attribute="lastName"/>
							<!-- The authentication device the account is checked against is set when the account is created. -->
							<field
								attribute="authDeviceID"
								readonly="true"
							/>
							<field attribute="admin"/>
							<field attribute="restrictedUser"/>
							<field attribute="locked"/>
							<field attribute="mfaRequirement"/>
							<value-input
								readonly="true"
								type="tl.core:Boolean"
								value="mfaConfigured"
							>
								<label>
									<en>Authenticator app set up</en>
									<de>Authenticator-App eingerichtet</de>
								</label>
							</value-input>
							<field attribute="unusedNotified"/>
						</group>
						<group>
							<label>
								<en>Settings</en>
								<de>Einstellungen</de>
							</label>
							<field attribute="language"/>
							<field attribute="country"/>
							<field attribute="timezone"/>
						</group>
						<group>
							<label>
								<en>Groups</en>
								<de>Gruppen</de>
							</label>
							<field attribute="groups"/>
							<field attribute="deputyFor"/>
						</group>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>