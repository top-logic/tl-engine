				<entry value="com.top_logic.tl.ai.core.tools.interaction.messages" />
				<entry value="com.top_logic.tl.ai.core.tools.integration.messages" />
				<entry value="com.top_logic.tl.ai.core.tools.web.messages" />
				<entry value="com.top_logic.tl.ai.core.session.persist.messages" />
				<entry value="com.top_logic.tl.ai.core.tools.web.WebSearchHit" />
				<entry value="com.top_logic.tl.ai.core.tools.web.WebSearchResults" />
				<entry value="com.top_logic.tl.ai.core.agent.skills.Skill" />
				<entry value="com.top_logic.tl.ai.core.memory.CompactionResult" />
