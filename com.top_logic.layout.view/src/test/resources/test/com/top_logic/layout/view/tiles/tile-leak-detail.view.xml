<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="item"/>
		<channel name="navPath"/>
		<derived-channel name="depth"
			expr="$navPath.size()"
			inputs="navPath"
		/>
	</channels>
	<panel title="Detail">
		<commands>
			<generic-command name="back"
				inputs="depth"
			>
				<executability>
					<visible-if expr="$depth > 0"/>
				</executability>
				<navigate-pop/>
			</generic-command>
		</commands>
		<form input="item">
			<field attribute="name"/>
			<visible-if
				expr="$depth == 1"
				input="depth"
			>
				<field
					attribute="name"
					readonly="true"
				/>
			</visible-if>
		</form>
	</panel>
</view>