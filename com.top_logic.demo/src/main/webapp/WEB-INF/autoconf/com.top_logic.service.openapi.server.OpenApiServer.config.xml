<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.service.openapi.server.OpenApiServer"
			config:override="true"
		>
			<instance class="com.top_logic.service.openapi.server.OpenApiServer"
				base-url="/api"
			>
				<information
					title="TL-Demo OpenAPI Server"
					version="1.0"
				/>
				<global-schemas>
					<schema name="Release">
						<schema><![CDATA[{
  "type": "object",
  "required": ["name", "version"],
  "properties": {
    "name": {"type": "string"},
    "version": {"type": "string"},
    "state": {"type": "string", "enum": ["planned", "released"]},
    "date": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}]]></schema>
					</schema>
				</global-schemas>
				<authentications>
					<basic-authentication
						domain="BasicAuth"
						in-user-context="true"
					/>
					<authentication class="com.top_logic.demo.api.CustomAuthentication"
						domain="API-Key DB"
						header="api-key"
					>
						<lookup-user><![CDATA[secret -> all(`test.dynamic_api_key:ApiKey`)
.filter(key -> $key.get(`test.dynamic_api_key:ApiKey#secret`) == $secret)
.map(key -> $key.get(`test.dynamic_api_key:ApiKey#owner`))]]></lookup-user>
					</authentication>
				</authentications>
				<paths>
					<PathItem path="/ping">
						<parameters>
							<path-parameter name="path"
								description=""
								example=""
								format="string"
								multiple="true"
								schema=""
							/>
						</parameters>
						<operations>
							<operation
								method="POST"
								summary="Reflects given parameters back to the sender."
							>
								<description><![CDATA[Produces a JSON result with the contents of the given request, header and body arguments.

A POST request to "/ping/a/b/c?q=q1&q=q2" e.g. delivers the result:

{
  "path": ["a", "b", "c"],
  "q": ["q1", "q2"],
  "body": null
}]]></description>
								<query-parameter name="q"
									description=""
									example=""
									format="string"
									multiple="true"
									required="false"
									schema=""
								/>
								<request-body name="body"
									description=""
									example=""
									format="object"
									required="false"
									schema=""
								/>
								<implementation transaction="false">
									<operation><![CDATA[{
  "q": $q,
  "path": $path,
  "body": $body
}]]></operation>
								</implementation>
							</operation>
						</operations>
					</PathItem>
					<PathItem path="/echo">
						<operations>
							<operation
								method="POST"
								summary="Echoes a release description that matches the declared schema."
							>
								<description><![CDATA[Returns the given request body unchanged. Demonstrates the validation of a request against the schema of its body parameter (#29785).

The body must be an object with a "release" matching the global schema "Release" and an optional "comment" that may be null. A body that does not match the schema is rejected with status 400 before the operation is executed; the response names each violation, e.g.:

Value of parameter 'body' does not match its schema: $.release: required property 'name' not found]]></description>
								<request-body name="body"
									format="object"
									required="true"
								>
									<schema><![CDATA[{
  "type": "object",
  "required": ["release"],
  "properties": {
    "release": {"$ref": "#/components/schemas/Release"},
    "comment": {"type": "string", "nullable": true}
  },
  "additionalProperties": false
}]]></schema>
								</request-body>
								<implementation transaction="false">
									<operation><![CDATA[$body]]></operation>
								</implementation>
							</operation>
						</operations>
					</PathItem>
					<PathItem path="/whoami">
						<operations>
							<operation
								authentication="API-Key DB,BasicAuth"
								method="GET"
							>
								<implementation>
									<operation><![CDATA[currentUser() == null ? "anonymous" : {
    "login": currentUser().get(`tl.accounts:Person#name`),
    "firstName": currentUser().get(`tl.accounts:Person#firstName`),
    "lastName": currentUser().get(`tl.accounts:Person#lastName`),
    "email": currentUser().get(`tl.accounts:Person#contact`).get(`Contacts:PersonContact#email`)
}]]></operation>
								</implementation>
							</operation>
						</operations>
					</PathItem>
					<PathItem path="/demo/A/{name}/binary">
						<parameters>
							<path-parameter name="name"
								description="The name of the Demo.A object whose binary attribute is requested."
								format="string"
							/>
						</parameters>
						<operations>
							<operation
								method="GET"
								summary="Downloads the binary attribute of a Demo.A object."
							>
								<description><![CDATA[Looks up the first Demo.A object with the given name and returns the raw bytes of its binary attribute. Demonstrates streaming binary responses from an OpenAPI endpoint via TL-Script (#29234).

Returns 404 if no matching object exists or its binary attribute is empty. Otherwise the response carries the binary's own content type (e.g. image/png).]]></description>
								<implementation transaction="false">
									<operation><![CDATA[{
  obj = all(`DemoTypes:A`)
    .filter(x -> $x.get(`DemoTypes:A#name`) == $name)
    .firstElement();
  $obj == null ? response(404) : {
    data = $obj.get(`DemoTypes:A#binary`);
    $data == null ? response(404) : $data;
  };
}]]></operation>
								</implementation>
							</operation>
						</operations>
					</PathItem>
				</paths>
			</instance>
		</config>
	</services>
</application>