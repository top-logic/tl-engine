<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient PasswordChange model bound to the form. -->
		<channel name="model"/>
		<!--
			The account of a login waiting for this password change, set by LoginAction. Empty when
			a user changes their own password from an established session: the account is then the
			session's own, and this view is the same dialog either way. Which of the two it is
			decides the explanation shown and whether the password is asked for again.
		-->
		<channel name="account"/>
	</channels>
	<window resizable="false"
			width="380px">
		<title>
			<en>Change password</en>
			<de>Passwort &#228;ndern</de>
		</title>
		<form input="model"
			initial-edit-mode="true"
			mode-switch="false"
		>
			<!--
				Why the dialog is open, and only when there is something to explain: a login blocked
				on an expired password says so, a user who chose to change their password does not
				need telling.
			-->
			<switch input="account">
				<case test="account -> $account != null">
					<text>
						<label>
							<en>Your password has expired. Please choose a new password.</en>
							<de>Ihr Passwort ist abgelaufen. Bitte w&#228;hlen Sie ein neues Passwort.</de>
						</label>
					</text>
				</case>
			</switch>
			<field attribute="newPassword"/>
			<field attribute="newPasswordConfirm"/>
			<commands>
				<generic-command placement="BUTTON_BAR" image="css:bi bi-key">
					<label>
						<en>Change password</en>
						<de>Passwort &#228;ndern</de>
					</label>
					<store-form-state/>
					<!--
						A user changing their own password proves they are the account holder before the
						change is applied, and the dialog closes once it is done: what was to be done
						here is done, and the settings dialog it was opened from is what remains. A login
						blocked on an expired password has just proven who it is with the password it
						authenticated with, has no session to ask in, and continues into the session it
						was waiting for - which takes the dialog with it.
					-->
					<if test="account -> model -> $account == null">
						<inputs>
							<input channel="account"/>
						</inputs>
						<then>
							<verify-identity/>
							<change-password/>
							<close-dialog/>
						</then>
						<else>
							<change-password/>
						</else>
					</if>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand" image="css:bi bi-x-lg">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
