<?xml version="1.0" encoding="utf-8" ?>

<!--
	Invoices: the list on the left, the selected invoice on the right.

	The same content the legacy tab shows (WEB-INF/layouts/tl-ai-demo/invoices/*.layout.xml), built
	from the standard view elements instead of layout templates - a table bound straight to
	tl.ai.demo.imageclassification:Invoice and a form on the table's selection.

	Creating an invoice from a scan is still done in the classic UI. The create dialog is the one
	part of this tab that did not carry over: its command chain runs the classification and fills the
	form, but the copied object does not reach the persistent world, so the new invoice never appears
	in this list. Rather than ship a create button that silently loses the invoice, the command is
	left out until that is understood - see the follow-up on issue #390.
-->
<view>
	<channels>
		<channel name="selectedInvoice"/>
	</channels>

	<split-panel orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane min-size="320"
				size="55"
				unit="%"
			>
				<panel fill="true">
					<title>
						<en>Invoices</en>
						<de>Belege</de>
					</title>
					<commands>
						<generic-command
							clique="more"
							image="css:bi bi-trash"
							input="selectedInvoice"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete invoice</en>
								<de>Beleg löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm>
								<confirm-label>
									<en>Delete</en>
									<de>Löschen</de>
								</confirm-label>
								<cancel-label>
									<en>Cancel</en>
									<de>Abbrechen</de>
								</cancel-label>
								<expr>obj -> {
									"en": "Delete this invoice?",
									"de": "Diesen Beleg löschen?"
								}.internationalize()</expr>
							</confirm>
							<with-transaction>
								<execute-script function="obj -> $obj.delete()"/>
							</with-transaction>
							<write-channel name="selectedInvoice"/>
						</generic-command>
					</commands>
					<table
						observed-types="tl.ai.demo.imageclassification:Invoice"
						selection="selectedInvoice"
						types="tl.ai.demo.imageclassification:Invoice"
					>
						<columns>
							<column attribute="date"
								sort="DESC"
							/>
							<column attribute="description"/>
							<column attribute="amount"/>
						</columns>
						<rows>x -> all(`tl.ai.demo.imageclassification:Invoice`)</rows>
					</table>
				</panel>
			</pane>
			<pane size="45"
				unit="%"
			>
				<panel fill="true">
					<title>
						<en>Invoice</en>
						<de>Beleg</de>
					</title>
					<form input="selectedInvoice">
						<field attribute="date"/>
						<field attribute="description"/>
						<field attribute="amount"/>
						<field attribute="data"/>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
