<?xml version="1.0" encoding="utf-8" ?>

<!--
	Initial frame of the tile drill-down demo. Lists all Person accounts and offers an "Open"
	button that pushes a detail frame onto the enclosing tile-stack with the selected Person as
	parameter. The pushed frame carries no label of its own - the stack names every frame of the
	detail view in its <frame> declaration, which is also what puts the frame into the address bar.
	The navPath channel is the stack's path (bound by the stack's bind-path-to), so the
	derived depth channel tells this frame how deep it sits: at depth 0 the "Back" command is
	hidden, which is why the initial frame shows no way out.
-->
<view>
	<channels>
		<channel name="selectedPerson"/>
		<channel name="navPath"/>
		<derived-channel name="depth"
			expr="p -> $p.size()"
			inputs="navPath"
		/>
	</channels>

	<panel>
		<title>
			<en>Accounts</en>
			<de>Konten</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-arrow-left"
				input="depth"
				placement="TOOLBAR"
			>
				<label>
					<en>Back</en>
					<de>Zurück</de>
				</label>
				<executability>
					<visible-if expr="d -> $d > 0"/>
				</executability>
				<navigate-pop/>
			</generic-command>
			<command class="com.top_logic.layout.view.tiles.NavigatePushCommand"
				bind-input-to="person"
				input="selectedPerson"
				placement="TOOLBAR"
				view="demo/tiles-demo/person-detail.view.xml"
			>
				<label>
					<en>Open</en>
					<de>Öffnen</de>
				</label>
			</command>
		</commands>
		<table
			selection="selectedPerson"
			types="tl.accounts:Person"
		>
			<rows>all(`tl.accounts:Person`)</rows>
		</table>
	</panel>
</view>