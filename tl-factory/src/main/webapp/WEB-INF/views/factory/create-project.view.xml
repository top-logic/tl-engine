<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog creating a project: the form edits the draft in "model". Creating stores the project in the
	context of the tenant of the user in "tenant", and starts building its workspace in the background;
	the new project is written to "selection". The project belongs to the tenant of the user; a user
	of no tenant, an operator, chooses the tenant.
	With git hosting, the dialog shows the git connection of the project, and an existing repository
	can be entered, which the workspace clones; without one, the workspace creates the repository of
	the project, which the constraint of the repository refuses if the access token of the connection
	may not create repositories (factoryCheckRepository).
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
		<channel name="tenant"/>
	</channels>
	<window width="520px">
		<title>
			<en>Create application</en>
			<de>Anwendung anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<visible-if
				expr="$tenant == null"
				input="tenant"
			>
				<field attribute="tenant"/>
			</visible-if>
			<field attribute="groupId"/>
			<field attribute="artifactId"/>
			<field attribute="engineVersion"/>
			<visible-if
				expr="factoryGitHosting()"
				input="model"
			>
				<field attribute="gitConnection"/>
				<field attribute="repository">
					<label>
						<en>Existing repository</en>
						<de>Bestehendes Repository</de>
					</label>
				</field>
				<alert severity="info">
					<message>
						<en>Enter an existing repository of the git connection to work on it, or leave the field empty: the first workspace then creates a new repository. If the access token of the git connection may not create repositories, the field asks for an existing repository.</en>
						<de>Ein bestehendes Repository der Git-Verbindung eingeben, um daran zu arbeiten, oder das Feld leer lassen: Der erste Workspace legt dann ein neues Repository an. Darf das Token der Git-Verbindung keine Repositorys anlegen, verlangt das Feld ein bestehendes Repository.</de>
					</message>
				</alert>
			</visible-if>
			<commands>
				<generic-command key="ENTER"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<persist-transient container="tenant">
						<with-result as="project">
							<write-channel name="selection"
								value="project"
							/>
							<close-dialog/>
							<execute-script function="factoryCreateWorkspace($project)"/>
						</with-result>
					</persist-transient>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>