<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tl-factory</artifactId>
  <name>${project.artifactId}</name>
  <description>Control application for TopLogic applications built by agents: the projects and their workspaces, one container per managed application, behind a pluggable provider with a Docker implementation, and the views managing them.</description>
  <url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
    </dependency>

    <!-- The views of the control application. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
    </dependency>

    <!-- The LLM provider whose API key the LLM proxy of the workspaces adds to their requests. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
    </dependency>

    <!-- The chat of tl-chat, showing the conversation of an agent working in a workspace. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-chat</artifactId>
    </dependency>

    <!-- Docker Engine API client of the Docker workspace provider (Apache-2.0). -->
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.docker-java</groupId>
      <artifactId>docker-java-transport-httpclient5</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
