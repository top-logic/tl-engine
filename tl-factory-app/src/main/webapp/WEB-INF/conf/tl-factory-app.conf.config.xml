<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<configs>
		<!-- A React-only application: its entry point is the view shell at /view/. -->
		<config config:interface="com.top_logic.base.accesscontrol.ApplicationPages$Config">
			<startPage>/view/</startPage>
		</config>
		<!--
			The control application shows nothing to a session without an account: whatever URL is
			asked for, the login page is displayed, and the requested URL is the one the user lands
			on after the login.
		-->
		<config config:interface="com.top_logic.layout.view.ViewConfig"
			login-view="login-page.view.xml"
		/>
	</configs>

	<services>
		<!--
			The provider whose API key the LLM proxy of the workspaces adds to their requests
			(LLMProxyService, provider "anthropic"); the key is read from the environment variable
			tl_anthropic_api_key. It exposes no models: the control application runs no agent itself.
		-->
		<config service-class="com.top_logic.tl.ai.core.provider.LLMProviderService">
			<instance class="com.top_logic.tl.ai.core.provider.LLMProviderService">
				<providers>
					<provider class="com.top_logic.tl.ai.core.provider.anthropic.AnthropicProviderConfig"
						api-key="%ANTHROPIC_API_KEY%"
						name="anthropic"
					/>
				</providers>
				<model-catalog fetch-remote-catalog="false"/>
			</instance>
		</config>
	</services>
</application>
