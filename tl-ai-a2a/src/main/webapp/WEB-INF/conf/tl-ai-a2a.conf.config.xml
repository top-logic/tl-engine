<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="tl-ai-a2a.app-messages" />
				</bundles>
			</instance>
		</config>

		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<!--
						On by default, and still closed: no agent is exposed and no call accepted until the
						application configures <agents> and <authentications> on A2AService.
					-->
					<module key="com.top_logic.ai.a2a.A2AService$Module" value="true"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.a2a.A2AService">
			<instance class="com.top_logic.ai.a2a.A2AService"/>
		</config>

		<!-- The client tools a2a.*, see A2AClientTools. -->
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance>
				<tool-factories>
					<factory name="a2a">
						<implementation class="com.top_logic.tl.ai.tool.api.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.a2a.client.A2AClientTools"
						/>
					</factory>
				</tool-factories>
			</instance>
		</config>
	</services>
</application>
