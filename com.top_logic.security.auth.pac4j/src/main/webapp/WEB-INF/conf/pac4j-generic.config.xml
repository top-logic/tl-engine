<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.security.auth.pac4j.config.Pac4jConfigFactory">
			<instance>
				<clients>
					<client name="pac4j-generic">
						<label>
							<en>Sign in with %PAC_LABEL%</en>
							<de>Über %PAC_LABEL% anmelden</de>
						</label>
						<client-id>%PAC_CLIENT_ID%</client-id>
						<scope>%PAC_SCOPE%</scope>
						<secret name="tl_pac_secret"/>
						<discovery-uri>%PAC_DISCOVERY_URI%</discovery-uri>
						<client-authentication-method>%PAC_CLIENT_AUTHENTICATION_METHOD%</client-authentication-method>
						<custom-params>
							<custom-param key="acr_values" value="%PAC_ACR_VALUES%" />
						</custom-params>
						<!--
							Accounts are created at login only with tl_pac_create_accounts=true; only then, or with
							a group claim (tl_pac_group_claim), is an account bound to the subject of its identity.
							Without both variables an existing account is found by its login name.
						-->
						<user-mapping class="com.top_logic.security.auth.pac4j.provisioning.OidcProvisioningUserMapping"
							create-accounts="%PAC_CREATE_ACCOUNTS%"
							group-claim="%PAC_GROUP_CLAIM%"
							groups-by-name="true"
							link-identities="%PAC_CREATE_ACCOUNTS%"
						/>
					</client>
				</clients>
			</instance>
		</config>
	</services>
</application>