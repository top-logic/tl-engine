<?xml version="1.0" encoding="utf-8" ?>

<!--
	Places the branch column of the tables behind the identifying columns of primary keys and
	indexes, e.g. (IDENTIFIER, BRANCH, REV_MAX). Meant for H2, which uses an index for an IN list only
	on its first column. An existing database is converted at the next start.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services/>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default"
					branch-last="true"
				/>
			</type-systems>
		</config>
	</configs>
</application>
