<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.factory">
		<types>
			<!--
				The state of a workspace: the states of its container, the operations running on it,
				and the error that ended an operation. Mirrors com.top_logic.factory.project.WorkspaceStatus.
			-->
			<enum name="WorkspaceStatus">
				<classifier name="CREATED"/>
				<classifier name="BUILDING"/>
				<classifier name="STARTING"/>
				<classifier name="RUNNING"/>
				<classifier name="APP_STOPPED"/>
				<classifier name="STOPPING"/>
				<classifier name="STOPPED"/>
				<classifier name="REMOVING"/>
				<classifier name="UPDATING"/>
				<classifier name="ERROR"/>
				<classifier name="UNKNOWN"/>
			</enum>

			<!--
				The role of a member in a tenant, one per reference of the tenant holding its members.
				Mirrors com.top_logic.factory.tenant.TenantRole.
			-->
			<enum name="TenantRole">
				<classifier name="ADMINISTRATOR"/>
				<classifier name="DEVELOPER"/>
				<classifier name="READER"/>
			</enum>

			<!--
				A company developing its applications in the control application: it owns its projects.
				Its members hold the roles of the tenant by the references they are in: an administrator
				manages the members, a developer works on the projects, a reader sees them. A user is a
				member of one tenant at most, in one or several of these roles.
			-->
			<class name="Tenant">
				<annotations>
					<main-properties properties="name"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<constraints>
								<unique/>
							</constraints>
						</annotations>
					</property>
					<reference name="administrators"
						kind="forwards"
						multiple="true"
						type="tl.accounts:Person"
					>
						<annotations>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckTenantMembers($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</reference>
					<reference name="developers"
						kind="forwards"
						multiple="true"
						type="tl.accounts:Person"
					>
						<annotations>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckTenantMembers($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</reference>
					<reference name="readers"
						kind="forwards"
						multiple="true"
						type="tl.accounts:Person"
					>
						<annotations>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckTenantMembers($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!--
				A git hosting service the repositories of projects live on: the type of the server, its
				URL, and the organization or user the repositories are created in. A built-in
				connection (without tenant) is configured in the installation and offered to every
				tenant; each tenant gets an organization of its own on it, named by the owner and the
				tenant. A connection of a tenant is created by its administrators with an access token,
				which is kept in the secret store of the installation under the hidden secret name.
				Connections are changed through the functions of com.top_logic.factory.git.GitConnections
				only.
			-->
			<class name="GitConnection">
				<annotations>
					<main-properties properties="name,providerType,url,owner,tenant"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<!-- The type of the git hosting service, one of the registered provider types. -->
					<property name="providerType"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<options-by-expression function="self -> factoryGitProviderTypes()"/>
							</options>
						</annotations>
					</property>
					<property name="url"
						mandatory="true"
						type="tl.core:String"
					/>
					<!--
						The organization or user the repositories are created in; for a built-in
						connection the start of the names of the organizations of the tenants.
					-->
					<property name="owner"
						mandatory="true"
						type="tl.core:String"
					/>
					<!-- The tenant that created the connection, empty for a built-in connection. -->
					<reference name="tenant"
						kind="forwards"
						type="Tenant"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</reference>
					<!--
						The tenants whose members may choose the connection: its tenant, or every tenant
						for a built-in connection. Its members read the connection.
					-->
					<reference name="tenants"
						kind="forwards"
						multiple="true"
						type="Tenant"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="hidden"/>
						</annotations>
					</reference>
					<!-- The name of the secret holding the access token of a connection of a tenant. -->
					<property name="secretName"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="hidden"/>
						</annotations>
					</property>
				</attributes>
			</class>

			<!-- A TopLogic application managed by the control application. -->
			<class name="Project">
				<annotations>
					<main-properties properties="name,tenant,groupId,artifactId,engineVersion,workspace"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<!--
						The tenant owning the project. A new project belongs to the tenant of the user
						creating it; a user of no tenant, an operator, chooses one. Read-only once the
						project is stored.
					-->
					<reference name="tenant"
						kind="forwards"
						mandatory="true"
						type="Tenant"
					>
						<annotations>
							<create-visibility value="editable"/>
							<visibility value="read-only"/>
							<default-value>
								<default-by-expression value="ctx -> factoryCurrentTenant()"/>
							</default-value>
							<!--
								The tenant of the user, all tenants the user may see for a user of no
								tenant.
							-->
							<options>
								<options-by-expression function="self -> {t = factoryCurrentTenant(); if($t == null, all(`tl.factory:Tenant`), [$t]);}"/>
							</options>
						</annotations>
					</reference>
					<!--
						The git connection the repository of the project lives on, chosen when the project
						is created among the built-in connections and those of its tenant; read-only
						afterwards. Empty for a project without repository, when there is no connection to
						choose.
					-->
					<reference name="gitConnection"
						kind="forwards"
						type="GitConnection"
					>
						<annotations>
							<create-visibility value="editable"/>
							<visibility value="read-only"/>
							<default-value>
								<default-by-expression value="ctx -> factoryDefaultGitConnection()"/>
							</default-value>
							<options>
								<options-by-expression function="self -> factoryGitConnections($self.get(`tl.factory:Project#tenant`))"/>
							</options>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckGitConnection($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</reference>
					<property name="groupId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> 'com.example'"/>
							</default-value>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckGroupId($value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<property name="artifactId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckArtifactId($value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<property name="engineVersion"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> factoryEngineVersion()"/>
							</default-value>
						</annotations>
					</property>
					<!--
						The repository of the project on the git hosting service, its full name
						owner/name. The workspace pushes to it through the git route of the workspace
						proxy. When the project is created, an existing repository may be entered,
						also as clone URL; empty, the first workspace creates one. The first workspace
						records the repository under its full name. Editable only on the draft of a
						new project, read-only once the project is stored.
					-->
					<property name="repository"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="editable"/>
							<visibility value="read-only"/>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckRepository($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<!--
						Whether the default branch of the repository is protected against force pushes and
						changes of the protected files; false if the access token of the git connection may
						not administer the repository. Empty (a tri-state value) until the creation of the
						first workspace has tried to protect the branch.
					-->
					<property name="branchProtected"
						type="tl.core:Tristate"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The page of the repository in the web interface of the git hosting service. -->
					<property name="repositoryUrl"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The job of the project on the CI server, which builds the default branch of its
						repository; set by the control application when it sets up the job.
					-->
					<property name="ciJob"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The page of the CI job in the web interface of the CI server. -->
					<property name="ciJobUrl"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<reference name="workspace"
						composite="true"
						kind="forwards"
						type="Workspace"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!-- The container the application of a project is built and run in. -->
			<class name="Workspace">
				<annotations>
					<id-column value="workspaceId"/>
					<main-properties properties="workspaceId,status,previewUrl"/>
				</annotations>
				<attributes>
					<property name="workspaceId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<reference name="status"
						mandatory="true"
						type="WorkspaceStatus"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</reference>
					<property name="hostPort"
						type="tl.core:Integer"
					>
						<annotations>
							<!-- A port, displayed without grouping separator. -->
							<format>
								<decimal pattern="0"/>
							</format>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<property name="previewUrl"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The initial password of the account root of the application of a development
						workspace. It is no longer valid once the password is changed in the application.
					-->
					<property name="initialPassword"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The image the container of the workspace was created from. A workspace without
						image or with another one than the current workspace image is outdated.
					-->
					<property name="image"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<property name="log"
						type="tl.core:Text"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The conversations with the coding agent working in the workspace. -->
					<reference name="conversations"
						composite="true"
						inverse-reference="workspace"
						kind="forwards"
						multiple="true"
						navigate="true"
						ordered="true"
						type="AgentConversation"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!--
				A conversation with the coding agent of a workspace: the subject of the chat that talks
				to the agent, started with a task given to the agent. The agent keeps the conversation
				itself; a new process of it continues the conversation stored under the session ID.
			-->
			<class name="AgentConversation">
				<annotations>
					<main-properties properties="createdAt,task,sessionId"/>
				</annotations>
				<attributes>
					<reference name="workspace"
						aggregate="true"
						inverse-reference="conversations"
						kind="backwards"
						navigate="true"
						type="Workspace"
					/>
					<property name="createdAt"
						type="tl.core:DateTime"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The task the conversation was started with, its first message to the agent. -->
					<property name="task"
						mandatory="true"
						type="tl.core:Text"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<!--
						The ID under which the agent keeps the conversation, empty before its first
						answer.
					-->
					<property name="sessionId"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
				</attributes>
			</class>
		</types>
	</module>

	<!--
		The input of the dialogs managing the tenants, their members and their git connections. Their
		objects are created transiently with new(..., transient: true) and never stored: the
		functions of com.top_logic.factory.tenant.TenantMembers create the accounts and memberships
		from them, those of com.top_logic.factory.git.GitConnections the git connections. No table is
		declared, and the module is marked internal in the access configuration.
	-->
	<module name="tl.factory.input">
		<types>
			<!-- The login data and the name of an account to create. -->
			<class name="Account"
				abstract="true"
			>
				<generalizations>
					<generalization type="tl.model:TLObject"/>
				</generalizations>
				<attributes>
					<property name="login"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="firstName"
						type="tl.core:String"
					/>
					<property name="lastName"
						type="tl.core:String"
					/>
					<property name="email"
						type="tl.core:String"
					/>
					<property name="password"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
							</input-control>
						</annotations>
					</property>
				</attributes>
			</class>

			<!-- A new member of a tenant: its account and its role in the tenant. -->
			<class name="NewMember">
				<generalizations>
					<generalization type="Account"/>
				</generalizations>
				<annotations>
					<id-column value="login"/>
				</annotations>
				<attributes>
					<reference name="role"
						mandatory="true"
						type="tl.factory:TenantRole"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> `tl.factory:TenantRole#DEVELOPER`"/>
							</default-value>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!-- A new tenant: its name and the account of its first administrator. -->
			<class name="NewTenant">
				<generalizations>
					<generalization type="Account"/>
				</generalizations>
				<annotations>
					<id-column value="tenantName"/>
				</annotations>
				<attributes>
					<property name="tenantName"
						mandatory="true"
						type="tl.core:String"
					/>
				</attributes>
			</class>

			<!-- The server and owner of a git connection of a tenant to create or change. -->
			<class name="GitConnectionData"
				abstract="true"
			>
				<generalizations>
					<generalization type="tl.model:TLObject"/>
				</generalizations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<!-- The type of the git hosting service, one of the registered provider types. -->
					<property name="providerType"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> factoryGitProviderTypes().firstElement()"/>
							</default-value>
							<options>
								<options-by-expression function="self -> factoryGitProviderTypes()"/>
							</options>
						</annotations>
					</property>
					<property name="url"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="owner"
						mandatory="true"
						type="tl.core:String"
					/>
				</attributes>
			</class>

			<!--
				An access token of a git connection, entered in a masked input and handed to the
				secret store only.
			-->
			<class name="GitToken"
				abstract="true"
			>
				<generalizations>
					<generalization type="tl.model:TLObject"/>
				</generalizations>
				<attributes>
					<property name="token"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
							</input-control>
						</annotations>
					</property>
				</attributes>
			</class>

			<!-- A new git connection of a tenant: its server, owner and access token. -->
			<class name="NewGitConnection">
				<generalizations>
					<generalization type="GitConnectionData"/>
					<generalization type="GitToken"/>
				</generalizations>
				<annotations>
					<id-column value="name"/>
				</annotations>
			</class>

			<!-- The changed server and owner of a git connection of a tenant. -->
			<class name="ChangedGitConnection">
				<generalizations>
					<generalization type="GitConnectionData"/>
				</generalizations>
				<annotations>
					<id-column value="name"/>
				</annotations>
				<attributes>
					<reference name="connection"
						mandatory="true"
						type="tl.factory:GitConnection"
					>
						<annotations>
							<visibility value="hidden"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!-- The new access token of a git connection of a tenant. -->
			<class name="NewGitToken">
				<generalizations>
					<generalization type="GitToken"/>
				</generalizations>
				<attributes>
					<reference name="connection"
						mandatory="true"
						type="tl.factory:GitConnection"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!-- The new role of a member of a tenant. -->
			<class name="MemberRole">
				<generalizations>
					<generalization type="tl.model:TLObject"/>
				</generalizations>
				<attributes>
					<reference name="member"
						type="tl.accounts:Person"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</reference>
					<reference name="role"
						mandatory="true"
						type="tl.factory:TenantRole"
					/>
				</attributes>
			</class>
		</types>
	</module>
</model>