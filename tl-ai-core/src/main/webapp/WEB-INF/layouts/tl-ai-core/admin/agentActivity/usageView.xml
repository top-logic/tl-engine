<?xml version="1.0" encoding="utf-8" ?>

<!--
	Verbrauch: what the agents consumed, over time and by the two dimensions a bill is read along.
	
	Charts rather than a table of aggregates. The rows of such a table would be groups, not model
	objects, and a TopLogic table builds its columns from a type - the scouting report marked that
	combination unverified and recommended against it. A chart takes arbitrary values, so the
	aggregation lives here and the tables stay lists of real runs.
	
	One period control at the top governs all three charts, the same way the Überblick tab works. Its
	own control rather than a shared one: a control that stays visible on the Sitzungen, Läufe and
	Rückfragen tabs, where it changes nothing, would be a control that lies about its reach.
	
	"Kosten nach Konto" is the one money figure here (#722): what each account's runs recorded, in the
	currency and at the rate configured when they ran. Per account because that is what a money
	budget is set for; the token charts beside it answer the per-model and per-agent questions.
-->
<securityLayout name="aiAgentUsageView"
	titleKey="admin.ai.agentActivity.usage.tabber"
	useDefaultChecker="false"
>
	<tabInfo label="admin.ai.agentActivity.usage.tabber"/>
	<components>
		<layout name="aiAgentUsageLayout"
			horizontal="false"
			resizable="true"
		>
			<components>
				<include name="tl-ai-core/admin/agentActivity/periodSelector.xml"
					rangeName="aiUsagePeriod"
					selectorName="aiUsagePeriodSelector"
				/>
				<include name="tl-ai-core/admin/agentActivity/charts/tokensPerDayChart.xml"/>
				<layout name="aiAgentUsageBreakdownRow"
					horizontal="true"
					resizable="true"
				>
					<components>
						<include name="tl-ai-core/admin/agentActivity/charts/tokensByModelChart.xml"/>
						<include name="tl-ai-core/admin/agentActivity/charts/tokensByAgentChart.xml"/>
						<include name="tl-ai-core/admin/agentActivity/charts/costByAccountChart.xml"/>
					</components>
				</layout>
			</components>
		</layout>
	</components>
</securityLayout>