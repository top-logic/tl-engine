<?xml version="1.0" encoding="utf-8" ?>

<!--
	Every session, without a time limit. Finding one is the header filters' job, not the model
	builder's.
	
	An earlier revision of this file pre-filtered to the last 30 days, on the theory that the four
	computed columns - how many runs a session had, how many failed, how many tokens they billed,
	how many questions still wait for a human (and, since #722, what the runs cost) - each walk AgentExecution#session backwards with
	referers() and so cost one indexed association query per row and column, which the table's own
	filters could not save because they run after the rows are built.
	
	The premise was right and the conclusion was wrong, and the measurement is in the pull request:
	over 500 sessions and 3874 runs, loading every session takes 1 ms and the date filter that used
	to bound it takes 2 ms - the window cost twice what it saved, because the filter evaluates
	now().withDayAdded(-30) once per row. All four referers() columns together evaluate over every
	row in 37 ms, and even that is only paid when a user sorts or filters on one: a column value is
	fetched per rendered cell, and only the current page is rendered.
-->
<tableView name="aiSessionsTable"
	objectType="tl.ai.execution:AgentSession"
	securityObject="securityRoot"
	titleKey="admin.ai.agentActivity.sessions.title"
>
	<layoutInfo size="68%"/>
	<modelBuilder class="com.top_logic.model.search.providers.ListModelByExpression">
		<elements><![CDATA[
			model -> all(`tl.ai.execution:AgentSession`)
		]]></elements>
		<supportsElement>element -&gt; $element.instanceOf(`tl.ai.execution:AgentSession`)</supportsElement>
	</modelBuilder>
	<table
		defaultColumns="displayName,kind,owner,runCount,errorCount,pendingCount,tokenCount,costTotal,lastUpdated"
		defaultSortOrder="lastUpdated:descending"
		fixedColumns="1"
	>
		<columns>
			<column name="displayName"
				columnWidth="190px"
				visibility="mandatory"
			/>
			<column name="kind"
				columnWidth="125px"
			/>
			<column name="owner"
				columnWidth="110px"
			/>
			<column name="title"
				columnWidth="200px"
			/>
			<column name="status"
				columnWidth="120px"
			/>
			<column name="createdAt"
				columnWidth="175px"
			/>
			<column name="lastUpdated"
				columnWidth="175px"
			/>
			<column name="metadata"
				visibility="excluded"
			/>
			<!--
				The computed columns are declared here for their width only; their label, type and
				accessor come from the configuration providers below.
			-->
			<column name="runCount"
				columnWidth="75px"
			/>
			<column name="errorCount"
				columnWidth="80px"
			/>
			<column name="pendingCount"
				columnWidth="80px"
			/>
			<column name="tokenCount"
				columnWidth="90px"
			/>
			<column name="costTotal"
				columnWidth="110px"
			/>
		</columns>
		<configurationProviders>
			<configurationProvider class="com.top_logic.model.search.providers.ComputedColumnProviderByExpression"
				columnId="runCount"
				columnLabel="admin.ai.agentActivity.sessions.runCount"
				columnType="tl.core:Integer"
			>
				<accessor><![CDATA[
					s -> $s.referers(`tl.ai.execution:AgentExecution#session`).size()
				]]></accessor>
			</configurationProvider>
			<configurationProvider class="com.top_logic.model.search.providers.ComputedColumnProviderByExpression"
				columnId="errorCount"
				columnLabel="admin.ai.agentActivity.sessions.errorCount"
				columnType="tl.core:Integer"
			>
				<accessor><![CDATA[
					s -> $s.referers(`tl.ai.execution:AgentExecution#session`)
						.filter(e -> $e.get(`tl.ai.execution:AgentExecution#status`) == `tl.ai.execution:ExecutionStatus#ERROR`)
						.size()
				]]></accessor>
			</configurationProvider>
			<configurationProvider class="com.top_logic.model.search.providers.ComputedColumnProviderByExpression"
				columnId="pendingCount"
				columnLabel="admin.ai.agentActivity.sessions.pendingCount"
				columnType="tl.core:Integer"
			>
				<accessor><![CDATA[
					s -> $s.referers(`tl.ai.execution:AgentExecution#session`)
						.flatMap(e -> $e.referers(`tl.ai.execution:InteractionRequest#execution`))
						.filter(r -> $r.get(`tl.ai.execution:InteractionRequest#state`) == `tl.ai.execution:InteractionState#PENDING`)
						.size()
				]]></accessor>
			</configurationProvider>
			<configurationProvider class="com.top_logic.model.search.providers.ComputedColumnProviderByExpression"
				columnId="tokenCount"
				columnLabel="admin.ai.agentActivity.sessions.tokenCount"
				columnType="tl.core:Long"
			>
				<accessor><![CDATA[
					s -> $s.referers(`tl.ai.execution:AgentExecution#session`)
						.map(e -> ifElse(isEmpty($e.get(`tl.ai.execution:AgentExecution#inputTokens`)), 0, $e.get(`tl.ai.execution:AgentExecution#inputTokens`))
							+ ifElse(isEmpty($e.get(`tl.ai.execution:AgentExecution#outputTokens`)), 0, $e.get(`tl.ai.execution:AgentExecution#outputTokens`)))
						.sum()
				]]></accessor>
			</configurationProvider>
			<!--
				Text rather than a number: the runs of one session are shown in the system currency at
				the rate of their day, or in US dollars where no rate converts them, and two amounts in
				two currencies are written side by side, never added. In the common case it is one
				amount.
			-->
			<configurationProvider class="com.top_logic.model.search.providers.ComputedColumnProviderByExpression"
				columnId="costTotal"
				columnLabel="admin.ai.agentActivity.sessions.costTotal"
				columnType="tl.core:String"
			>
				<accessor><![CDATA[
					s -> {
						priced = $s.referers(`tl.ai.execution:AgentExecution#session`)
							.filter(e -> !isEmpty($e.get(`tl.ai.execution:AgentExecution#displayCost`)));
						byCurrency = $priced.groupBy(e -> $e.get(`tl.ai.execution:AgentExecution#displayCurrency`));
						$byCurrency.keySet().toList().sort()
							.map(c -> numberFormat('#,##0.00##').format($byCurrency[$c]
								.map(e -> $e.get(`tl.ai.execution:AgentExecution#displayCost`)).sum()) + ' ' + $c)
							.join(' + ');
					}
				]]></accessor>
			</configurationProvider>
		</configurationProviders>
	</table>
	<buttons>
		<button id="refreshSessions"
			class="com.top_logic.layout.form.component.InvalidateCommand"
		/>
		<button id="exportExcel"
			class="com.top_logic.layout.table.export.ExcelExportHandler"
		/>
	</buttons>
</tableView>