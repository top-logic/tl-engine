<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="term"/>
		<channel name="flag"/>
		<channel name="date"/>
		<channel name="state"/>
		<channel name="owners"/>
		<channel name="project"/>
		<channel name="choice"/>
		<channel name="amount"/>
		<channel name="switched"/>
		<channel name="change"/>
	</channels>

	<panel>
		<children>
			<value-input
				clearable="true"
				debounce="500ms"
				icon="css:fa-solid fa-magnifying-glass"
				value="term"
			>
				<placeholder>
					<en>Search</en>
				</placeholder>
				<on-submit>
					<execute-script function="$value"/>
					<write-channel name="state"/>
				</on-submit>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="flag"
			/>
			<value-input
				type="tl.core:Date"
				value="date"
			/>
			<value-input
				label-position="above-value"
				readonly="true"
				type="test.input:Status"
				value="state"
			>
				<label>
					<en>Status</en>
				</label>
			</value-input>
			<value-input
				multiple="true"
				options="all(`tl.accounts:Person`)"
				type="tl.accounts:Person"
				value="owners"
			>
				<inputs>
					<input channel="project"/>
				</inputs>
			</value-input>
			<value-input
				type="test.input:Status"
				value="choice"
			>
				<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
					display="segmented"
				/>
			</value-input>
			<value-input
				type="tl.core:Integer"
				value="amount"
			>
				<input-control class="com.top_logic.layout.view.form.NumberInputControlProvider"
					display="slider"
					max="10.0"
					min="0.0"
					step="1.0"
				/>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="switched"
			>
				<input-control class="com.top_logic.layout.view.form.BooleanControlProvider"
					display="switch"
				/>
			</value-input>
			<value-input
				submit-on="change"
				value="term"
			>
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
			<value-input value="term">
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
			<value-input
				submit-on="change"
				type="tl.core:Boolean"
				value="flag"
			>
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="flag"
			>
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
			<value-input
				mandatory="true"
				type="tl.changelog:ChangeType"
				value="change"
			>
				<label>
					<en>Change</en>
				</label>
			</value-input>
			<value-input
				type="tl.changelog:ChangeType"
				value="change"
			>
				<label>
					<en>Change</en>
				</label>
			</value-input>
			<value-input
				type="tl.changelog:ChangeType"
				value="change"
			>
				<annotations>
					<classification-display value="radio"/>
				</annotations>
			</value-input>
			<value-input
				type="tl.changelog:ChangeType"
				value="change"
			>
				<annotations>
					<input-control>
						<impl class="com.top_logic.layout.view.form.SelectControlProvider"
							display="segmented"
						/>
					</input-control>
				</annotations>
			</value-input>
			<value-input
				type="tl.changelog:ChangeType"
				value="change"
			>
				<annotations>
					<input-control>
						<impl class="com.top_logic.layout.view.form.SelectControlProvider"
							display="segmented"
						/>
					</input-control>
				</annotations>
				<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
					display="chips"
				/>
			</value-input>
			<value-input
				mandatory="true"
				value="term"
			>
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
			<value-input
				mandatory="true"
				submit-on="change"
				value="term"
			>
				<on-submit class="test.com.top_logic.layout.view.element.TestValueInputElement$RecordingCommand"/>
			</value-input>
		</children>
	</panel>
</view>