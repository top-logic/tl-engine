<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.devtools.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.devtools.model.xml"/>
				</declarations>
			</instance>
		</config>
		<!--
			The developer tools model holds the transient form objects of the model editor. They
			are handled by the editor code only and never on behalf of a user through the access
			check, so they carry no access definition on purpose.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<module name="tl.devtools"
						internal="true"
					/>
				</security-config>
			</instance>
		</config>
	</services>
</application>
