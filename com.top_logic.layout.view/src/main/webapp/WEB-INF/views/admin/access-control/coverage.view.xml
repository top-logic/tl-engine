<?xml version="1.0" encoding="utf-8" ?>

<!--
	Security coverage: the completeness of the model based access definition, one row per analyzed
	type. The SecurityCoverageTable analyses the definition itself when the view is opened and
	rebuilds from the rows channel after a command; it writes the selected row to the selection
	channel and the parts of it the detail shows to the selectedType / selectedFindings /
	selectedRule channels. "Show configuration" hands the rendered security parents of all types
	to a dialog, "Show rule" the rule of the selected type (it is hidden while the selected type
	has none); both are copied into the application configuration by the developer.
-->
<view>
	<channels>
		<channel name="rows"/>
		<channel name="selection"/>
		<channel name="selectedType"/>
		<channel name="selectedFindings"/>
		<channel name="selectedRule"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="300"
				size="65"
				unit="%"
			>
				<panel fill="true">
					<title>
						<en>Coverage</en>
						<de>Abdeckung</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-arrow-clockwise"
							placement="TOOLBAR"
						>
							<label>
								<en>Refresh</en>
								<de>Aktualisieren</de>
							</label>
							<action class="com.top_logic.layout.view.admin.SecurityCoverageAction"
								mode="REFRESH"
							/>
							<write-channel name="rows"/>
						</generic-command>
						<generic-command
							image="css:bi bi-file-earmark-code"
							placement="TOOLBAR"
						>
							<label>
								<en>Show configuration</en>
								<de>Konfiguration anzeigen</de>
							</label>
							<action class="com.top_logic.layout.view.admin.SecurityCoverageAction"
								mode="CONFIGURATION"
								rows="rows"
							/>
							<open-dialog
								bind-input-to="content"
								dialog-view="admin/access-control/coverage-configuration.view.xml"
							/>
						</generic-command>
					</commands>
					<child class="com.top_logic.layout.view.admin.SecurityCoverageTable"
						input="rows"
						selected-findings="selectedFindings"
						selected-rule="selectedRule"
						selected-type="selectedType"
						selection="selection"
					/>
				</panel>
			</pane>
			<pane
				size="35"
				unit="%"
			>
				<panel>
					<title>
						<en>Type</en>
						<de>Typ</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-code-square"
							input="selectedRule"
							placement="TOOLBAR"
						>
							<label>
								<en>Show rule</en>
								<de>Regel anzeigen</de>
							</label>
							<executability>
								<visible-if expr="rule -> $rule != null"/>
							</executability>
							<open-dialog
								bind-input-to="content"
								dialog-view="admin/access-control/coverage-rule.view.xml"
							/>
						</generic-command>
					</commands>
					<visible-if
						expr="selected -> $selected != null"
						input="selection"
					>
						<stack
							direction="column"
							gap="default"
						>
							<text
								css-class="tlText--strong"
								input="selectedType"
							/>
							<text>
								<label>
									<en>Findings</en>
									<de>Befunde</de>
								</label>
							</text>
							<text input="selectedFindings"/>
							<visible-if
								expr="rule -> $rule != null"
								input="selectedRule"
							>
								<stack
									direction="column"
									gap="compact"
								>
									<text>
										<label>
											<en>Proposed security parent rule</en>
											<de>Vorgeschlagene Regel für das übergeordnete Sicherheitsobjekt</de>
										</label>
									</text>
									<html input="selectedRule"/>
								</stack>
							</visible-if>
						</stack>
					</visible-if>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>