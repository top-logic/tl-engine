<?xml version="1.0" encoding="utf-8" ?>

<!--
	The table of test.objectedit:Book and test.objectedit:Pamphlet, which also holds the container of
	each: the shelf of a book, with its position there, and the box of a pamphlet. Shaped like tl.doc's
	table of pages, whose container column is a key attribute too.
-->
<objectlist xmlns="http://www.top-logic.com/ns/meta/5.8">
	<metaobjects>
		<metaobject
			object_name="TestObjectEditBook"
			super_class="TLObject"
		>
			<annotations>
				<key-attributes attributes="shelf"/>
			</annotations>
			<attributes>
				<mo_attribute
					att_name="title"
					att_type="String"
					mandatory="false"
				/>
				<reference
					att_name="shelf"
					branch-global="false"
					by-value="true"
					deletion-policy="delete-referer"
					monomorphic="true"
					target-type="GenericObject"
				/>
				<mo_attribute
					att_name="shelfOrder"
					att_type="Integer"
					mandatory="false"
				/>
				<reference
					att_name="box"
					branch-global="false"
					by-value="true"
					deletion-policy="delete-referer"
					monomorphic="true"
					target-type="GenericObject"
				/>
			</attributes>
		</metaobject>
	</metaobjects>
</objectlist>
