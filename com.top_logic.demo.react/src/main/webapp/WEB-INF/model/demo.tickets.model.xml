<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="demo.tickets">
			<annotations>
				<package-binding
					implementation-package="com.top_logic.demo.react.model.tickets.impl"
					interface-package="com.top_logic.demo.react.model.tickets"
				/>
			</annotations>
			<enum name="TicketStatus">
				<classifier name="open">
					<annotations>
						<color role="warning"/>
					</annotations>
				</classifier>
				<classifier name="inProgress">
					<annotations>
						<color role="info"/>
					</annotations>
				</classifier>
				<classifier name="closed">
					<annotations>
						<color role="success"/>
					</annotations>
				</classifier>
			</enum>
			<class name="Ticket">
				<annotations>
					<dynamic-color>
						<color-by-expression color="t -> $t.get(`demo.tickets:Ticket#status`)"/>
					</dynamic-color>
					<main-properties properties="name"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<reference name="status"
						kind="forwards"
						type="TicketStatus"
					>
						<annotations>
							<default-value>
								<classifier value="open"/>
							</default-value>
						</annotations>
					</reference>
					<property name="order"
						type="tl.core:Integer"
					/>
					<property name="statusLabel"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<query>
									<expr>t -&gt; label($t.get(`demo.tickets:Ticket#status`))</expr>
								</query>
							</storage-algorithm>
						</annotations>
					</property>
					<property name="headline"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<implementation class="com.top_logic.demo.react.model.tickets.HeadlineStorage"/>
							</storage-algorithm>
						</annotations>
					</property>
					<property name="resolution"
						type="tl.core:String"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="t -> editMode -> if(demoTicketsIsClosed($t), if($editMode, &quot;editable&quot;, &quot;read-only&quot;), &quot;hidden&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<reference name="comments"
						composite="true"
						kind="forwards"
						multiple="true"
						ordered="true"
						type="Comment"
					/>
					<property name="category"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<options-by-expression function="t -&gt; all(`demo.tickets:Ticket`).map(x -&gt; $x.get(`demo.tickets:Ticket#category`)).filter(c -&gt; $c != null).toSet()"/>
							</options>
						</annotations>
					</property>
					<property name="tags"
						multiple="true"
						type="tl.core:String"
					>
						<annotations>
							<config-type value="STRING_SET"/>
							<storage-algorithm>
								<string-set-storage/>
							</storage-algorithm>
							<options>
								<options-by-expression function="t -&gt; all(`demo.tickets:Ticket`).map(x -&gt; $x.get(`demo.tickets:Ticket#tags`)).flatten().toSet()"/>
							</options>
						</annotations>
					</property>
					<reference name="keywords"
						kind="forwards"
						multiple="true"
						type="Keyword"
					/>
				</attributes>
			</class>
			<class name="Keyword">
				<annotations>
					<main-properties properties="name"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
				</attributes>
			</class>
			<class name="Comment">
				<annotations>
					<label>
						<label-provider class="com.top_logic.model.search.providers.LabelProviderByExpression"
							label="comment -> { a = $comment.get(`demo.tickets:Comment#author`); d = $comment.get(`demo.tickets:Comment#date`); if($a == null, #(&quot;Kommentar&quot;@de, &quot;Comment&quot;@en), label($a) + if($d != null, &quot; · &quot; + dateFormat(&quot;dd.MM.yyyy HH:mm&quot;).format($d), &quot;&quot;)); }"
						/>
					</label>
				</annotations>
				<attributes>
					<property name="content"
						mandatory="true"
						type="tl.model.wysiwyg:Html"
					/>
					<reference name="author"
						kind="forwards"
						type="tl.accounts:Person"
					/>
					<property name="date"
						type="tl.core:DateTime"
					/>
					<reference name="cited"
						kind="forwards"
						type="Comment"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="comment -> editMode -> if ($comment.get(`demo.tickets:Comment#cited`) != null, if($editMode, &quot;editable&quot;, &quot;read-only&quot;), &quot;hidden&quot;)"
								/>
							</dynamic-visibility>
							<options>
								<options-by-expression function="comment -> $comment.container().get(`demo.tickets:Ticket#comments`)"/>
							</options>
						</annotations>
					</reference>
					<reference name="attachments"
						composite="true"
						kind="forwards"
						multiple="true"
						ordered="true"
						type="Attachment"
					/>
				</attributes>
			</class>
			<class name="Attachment">
				<annotations>
					<main-properties properties="name, data"/>
				</annotations>
				<attributes>
					<property name="name"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<fallback-storage
									fallback-attribute="fileName"
									storage-attribute="customName"
								/>
							</storage-algorithm>
						</annotations>
					</property>
					<property name="customName"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="hidden"/>
						</annotations>
					</property>
					<property name="fileName"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<query>
									<expr>x -&gt; label($x.get(`demo.tickets:Attachment#data`))</expr>
								</query>
							</storage-algorithm>
							<visibility value="hidden"/>
						</annotations>
					</property>
					<property name="data"
						mandatory="true"
						type="tl.core:Binary"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>