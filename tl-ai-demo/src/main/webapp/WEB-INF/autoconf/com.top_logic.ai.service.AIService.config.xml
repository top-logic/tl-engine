<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.ai.service.AIService"
			config:override="true"
		>
			<instance class="com.top_logic.ai.service.AIService"
			>
				<factory class="com.top_logic.ai.service.providers.OpenAIChatModelFactory"
					api-key="%OPENAI_API_KEY%"
					base-url="https://api.openai.com/v1"
					max-idle-models="5"
					max-pool-size="10"
					models=""
				/>
				<factory class="com.top_logic.ai.service.providers.AnthropicChatModelFactory"
					api-key="%ANTHROPIC_API_KEY%"
					base-url="https://api.anthropic.com/v1"
					max-idle-models="5"
					max-pool-size="10"
					models=""
				/>
				<factory class="com.top_logic.ai.service.providers.MistralChatModelFactory"
					api-key="%MISTRAL_API_KEY%"
					base-url="https://api.mistral.ai/v1"
					max-idle-models="5"
					max-pool-size="10"
				/>
			</instance>
		</config>
	</services>
</application>