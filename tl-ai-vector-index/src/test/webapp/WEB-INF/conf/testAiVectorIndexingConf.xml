<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- 
		Vector Index Test Configuration
		
		This configuration is used for running tests.
		Default: JVector (local, no external dependencies required)
		Alternative: Qdrant (requires running Qdrant server)
	-->
	
	<!-- ============================================ -->
	<!-- ACTIVE TEST CONFIGURATION: JVector (Local)  -->
	<!-- ============================================ -->
	<instance class="com.top_logic.ai.vector.index.VectorIndex">
		<!-- Vector store type: "jvector" for local testing -->
		<vector-store-type>jvector</vector-store-type>
		
		<!-- Local storage path for JVector index files -->
		<local-store-path>tmp/test-jvector</local-store-path>
		
		<!-- Vector dimension (default: 1024 for Mistral embeddings) -->
		<vector-dimension>1024</vector-dimension>
		
		<!-- Mistral AI embedding configuration -->
		<mistral-api-key>TEST_API_KEY</mistral-api-key>
		<mistral-embed-model>mistral-embed</mistral-embed-model>
		
		<!-- Models to include in vector indexing (comma-separated) -->
		<vector-index-models></vector-index-models>
		
		<!-- Timeout settings (milliseconds) -->
		<timeout-abort-indexing-for-shutdown>5000</timeout-abort-indexing-for-shutdown>
		<warn-queue-size>100</warn-queue-size>
	</instance>
	
