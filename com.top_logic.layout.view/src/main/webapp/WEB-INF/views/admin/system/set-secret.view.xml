<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the secrets view (opened from secrets.view.xml) writing the secret of the selected
	reference. The opener binds the reference to the reference channel and its own secrets and
	selection channels to the channels of the same names. The secret is a value of the view (value-input on the channel secret),
	entered in a masked password input (PasswordInputControlProvider); no model object is involved
	and the dialog shows the secret nowhere else. Save runs secretStore with the reference and the
	secret - a secret that cannot be stored is reported as error of the command and leaves the
	dialog open -, then writes a new snapshot of the references (secretReferences) to the secrets
	channel, so that the table of the opener shows the new status, selects the reference of the new
	snapshot with the service and property path of the edited one, and closes the dialog.
-->
<view>
	<channels>
		<channel name="reference"/>
		<channel name="secrets"/>
		<channel name="selection"/>
		<channel name="secret"/>
	</channels>
	<window
		resizable="false"
		width="640px"
	>
		<title>
			<en>Set secret</en>
			<de>Geheimnis setzen</de>
		</title>
		<fields
			label-position="top"
			max-columns="1"
			with-inset="true"
		>
			<text>
				<label>
					<en>Writes the secret to the writable secret storage of the installation under the name the selected configuration refers to. A secret stored before under this name is replaced. A service that read the secret already, e.g. when it was started, may need a restart to use the new one.</en>
					<de>Schreibt das Geheimnis unter dem Namen, auf den die ausgewählte Konfiguration verweist, in die beschreibbare Geheimnisablage der Installation. Ein zuvor unter diesem Namen abgelegtes Geheimnis wird ersetzt. Ein Dienst, der das Geheimnis bereits gelesen hat, z. B. beim Start, muss eventuell neu gestartet werden, um das neue zu verwenden.</de>
				</label>
			</text>
			<value-input
				mandatory="true"
				type="tl.core:String"
				value="secret"
			>
				<label>
					<en>Secret</en>
					<de>Geheimnis</de>
				</label>
				<input-control class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
			</value-input>
		</fields>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-check-lg"
					inputs="reference, secret"
				>
					<label>
						<en>Save</en>
						<de>Speichern</de>
					</label>
					<execute-script function="secretStore($reference, $secret)"/>
					<execute-script function="secretReferences()">
						<with-result as="snapshot">
							<write-channel name="secrets"/>
							<execute-script function="$snapshot.filter(r -> secretService($r) == secretService($reference) and secretPath($r) == secretPath($reference)).firstElement()">
								<with-result>
									<write-channel name="selection"/>
								</with-result>
							</execute-script>
						</with-result>
					</execute-script>
					<close-dialog/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>