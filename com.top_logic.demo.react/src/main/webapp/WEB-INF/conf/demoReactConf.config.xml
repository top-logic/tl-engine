<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<!--
					A third data language (without own UI resources, falling back to English)
					exercises multi-language features beyond the trivial two-locale case, e.g. the
					language selector of the I18N editor dialog.
				-->
				<supported-locales>
					<locale name="es"/>
				</supported-locales>
				<bundles>
					<bundle name="model.demo.react.messages"/>
					<bundle name="model.demo.tickets.messages"/>
					<bundle name="model.demo.charts.messages"/>
					<bundle name="model.test.constraints.messages"/>
					<bundle name="model.test.flowchart.messages"/>
					<bundle name="model.tl.demo.projectManagement.messages"/>
					<bundle name="model.demo.filter.messages"/>
					<bundle name="model.demo.calendar.messages"/>
					<bundle name="model.demo.documents.messages"/>
				</bundles>
			</instance>
		</config>
		<!--
			The roles of this application: the administrator role that may open the administration
			area, granted in security.xml; the account reader and user roles that the role rules below
			give to the members of the "users" group; the project member and project administrator
			roles that the role rules below give to the members and the administrators of a project,
			on that project only; and the chart reader role
			that makes the sales and purchases of the chart demo visible to a visitor without an
			account, granted by a role rule below as well.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="demo.react.Administrator"/>
					<role name="demo.react.AccountReader"/>
					<role name="demo.react.User"/>
					<role name="demo.react.ProjectMember"/>
					<role name="demo.react.ProjectAdmin"/>
					<role name="demo.react.ChartReader"/>
				</roles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/demo.react.model.xml"/>
					<declaration file="/WEB-INF/model/demo.tickets.model.xml"/>
					<declaration file="/WEB-INF/model/DemoCharts.model.xml"/>
					<declaration file="/WEB-INF/model/test.constraints.model.xml"/>
					<declaration file="/WEB-INF/model/test.flowchart.model.xml"/>
					<declaration file="/WEB-INF/model/tl.demo.projectManagement.model.xml"/>
					<declaration file="/WEB-INF/model/demo.filter.model.xml"/>
					<declaration file="/WEB-INF/model/demo.calendar.model.xml"/>
					<declaration file="/WEB-INF/model/demo.documents.model.xml"/>
				</declarations>
			</instance>
		</config>
		<!--
			Every newly created account joins the "users" group. The administration hub shows the
			default-group flag on that group.
		-->
		<config service-class="com.top_logic.base.services.InitialGroupManager">
			<instance default-group="users">
				<groups>
					<group name="users"/>
				</groups>
			</instance>
		</config>
		<!--
			Every member of the "users" group reads every account and every group, so that the
			deputy settings can offer the other accounts and show who stands in for whom. This is a
			decision of this demo; a real application decides for itself whether and which accounts
			a user may see. The engine grants an account read access to its own account only.
			
			The anonymous account, which every visitor without an account shares, reads the sales and
			purchases of the chart demo, so that such a visitor sees them on the page written for them
			(browse.view.xml). The rule assigns the role to the representative group of that account,
			which is named after it and contains nothing else, so no other account gains a right.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="tl.accounts:Person">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.AccountReader"
						/>
					</class>
					<class name="tl.accounts:Group">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.AccountReader"
						/>
					</class>
					<!--
						A project member - an account listed in the members of a project, by the role
						rules below - works in that project without owning it: they read the project,
						its milestones, notes and tickets; they write the project, except for its members
						and administrators, and therefore create, edit and delete its milestones and
						notes.
						
						The milestones and the notes of a project have no access definition of their
						own: their access parent is the project containing them, which makes the whole
						access decision. Reading one is reading the project, and editing, creating or
						deleting one is writing the project, since a part is created or deleted by
						editing the whole. The tickets of a project decide for themselves: the role
						rules below pass the project roles on to them, and the module grants decide what
						these roles may do with a ticket.
						
						A project administrator - an account listed in the administrators of a project -
						reads, writes, creates and deletes everything in that project, deletes the
						project, and decides who its members and administrators are.
						
						A project whose members and administrators do not list the account is not
						visible to it at all. Creating a project is decided against the security root,
						where these roles are held by no one, so only a super user creates projects.
						
						A user - every member of the "users" group - reads the contributors, which
						belong to no project, and the tickets of the ticket demo.
						
						The views follow these rights: for an account that is a member of P1 but not
						of P2, the project list shows P1 only; "New Project" is not offered at all;
						"Delete" of P1 is offered but disabled with the reason; "New Milestone", "New
						Note" and the deletion of a milestone work in P1; a save that changes the
						members or the administrators of P1 is refused. An administrator of P1
						deletes P1 and changes its members. The ticket demo shows its tickets, but
						neither creates nor deletes one.
					-->
					<module name="tl.demo.projectManagement">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.ProjectMember, demo.react.ProjectAdmin"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="demo.react.ProjectAdmin"
						/>
						<grant
							inherit="true"
							operation="Create"
							roles="demo.react.ProjectAdmin"
						/>
						<grant
							inherit="true"
							operation="Delete"
							roles="demo.react.ProjectAdmin"
						/>
					</module>
					<class name="tl.demo.projectManagement:ProjectScope">
						<grant
							inherit="true"
							operation="Write"
							roles="demo.react.ProjectMember"
						/>
					</class>
					<part name="tl.demo.projectManagement:ProjectScope#members">
						<grant
							operation="Write"
							roles="demo.react.ProjectAdmin"
						/>
					</part>
					<part name="tl.demo.projectManagement:ProjectScope#admins">
						<grant
							operation="Write"
							roles="demo.react.ProjectAdmin"
						/>
					</part>
					<class name="tl.demo.projectManagement:Milestone">
						<access-parent>
							<container reference="tl.demo.projectManagement:ProjectScope#milestones"/>
						</access-parent>
					</class>
					<class name="tl.demo.projectManagement:Note">
						<access-parent>
							<container reference="tl.demo.projectManagement:ProjectScope#notes"/>
						</access-parent>
					</class>
					<class name="tl.demo.projectManagement:Contributor">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.User"
						/>
					</class>
					<module name="demo.tickets">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.User"
						/>
					</module>
					<class name="demo.charts:Transaktion">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.ChartReader"
						/>
					</class>
				</security-config>
			</instance>
		</config>
		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="AccountsReadableByUsers"
							inherit="true"
							meta-element="tl.accounts:Person"
							role="demo.react.AccountReader"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="GroupsReadableByUsers"
							inherit="true"
							meta-element="tl.accounts:Group"
							role="demo.react.AccountReader"
						>
							<group-with-name name="users"/>
						</rule>
						<!--
							An account listed in the members of a project is a project member, and an
							account listed in its administrators a project administrator, on that
							project and, by inheritance, on its tickets. The milestones and notes of the
							project need no role of their own, since the project decides their access.
						-->
						<rule id="MembersOfProject"
							inherit="true"
							meta-element="tl.demo.projectManagement:ProjectScope"
							role="demo.react.ProjectMember"
						>
							<path>
								<step attribute="tl.demo.projectManagement:ProjectScope#members"/>
							</path>
						</rule>
						<rule id="AdminsOfProject"
							inherit="true"
							meta-element="tl.demo.projectManagement:ProjectScope"
							role="demo.react.ProjectAdmin"
						>
							<path>
								<step attribute="tl.demo.projectManagement:ProjectScope#admins"/>
							</path>
						</rule>
						<inheritance-rule id="MembersOnTickets"
							inherit="true"
							meta-element="tl.demo.projectManagement:Ticket"
							role="demo.react.ProjectMember"
							source-role="demo.react.ProjectMember"
						>
							<path>
								<step
									attribute="tl.demo.projectManagement:ProjectScope#tickets"
									inverse="true"
								/>
							</path>
						</inheritance-rule>
						<inheritance-rule id="AdminsOnTickets"
							inherit="true"
							meta-element="tl.demo.projectManagement:Ticket"
							role="demo.react.ProjectAdmin"
							source-role="demo.react.ProjectAdmin"
						>
							<path>
								<step
									attribute="tl.demo.projectManagement:ProjectScope#tickets"
									inverse="true"
								/>
							</path>
						</inheritance-rule>
						<!--
							Every member of the "users" group is a user on the contributors and on every
							object of the ticket demo.
						-->
						<rule id="ContributorsOfUsers"
							inherit="true"
							meta-element="tl.demo.projectManagement:Contributor"
							role="demo.react.User"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="TicketsOfUsers"
							inherit="true"
							meta-element="demo.tickets:Ticket"
							role="demo.react.User"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="CommentsOfUsers"
							inherit="true"
							meta-element="demo.tickets:Comment"
							role="demo.react.User"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="AttachmentsOfUsers"
							inherit="true"
							meta-element="demo.tickets:Attachment"
							role="demo.react.User"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="ChartsReadableByAnonymous"
							inherit="true"
							meta-element="demo.charts:Transaktion"
							role="demo.react.ChartReader"
						>
							<group-with-name name="anonymous"/>
						</rule>
					</rules>
				</role-rules>
			</instance>
		</config>
		<!--
			Where this application displays its business objects. A read-only value whose type is
			listed here is offered as a link; following it reveals the views below in order and
			hands each of them the values its bindings compute.
			
			The frames a target pushes carry the same channel values and the same labels as the
			frames the user's own drill-down pushes, so a target leading into a drill-down the user
			already has leaves it untouched.
			
			Each view is looked for within the view shown before it, and a view that the drill-down
			reaches by pushing a frame is named as its own step: the milestone list sits behind the
			Milestones tile of the project cockpit, so it is a frame after the cockpit frame, and
			its label is the one that tile pushes with.
		-->
		<config service-class="com.top_logic.layout.view.navigation.DisplayTargetService">
			<instance>
				<targets>
					<target type="tl.demo.projectManagement:ProjectScope">
						<show view="projects/overview.view.xml">
							<bind channel="project"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Milestone">
						<show view="projects/overview.view.xml">
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
						</show>
						<show
							label-expr="m -> $m.container().get(`tl.demo.projectManagement:ProjectScope#name`)"
							view="projects/milestones.view.xml"
						>
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
						</show>
						<show
							label-expr="m -> #('Milestones'@en, 'Meilensteine'@de)"
							view="projects/milestone-list.view.xml"
						>
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
							<bind channel="milestone"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Ticket">
						<show view="projects/overview.view.xml">
							<bind
								channel="project"
								expr="t -> $t.container()"
							/>
						</show>
						<show
							label-expr="t -> $t.container().get(`tl.demo.projectManagement:ProjectScope#name`)"
							view="projects/milestones.view.xml"
						>
							<bind
								channel="project"
								expr="t -> $t.container()"
							/>
						</show>
						<show
							label-expr="t -> #('Milestones'@en, 'Meilensteine'@de)"
							view="projects/milestone-list.view.xml"
						>
							<bind
								channel="project"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`).container()"
							/>
							<bind
								channel="milestone"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`)"
							/>
						</show>
						<show
							label-expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`).get(`tl.demo.projectManagement:Milestone#name`)"
							view="projects/tickets.view.xml"
						>
							<bind
								channel="milestone"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`)"
							/>
						</show>
						<show
							label-expr="t -> $t.get(`tl.demo.projectManagement:Ticket#title`)"
							view="projects/ticket-detail.view.xml"
						>
							<bind channel="ticket"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Contributor">
						<show
							dialog="true"
							view="projects/contributor-dialog.view.xml"
						>
							<bind channel="contributor"/>
						</show>
					</target>
					<target type="tl.accounts:Person">
						<show view="demo/tiles-demo/overview.view.xml">
							<bind channel="selectedPerson"/>
						</show>
						<show
							label-expr="p -> $p.get(`tl.accounts:Person#name`)"
							view="demo/tiles-demo/person-detail.view.xml"
						>
							<bind channel="person"/>
						</show>
					</target>
					<target type="demo.tickets:Ticket">
						<show view="tickets.view.xml">
							<bind channel="ticket"/>
						</show>
					</target>
				</targets>
			</instance>
		</config>
		<!--
			The themes of this application, each restyling the tokens the React controls and the
			application stylesheet are drawn from.
			
			"Flat" takes rounding and elevation away, demonstrating that the React controls take
			their corners and their shadows from the theme alone. "Glass" turns on the two tokens
			the shipped themes leave without effect - the blur behind a translucent surface and the
			glow around a highlighted one, both consumed by the glass card of the styling demo - and
			gives the headings a display face of their own.
		-->
		<config service-class="com.top_logic.layout.react.theme.UIThemeService">
			<instance>
				<themes>
					<theme name="flat"
						extends="default"
						icon="css:bi bi-square"
					>
						<label>
							<en>Flat</en>
							<de>Flach</de>
						</label>
						<length name="border-radius-02"
							value="0"
						/>
						<length name="corner-radius"
							value="0"
						/>
						<text name="shadow-dialog"
							value="none"
						/>
						<text name="shadow-menu"
							value="none"
						/>
						<text name="shadow-raised"
							value="none"
						/>
					</theme>
					<theme name="glass"
						extends="default"
						icon="css:bi bi-droplet-half"
					>
						<label>
							<en>Glass</en>
							<de>Glas</de>
						</label>
						<text name="font-family-display"
							value="Georgia, serif"
						/>
						<text name="shadow-glow"
							value="0 0 24px rgba(41,104,200,0.45)"
						/>
						<length name="surface-blur"
							value="12px"
						/>
					</theme>
				</themes>
			</instance>
		</config>
		<!--
			The stylesheet of this application, contributed to the client resources of the React UI
			behind the stylesheets of the controls, so that it overrides them. It holds the
			staggered entrance of the repeater demo's items.
		-->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="tl-demo-react-css"
						requires="tl-react-controls-css"
						resource="/style/tl-demo-react.css"
					/>
				</resources>
			</instance>
		</config>
	</services>

	<configs>
		<!--
			This is a React-only application: its entry point is the React view shell at /view/.
			The framework's start page is a singleton setting that the legacy core defaults to the
			layout servlet; the application authoritatively declares its own entry here.
		-->
		<config config:interface="com.top_logic.base.accesscontrol.ApplicationPages$Config">
			<startPage>/view/</startPage>
		</config>
		<!--
			The demo lowers the upload limit below the framework default so that the refusal of an
			oversized file can be tried out with a moderately sized file.
		-->
		<config config:interface="com.top_logic.layout.react.control.upload.UploadConfig"
			max-upload-size="10m"
		/>
		<!--
			What a session that belongs to no account sees in place of the application: the
			framework's login page, whatever the URL asks for, with a link to the one page such a
			visitor may browse. Apart from that page, this demo shows its objects to accounts only,
			like a business application, and the requested URL is held while the login page is
			displayed, so a deep link leads to the page it names as soon as the visitor is logged in.
		-->
		<config config:interface="com.top_logic.layout.view.ViewConfig"
			login-view="demo-login-page.view.xml"
		>
			<!--
				A second view a URL may load top-level, besides the default view: the document viewer
				is self-contained, so it shows the same thing in a browser tab of its own as it does
				inside the application shell.
			-->
			<entry-points>
				<entry-point view="demo/pdf-demo.view.xml"/>
				<!--
					The page a visitor without an account may browse, linked from the login page:
					shown to such a session instead of the login page.
				-->
				<entry-point
					anonymous="true"
					view="browse.view.xml"
				/>
			</entry-points>
		</config>
	</configs>
</application>