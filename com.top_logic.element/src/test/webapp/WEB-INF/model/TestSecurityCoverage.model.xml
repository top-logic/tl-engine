<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestSecurityCoverage">
			<types>
				<!-- Role rule and read grant: completely covered. -->
				<class name="Covered">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
						<reference name="children"
							composite="true"
							multiple="true"
							type="ChildOfCovered"
						/>
					</attributes>
				</class>

				<!-- Inherits the role rule and the grant of its generalization. -->
				<class name="CoveredSub">
					<generalizations>
						<generalization type="Covered"/>
					</generalizations>
				</class>

				<!-- Role source is a security parent rule pointing to the container. -->
				<class name="ChildOfCovered"/>

				<!-- Neither a role source nor a container. -->
				<class name="Orphan"/>

				<!-- Contained in exactly one composition: a security parent can be proposed. -->
				<class name="SingleContained"/>

				<!-- Contained in two compositions: the security parent is ambiguous. -->
				<class name="DoubleContained"/>

				<class name="Container">
					<attributes>
						<reference name="singles"
							composite="true"
							multiple="true"
							type="SingleContained"
						/>
						<reference name="doublesA"
							composite="true"
							multiple="true"
							type="DoubleContained"
						/>
					</attributes>
				</class>

				<class name="OtherContainer">
					<attributes>
						<reference name="doublesB"
							composite="true"
							multiple="true"
							type="DoubleContained"
						/>
					</attributes>
				</class>

				<!-- Read is granted to a role that no rule delivers on this type. -->
				<class name="DeadGrant">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<!-- Excluded from access control: no finding despite the missing definitions. -->
				<class name="Unsecured"/>
			</types>
		</module>

		<!-- Analyzed only when the module is not excluded. -->
		<module name="TestSecurityCoverageExcluded">
			<types>
				<class name="Ignored"/>
			</types>
		</module>
	</modules>
</model>
