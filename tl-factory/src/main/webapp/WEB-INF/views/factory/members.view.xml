<?xml version="1.0" encoding="utf-8" ?>

<!--
	The members of a tenant: their accounts with login name, name, e-mail address and role in the
	tenant. Whoever may change the tenant - an administrator of the tenant or an operator - creates
	members with new accounts (factory/create-member.view.xml), changes their role
	(factory/change-member-role.view.xml) and removes them, which deletes their accounts
	(TenantMembers). The other members see the list only.
	
	The embedding view binds the tenant: the tenant of the user (factory/my-tenant.view.xml) or the
	tenant an operator selects (factory/tenants.view.xml).
-->
<view>
	<channels>
		<channel name="tenant"/>
		<channel name="member"/>
	</channels>
	<panel>
		<title>
			<en>Members</en>
			<de>Mitglieder</de>
		</title>
		<commands>
			<generic-command name="createMember"
				image="css:bi bi-person-plus"
				inputs="tenant"
				placement="TOOLBAR"
			>
				<label>
					<en>Create member</en>
					<de>Mitglied anlegen</de>
				</label>
				<access>
					<operation name="Write"
						object="$tenant"
						type="tl.factory:Tenant"
					/>
				</access>
				<executability>
					<null-input-hidden/>
				</executability>
				<execute-script function="new(`tl.factory.input:NewMember`, transient: true)">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="factory/create-member.view.xml"
						>
							<bind
								channel="tenant"
								to="tenant"
							/>
							<bind
								channel="selection"
								to="member"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command name="changeMemberRole"
				clique="edit"
				image="css:bi bi-person-gear"
				inputs="tenant, member"
				placement="TOOLBAR"
			>
				<label>
					<en>Change role</en>
					<de>Rolle ändern</de>
				</label>
				<access>
					<operation name="Write"
						object="$tenant"
						type="tl.factory:Tenant"
					/>
				</access>
				<executability>
					<null-input-hidden/>
					<disabled-if expr="if($member == null, #('Select a member.'@en, 'Ein Mitglied auswählen.'@de), null)"/>
				</executability>
				<execute-script function="new(`tl.factory.input:MemberRole`, transient: true)..set(`tl.factory.input:MemberRole#member`, $member)">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="factory/change-member-role.view.xml"
						>
							<bind
								channel="tenant"
								to="tenant"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command name="removeMember"
				clique="delete"
				image="css:bi bi-person-dash"
				inputs="tenant, member"
				placement="TOOLBAR"
			>
				<label>
					<en>Remove member</en>
					<de>Mitglied entfernen</de>
				</label>
				<access>
					<operation name="Write"
						object="$tenant"
						type="tl.factory:Tenant"
					/>
				</access>
				<executability>
					<null-input-hidden/>
					<disabled-if expr="if($member == null, #('Select a member.'@en, 'Ein Mitglied auswählen.'@de), if($member == currentUser(), #('You cannot remove yourself from the tenant.'@en, 'Sie können sich nicht selbst aus dem Mandanten entfernen.'@de), null))"/>
				</executability>
				<confirm expr="#('Remove {0} from the tenant {1}? The account is deleted.'@en, '{0} aus dem Mandanten {1} entfernen? Das Konto wird gelöscht.'@de).fill($member, $tenant)"/>
				<execute-script function="factoryRemoveMember($tenant, $member)"/>
				<write-channel name="member"
					clear="true"
				/>
			</generic-command>
		</commands>
		<table
			observed-types="tl.factory:Tenant, tl.accounts:Person"
			personalization-key="tl-factory-members"
			selection="member"
			types="tl.accounts:Person"
		>
			<columns>
				<column attribute="name">
					<label>
						<en>Login name</en>
						<de>Anmeldename</de>
					</label>
				</column>
				<column attribute="firstName"/>
				<column attribute="lastName"/>
				<computed-column name="email"
					type="tl.core:String"
				>
					<label>
						<en>E-mail</en>
						<de>E-Mail</de>
					</label>
					<value>factoryEmail($row)</value>
				</computed-column>
				<computed-column name="role"
					type="tl.factory:TenantRole"
				>
					<label>
						<en>Role</en>
						<de>Rolle</de>
					</label>
					<inputs>
						<input channel="tenant"/>
					</inputs>
					<value>factoryMemberRole($tenant, $row)</value>
				</computed-column>
			</columns>
			<inputs>
				<input channel="tenant"/>
			</inputs>
			<rows>factoryMembers($tenant)</rows>
		</table>
	</panel>
</view>