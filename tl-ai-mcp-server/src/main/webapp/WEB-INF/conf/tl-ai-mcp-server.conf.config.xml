<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="tl-ai-mcp-server.app-messages" />
				</bundles>
			</instance>
		</config>

		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance>
				<modules>
					<module name="tl-ai-mcp-server" />
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<!--
						The MCP server is opt-in, because /mcp/* authenticates nobody.

						Enabling it publishes the application's model and business data to
						everyone who can reach the endpoint. See doc/security/mcp-endpoint.md
						for what exactly is exposed and how to switch it on. Transport
						authentication is issue #261.
					-->
					<module key="com.top_logic.ai.mcp.server.MCPServerService$Module" value="false"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.mcp.server.MCPServerService">
			<instance class="com.top_logic.ai.mcp.server.MCPServerService"
				server-name="TopLogic MCP Server"
				server-version="1.0.0"
				keep-alive-interval="30"
			/>
		</config>
		<!--
			Who may read a personal access token (Issue #671): its owner, plus administrators. Model
			access is deny-by-default, so without this an account that is no administrator could not
			even list its own tokens.

			Built the way tl-ai-core's binary policy is (tl-ai-core.binarySecurity.config.xml): the
			technical role "McpAccessTokenOwner", held by nobody globally, is derived per token from
			its "owner" by a role rule, and the security configuration grants Read to that role.
			Administrators bypass the check. Revoking goes through mcpAccessTokenRevoke, which checks
			owner or administrator itself, so no Delete grant is written here.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="McpAccessTokenOwner"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="tl.ai.mcp.server.accessToken.owner"
							inherit="true"
							meta-element="tl.ai.mcp.server:AccessToken"
							role="McpAccessTokenOwner"
							type="reference"
						>
							<path>
								<step attribute="tl.ai.mcp.server:AccessToken#owner"/>
							</path>
						</rule>
					</rules>
				</role-rules>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="tl.ai.mcp.server:AccessToken">
						<grant
							inherit="true"
							operation="Read"
							roles="McpAccessTokenOwner"
						/>
					</class>
				</security-config>
			</instance>
		</config>
	</services>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/tl-ai-mcp-serverMeta.xml" />
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
