<?xml version="1.0" encoding="utf-8" ?>

<!--
	Second frame of the project drill-down: the cockpit of the project the frame was opened for.
	
	The cockpit is a dashboard of tiles. The Project tile displays the project and nothing
	else; it spans two rows, so all fields of the project fit without scrolling. The Milestones and
	Notes tiles are entry points: pressing one pushes the frame listing that collection, announced
	by a label of its own. The engine marks such a tile only by how it answers the user, so each of
	the two cards draws the chevron itself, in the header slot at the right of its title.
	
	The Notes tile is refused while the project has no notes and gives that as its reason; creating
	the first note through the card's own button lifts the refusal, because the action observes the
	project. The create buttons inside the cards answer a press themselves, so they open their
	dialog instead of pushing the list behind the tile.
	
	The Deliverables tile pushes the list of the deliverables of the project, where a deliverable of
	a kind the user chooses is created (see projects/deliverables.view.xml).
	
	The Planning tile lists the due dates and approvals of the milestones. It is guarded by the
	operation "ShowPlanning" on the project, which only the administrators of the project hold, so
	a member of the project who administers another project sees the "no access" placeholder in its
	place (denied="placeholder"). The Approvals tile is guarded the same way, but with the default
	denied="hide": such a member does not see it at all, and the grid closes the gap. A member who
	administers no project at all can hold "ShowPlanning" on no project, so neither tile is offered
	to him.
	
	The milestones of the project are tiles of their own, between the fixed tiles: each as wide as
	the tile size of the milestone says, opening the milestone when it is pressed. The arrangement of
	the tiles is stored at the project and applies to all its users; only an administrator of the
	project (operation "ArrangeCockpit") is offered to edit it.
	
	The milestone channel carries what the create dialog reports back: the milestone it created,
	which the milestone list picks up when the Milestones tile is pressed.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="milestone"/>
		<derived-channel name="milestoneCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).size())"
			inputs="project"
		/>
		<derived-channel name="noteCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#notes`).size())"
			inputs="project"
		/>
		<derived-channel name="deliverableCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`).size())"
			inputs="project"
		/>
	</channels>

	<panel>
		<title>
			<en>Cockpit</en>
			<de>Cockpit</de>
		</title>
		<dashboard id="project-cockpit"
			arrangement="if($project == null || $project.get(`tl.demo.projectManagement:ProjectScope#cockpitOrder`) == null, null, {'order': $project.get(`tl.demo.projectManagement:ProjectScope#cockpitOrder`).split(','), 'hidden': if($project.get(`tl.demo.projectManagement:ProjectScope#cockpitHidden`) == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#cockpitHidden`).split(','))})"
			inputs="project"
			store-arrangement="{$project.set(`tl.demo.projectManagement:ProjectScope#cockpitOrder`, $order.join(',')); $project.set(`tl.demo.projectManagement:ProjectScope#cockpitHidden`, $hidden.join(','));}"
		>
			<arrangement-access>
				<operation name="ArrangeCockpit"
					object="$project"
					type="tl.demo.projectManagement:ProjectScope"
				/>
			</arrangement-access>
			<tile id="project"
				row-span="2"
				width="half"
			>
				<panel>
					<title>
						<en>Project</en>
						<de>Projekt</de>
					</title>
					<form
						input="project"
						with-inset="true"
					>
						<field attribute="name"/>
						<field attribute="description"/>
						<field attribute="budget"/>
						<field attribute="members"/>
						<field attribute="admins"/>
						<field attribute="reportTemplate"/>
					</form>
				</panel>
			</tile>
			<tile id="milestones"
				width="quarter"
			>
				<card>
					<title>
						<en>Milestones</en>
						<de>Meilensteine</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="milestoneCount"/>
					<button>
						<action class="com.top_logic.layout.view.command.GenericViewCommand"
							image="css:bi bi-plus-lg"
							inputs="project"
						>
							<label>
								<en>New Milestone</en>
								<de>Neuer Meilenstein</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="project"
								reference="milestones"
								type="tl.demo.projectManagement:Milestone"
							>
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-milestone.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
										<bind
											channel="selection"
											to="milestone"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</action>
					</button>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					frame="milestones"
					inputs="project"
					observed-types="tl.demo.projectManagement:ProjectScope"
				>
					<executability>
						<null-input-disabled/>
					</executability>
				</action>
			</tile>
			<tile id="notes"
				width="quarter"
			>
				<card>
					<title>
						<en>Notes</en>
						<de>Notizen</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="noteCount"/>
					<button>
						<action class="com.top_logic.layout.view.command.GenericViewCommand"
							image="css:bi bi-plus-lg"
							inputs="project"
						>
							<label>
								<en>New Note</en>
								<de>Neue Notiz</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="project"
								reference="notes"
								type="tl.demo.projectManagement:Note"
							>
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-note.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</action>
					</button>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					frame="notes"
					inputs="project"
					observed-types="tl.demo.projectManagement:ProjectScope"
				>
					<executability>
						<disabled-if expr="if($project == null || $project.get(`tl.demo.projectManagement:ProjectScope#notes`).isEmpty(), #('The project has no notes.'@en, 'Das Projekt hat keine Notizen.'@de))"/>
					</executability>
				</action>
			</tile>
			<tile id="deliverables"
				width="quarter"
			>
				<card>
					<title>
						<en>Deliverables</en>
						<de>Liefergegenstände</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="deliverableCount"/>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					frame="deliverables"
					inputs="project"
				>
					<executability>
						<null-input-disabled/>
					</executability>
				</action>
			</tile>
			<!--
				One tile per milestone of the project, between the fixed tiles. The width of a tile is
				the tile size of its milestone, a click on it opens the milestone. A milestone created
				with the "New Milestone" button of the Milestones tile appears as a tile right away, one
				deleted with the button of its tile disappears.
			-->
			<tiles id="milestone"
				inputs="project"
				items="if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#milestones`))"
				label="$element.get(`tl.demo.projectManagement:Milestone#name`)"
				observed-types="tl.demo.projectManagement:Milestone, tl.demo.projectManagement:ProjectScope"
				width="if($element.get(`tl.demo.projectManagement:Milestone#tileSize`) == null, 'quarter', $element.get(`tl.demo.projectManagement:Milestone#tileSize`))"
			>
				<view-ref view="projects/milestone-tile.view.xml">
					<bind
						channel="element"
						to="element"
					/>
				</view-ref>
				<action class="com.top_logic.layout.view.command.GenericViewCommand">
					<show-object/>
				</action>
			</tiles>
			<!--
				The progress of the approvals is part of the planning as well. The tile demonstrates
				the default denied="hide": a member of the project does not see the tile at all, and the
				Planning tile takes its place next to the Project tile.
			-->
			<tile id="approvals"
				width="half"
			>
				<access-control
					inputs="project"
					object="$project"
					operation="ShowPlanning"
					type="tl.demo.projectManagement:ProjectScope"
				/>
				<panel>
					<title>
						<en>Approvals</en>
						<de>Freigaben</de>
					</title>
					<progress
						done="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).filter(m -> $m.get(`tl.demo.projectManagement:Milestone#approved`)).size())"
						input="project"
						label="#('Approved milestones'@en, 'Freigegebene Meilensteine'@de)"
						observed-types="tl.demo.projectManagement:Milestone"
						total="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).size())"
					/>
				</panel>
			</tile>
			<!--
				The planning of the project is shown to the administrators of the project alone, who
				hold the operation "ShowPlanning" on it. The tile demonstrates the placeholder: a
				member of the project who administers another project sees a "no access" placeholder in
				place of the tile's content.
			-->
			<tile id="planning"
				width="half"
			>
				<access-control
					denied="placeholder"
					inputs="project"
					object="$project"
					operation="ShowPlanning"
					type="tl.demo.projectManagement:ProjectScope"
				/>
				<panel>
					<title>
						<en>Planning</en>
						<de>Planung</de>
					</title>
					<table
						observed-types="tl.demo.projectManagement:Milestone"
						types="tl.demo.projectManagement:Milestone"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="dueDate"/>
							<column attribute="approved"/>
						</columns>
						<inputs>
							<input channel="project"/>
						</inputs>
						<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#milestones`))</rows>
					</table>
				</panel>
			</tile>
		</dashboard>
	</panel>
</view>