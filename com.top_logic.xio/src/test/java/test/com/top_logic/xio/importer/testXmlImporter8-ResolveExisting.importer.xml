<handler>
	<tag name="data">
		<dispatch>
			<tag name="items">
				<dispatch>
					<tag name="item">
						<resolve-existing
							key="x -> $x.get(`test.com.top_logic.xio.importer.test8:Item#extId`)"
							objects="c -> {
								$c.set(`test.com.top_logic.xio.importer.test8:Container#evaluations`, $c.get(`test.com.top_logic.xio.importer.test8:Container#evaluations`) + 1);
								$c.get(`test.com.top_logic.xio.importer.test8:Container#elements`);
							}"
						>
							<object model-type="test.com.top_logic.xio.importer.test8:Item" id-attribute="id" join-duplicates="true">
								<property name="extId" xml-attribute="id"/>
								<property name="name" xml-attribute="name"/>
								<reference name="other" id-attribute="other"/>
								<linking>
									<list-linking name="test.com.top_logic.xio.importer.test8:Container#elements"/>
								</linking>
								<dispatch/>
							</object>
						</resolve-existing>
					</tag>
				</dispatch>
			</tag>
			<tag name="plain">
				<dispatch>
					<tag name="item">
						<object model-type="test.com.top_logic.xio.importer.test8:Item" id-attribute="id" join-duplicates="true">
							<property name="extId" xml-attribute="id"/>
							<property name="name" xml-attribute="name"/>
							<linking>
								<list-linking name="test.com.top_logic.xio.importer.test8:Container#elements"/>
							</linking>
							<dispatch/>
						</object>
					</tag>
				</dispatch>
			</tag>
		</dispatch>
	</tag>
</handler>
