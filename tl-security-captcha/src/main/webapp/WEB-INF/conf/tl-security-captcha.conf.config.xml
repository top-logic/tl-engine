<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="com.top_logic.security.captcha.CaptchaService$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>

		<!--
			The classic captcha field: the ALTCHA web component (copied from the npm package altcha by
			the build) and the script connecting it with the field on the server.
		-->
		<config service-class="com.top_logic.gui.JSFileCompiler">
			<instance>
				<files>
					<file resource="tl-security-captcha.js"/>
				</files>
				<additional-files>
					<file resource="/script/altcha.js"
						type="module"
					/>
				</additional-files>
			</instance>
		</config>

		<!--
			The key signing the challenges is a secret of the installation. Without it, the service
			signs with a random key of its own, valid only on this node and until its restart.
			Configure it by name, e.g.

				<hmac-key name="tl_captcha_hmac_key"/>

			and provide the variable tl_captcha_hmac_key (or the secret of that name in the secret
			store of the installation).
		-->
		<config service-class="com.top_logic.security.captcha.CaptchaService">
			<instance class="com.top_logic.security.captcha.CaptchaService"
				expires="10min"
			/>
		</config>
	</services>
</application>
