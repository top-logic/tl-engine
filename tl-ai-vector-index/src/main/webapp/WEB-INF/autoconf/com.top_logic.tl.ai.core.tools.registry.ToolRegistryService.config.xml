<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tl.ai.core.tools.registry.ToolRegistryService">
			<instance class="com.top_logic.tl.ai.core.tools.registry.ToolRegistryService">
				<tool-factories>
					<factory name="vector-index-search">
						<implementation class="com.top_logic.tl.ai.core.tools.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.vector.index.VectorIndexSearchTool"
						/>
					</factory>
				</tool-factories>
			</instance>
		</config>
	</services>
</application>
