<?xml version="1.0" encoding="utf-8" ?>
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<!--
		Seed overlay so that the autoconf path is registered at boot.
		ScriptToolConfigPersistence overwrites this file at runtime when
		creating, updating, or deleting TL-Script tools.
	-->
	<services>
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService"/>
		</config>
	</services>
</application>
