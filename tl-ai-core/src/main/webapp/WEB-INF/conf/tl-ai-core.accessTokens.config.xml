<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<!-- The permission an access token needs for the agent endpoints, MCP and A2A. -->
		<config service-class="com.top_logic.element.accesstoken.AccessTokenPermissions">
			<instance>
				<permissions>
					<permission name="agent-endpoints"
						label="class.com.top_logic.ai.core.access.I18NConstants.PERMISSION_AGENT_ENDPOINTS"
					/>
				</permissions>
			</instance>
		</config>
	</services>
</application>
