<?xml version="1.0" encoding="utf-8" ?>

<!--
	The git connections of the tenant of the user (factory/git-connections.view.xml); a user of no
	tenant is told so.
-->
<view>
	<channels>
		<channel name="tenant">
			<init>factoryCurrentTenant()</init>
		</channel>
	</channels>
	<switch input="tenant">
		<case test="$tenant != null">
			<view-ref view="factory/git-connections.view.xml">
				<bind
					channel="tenant"
					to="tenant"
				/>
			</view-ref>
		</case>
		<default>
			<inset>
				<alert severity="info">
					<title>
						<en>No tenant</en>
						<de>Kein Mandant</de>
					</title>
					<message>
						<en>You are a member of no tenant. The git connections of all tenants are managed under "Tenants".</en>
						<de>Sie sind Mitglied keines Mandanten. Die Git-Verbindungen aller Mandanten werden unter "Mandanten" verwaltet.</de>
					</message>
				</alert>
			</inset>
		</default>
	</switch>
</view>