<web-fragment xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
    http://java.sun.com/xml/ns/javaee/web-fragment_3_0.xsd"
    version="3.0" metadata-complete="true">
  <name>tl-factory</name>

  <!--
    The workspace proxy of the workspace containers in the web application, mapped to the paths of
    its routes (the LLM route: LLMRoute.DEFAULT_PATH). It answers only if servlet-enabled of the
    WorkspaceProxyService is set; by default the proxy listens on a port of its own instead. The
    servlet authenticates the requests itself by the token of a workspace.
  -->
  <servlet>
    <servlet-name>WorkspaceProxyServlet</servlet-name>
    <servlet-class>com.top_logic.factory.proxy.WorkspaceProxyServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>WorkspaceProxyServlet</servlet-name>
    <url-pattern>/llm-proxy/*</url-pattern>
  </servlet-mapping>
</web-fragment>
