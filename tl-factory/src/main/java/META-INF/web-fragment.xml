<web-fragment xmlns="http://java.sun.com/xml/ns/javaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://java.sun.com/xml/ns/javaee
    http://java.sun.com/xml/ns/javaee/web-fragment_3_0.xsd"
    version="3.0" metadata-complete="true">
  <name>tl-factory</name>

  <!--
    The LLM proxy of the workspace containers (LLMProxyServlet.PATH). The servlet authenticates the
    requests itself by the token of a workspace.
  -->
  <servlet>
    <servlet-name>LLMProxyServlet</servlet-name>
    <servlet-class>com.top_logic.factory.llm.LLMProxyServlet</servlet-class>
  </servlet>

  <servlet-mapping>
    <servlet-name>LLMProxyServlet</servlet-name>
    <url-pattern>/llm-proxy/*</url-pattern>
  </servlet-mapping>
</web-fragment>
