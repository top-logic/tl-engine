<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestViewModelAccess">
			<types>
				<class name="Project">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="secret"
							type="tl.core:String"
						/>
						<reference name="responsible"
							type="tl.accounts:Person"
						/>
						<reference name="category"
							type="Category"
						/>
						<reference name="tasks"
							composite="true"
							multiple="true"
							ordered="true"
							type="Task"
						/>
					</attributes>
				</class>

				<class name="Task">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="number"
							type="tl.core:Long"
						>
							<annotations>
								<default-value>
									<provider class="com.top_logic.element.structured.util.SequenceDefaultProvider"
										sequence-name="TestViewModelAccess_Task_number"
									/>
								</default-value>
							</annotations>
						</property>
						<reference name="createdIn"
							type="Project"
						>
							<annotations>
								<default-value>
									<default-by-expression value="context -> $context"/>
								</default-value>
							</annotations>
						</reference>
					</attributes>
				</class>

				<class name="Category">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<reference name="reader"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>
			</types>
		</module>
	</modules>
</model>