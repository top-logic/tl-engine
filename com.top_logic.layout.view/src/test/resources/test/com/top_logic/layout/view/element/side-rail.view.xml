<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="count"/>
		<channel name="present"/>
		<channel name="railOpen"/>
		<channel name="railBadge"/>
	</channels>

	<side-rail badge-channel="railBadge"
		css-class="my-rail"
		open="false"
		open-channel="railOpen"
		side="right"
		width="320"
	>
		<section name="tasks"
			badge="count"
			icon="css:fa-solid fa-list-check"
		>
			<label>
				<en>Tasks</en>
			</label>
			<panel/>
		</section>
		<section name="sources"
			open="false"
		>
			<panel/>
		</section>
		<section name="document"
			width="560"
		>
			<visibility
				expr="$present"
				inputs="present"
			/>
			<panel/>
		</section>
	</side-rail>
</view>
