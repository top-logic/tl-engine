<?xml version="1.0" encoding="utf-8" ?>

<!--
	Secrets written by the application (com.top_logic.knowledge.secret.DatabaseSecretStore), each
	encrypted with the key of the store. The table is not versioned, so that a replaced or removed
	secret leaves no cipher text behind. Its rows are no model objects (no type, no wrapper) and
	cannot be reached through the model, TL-Script or the generic UI.
-->
<objectlist
	xmlns="http://www.top-logic.com/ns/meta/5.8"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<metaobjects>
		<metaobject
			object_name="StoredSecret"
			super_class="KnowledgeObject"
			versioned="false"
		>
			<annotations>
				<annotation config:interface="com.top_logic.knowledge.service.xml.annotation.KnowledgeItemFactoryAnnotation">
					<implementation-factory class="com.top_logic.knowledge.service.db2.StaticKnowledgeObjectFactory"/>
				</annotation>
			</annotations>
			<attributes>
				<mo_attribute
					att_name="name"
					att_type="String"
					binary="true"
					db_size="254"
					mandatory="true"
				/>
				<mo_attribute
					att_name="cipherText"
					att_type="String"
					db_size="1000000"
					db_type="clob"
					mandatory="true"
				/>
			</attributes>
			<index>
				<mo_index name="secretName"
					unique="true"
				>
					<index-parts>
						<index_part name="name"/>
					</index-parts>
				</mo_index>
			</index>
		</metaobject>
	</metaobjects>
</objectlist>
