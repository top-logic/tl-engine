					/>
				</bpmndi:BPMNLabel>
			</bpmndi:BPMNShape>
			<bpmndi:BPMNShape id="Task_Rejected_di"
				bpmnElement="Task_Rejected"
			>
				<dc:Bounds
					height="80"
					width="100"
					x="560"
					y="95"
				/>
			</bpmndi:BPMNShape>
			<bpmndi:BPMNShape id="EndEvent_Rejected_di"
				bpmnElement="EndEvent_Rejected"
			>
				<dc:Bounds
					height="36"
					width="36"
					x="720"
