<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient OtpEntry model (the entered code) bound to the form. -->
		<channel name="model"/>
		<!-- The invitation being accepted (set by RequestInvitationCodeAction). -->
		<channel name="invitation"/>
		<!-- The verification code that was mailed (set by RequestInvitationCodeAction). -->
		<channel name="verification"/>
	</channels>
	<window
		resizable="false"
		width="400px"
	>
		<title>
			<en>Confirm invitation</en>
			<de>Einladung bestätigen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<text>
				<label>
					<en>Enter the verification code from the e-mail.</en>
					<de>Geben Sie den Bestätigungscode aus der E-Mail ein.</de>
				</label>
			</text>
			<field attribute="code"/>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Continue</en>
						<de>Weiter</de>
					</label>
					<store-form-state>
						<with-result>
							<check-invitation-code/>
						</with-result>
					</store-form-state>
				</generic-command>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Send new code</en>
						<de>Neuen Code senden</de>
					</label>
					<request-invitation-code/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>