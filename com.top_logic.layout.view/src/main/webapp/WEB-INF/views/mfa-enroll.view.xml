<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient OtpEntry model bound to the form. -->
		<channel name="model"/>
		<!-- The account enabling MFA (set by LoginAction). -->
		<channel name="account"/>
		<!-- The freshly generated TOTP secret, persisted only once a valid code confirms it. -->
		<channel name="secret"/>
		<!-- The QR-code PNG encoding the otpauth:// provisioning URI (set by LoginAction). -->
		<channel name="qr"/>
		<!-- The secret in plain text, for entering it by hand (set by LoginAction). -->
		<channel name="secret-text"/>
	</channels>
	<window
		resizable="false"
		width="420px"
	>
		<title>
			<en>Set up two-factor authentication</en>
			<de>Zwei-Faktor-Authentifizierung einrichten</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<text>
				<label>
					<en>Scan this QR code with your authenticator app or enter the key below in it by hand, then enter the generated code to confirm.</en>
					<de>Scannen Sie diesen QR-Code mit Ihrer Authenticator-App oder geben Sie dort den Schlüssel darunter von Hand ein. Geben Sie zur Bestätigung anschließend den erzeugten Code ein.</de>
				</label>
			</text>
			<image input="qr">
				<alt>
					<en>QR code enrolling this account in your authenticator app</en>
					<de>QR-Code, der dieses Konto in Ihrer Authenticator-App einrichtet</de>
				</alt>
			</image>
			<value-input
				readonly="true"
				type="tl.core:String"
				value="secret-text"
			>
				<label>
					<en>Key for manual entry</en>
					<de>Schlüssel zur manuellen Eingabe</de>
				</label>
				<annotations>
					<multi-line
						preformatted="true"
						rows="1"
					/>
				</annotations>
			</value-input>
			<field attribute="code"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Confirm</en>
						<de>Bestätigen</de>
					</label>
					<store-form-state>
						<with-result>
							<verify-otp persist="true"/>
						</with-result>
					</store-form-state>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>