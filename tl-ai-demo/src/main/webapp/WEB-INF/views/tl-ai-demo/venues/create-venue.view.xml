<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a venue, opened from venues.view.xml. The rooms can be entered right away;
	"Create" copies the transient venue, rooms included, into the persistent world and gives it an
	empty address, which venue-detail.view.xml then shows as a form of its own.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
	</channels>

	<window width="640px">
		<title>
			<en>New venue</en>
			<de>Neuer Veranstaltungsort</de>
		</title>
		<form initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="capacity"/>
			<field attribute="website"/>
			<field attribute="email"/>
			<field attribute="phone"/>
			<field attribute="description"/>
			<composition-table attribute="rooms">
				<columns>
					<column attribute="name"/>
					<column attribute="capacity"/>
					<column attribute="hasProjector"/>
				</columns>
			</composition-table>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					inputs="model as draft"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<with-transaction>
						<execute-script>
							<function><![CDATA[{
								venue = $draft.copy(transient: false);
								$venue.set(`demo.events:Venue#address`, new(`demo.events:Address`));
								$venue;
							}]]></function>
						</execute-script>
						<with-result>
							<write-channel name="selection"/>
						</with-result>
					</with-transaction>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
