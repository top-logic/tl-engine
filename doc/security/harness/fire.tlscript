// ===========================================================================
// Agent security test bed - AGENT RUNS, STEP 1 of 2: FIRE
//
// Starts one background agent run per scenario of the model-rights walkthrough
// (doc/security/e2e-security-test.md, section 3) and hands the run handles to
// collect.tlscript through the user session.
//
// This needs an LLM API key, because a real agent has to decide to call the
// TL-Script tool. To see the TOOL layer without any model call, run
// probe.tlscript instead - it needs no key and finishes in a second.
//
// Where to run it: Administration > Development > Script console, logged in as
// the persona whose scenarios you want to execute. The runs act as that
// account - see section 4 of the test procedure.
//
// After this script returns, WAIT until the runs have finished, then execute
// collect.tlscript in the SAME browser session. Fire and collect must be two
// separate script executions: a request pins its knowledge-base revision, so a
// run started here stays invisible for the rest of this request.
//
// THESE RUNS CANNOT WRITE. aiAgentChatAsync detaches, so the runs are
// unattended: they auto-approve every tool call, which is why the
// <background-allowlist> caps them - and committing through TL-Script costs
// "data.write", which the demo policy deliberately keeps off that list. Every
// case below that asks for a commit is therefore refused here whatever the
// persona holds, root included (testbed.md, scenario A5). To watch a commit
// succeed, use a foreground surface: the chat, or
//
//   aiCallTool("script-exec.executeTLScript",
//       {"script": "new(`pm:Ticket`)", "withCommit": true})
//
// in this console as anna (testbed.md, scenario T9).
// ===========================================================================
{
	// -- configuration ----------------------------------------------------

	// The agent that executes the cases. The default is the demo's chat entry
	// point, so a case run here goes through the same agent as the manual
	// walkthrough of section 3.
	//
	// To see which names exist, run (as "root", because both readings are
	// subject to model access rights):
	//
	//   aiCallTool("framework-wiring.listFrameworkAgents", null)
	//       agents defined in the application configuration - this is where
	//       TL_SingleAgent comes from,
	//
	//   all(`tl.ai.core:Agent`).get(`tl.ai.core:Agent#name`)
	//       agents stored in the knowledge base - the shipped demo has none.
	agentName = "TL_SingleAgent";

	// Whose cases to run. "auto" derives it from the logged-in account and
	// picks the rows below that name it; "root" fires all of them (the
	// administrator baseline). Set an explicit account name to fire someone
	// else's cases - note that they then run with YOUR rights and the
	// expectations below no longer apply.
	account = "auto";

	// Session key under which collect.tlscript picks the runs up again.
	handleKey = "secdemo-e2e-handles";

	// -- the cases --------------------------------------------------------
	// [ case id, account, prompt, expected outcome ]
	//
	// 3.x are the MODEL-rights cases of doc/security/e2e-security-test.md
	// section 3. Their prompts deliberately steer the agent to the TL-Script
	// tool, because only that tool runs with the engine's security checks. Do
	// not reword them.
	//
	// T-x are tool-layer cases of this script's own - the ids are local here
	// and are NOT the T-rows of doc/security/testbed.md, which are console
	// scenarios with no model in them. The agent is asked for something the
	// persona lacks the capability for, and what is judged is whether it NAMES
	// the missing capability rather than failing opaquely. Read their results
	// as prose, not as a status code - the deterministic version of the same
	// assertions is the SecDemo* JUnit suite, and probe.tlscript shows the raw
	// decisions with no model involved.
	cases = [
		[
			"3.1", "anna",
			'Use the TL-Script tool to evaluate: all(`pm:Project`).get(`pm:Project#name`)',
			"ALLOWED, and EXACTLY ONE name: Alpha. Anna partners on Alpha and not on Beta, so the"
				+ " read filter of issue #289 removes the other project - the sharpest single"
				+ " observation this fixture offers, because both projects are instances of the same"
				+ " type and Anna holds the same capability for both."
		],
		[
			"3.2", "anna",
			'Use the TL-Script tool with commit to evaluate: new(`pm:Ticket`).set(`pm:Ticket#title`, "Anna was here")',
			"DENIED HERE, ALLOWED IN THE CHAT (testbed.md, A1) - Anna does hold 'data.write', but this"
				+ " run is unattended and that capability is off the <background-allowlist>, so the"
				+ " commit is refused naming the allowlist rather than the role. No object is created."
		],
		[
			"3.3", "ben",
			'Use the TL-Script tool to evaluate: all(`pm:Project`).get(`pm:Project#name`)',
			"ALLOWED and EMPTY - pm:Project grants Read to projectPartner only, and Ben is a ticket"
				+ " reader. Note the shape of the refusal: an empty list, not an error. That is the"
				+ " engine's read semantics, and it is why an agent can report 'there are no"
				+ " projects'."
		],
		[
			"3.4", "ben",
			'Use the TL-Script tool to evaluate: all(`pm:Ticket`).get(`pm:Ticket#title`)',
			"ALLOWED - all three ticket titles. A ticket reader reads every ticket, from the"
				+ " <rule meta-element=\"pm:Ticket\" role=\"ticketReader\"> that puts the role on"
				+ " every instance of the type."
		],
		[
			"3.5", "ben",
			'Use the TL-Script tool to evaluate: all(`pm:Ticket`).get(`pm:Ticket#body`)',
			"ALLOWED and EMPTY - per-attribute Read. pm:Ticket#body carries a <part> grant naming"
				+ " projectPartner only, so the ticket is readable and this one attribute of it is"
				+ " not. Compare 3.6."
		],
		[
			"3.6", "anna",
			'Use the TL-Script tool to evaluate: all(`pm:Ticket`).get(`pm:Ticket#body`)',
			"ALLOWED, and the bodies of ALPHA'S TICKETS ONLY - Anna holds projectPartner on Alpha,"
				+ " which reaches Alpha's tickets through the <security-parents> rule and reaches"
				+ " Beta's not at all. The pair with 3.5 is what makes the omission attributable to"
				+ " the grant."
		],
		[
			"3.7", "dora",
			'Use the TL-Script tool to evaluate: all(`pm:Project`).get(`pm:Project#name`)',
			"ALLOWED and EMPTY - and this is the case to understand. Dora holds projectPartner on the"
				+ " security root, so every read and write tool is hers, and she partners on nothing,"
				+ " so there is no object any of them may touch. Nothing in this answer tells her that"
				+ " projects exist. This is the failure mode the boot warning of #289 exists for."
		],
		[
			"T1", "ben",
			'Use the secdemo-editing.addTicket tool to add a ticket titled "Reader was here" to project Alpha.',
			"DENIED at the TOOL layer - Ben holds no 'data.write', so the agent never reaches the"
				+ " model rights. It must say which capability is missing. Note that no framework"
				+ " agent carries this tool either, so the answer may instead be that the tool is not"
				+ " carried by this agent - which is testbed.md scenario C7 working, and equally true."
		],
		[
			"T2", "anna",
			'List the instances of pm:Project.',
			"ALLOWED at the TOOL layer, and the listing has ONE entry with totalCount 1. The count"
				+ " follows the filter: a total taken over the unfiltered list would tell Anna that a"
				+ " project she may not see exists."
		],
		[
			"T3", "dora",
			'List the instances of pm:Project, then tell me how many there are.',
			"ALLOWED at the TOOL layer, totalCount 0. Dora is told there are none. Compare what"
				+ " secdemo-reporting.countTickets answers for her (probe.tlscript): an unfiltered"
				+ " count, which is the accepted boundary of the read filtering (issue #291)."
		],
		[
			"T4", "cara",
			'What can you do for me? Name any capability you are missing.',
			"ALLOWED - Cara holds both roles, so she has the union of their grants. The prompt must"
				+ " name the capabilities no role of this fixture holds: workspace, agent.meta,"
				+ " agent.authoring, model.structure, egress."
		]
	];

	// -- fire -------------------------------------------------------------

	me = $account == "auto" ? currentUser().get(`tl.accounts:Person#name`) : $account;
	selected = $cases.filter(c -> $me == "root" or $c[1] == $me);

	// Each row keeps its case metadata next to the handle, so collect.tlscript
	// needs no second copy of the table above.
	fired = $selected.map(c -> [$c[0], $c[1], $c[2], $c[3], aiAgentChatAsync($agentName, $c[2])]);
	$fired.storeInSession(key: $handleKey);

	[
		"Started " + $fired.size() + " agent run(s) as '" + $me + "' on agent '" + $agentName + "'.",
		$me == "root"
			? "WARNING: running as an administrator. Administrators bypass ModelAccessRights, so"
				+ " every case is expected to be ALLOWED and the deny cases prove nothing. This is"
				+ " only meaningful as the administrator baseline of case 3.7."
			: "Running as a role-based account: the per-case expectations apply as written.",
		"",
		"Handles (also stored in this session under '" + $handleKey + "'):"
	].concat($fired.map(f -> "   " + $f[0] + "  ->  " + $f[4]))
	 .concat([
		"",
		"Now wait until the runs have finished, then execute collect.tlscript",
		"in this same browser session."
	]);
}
