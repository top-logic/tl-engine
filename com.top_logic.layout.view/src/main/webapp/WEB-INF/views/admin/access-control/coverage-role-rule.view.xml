<?xml version="1.0" encoding="utf-8" ?>

<!--
	Edits one role rule of the model based access definition. The rule channel carries the
	configuration the opening command produced - an empty rule for the selected type or a copy of a
	rule already in effect - and the configuration form writes the entries straight into it. Save
	hands that configuration to the editor, which stores it in the application configuration, and
	marks the pending channel: the stored definition differs from the running one until the coverage
	display applies it.
-->
<view>
	<channels>
		<channel name="rule"/>
		<channel name="pending"/>
	</channels>
	<window width="800px">
		<title>
			<en>Role rule</en>
			<de>Rollenregel</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-check-lg"
				input="rule"
				placement="BUTTON_BAR"
			>
				<label>
					<en>Save</en>
					<de>Speichern</de>
				</label>
				<action class="com.top_logic.layout.view.admin.SecurityDefinitionAction"
					mode="SAVE_ROLE_RULE"
				/>
				<write-channel name="pending"/>
				<close-dialog/>
			</generic-command>
		</commands>
		<config-form
			input="rule"
			withEditMode="false"
		/>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>