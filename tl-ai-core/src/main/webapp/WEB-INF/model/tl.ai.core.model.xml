<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.ai.core">
		<annotations>
			<package-binding
				implementation-package="com.top_logic.tl.ai.core.model.impl"
				interface-package="com.top_logic.tl.ai.core.model"
			/>
		</annotations>
		<types>

			<class name="Agent">
				<annotations>
					<table name="AIAgent"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="description"
						type="tl.core:String"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<property name="model"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<all-model-names/>
							</options>
						</annotations>
					</property>
					<property name="systemPrompt"
						type="tl.core:Text"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<property name="maxTokens"
						type="tl.core:Integer"
					/>
					<property name="temperature"
						type="tl.core:Double"
					/>
					<property name="topP"
						type="tl.core:Double"
					/>
					<property name="timeoutSeconds"
						type="tl.core:Integer"
					/>
					<property name="maxRetries"
						type="tl.core:Integer"
					/>
					<property name="tools"
						type="tl.core:String"
						multiple="true"
					>
						<annotations>
							<options>
								<all-tool-names/>
							</options>
						</annotations>
					</property>
					<reference name="skills"
						kind="forwards"
						multiple="true"
						type="Skill"
					/>
				</attributes>
			</class>

			<class name="Skill">
				<annotations>
					<table name="AISkill"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="description"
						type="tl.core:String"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<property name="content"
						type="tl.core:Text"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<reference name="agents"
						inverse-reference="skills"
						kind="backwards"
						multiple="true"
						type="Agent"
					/>
				</attributes>
			</class>

		</types>
	</module>
</model>
