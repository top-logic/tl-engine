<?xml version="1.0" encoding="utf-8" ?>

<view>
	<app-shell>
		<!--
			System-wide notices, shown between app bar and content. Each element decides for itself
			whether it has anything to announce; the area occupies no space while all of them stay
			silent, so nothing is reserved during normal operation.
		-->
		<notices>
			<maintenance-notice/>
			<session-timeout-notice/>
		</notices>
		<content>
			<sidebar
				active-item="attributes"
				drawer-open-slot-name="appbar-leading"
			>
				<items>
					<nav-item id="attributes"
						icon="css:bi bi-card-list"
					>
						<view-ref view="attributes.view.xml"/>
						<label>
							<en>Attributes</en>
							<de>Attribute</de>
						</label>
					</nav-item>
					<nav-item id="tickets"
						icon="css:bi bi-chat-left-text"
					>
						<view-ref view="tickets.view.xml"/>
						<label>
							<en>Object list</en>
							<de>Objektliste</de>
						</label>
					</nav-item>
					<nav-item id="projects"
						icon="css:bi bi-kanban"
					>
						<view-ref view="projects.view.xml"/>
						<label>
							<en>Projects</en>
							<de>Projekte</de>
						</label>
					</nav-item>
					<nav-item id="table-columns"
						icon="css:bi bi-layout-three-columns"
					>
						<view-ref view="demo/table-columns.view.xml"/>
						<label>
							<en>Table columns</en>
							<de>Tabellenspalten</de>
						</label>
					</nav-item>
					<nav-item id="tree-demo"
						icon="css:bi bi-diagram-2"
					>
						<view-ref view="demo/tree-demo.view.xml"/>
						<label>
							<en>Tree Demo</en>
							<de>Baum-Demo</de>
						</label>
					</nav-item>
					<nav-item id="charts"
						icon="css:bi bi-bar-chart-line"
					>
						<view-ref view="demo/chart-demo.view.xml"/>
						<label>
							<en>Chart Demo</en>
							<de>Diagramm-Demo</de>
						</label>
					</nav-item>
					<nav-item id="flow-diagram"
						icon="css:bi bi-diagram-3"
					>
						<view-ref view="demo/flow-diagram-demo.view.xml"/>
						<label>
							<en>Flow Diagram</en>
							<de>Flow-Diagramm</de>
						</label>
					</nav-item>
					<nav-item id="gantt-demo"
						icon="css:bi bi-bar-chart-steps"
					>
						<view-ref view="demo/gantt-demo.view.xml"/>
						<label>
							<en>Gantt Demo</en>
							<de>Gantt-Demo</de>
						</label>
					</nav-item>
					<nav-item id="pdf"
						icon="css:bi bi-file-earmark-pdf"
					>
						<view-ref view="demo/pdf-demo.view.xml"/>
						<label>
							<en>Document Viewer</en>
							<de>Dokumentanzeige</de>
						</label>
					</nav-item>
					<nav-item id="html"
						icon="css:bi bi-filetype-html"
					>
						<view-ref view="demo/html-demo.view.xml"/>
						<label>
							<en>HTML content</en>
							<de>HTML-Inhalte</de>
						</label>
					</nav-item>
					<nav-item id="config-editor"
						icon="css:bi bi-sliders"
					>
						<view-ref view="demo/config-editor-demo.view.xml"/>
						<label>
							<en>Config Editor</en>
							<de>Konfigurationseditor</de>
						</label>
					</nav-item>
					<nav-item id="tlscript"
						icon="css:bi bi-code-square"
					>
						<view-ref view="demo/tlscript-editor-demo.view.xml"/>
						<label>
							<en>TL-Script Editor</en>
							<de>TL-Script-Editor</de>
						</label>
					</nav-item>
					<nav-item id="constraints"
						icon="css:bi bi-check-circle"
					>
						<view-ref view="demo/constraint-test.view.xml"/>
						<label>
							<en>Constraint Test</en>
							<de>Constraint-Test</de>
						</label>
					</nav-item>
					<nav-item id="tiles-demo"
						icon="css:bi bi-layers"
					>
						<view-ref view="demo/tiles-demo.view.xml"/>
						<label>
							<en>Tiles Demo</en>
							<de>Tiles-Demo</de>
						</label>
					</nav-item>
					<nav-item id="tiles-multi-demo"
						icon="css:bi bi-columns-gap"
					>
						<view-ref view="demo/tiles-multi-demo.view.xml"/>
						<label>
							<en>Tiles Multi-Tab Demo</en>
							<de>Tiles Mehr-Tab-Demo</de>
						</label>
					</nav-item>
					<nav-item id="responsive-md-demo"
						icon="css:bi bi-layout-sidebar-inset"
					>
						<view-ref view="demo/responsive-md-demo.view.xml"/>
						<label>
							<en>Responsive Master-Detail Demo</en>
							<de>Responsive Master-Detail-Demo</de>
						</label>
					</nav-item>
					<nav-item id="errors"
						icon="css:bi bi-exclamation-triangle"
					>
						<view-ref view="demo/error-handling-demo.view.xml"/>
						<label>
							<en>Error Handling</en>
							<de>Fehlerbehandlung</de>
						</label>
					</nav-item>
					<nav-item id="switch-demo"
						icon="css:bi bi-signpost-split"
					>
						<view-ref view="switch-demo.view.xml"/>
						<label>
							<en>Switch demo</en>
							<de>Switch-Demo</de>
						</label>
					</nav-item>
					<nav-item id="repeater"
						icon="css:bi bi-grid-3x3-gap"
					>
						<view-ref view="demo/repeater-demo.view.xml"/>
						<label>
							<en>Repeater</en>
							<de>Repeater</de>
						</label>
					</nav-item>
					<nav-item id="images"
						icon="css:bi bi-image"
					>
						<view-ref view="demo/image-demo.view.xml"/>
						<label>
							<en>Images</en>
							<de>Bilder</de>
						</label>
					</nav-item>
					<nav-item id="long-job"
						icon="css:bi bi-hourglass-split"
					>
						<view-ref view="demo/long-job-demo.view.xml"/>
						<label>
							<en>Long-running job</en>
							<de>Lang laufender Auftrag</de>
						</label>
					</nav-item>
					<nav-item id="wizard"
						icon="css:bi bi-signpost-2"
					>
						<view-ref view="demo/wizard-demo.view.xml"/>
						<label>
							<en>Wizard</en>
							<de>Assistent</de>
						</label>
					</nav-item>
					<nav-item id="form-fill"
						icon="css:bi bi-layout-text-window-reverse"
					>
						<view-ref view="demo/form-fill-demo.view.xml"/>
						<label>
							<en>Page form</en>
							<de>Seitenformular</de>
						</label>
					</nav-item>
					<nav-item id="calendar"
						icon="css:bi bi-calendar3"
					>
						<view-ref view="demo/calendar.view.xml"/>
						<label>
							<en>Calendar</en>
							<de>Kalender</de>
						</label>
					</nav-item>
					<separator/>
					<nav-item id="administration"
						icon="css:bi bi-shield-lock"
						route="none"
					>
						<access-control scope="administration"/>
						<view-ref view="admin/admin.view.xml"/>
						<label>
							<en>Administration</en>
							<de>Administration</de>
						</label>
					</nav-item>
				</items>
			</sidebar>
		</content>
		<header>
			<app-bar variant="flat">
				<commands>
					<open-designer
						image="css:bi bi-easel"
						placement="TOOLBAR"
					>
						<label>
							<en>Designer</en>
							<de>Designer</de>
						</label>
						<tooltip>
							<en>Open the view designer to edit the current page.</en>
							<de>Öffnet den View-Designer zur Bearbeitung der aktuellen Seite.</de>
						</tooltip>
					</open-designer>

					<!--
						Pops out the script-recorder side-window: a generic open-window command configured
						with the recorder view.
					-->
					<open-window
						height="320"
						image="css:bi bi-record-circle"
						placement="TOOLBAR"
						singleton-key="script-recorder"
						view="script-recorder.view.xml"
						width="420"
					>
						<title>
							<en>Script Recorder</en>
							<de>Skript-Rekorder</de>
						</title>
						<label>
							<en>Record</en>
							<de>Aufzeichnen</de>
						</label>
						<tooltip>
							<en>Open the script recorder to capture interactions as a replayable script.</en>
							<de>Öffnet den Skript-Rekorder, um Interaktionen als abspielbares Skript aufzuzeichnen.</de>
						</tooltip>
						<executability>
							<authenticated-only/>
						</executability>
					</open-window>

					<!--
						Pops out the UI-inspector side-window: pick an element of this window and see the
						control behind it. Developer tooling, shown only where UI inspection is switched on.
					-->
					<open-window
						height="640"
						image="css:bi bi-search"
						placement="TOOLBAR"
						singleton-key="ui-inspector"
						view="ui-inspector.view.xml"
						width="720"
					>
						<title>
							<en>UI inspector</en>
							<de>UI-Inspektor</de>
						</title>
						<label>
							<en>Inspect</en>
							<de>Untersuchen</de>
						</label>
						<tooltip>
							<en>Open the UI inspector to examine the elements of this window.</en>
							<de>Öffnet den UI-Inspektor zur Untersuchung der Elemente dieses Fensters.</de>
						</tooltip>
						<executability>
							<inspect-enabled/>
						</executability>
					</open-window>

					<!--
						Opens the agent access administration: issue an access token that lets an
						agent outside the browser drive this session, and withdraw issued ones.
					-->
					<generic-command
						image="css:bi bi-robot"
						placement="TOOLBAR"
					>
						<label>
							<en>Agent access</en>
							<de>Agentenzugriff</de>
						</label>
						<tooltip>
							<en>Issue and withdraw the access tokens through which an agent drives this session.</en>
							<de>Stellt Zugriffstokens aus, mit denen ein Agent diese Sitzung bedient, und zieht sie zurück.</de>
						</tooltip>
						<executability>
							<authenticated-only/>
						</executability>
						<open-dialog dialog-view="agent-access.view.xml"/>
					</generic-command>
				</commands>
				<title>
					<en>TopLogic React Demo</en>
					<de>TopLogic React Demo</de>
				</title>
				<leading>
					<!--
						Mobile drawer-toggle target. The sidebar above is configured with
						drawer-open-slot-name="appbar-leading", which makes it contribute a
						hamburger button into this slot via the slot-content registry; CSS makes
						it visible only at small viewports. The two names must match.
					-->
					<slot name="appbar-leading"/>
				</leading>
				<children>
					<!--
						Inline projection slot. Any descendant view in the shell may push content
						here by declaring <slot-content to="appbar-content">...</slot-content>; the
						slot routes contributions to the nearest matching <slot> by tree distance.
						The tiles demos use it to raise their drill-down breadcrumb to the app bar.
					-->
					<slot name="appbar-content"/>
				</children>
				<trailing>
					<!--
						The account area: who is logged in, plus logout and the theme entries.
						Provided by tl-layout-view, which also declares the channel feeding it, so
						nothing here wires it. It closes the bar, right of the command buttons,
						where an application's account area is looked for. Its login button belongs
						to an anonymous session, which this application never displays - a visitor
						sees the login page instead (see the login-view of demoReactConf.config.xml).
					-->
					<view-ref view="user-menu.view.xml"/>
				</trailing>
			</app-bar>
		</header>
	</app-shell>
</view>