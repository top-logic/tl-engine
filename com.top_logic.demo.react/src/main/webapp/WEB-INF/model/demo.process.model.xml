<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<!--
			Process data of the demo workflow "Urlaubsantrag" (WEB-INF/workflow/LeaveRequest.bpmn.xml):
			a running process of the workflow is a leave request. A process is started empty and its
			data is entered in its first task, so no attribute is mandatory; the sequence flow leaving
			the task refuses to continue while name, from or to is missing.
		-->
		<module name="demo.process">
			<class name="LeaveRequest">
				<generalizations>
					<generalization type="tl.bpe.execution:ProcessExecution"/>
				</generalizations>
				<annotations>
					<main-properties properties="name, from, to"/>
				</annotations>
				<attributes>
					<property name="name"
						type="tl.core:String"
					/>
					<property name="from"
						type="tl.core:Date"
					/>
					<property name="to"
						type="tl.core:Date"
					/>
					<property name="reason"
						type="tl.core:Text"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>