<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.ai.demo.imageclassification">
		<annotations>
			<display-group value="ai-demo"/>
		</annotations>
		<class name="Invoice">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<form-definition>
					<form>
						<field
							attribute="date"
							fullQualifiedName="tl.ai.demo.imageclassification:Invoice#date"
							type="tl.core:Date"
						/>
						<field
							attribute="description"
							fullQualifiedName="tl.ai.demo.imageclassification:Invoice#description"
							type="tl.core:String"
						/>
						<field
							attribute="amount"
							fullQualifiedName="tl.ai.demo.imageclassification:Invoice#amount"
							type="tl.core:Double"
						/>
						<field
							attribute="data"
							fullQualifiedName="tl.ai.demo.imageclassification:Invoice#data"
							type="tl.core:Binary"
						/>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="data"
					mandatory="true"
					type="tl.core:Binary"
				/>
				<property name="date"
					type="tl.core:Date"
				/>
				<property name="description"
					type="tl.core:String"
				/>
				<!--
					An invoice amount is money, so it is written as money: two decimal places, a
					thousands separator and the euro sign. The demo's invoices are euro invoices, so
					the sign is literal rather than the locale's currency symbol.
				-->
				<property name="amount"
					type="tl.core:Double"
				>
					<annotations>
						<format>
							<decimal
								normalize="true"
								pattern="#,##0.00 €"
								result-type="double"
							/>
						</format>
					</annotations>
				</property>
				<!--
					The amount as text, for the table.

					The React view layer renders a number cell from the raw value and does not yet
					consult the attribute's format annotation, so a table column bound to `amount`
					reads "84.9". This derived attribute does the formatting itself and is what the
					invoice table shows; `amount` stays the number everything else works with - the
					form edits it, and the create handler writes what the model read off the scan.

					TODO: a presentation concern living in the domain model, and it will outlive the
					gap it works around. The framework gap is that the React view layer ignores an
					attribute's `format` annotation - which is also why the detail form beside the
					table still shows "84.9" while the column shows "84,90 €". Remove this attribute
					and bind the column back to `amount` once the view layer honours the annotation.
				-->
				<property name="amountLabel"
					type="tl.core:String"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr>invoice -> {
									value = $invoice.get(`tl.ai.demo.imageclassification:Invoice#amount`);
									if ($value == null, null, numberFormat("#,##0.00 €").format($value));
								}</expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
			</attributes>
		</class>
	</module>
</model>