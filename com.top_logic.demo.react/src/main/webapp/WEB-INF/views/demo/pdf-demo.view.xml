<?xml version="1.0" encoding="utf-8" ?>

<!--
	The document viewer of the React UI: the table on the left lists the documents, the panel on
	the right previews the selected one - a picture in the image element (<image>), a PDF in the PDF
	viewer (<pdf>). A <switch> on the content type of the document chooses the viewer. The toolbar
	uploads further documents and deletes the selected one; an uploaded file becomes a document
	named after the file and is selected right away.
	
	Both viewers read the "data" channel, which is derived from the "document" channel the <switch>
	switches on. Both therefore change within the same notification - the viewer being replaced
	sees the new document value before its container replaces it.
-->
<view>
	<channels>
		<channel name="document"/>
		<derived-channel name="data"
			expr="d -> $d.get(`demo.documents:Document#data`)"
			inputs="document"
		/>
		<derived-channel name="name"
			expr="d -> $d.get(`demo.documents:Document#name`)"
			inputs="document"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="220"
				size="30"
				unit="%"
			>
				<panel>
					<title>
						<en>Documents</en>
						<de>Dokumente</de>
					</title>
					<commands>
						<upload-command
							accept="image/*,.pdf"
							image="css:bi bi-upload"
							multiple="true"
							placement="TOOLBAR"
						>
							<label>
								<en>Upload</en>
								<de>Hochladen</de>
							</label>
							<with-transaction>
								<execute-script function="file -> { doc = new(`demo.documents:Document`); $doc.set(`demo.documents:Document#name`, label($file)); $doc.set(`demo.documents:Document#data`, $file); $doc; }"/>
							</with-transaction>
							<write-channel name="document"/>
						</upload-command>
						<generic-command
							image="css:bi bi-trash"
							input="document"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="d -> { $d.delete(); null; }"/>
							</with-transaction>
							<write-channel name="document"/>
						</generic-command>
					</commands>
					<text>
						<label>
							<en>Upload a picture or a PDF file to add it to the list. The document selected here is shown in the preview beside it.</en>
							<de>Laden Sie ein Bild oder eine PDF-Datei hoch, um sie der Liste hinzuzufügen. Das hier gewählte Dokument wird in der Vorschau daneben angezeigt.</de>
						</label>
					</text>
					<table
						observed-types="demo.documents:Document"
						selection="document"
						types="demo.documents:Document"
					>
						<columns>
							<column attribute="name"/>
						</columns>
						<rows>all(`demo.documents:Document`)</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="70"
				unit="%"
			>
				<panel>
					<title>
						<en>Preview</en>
						<de>Vorschau</de>
					</title>
					<title-content>
						<text input="name"/>
					</title-content>
					<switch input="document">
						<case test="d -> $d != null &amp;&amp; binaryContentType($d.get(`demo.documents:Document#data`)).stringStartsWith('image/')">
							<image input="data">
								<alt>
									<en>The selected picture.</en>
									<de>Das gewählte Bild.</de>
								</alt>
							</image>
						</case>
						<case test="d -> $d != null &amp;&amp; binaryContentType($d.get(`demo.documents:Document#data`)).stringStartsWith('application/pdf')">
							<pdf input="data"/>
						</case>
						<default>
							<inset>
								<text>
									<label>
										<en>Select a document in the table; pictures are shown inline, PDF files in the PDF viewer.</en>
										<de>Wählen Sie ein Dokument in der Tabelle; Bilder werden direkt angezeigt, PDF-Dateien im PDF-Viewer.</de>
									</label>
								</text>
							</inset>
						</default>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>