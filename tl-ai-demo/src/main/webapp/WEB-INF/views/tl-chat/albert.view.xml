<?xml version="1.0" encoding="utf-8" ?>

<!--
	The demo's part of the chat page that tl-chat ships (same path in tl-chat, merged in dependency
	order, see the developer article view-layer/overlays). The shipped page brings the chat list, the
	conversation and the rail with Progress, Sources and Memory; this fragment adds what is about the
	event management of this demo:
	
	- the channel "invoiceEvent", the event the agent's "createInvoice" command files a new invoice
	  under: the command writes the event the agent passed into it, and the dialog's event table shows
	  it selected;
	- on the conversation "conversation": the composer's invitation, the demo's working indicator, the
	  facts about the situation, the first questions of a new chat, the "@" mentions of events, venues
	  and invoices, and the command "createInvoice" the agent may run;
	- on the rail "rail": the section "events" after the shipped section "sources".
-->
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<channels>
		<channel name="invoiceEvent"/>
	</channels>
	<chat config:ref="albert">
		<!--
			`working-indicator` is what stands where the answer will appear while the agent works:
			here the demo's own example animation instead of the chat's three dots. An SVG is placed
			into the page, so it draws in the theme's colours in the light and the dark theme alike.
		-->
		<chat-conversation config:ref="conversation"
			working-indicator="/images/tl-ai-demo-working.svg"
		>
			<!--
				The composer's idle invitation, in this application's own words (Issue #420). The
				chat's own German addresses the user with "du", which an application that says
				"Sie" everywhere else cannot have on its most-read control. Idle only: while the
				agent works the field keeps saying "Nächste Nachricht schreiben …", which is
				about the run rather than about this application.
			-->
			<placeholder>
				<en>Ask about the events, their programme, registrations, sponsors or invoices.</en>
				<de>Frag nach den Veranstaltungen, ihrem Programm, Anmeldungen, Sponsoren oder Rechnungen.</de>
			</placeholder>
			<!--
				What this page states about the situation the user is asking in (Issue #437). The
				server evaluates these when the page's channels change and they travel with every
				message; the message text itself is never touched.
				
				"Application" is stable, so it is rendered into the environment block of the system
				prompt - which has to stay byte-identical across the turns of one conversation, or
				the provider's prompt cache misses on every one of them. "Open event" follows the
				user's clicks in the rail, so it is not: it goes into the per-turn <turn-context>
				block, which travels in the turn itself, beside the user's text (#438).
				
				The dock in app.view.xml embeds this page, so the same conversation states the same
				facts in both places: a page that states them and a dock that does not would flip the
				environment block between the turns of one chat.
				
				Every fact takes the <inputs> as its leading arguments, the way <data-list> binds
				its rows - which is why the stable one names the channel it does not use.
			-->
			<context>
				<inputs>
					<input channel="paneObject"/>
				</inputs>
				<fact name="Application"
					stable="true"
				>
					<value><![CDATA[open -> "Event management demo (tl-ai-demo)"]]></value>
				</fact>
				<fact name="Open event"
					stable="false"
				>
					<value><![CDATA[open -> ifElse(isEmpty($open) || !$open.instanceOf(`demo.events:Event`), "none",
						$open.get(`demo.events:Named#name`)
							+ ": " + $open.get(`demo.events:Event#registrationCount`) + " active registrations, balance "
							+ $open.get(`demo.events:Event#balance`))]]></value>
				</fact>
			</context>
			<!--
				The first questions this page offers (Issue #529). The same binding as the
				<context> above - the <inputs> are the leading arguments of every card's
				expression, evaluated on the server and re-evaluated when the pane changes - so a
				card can name the object the user has open rather than only a fixed sentence.
				
				A click FILLS the composer and stops there. The user reads the sentence and
				presses send, which is the rule the draft, reference and quote channels already
				follow, and the reason a card may offer a longer and more precise question than
				anyone would type.
				
				They stand under the greeting of a NEW chat and nowhere else - the one screen
				with nothing to react to - and a chat opened from the list on the left never
				shows them, whatever it holds. The third card is the one that is worth having:
				with an object open it asks about that object by name, and with none open it
				asks the question that still makes sense.
			-->
			<prompts>
				<inputs>
					<input channel="paneItem"/>
				</inputs>
				<prompt icon="css:bi bi-people">
					<label>
						<en>Which events are filling up?</en>
						<de>Welche Veranstaltungen sind fast voll?</de>
					</label>
					<value><![CDATA[open -> {
						"en": "Which events have the fewest seats left, and how much has each of them earned so far?",
						"de": "Welche Veranstaltungen haben die wenigsten freien Plätze, und was hat jede bisher eingenommen?"
					}.internationalize()]]></value>
				</prompt>
				<prompt icon="css:bi bi-exclamation-triangle">
					<label>
						<en>Overdue invoices</en>
						<de>Überfällige Rechnungen</de>
					</label>
					<value><![CDATA[open -> {
						"en": "Which incoming invoices are overdue and not paid yet? Show them to me.",
						"de": "Welche eingehenden Rechnungen sind überfällig und noch nicht bezahlt? Zeig sie mir."
					}.internationalize()]]></value>
				</prompt>
				<prompt icon="css:bi bi-question-circle">
					<label>
						<en>Explain what is open</en>
						<de>Das Geöffnete erklären</de>
					</label>
					<value><![CDATA[open -> ifElse(isEmpty($open),
						{
							"en": "Open the next upcoming event and summarise its programme and budget.",
							"de": "Öffne die nächste anstehende Veranstaltung und fasse Programm und Budget zusammen."
						}.internationalize(),
						{
							"en": "Please explain “",
							"de": "Bitte erkläre „"
						}.internationalize()
							+ $open.label()
							+ {"en": "” and what still needs to be done.", "de": "“ und was noch zu tun ist."}.internationalize())]]></value>
				</prompt>
			</prompts>
			<!--
				Declarative @-mention: typing "@" offers this application's events, venues and
				invoices, no TypeScript. Each mention carries the object's id and puts its label
				into the message as the quoted text the agent reads.
			-->
			<mention observed-types="demo.events:Event,demo.events:Venue,demo.events:Invoice">
				<rows><![CDATA[all(`demo.events:Event`)
					.sort((e -> $e.get(`demo.events:Event#startDate`)).comparator().desc())
					.union(all(`demo.events:Venue`).sort((v -> $v.get(`demo.events:Named#name`)).comparator()))
					.union(all(`demo.events:Invoice`).sort((i -> $i.get(`demo.events:Invoice#invoiceDate`)).comparator().desc()))]]></rows>
				<label><![CDATA[o -> $o.label()]]></label>
				<text><![CDATA[o -> $o.label() + " (" + $o.type().label() + ")"]]></text>
			</mention>
			<!--
				The commands of this page the agent may run for the user (#30158): "Erfasse eine
				Rechnung für KI im Mittelstand" opens the dialog in which the user uploads the scan -
				a file the chat does not carry - with the event the agent names already chosen. The
				agent passes the event's id as the command's parameter "event", which only accepts an
				event the user may read; the command runs for that event only, and the rule below
				decides over it exactly as for a click. Without the parameter the dialog opens with no
				event chosen, as "Neu" on the Rechnungen page does.
				
				After "Erstellen" the dialog writes the new invoice to its "selection", bound here to
				the rail's pane, so the invoice opens beside the conversation.
			-->
			<agent-commands>
				<agent-command name="createInvoice"
					description="Opens the dialog in which the user records an invoice of an event: the user chooses its direction (incoming or outgoing) and uploads the scan, and the application reads the number, the dates and the lines off the scan when the user creates it. Use it when the user wants to record, enter or file an invoice."
				>
					<parameters>
						<property name="event"
							type="com.top_logic.model.TLObject"
						>
							<label>
								<en>Event</en>
								<de>Veranstaltung</de>
								<tooltip>
									<en>The event the new invoice is filed under. Omit it to let the user choose the event in the dialog.</en>
								</tooltip>
							</label>
							<format value="com.top_logic.tl.ai.core.tools.model.AgentObjectFormat"/>
							<object-type value="demo.events:Event"/>
						</property>
					</parameters>
					<executability>
						<disabled-if>
							<expr><![CDATA[ifElse($event != null && $event.get(`demo.events:Event#status`) == `demo.events:EventStatus#CANCELLED`,
								#("The event is cancelled; it takes no new invoices."@en, "Die Veranstaltung ist abgesagt und nimmt keine neuen Rechnungen auf."@de),
								null)]]></expr>
						</disabled-if>
					</executability>
					<execute-script function="$event">
						<with-result>
							<write-channel name="invoiceEvent"/>
						</with-result>
					</execute-script>
					<execute-script function="new(`demo.events:Invoice`, transient: true)">
						<with-result>
							<open-dialog
								bind-input-to="model"
								close-on-backdrop="false"
								dialog-view="tl-ai-demo/invoices/create-invoice.view.xml"
							>
								<bind
									channel="event"
									to="invoiceEvent"
								/>
								<bind
									channel="selection"
									to="paneObject"
								/>
							</open-dialog>
						</with-result>
					</execute-script>
				</agent-command>
			</agent-commands>
		</chat-conversation>
		<!--
			Nothing chat-specific: an ordinary <data-list> of this application's own objects, in a rail
			section. Picking one writes it to "paneObject", which is what opens the pane.
		-->
		<chat-rail config:ref="rail">
			<section name="events"
				config:position="after"
				config:reference="sources"
				icon="css:bi bi-calendar-event"
			>
				<label>
					<en>Events</en>
					<de>Veranstaltungen</de>
				</label>
				<data-list
					collapsible="false"
					observed-types="demo.events:Event"
					row-actions="hover"
					row-channel="event"
					search="false"
					selection="paneObject"
				>
					<empty-text>
						<en>No events yet</en>
						<de>Noch keine Veranstaltungen</de>
					</empty-text>
					<!--
						What issue #440 is about: ordinary view commands put a question about this
						row into the composer, with no chat-specific code and no new command class.
						The first writes a whole sentence to the "chatDraft" channel; the second
						writes the event itself to "chatReference", which the composer turns into one
						atomic reference token at the caret - what picking it with "@" does. Neither
						sends: the user reads the sentence and presses send.
						
						The last two are issue #509: a passage *of* the event rather than the event.
						"chatQuote" takes the token itself, so the command says which piece the user
						marked - here the description, there the balance - and the composer inserts
						the same atomic token with that text and that location. Two commands rather
						than one, because that is the case the channel exists for: two passages of
						the SAME object, each inserting at the caret, which a channel carrying only
						the object could not tell apart. The location is written as a text per
						language, the way the sentence above is, and the control resolves it in the
						user's own.
					-->
					<row-commands>
						<generic-command
							image="css:bi bi-chat-left-text"
							inputs="event"
						>
							<label>
								<en>Ask about this</en>
								<de>Dazu fragen</de>
							</label>
							<execute-script>
								<function><![CDATA[{
									"en": "How is the event “" + $event.get(`demo.events:Named#name`)
										+ "” doing - registrations, budget and open invoices?",
									"de": "Wie steht die Veranstaltung „" + $event.get(`demo.events:Named#name`)
										+ "“ - Anmeldungen, Budget und offene Rechnungen?"
								}.internationalize()]]></function>
								<with-result>
									<write-channel name="chatDraft"/>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							image="css:bi bi-quote"
							inputs="event"
						>
							<label>
								<en>Quote in the message</en>
								<de>In die Nachricht übernehmen</de>
							</label>
							<write-channel name="chatReference"/>
						</generic-command>
						<generic-command
							image="css:bi bi-card-text"
							inputs="event"
						>
							<label>
								<en>Quote the description</en>
								<de>Beschreibung zitieren</de>
							</label>
							<execute-script>
								<function><![CDATA[{
									"id": $event,
									"location": {"en": "Description", "de": "Beschreibung"}.internationalize(),
									"text": $event.get(`demo.events:Named#description`)
								}]]></function>
								<with-result>
									<write-channel name="chatQuote"/>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							image="css:bi bi-cash-coin"
							inputs="event"
						>
							<label>
								<en>Quote the balance</en>
								<de>Saldo zitieren</de>
							</label>
							<execute-script>
								<function><![CDATA[{
									"id": $event,
									"location": {"en": "Balance", "de": "Saldo"}.internationalize(),
									"text": numberFormat("#,##0.00").format($event.get(`demo.events:Event#balance`))
								}]]></function>
								<with-result>
									<write-channel name="chatQuote"/>
								</with-result>
							</execute-script>
						</generic-command>
					</row-commands>
					<lines>
						<line attribute="name"/>
						<line
							attribute="startDate"
							emphasis="secondary"
						/>
					</lines>
					<rows><![CDATA[all(`demo.events:Event`)
						.sort((e -> $e.get(`demo.events:Event#startDate`)).comparator().desc())]]></rows>
				</data-list>
			</section>
		</chat-rail>
	</chat>
</view>