<?xml version="1.0" encoding="utf-8" ?>

<!--
	A session of an event, opened from the programme tab of event-detail.view.xml: the session
	itself and the people who speak in it, each with a role and a fee.
-->
<view>
	<channels>
		<channel name="session"/>
		<channel name="editMode"/>
	</channels>
	<window width="720px">
		<title>
			<en>Session</en>
			<de>Session</de>
		</title>
		<form
			editMode="editMode"
			input="session"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="format"/>
			<field attribute="startTime"/>
			<field attribute="durationMinutes"/>
			<field attribute="room"/>
			<field attribute="description"/>
			<composition-table attribute="speakers">
				<columns>
					<column attribute="person"/>
					<column attribute="role"/>
					<column attribute="fee"/>
				</columns>
			</composition-table>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>OK</en>
						<de>OK</de>
					</label>
					<store-form-state/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
