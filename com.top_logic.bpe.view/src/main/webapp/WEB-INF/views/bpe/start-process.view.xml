<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the task page (bpe/tasks.view.xml) starting a process: the start events of the
	released workflows the current user may start a process with (bpeStartEvents). "Start" starts
	the process (bpeStart) and writes its first task (bpeStartTask) to the channel selection,
	which the task page binds to its selected task: the user works on it right away when the start
	event merges the first task into the start (requireReview false) or the user is an actor of
	that task. Otherwise the task waits in the task lists of its actors, and the dialog says the
	process was started.
-->
<view>
	<channels>
		<channel name="event"/>
		<channel name="selection"/>
	</channels>
	<window width="600px">
		<title>
			<en>Start process</en>
			<de>Prozess starten</de>
		</title>
		<table
			selection="event"
			types="tl.bpe.bpml:StartEvent"
		>
			<columns>
				<computed-column name="workflow"
					sort="ASC"
					type="tl.bpe.bpml:Collaboration"
				>
					<label>
						<en>Workflow</en>
						<de>Workflow</de>
					</label>
					<value>$row.get(`tl.bpe.bpml:Node#process`).get(`tl.bpe.bpml:Process#collaboration`)</value>
				</computed-column>
				<column attribute="name">
					<label>
						<en>Start event</en>
						<de>Startereignis</de>
					</label>
				</column>
			</columns>
			<rows>bpeStartEvents()</rows>
		</table>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-play-circle"
					inputs="event"
				>
					<label>
						<en>Start</en>
						<de>Starten</de>
					</label>
					<executability>
						<null-input-disabled/>
					</executability>
					<with-transaction>
						<commitMessage>
							<en>Started a process at {0}.</en>
							<de>Prozess bei {0} gestartet.</de>
						</commitMessage>
						<execute-script function="bpeStart($event)"/>
						<with-result as="execution">
							<execute-script function="{ task = bpeStartTask($execution); if($task != null &amp;&amp; ($event.get(`tl.bpe.bpml:StartEvent#requireReview`) != true || bpeTasks().containsElement($task)), $task, null); }">
								<with-result as="task">
									<if test="$task != null">
										<then>
											<write-channel name="selection"/>
										</then>
										<else>
											<notify expr="#('Process {0} started.'@en, 'Prozess {0} gestartet.'@de).fill($execution)"/>
										</else>
									</if>
									<close-dialog/>
								</with-result>
							</execute-script>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
