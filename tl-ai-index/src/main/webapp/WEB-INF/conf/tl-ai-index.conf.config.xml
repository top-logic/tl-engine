<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="tl-ai-index.app-messages" />
				</bundles>
			</instance>
		</config>

		<!--
			The tools index.search and index.similar. They are offered only while the AiIndexService
			runs; give them to an agent with <tool name="index.search"/>.
		-->
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance>
				<tool-factories>
					<factory name="index">
						<implementation class="com.top_logic.tl.ai.tool.api.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.tl.ai.index.tools.IndexTools"
						/>
					</factory>
				</tool-factories>
			</instance>
		</config>

		<!--
			The AI index. It holds nothing until an application configures its <types>, and it is not
			started until the application switches its module on:

				<config service-class="com.top_logic.basic.module.ModuleSystem">
					<instance>
						<modules>
							<module key="com.top_logic.tl.ai.index.AiIndexService$Module" value="true"/>
						</modules>
					</instance>
				</config>

			See tl-ai-index/README.md.
		-->
		<config service-class="com.top_logic.tl.ai.index.AiIndexService">
			<instance class="com.top_logic.tl.ai.index.AiIndexService"/>
		</config>
	</services>
</application>
