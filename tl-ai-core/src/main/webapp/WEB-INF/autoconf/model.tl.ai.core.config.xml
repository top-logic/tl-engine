<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
  xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
  <services>
    <config service-class="com.top_logic.util.model.ModelService">
      <instance class="com.top_logic.element.model.DynamicModelService">
        <declarations>
          <declaration file="/WEB-INF/model/tl.ai.core.model.xml"/>
          <!--
            The account's own preferences for the assistant, added to tl.accounts:Person. Kept in
            its own file because it extends a type this module does not own.
          -->
          <declaration file="/WEB-INF/model/tl-ai-core/extension.tl.accounts.model.xml"/>
        </declarations>
      </instance>
    </config>
  </services>
</application>
