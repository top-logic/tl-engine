<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-all</artifactId>
    <version>8.0.0-alpha12</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>tl-basic-core</artifactId>
	<name>${project.artifactId}</name>
	<description>Collection of utilities shared between build plugins and runtime.</description>
	<url>https://github.com/top-logic/tl-engine/</url>

  <properties>
    <!-- Fail on JavaDoc references that do not resolve, also in private members. -->
    <tl.javac.doclint>-Xdoclint:reference/private</tl.javac.doclint>
    <!-- Fail on imports that are not used. -->
    <tl.unused-imports.skip>false</tl.unused-imports.skip>
  </properties>

  <dependencies>
  	<dependency>
	    <groupId>org.apache.maven</groupId>
		<artifactId>maven-model-builder</artifactId>
		<scope>provided</scope>
  	</dependency>
  </dependencies>
</project>
