<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="parent"/>
		<channel name="before"/>
		<channel name="target"/>
	</channels>

	<tree
		children="node -> if($node == 'root', ['a', 'b'], if($node == 'a', ['a1', 'a2'], []))"
		root="'root'"
	>
		<drag kind="item">
			<node-executability>
				<disabled-if expr="node -> $node == 'b'"/>
			</node-executability>
		</drag>
		<drop
			accept="item"
			before-channel="before"
			parent-channel="parent"
			refuse-if="objects -> parent -> before -> $parent == 'b' || $objects.size() != 1"
			target="ordered"
		>
			<execute-script function="objects -> $objects"/>
		</drop>
		<drop
			accept="item"
			target="node"
			target-channel="target"
		>
			<execute-script function="objects -> $objects"/>
		</drop>
	</tree>
</view>