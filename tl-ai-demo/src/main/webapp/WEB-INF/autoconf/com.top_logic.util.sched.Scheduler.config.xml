<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.util.sched.Scheduler">
			<instance class="com.top_logic.util.sched.Scheduler">
				<tasks>
					<!--
						One AgentTask, so that the path exists in a running application and can be
						tried by hand: Administration > Scheduler > Tasks > DailyInvoiceSummary >
						"Start task".

						Disabled, because every run of it costs a real model call and this is a demo
						that is started for a minute at a time. Set enabled="true" to have it run at
						18:00 as configured; it then writes its sitting into root's chat history,
						where it can be opened and continued like any other conversation.

						It names no agent, so the application's entry-point agent answers - the same
						one a chat message without an explicit choice runs.
					-->
					<task class="com.top_logic.ai.chat.sched.AgentTask"
						name="DailyInvoiceSummary"
						enabled="false"
						run-as="root"
						run-on-startup="false"
						session-title="Tageszusammenfassung der Belege"
					>
						<prompt>Fasse die Belege zusammen, die heute erfasst wurden: wie viele es sind, auf welche Summe sie sich belaufen und was auffällt. Wenn heute keiner erfasst wurde, schreibe genau das. Frage nicht nach - zu diesem Lauf gibt es niemanden, der antworten könnte.</prompt>
						<schedules>
							<daily time-of-day="18:00"/>
						</schedules>
					</task>
				</tasks>
			</instance>
		</config>
	</services>
</application>
