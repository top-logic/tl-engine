<handler>
	<tag name="data">
		<dispatch>
			<tag name="item">
				<resolve-existing
					key="x -> $x.get(`test.com.top_logic.xio.importer.test15:Item#extId`)"
					objects="c -> p -> {
						$c.set(`test.com.top_logic.xio.importer.test15:Container#partitions`, regex('$').regexReplace($c.get(`test.com.top_logic.xio.importer.test15:Container#partitions`), regex('$').regexReplace($p, ',')));
						$c.get(`test.com.top_logic.xio.importer.test15:Container#elements`).filter(x -> $x.get(`test.com.top_logic.xio.importer.test15:Item#extId`).split('_', limit: 2).firstElement() == $p);
					}"
					partition="id -> $id.split('_', limit: 2).firstElement()"
				>
					<object model-type="test.com.top_logic.xio.importer.test15:Item" id-attribute="id" join-duplicates="true">
						<property name="extId" xml-attribute="id"/>
						<property name="name" xml-attribute="name"/>
						<reference name="other" id-attribute="other"/>
						<linking>
							<list-linking name="test.com.top_logic.xio.importer.test15:Container#elements"/>
						</linking>
						<dispatch/>
					</object>
				</resolve-existing>
			</tag>
		</dispatch>
	</tag>
</handler>
