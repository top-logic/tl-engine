<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>tl-chat-classic</artifactId>
  <name>${project.artifactId}</name>
  <description>The React chat in a classic LayoutServlet application: a LayoutComponent that writes a React view into a classic page.</description>
  <url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
    </dependency>
    <!--
      The React view layer: ReactViewComponent builds a view's control tree and registers it as
      the React window of the classic window. tl-chat brings both in already; they are named
      here because this module's code uses them directly.
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-react</artifactId>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
    </dependency>
    <!--
      The chat this module's tab displays: the view elements of chat.view.xml and the chat
      controls they talk to.
    -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-chat</artifactId>
    </dependency>
    <!-- The AI administration of the classic UI: agent editor, agent activity monitor, tool access policy. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-classic</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    The Node tests of the plain scripts (src/test/js, `npm test`) run in the `test` phase, after surefire, as in
    tl-design-system: skipped by default, run with `-DskipTests=false`. There are no npm dependencies, hence no
    `npm install`.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>

        <executions>
          <execution>
            <id>install-node</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
          </execution>

          <execution>
            <id>npm-test</id>
            <phase>test</phase>
            <goals>
              <goal>npm</goal>
            </goals>
            <configuration>
              <arguments>test</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
