<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the secrets view (opened from secrets.view.xml) decrypting a value found in a
	configuration. The encrypted value and its format are values of the view (value-input on the
	channels value and format); no model object is involved. Decrypt runs secretDecrypt and writes
	the plain value together with the input it was computed from to the converted channel. The
	result channel derives the plain value from it while the input is unchanged, so that no result
	of another input is shown; a read-only multi-line input below shows it once there is one. A
	value that is not encrypted in the chosen format is reported as error of the command. The dialog
	stays open, so that further values can be decrypted.
-->
<view>
	<channels>
		<channel name="value"/>
		<channel name="format"
			init="secretFormats().firstElement()"
		/>
		<!-- The last conversion: the value and format converted, and the result. -->
		<channel name="converted"/>
		<!-- The result, only while it belongs to the value and format entered. -->
		<derived-channel name="result"
			expr="if($converted != null and $converted['value'] == $value and $converted['format'] == $format, $converted['result'], null)"
			inputs="converted, value, format"
		/>
	</channels>
	<window
		resizable="false"
		width="640px"
	>
		<title>
			<en>Decrypt value</en>
			<de>Wert entschlüsseln</de>
		</title>
		<fields
			label-position="top"
			max-columns="1"
			with-inset="true"
		>
			<text>
				<label>
					<en>Decrypts a value written encrypted into a configuration. Choose the format the configuration property accepts: "Configuration encryption" for an encrypted configuration property and an entry marked with encrypt="true" in the application properties (with or without the prefix {gcm}), "RSA encoding" for the master credential of an LDAP server given as attribute and for crypt-support-secret.</en>
					<de>Entschlüsselt einen verschlüsselt in eine Konfiguration eingetragenen Wert. Wählen Sie das Format, das die Konfigurationseigenschaft akzeptiert: "Konfigurationsverschlüsselung" für eine verschlüsselte Konfigurationseigenschaft und einen mit encrypt="true" markierten Eintrag der Anwendungseigenschaften (mit oder ohne das Präfix {gcm}), "RSA-Kodierung" für die als Attribut angegebene Master-Anmeldung eines LDAP-Servers und für crypt-support-secret.</de>
				</label>
			</text>
			<value-input
				mandatory="true"
				type="tl.core:String"
				value="value"
			>
				<label>
					<en>Encrypted value</en>
					<de>Verschlüsselter Wert</de>
				</label>
			</value-input>
			<value-input
				mandatory="true"
				type="tl.admin:EncryptionFormat"
				value="format"
			>
				<label>
					<en>Format</en>
					<de>Format</de>
				</label>
				<input-control class="com.top_logic.layout.view.form.SelectControlProvider"
					display="radio"
					orientation="vertical"
				/>
			</value-input>
			<visible-if
				expr="$result != null"
				input="result"
			>
				<value-input
					readonly="true"
					type="tl.core:String"
					value="result"
				>
					<annotations>
						<multi-line/>
					</annotations>
					<label>
						<en>Plain value</en>
						<de>Klartext</de>
					</label>
				</value-input>
			</visible-if>
		</fields>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-unlock"
				>
					<label>
						<en>Decrypt</en>
						<de>Entschlüsseln</de>
					</label>
					<execute-script inputs="value, format">
						<function><![CDATA[{"value": $value, "format": $format, "result": secretDecrypt($value, $format)}]]></function>
						<with-result>
							<write-channel name="converted"/>
						</with-result>
					</execute-script>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>