<?xml version="1.0" encoding="utf-8" ?>

<!--
	Second frame of the project drill-down: the cockpit of the project the frame was opened for.
	
	The cockpit is a dashboard of tiles. The Project tile displays the project and nothing
	else; it spans two rows, so all fields of the project fit without scrolling. The Milestones and
	Notes tiles are entry points: pressing one pushes the frame listing that collection, announced
	by a label of its own. The engine marks such a tile only by how it answers the user, so each of
	the two cards draws the chevron itself, in the header slot at the right of its title.
	
	The Notes tile is refused while the project has no notes and gives that as its reason; creating
	the first note through the card's own button lifts the refusal, because the action observes the
	project. The create buttons inside the cards answer a press themselves, so they open their
	dialog instead of pushing the list behind the tile.
	
	The Deliverables tile pushes the list of the deliverables of the project, where a deliverable of
	a kind the user chooses is created (see projects/deliverables.view.xml).
	
	The Planning tile lists the due dates and approvals of the milestones. It is guarded by the
	operation "ShowPlanning" on the project, which only the administrators of the project hold, so
	a member of the project sees the "no access" placeholder in its place (denied="placeholder").
	The Approvals tile is guarded the same way, but with the default denied="hide": a member of
	the project does not see it at all, and the grid closes the gap.
	
	The milestone channel carries what the create dialog reports back: the milestone it created,
	which the milestone list picks up when the Milestones tile is pressed.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="milestone"/>
		<derived-channel name="milestoneCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).size())"
			inputs="project"
		/>
		<derived-channel name="noteCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#notes`).size())"
			inputs="project"
		/>
		<derived-channel name="deliverableCount"
			expr="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`).size())"
			inputs="project"
		/>
	</channels>

	<panel>
		<title>
			<en>Cockpit</en>
			<de>Cockpit</de>
		</title>
		<dashboard id="project-cockpit">
			<tile id="project"
				row-span="2"
				width="half"
			>
				<panel>
					<title>
						<en>Project</en>
						<de>Projekt</de>
					</title>
					<form
						input="project"
						with-inset="true"
					>
						<field attribute="name"/>
						<field attribute="description"/>
						<field attribute="budget"/>
						<field attribute="members"/>
						<field attribute="admins"/>
						<field attribute="reportTemplate"/>
					</form>
				</panel>
			</tile>
			<tile id="milestones"
				width="quarter"
			>
				<card>
					<title>
						<en>Milestones</en>
						<de>Meilensteine</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="milestoneCount"/>
					<button>
						<action class="com.top_logic.layout.view.command.GenericViewCommand"
							image="css:bi bi-plus-lg"
							inputs="project"
						>
							<label>
								<en>New Milestone</en>
								<de>Neuer Meilenstein</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="project"
								reference="milestones"
								type="tl.demo.projectManagement:Milestone"
							>
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-milestone.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
										<bind
											channel="selection"
											to="milestone"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</action>
					</button>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					inputs="project"
					observed-types="tl.demo.projectManagement:ProjectScope"
					view="projects/milestone-list.view.xml"
				>
					<executability>
						<null-input-disabled/>
					</executability>
					<frame-label class="com.top_logic.layout.view.tiles.StaticTileLabel">
						<value>
							<en>Milestones</en>
							<de>Meilensteine</de>
						</value>
					</frame-label>
				</action>
			</tile>
			<tile id="notes"
				width="quarter"
			>
				<card>
					<title>
						<en>Notes</en>
						<de>Notizen</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="noteCount"/>
					<button>
						<action class="com.top_logic.layout.view.command.GenericViewCommand"
							image="css:bi bi-plus-lg"
							inputs="project"
						>
							<label>
								<en>New Note</en>
								<de>Neue Notiz</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<create-transient
								container="project"
								reference="notes"
								type="tl.demo.projectManagement:Note"
							>
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-note.view.xml"
									>
										<bind
											channel="container"
											to="project"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</action>
					</button>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					inputs="project"
					observed-types="tl.demo.projectManagement:ProjectScope"
					view="projects/notes.view.xml"
				>
					<executability>
						<disabled-if expr="if($project == null || $project.get(`tl.demo.projectManagement:ProjectScope#notes`).isEmpty(), #('The project has no notes.'@en, 'Das Projekt hat keine Notizen.'@de))"/>
					</executability>
					<frame-label class="com.top_logic.layout.view.tiles.StaticTileLabel">
						<value>
							<en>Notes</en>
							<de>Notizen</de>
						</value>
					</frame-label>
				</action>
			</tile>
			<tile id="deliverables"
				width="quarter"
			>
				<card>
					<title>
						<en>Deliverables</en>
						<de>Liefergegenstände</de>
					</title>
					<header-content>
						<theme-icon image="css:bi bi-chevron-right"/>
					</header-content>
					<text input="deliverableCount"/>
				</card>
				<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
					bind-input-to="project"
					inputs="project"
					view="projects/deliverables.view.xml"
				>
					<executability>
						<null-input-disabled/>
					</executability>
					<frame-label class="com.top_logic.layout.view.tiles.StaticTileLabel">
						<value>
							<en>Deliverables</en>
							<de>Liefergegenstände</de>
						</value>
					</frame-label>
				</action>
			</tile>
			<!--
				The progress of the approvals is part of the planning as well. The tile demonstrates
				the default denied="hide": a member of the project does not see the tile at all, and the
				Planning tile takes its place next to the Project tile.
			-->
			<tile id="approvals"
				width="half"
			>
				<access-control
					inputs="project"
					object="$project"
					operation="ShowPlanning"
					type="tl.demo.projectManagement:ProjectScope"
				/>
				<panel>
					<title>
						<en>Approvals</en>
						<de>Freigaben</de>
					</title>
					<progress
						done="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).filter(m -> $m.get(`tl.demo.projectManagement:Milestone#approved`)).size())"
						input="project"
						label="#('Approved milestones'@en, 'Freigegebene Meilensteine'@de)"
						observed-types="tl.demo.projectManagement:Milestone"
						total="if($project == null, 0, $project.get(`tl.demo.projectManagement:ProjectScope#milestones`).size())"
					/>
				</panel>
			</tile>
			<!--
				The planning of the project is shown to the administrators of the project alone, who
				hold the operation "ShowPlanning" on it. The tile demonstrates the placeholder: a
				member of the project sees a "no access" placeholder in place of the tile's content.
			-->
			<tile id="planning"
				width="half"
			>
				<access-control
					denied="placeholder"
					inputs="project"
					object="$project"
					operation="ShowPlanning"
					type="tl.demo.projectManagement:ProjectScope"
				/>
				<panel>
					<title>
						<en>Planning</en>
						<de>Planung</de>
					</title>
					<table
						observed-types="tl.demo.projectManagement:Milestone"
						types="tl.demo.projectManagement:Milestone"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="dueDate"/>
							<column attribute="approved"/>
						</columns>
						<inputs>
							<input channel="project"/>
						</inputs>
						<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#milestones`))</rows>
					</table>
				</panel>
			</tile>
		</dashboard>
	</panel>
</view>