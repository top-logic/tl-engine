<?xml version="1.0" encoding="utf-8" ?>

<!--
	Overlay contributing the MCP section to the administration defined by tl-layout-view
	(WEB-INF/views/admin/admin.view.xml): every personal access token of every account, which an
	administrator may revoke (Issue #671). A same-path overlay, merged onto the base in dependency
	order.

	A section of its own rather than a tab inside "Access control": a tab's content is an unkeyed
	list, so an overlay naming that tab's inner tab bar appends a second tab bar beside it instead of
	merging into it. The top-level tab list is keyed, which is where a module adds a section - the
	way tl-model-search-react adds "Development".
-->
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<tab-bar>
		<tabs>
			<tab id="mcp"
				config:operation="add"
				config:position="end"
			>
				<label>
					<en>MCP</en>
					<de>MCP</de>
				</label>
				<tab-bar active-tab="access-tokens">
					<tabs>
						<tab id="access-tokens">
							<label>
								<en>Access tokens</en>
								<de>Zugriffstokens</de>
							</label>
							<view-ref view="tl-ai-mcp-server/admin/access-tokens.view.xml"/>
						</tab>
					</tabs>
				</tab-bar>
			</tab>
		</tabs>
	</tab-bar>
</view>
