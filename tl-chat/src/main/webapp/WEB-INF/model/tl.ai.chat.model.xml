<!-- Obsolete: replaced by tl.ai.execution:AgentSession (tl-ai-core). Instances are migrated
     eagerly at startup by LegacyChatSessionMigration.
     TODO: Delete this model in the next release via a migration (delete-class/delete-module +
     DeleteTableProcessor) — see the checklist in LegacyChatSessionMigration. -->
<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.ai.chat">
		<types>
			<class name="ChatSession">
				<annotations>
					<table name="ChatSession"/>
				</annotations>
				<generalizations>
					<generalization type="tl.accounts:WithOwner"/>
				</generalizations>
				<attributes>
					<property name="title"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="messages"
						type="tl.core:Text"
					/>
					<property name="createdAt"
						mandatory="true"
						type="tl.core:DateTime"
					/>
					<property name="lastUpdated"
						type="tl.core:DateTime"
					/>
					<property name="metadata"
						type="tl.core:Text"
					/>
				</attributes>
			</class>
		</types>
	</module>
</model>
