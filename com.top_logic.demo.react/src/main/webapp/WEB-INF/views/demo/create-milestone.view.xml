<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a tl.demo.projectManagement:Milestone inside a selected ProjectScope.
	
	"model" carries the transient Milestone (bound by the opening command); "container" is bound to
	the list's selectedScope. The Create button persists the milestone with <persist-transient> and
	adds it to ProjectScope#milestones of the container - the composite back-reference
	Milestone#scope is derived and cannot be set, so the link is made from the container side. The
	created milestone is written to "selection" (bound to selectedMilestone) so it becomes selected.
	
	The Create button binds its input to the draft ("model"): its intrinsic rule offers it only
	while the user may create a milestone in the container.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="container"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>New Milestone</en>
			<de>Neuer Meilenstein</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="dueDate"/>
			<field attribute="approved"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					input="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<persist-transient
						container="container"
						reference="milestones"
					/>
					<write-channel name="selection"/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>