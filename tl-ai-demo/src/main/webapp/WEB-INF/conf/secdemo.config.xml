<?xml version="1.0" encoding="utf-8" ?>

<!--
	Opt-in aspect for the agent security test bed.

	Enable it by adding the line

		secdemo.config.xml

	to "WEB-INF/conf/metaConf.txt" (a commented-out line is already there); disable it by
	commenting the line out again. Nothing in this file is active while the line is commented
	out, so the demo boots unchanged.

	To compare enforced against unenforced behaviour, add "secdemo-legacy.config.xml" on the
	following line - it overrides nothing but the mode. See doc/security/testbed.md, section
	"Switching between LEGACY and ENFORCED".

	Note when disabling: withdrawing the "secdemo" model declaration makes the engine's model
	upgrade delete the module on the next boot, which fails while Note / Secret instances still
	exist. Start from a fresh database, or delete those instances first. See
	doc/security/testbed.md, section "Enabling and resetting the fixture".

	What it wires:
	  * the "secdemo" example model (Note / Secret),
	  * six security roles and the groups carrying them - the persona matrix,
	  * the <security-config> that the engine's ModelAccessRights evaluates,
	  * the <tool-access> policy that tl-ai's tool layer evaluates,
	  * three TL-Script tool factories, two of them classified by a factory wildcard and one
	    deliberately left unclassified,
	  * the component (layout) access every persona needs to reach the agent chat and the
	    TL-Script console,
	  * SecDemoSetupService, which seeds the persona accounts and a few instances.

	doc/security/testbed.md is the entry point: it maps every behaviour to a persona, a thing to
	type and an expected result.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/secdemo.model.xml"/>
				</declarations>
			</instance>
		</config>

		<!--
			The roles referenced by the <security-config> and the <tool-access> below. They must
			exist before SecurityConfigurationService and AiToolAccessService start, which is
			guaranteed because both services declare a dependency on InitialRolesManager.

			One role per persona. What distinguishes them is written twice, deliberately at two
			independent layers: <security-config> says what each may do with the *data*,
			<tool-access> says which *tools* each may invoke. See doc/security/testbed.md for the
			matrix in one table.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="secReader"/>
					<role name="secEditor"/>
					<role name="secWriter"/>
					<role name="secViewer"/>
					<role name="secAuthor"/>
					<role name="secBare"/>
				</roles>
			</instance>
		</config>

		<!--
			Members of these groups get the corresponding role on the security root; the
			assignment itself is done by SecDemoSetupService, driven by its <personas> list.
		-->
		<config service-class="com.top_logic.base.services.InitialGroupManager">
			<instance>
				<groups>
					<group name="secReaders"/>
					<group name="secEditors"/>
					<group name="secWriters"/>
					<group name="secViewers"/>
					<group name="secAuthors"/>
					<group name="secBareUsers"/>
				</groups>
			</instance>
		</config>

		<!--
			Make the security root the security parent of every model object that does not define
			one itself. Without this, a role granted on the security root would not reach the
			"secdemo:Note" instances, and every instance-level check would deny.
		-->
		<config service-class="com.top_logic.tool.boundsec.BoundHelper">
			<instance use-default-security-parent="true"/>
		</config>

		<!--
			The policy the engine enforces. Deny-by-default: an operation on a type without a
			matching grant is denied for every role-based user (administrators bypass).

			"secdemo:Secret" is deliberately absent - that is what makes it inaccessible.

			"secAuthor" and "secBare" appear nowhere here on purpose. They hold tool grants and no
			data rights, which is the contrast that shows the two layers are independent: a tool
			grant is not a data grant.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="secdemo:Note">
						<grant operation="Read"
							roles="secReader, secEditor, secWriter, secViewer"
						/>
						<grant operation="Create"
							roles="secEditor, secWriter"
						/>
						<grant operation="Write"
							roles="secEditor, secWriter"
						/>
					</class>
				</security-config>
			</instance>
		</config>

		<!--
			Three TL-Script tool factories, which exist to make the *classification* mechanism
			testable end to end rather than only in a unit test.

			A TL-Script tool has no @ToolMethod annotation to carry a group, so it arrives
			ungrouped and is therefore denied to everyone under an enforcing policy. The only way
			to give it one is a <tool-groups> entry, typically a "{factory}.*" wildcard - see the
			<tool-groups> block below. That is the migration path every application with script
			tools will have to walk.

			"secdemo-reporting.countNotes" and "secdemo-unclassified.countNotesUnclassified" have
			the same body, the same mode and the same parameters. The single difference between
			them is that a wildcard classifies the first factory and not the second, so the pair
			isolates the mechanism exactly.
		-->
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance>
				<tool-factories>
					<factory name="secdemo-reporting">
						<implementation class="com.top_logic.tl.ai.core.tools.registry.ScriptToolFactory">
							<tools>
								<tool name="countNotes"
									mode="READ"
								>
									<description>
										<en>Counts the notes visible to the acting account. Classified into data.read by a factory wildcard.</en>
										<de>Zählt die für das ausführende Konto sichtbaren Notizen. Wird über einen Factory-Platzhalter der Gruppe data.read zugeordnet.</de>
									</description>
									<implementation>all(`secdemo:Note`).size()</implementation>
								</tool>
							</tools>
						</implementation>
					</factory>
					<factory name="secdemo-editing">
						<implementation class="com.top_logic.tl.ai.core.tools.registry.ScriptToolFactory">
							<tools>
								<tool name="addNote"
									mode="DATA_WRITE"
								>
									<description>
										<en>Creates a note with the given title. Classified into data.write by a factory wildcard.</en>
										<de>Erzeugt eine Notiz mit dem angegebenen Titel. Wird über einen Factory-Platzhalter der Gruppe data.write zugeordnet.</de>
									</description>
									<parameters>
										<parameter name="title"
											type="tl.core:String"
											mandatory="true"
										/>
									</parameters>
									<implementation>new(`secdemo:Note`)..set(`secdemo:Note#title`, $title)</implementation>
								</tool>
							</tools>
						</implementation>
					</factory>
					<factory name="secdemo-unclassified">
						<implementation class="com.top_logic.tl.ai.core.tools.registry.ScriptToolFactory">
							<tools>
								<tool name="countNotesUnclassified"
									mode="READ"
								>
									<description>
										<en>Counts the notes. Deliberately left out of tool-groups, so it belongs to no group and is denied to every role.</en>
										<de>Zählt die Notizen. Absichtlich nicht in tool-groups eingetragen, gehört daher zu keiner Gruppe und ist für jede Rolle gesperrt.</de>
									</description>
									<implementation>all(`secdemo:Note`).size()</implementation>
								</tool>
							</tools>
						</implementation>
					</factory>
				</tool-factories>
			</instance>
		</config>

		<!--
			The tl-ai tool layer (L1): which roles may execute which agent tools. Independent of the
			<security-config> above, which governs the data - a role can be granted the TL-Script tool
			and still be denied every object it tries to touch, and vice versa.

			Writing this block is what turns tool authorization on. Without it the service resolves to
			LEGACY and every tool an agent carries is callable by anyone, which is how the demo behaves
			with this aspect switched off. To keep the fixture and compare against LEGACY anyway, add
			"secdemo-legacy.config.xml" to metaConf.txt.

			The six roles, ordered from the narrowest to the widest, and what each one is here to
			demonstrate:

			  secBare    nothing beyond the <baseline>. Every skill that declares a tool disappears.
			  secViewer  model.read only. Shows a *partially* denied skill: TL_modelExploration keeps
			             its eight model.read tools and loses its three data.read ones.
			  secReader  model.read + data.read + script. The read-only persona of the model-rights
			             walkthrough; TL_taskManagement is fully denied to it, so the skill is dropped.
			  secEditor  the same plus agent.meta - one capability apart from secReader, which is what
			             makes the allow/deny pair on a single tool comparable.
			  secWriter  model.read + data.read + data.write + workspace. The only role that reaches a
			             write tool, and only in the foreground: data.write is off the
			             <background-allowlist> on purpose.
			  secAuthor  agent.meta + agent.authoring, and no data rights at all.

			Both secReader and secEditor keep "script": the cases in doc/security/testbed.md that
			exercise the *model* rights ask the agent to use the TL-Script tool, and denying it at the
			tool layer would stop them before the layer they are about.

			"script", "model.structure" and "agent.authoring" are privileged groups: no wildcard grant
			reaches them and an administrator must name them explicitly. "model.structure" is granted to
			nobody, so the model editor is denied to every persona - deny-by-default, no <deny> needed.
			"egress" is granted to nobody either.

			See doc/security/tool-access-configuration.md and doc/security/testbed.md.
		-->
		<config service-class="com.top_logic.tl.ai.core.security.AiToolAccessService">
			<instance class="com.top_logic.tl.ai.core.security.AiToolAccessService">
				<!--
					A TL-Script tool declares no group, so this is the only place it can get one. One
					line per factory classifies everything that factory contributes.

					"secdemo-unclassified" is deliberately absent: an unclassified tool must stay
					denied to everyone, and the pair of otherwise identical tools is what proves the
					wildcard is what makes the difference.

					Note what the administrator guide warns about this mechanism: mapping a factory
					delegates classification authority over that namespace, because createScriptTool
					lets its caller choose the factory freely. Both factories mapped here are shipped
					in this aspect; the factory agents author into by default ("custom") is left out.
				-->
				<tool-groups>
					<group name="data.read">
						<tools>
							<tool name="secdemo-reporting.*"/>
						</tools>
					</group>
					<group name="data.write">
						<tools>
							<tool name="secdemo-editing.*"/>
						</tools>
					</group>
				</tool-groups>

				<tool-access>
					<role name="secBare">
						<!--
							Present with no grants on purpose. A role that appears nowhere and a role
							that appears with an empty grant list are the same thing to the policy, and
							writing it out says the emptiness is intended.
						-->
						<grants/>
					</role>
					<role name="secViewer">
						<grants>
							<grant group="model.read"/>
						</grants>
					</role>
					<role name="secReader">
						<grants>
							<grant group="model.read"/>
							<grant group="data.read"/>
							<grant group="script"/>
						</grants>
					</role>
					<role name="secEditor">
						<grants>
							<grant group="model.read"/>
							<grant group="data.read"/>
							<grant group="script"/>
							<grant group="agent.meta"/>
						</grants>
					</role>
					<role name="secWriter">
						<grants>
							<grant group="model.read"/>
							<grant group="data.read"/>
							<grant group="data.write"/>
							<grant group="workspace"/>
						</grants>
					</role>
					<role name="secAuthor">
						<grants>
							<grant group="agent.meta"/>
							<grant group="agent.authoring"/>
						</grants>
					</role>
				</tool-access>

				<!-- Without this an agent cannot even ask the user a question. -->
				<baseline>
					<grant group="interaction"/>
				</baseline>

				<!--
					The ceiling for a run with nobody to answer an approval prompt - aiAgentChatAsync,
					which the TL-Script harness uses, and the MCP endpoint.

					"script" is on the list only because that harness needs it. "data.write" and
					"workspace" are deliberately off it, so secWriter - the one role that holds
					data.write - reaches "secdemo-editing.addNote" in the chat and is refused it in a
					background run. That contrast is the whole point of the mechanism, and
					SecDemoBackgroundAccessTest pins it.
				-->
				<background-allowlist>
					<grant group="model.read"/>
					<grant group="data.read"/>
					<grant group="agent.meta"/>
					<grant group="interaction"/>
					<grant group="script"/>
				</background-allowlist>
			</instance>
		</config>

		<!--
			The second, independent security layer: component (layout) access. The policies above
			decide what a role may do with the data and which tools it may call, this decides which
			views a role may open at all. All three are needed - a role with model rights and tool
			grants but no view rights logs in to an application without a single tab.

			The format is the engine's own "WEB-INF/conf/security.xml" format
			(com.top_logic.tool.boundsec.config.AccessConfiguration). It is applied here instead of
			in that file because the engine's import resets the access of every view in the
			application before applying it, which an opt-in aspect must not do. The entries below
			are added, nothing else is touched.

			View names are the names of the enclosing "securityLayout" components; only those can
			hold access rights. "Read" is the command group that decides visibility.

			Nesting does not inherit, so every securityLayout on the way to a view needs its own
			grant. The script console sits three levels deep (the tabs labelled "Administration",
			"Development" and "Script console"), hence three entries; the sibling views on those
			levels stay closed because they are security components of their own with no grant.

			The profile is named "*", which SecDemoSetupService expands to the role of every
			configured persona. Every persona therefore sees exactly the same UI, which is what makes
			the allow/deny pairs comparable: the only thing that differs between two personas is the
			policy, never what they can reach. A profile named after one role still works, for a
			persona that deliberately needs different views.

			Granting the script console to a non-administrator role lets that role execute
			arbitrary TL-Script. That is deliberate here and confined to this opt-in aspect: the
			walkthrough asserts that the model access rights hold even for a user who can run any
			expression. Only "Read" is granted, which covers opening the view and its "execute"
			button; the "execute and save changes" button is bound to "Write" and stays disabled -
			the agent runs started from the console do their own writes in their own transaction on
			the background thread.
		-->
		<config service-class="com.top_logic.ai.demo.secdemo.SecDemoSetupService">
			<instance class="com.top_logic.ai.demo.secdemo.SecDemoSetupService">
				<!--
					The persona matrix. One row per account: which group it joins, which role that
					group carries on the security root, and what the persona is here to demonstrate.
					The purpose is logged at boot, so the boot log is itself a readable index of the
					fixture.
				-->
				<personas>
					<persona login="secbare1"
						group="secBareUsers"
						role="secBare"
						purpose="holds nothing beyond the baseline - every skill that declares a tool is dropped"
					/>
					<persona login="secviewer1"
						group="secViewers"
						role="secViewer"
						purpose="model.read only - a partially denied skill keeps the tools it may use"
					/>
					<persona login="secreader1"
						group="secReaders"
						role="secReader"
						purpose="read-only plus TL-Script - reads notes, cannot create one, sees no secret"
					/>
					<persona login="seceditor1"
						group="secEditors"
						role="secEditor"
						purpose="secreader1 plus agent.meta - the allow half of the one-capability pair"
					/>
					<persona login="secwriter1"
						group="secWriters"
						role="secWriter"
						purpose="the only persona holding data.write, and only in the foreground"
					/>
					<persona login="secauthor1"
						group="secAuthors"
						role="secAuthor"
						purpose="agent authoring, with no data rights at all"
					/>
				</personas>

				<component-access>
					<profile name="*">
						<!-- The "Albert" tab. -->
						<view name="tl-chat/chat/tabLayout.layout.xml#TabLayout">
							<commandGroup name="Read"/>
						</view>
						<!-- The chat itself, a security component of its own. -->
						<view name="tl-chat/chat/agent.layout.xml#agent">
							<commandGroup name="Read"/>
						</view>
						<!-- The three nested tabs leading to the script console. -->
						<view name="admin/index.layout.xml#adminView">
							<commandGroup name="Read"/>
						</view>
						<view name="admin/studio/index.layout.xml#studioView">
							<commandGroup name="Read"/>
						</view>
						<view name="com.top_logic.model.search/admin/scriptConsole.layout.xml#view">
							<commandGroup name="Read"/>
						</view>
					</profile>
				</component-access>
			</instance>
		</config>

		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<!-- Seeds the persona accounts, their group memberships and the example data. -->
					<module key="com.top_logic.ai.demo.secdemo.SecDemoSetupService$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>
	</services>
</application>
