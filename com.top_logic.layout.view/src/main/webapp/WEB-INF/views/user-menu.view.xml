<?xml version="1.0" encoding="utf-8" ?>

<!--
	The account area of an app bar: who is logged in, and what they can do about it.

	Referenced rather than copied - an application places it with

		<app-bar>
			<trailing>
				<view-ref view="user-menu.view.xml"/>
			</trailing>
		</app-bar>

	and wires nothing, because the channel feeding the area is declared here.

	A depending module or the application adds entries with a same-path overlay
	(WEB-INF/views/user-menu.view.xml of its own module); the ViewLoader merges all copies in
	dependency order, so an entry is contributed without this module knowing the contributor. The
	administration view is extended the same way - see admin/admin.view.xml.
-->
<view>
	<channels>
		<!-- Feeds the area; read-only, recomputed per session. -->
		<derived-channel name="currentUser"
			expr="currentUser()"
		/>
	</channels>

	<!--
		An anonymous session has one thing to do here, and it is offered in plain sight: a Login
		button where the account area is, with no avatar and no menu in front of it. Everything an
		account carries - and the preferences stored on it - waits until somebody is logged in.
	-->
	<switch input="currentUser">
		<case test="account -> $account.accountIsAnonymous()">
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-box-arrow-in-right"
				>
					<label>
						<en>Login</en>
						<de>Anmelden</de>
					</label>
					<execute-script function="x -> new(`tl.login:Credentials`, transient: true)"/>
					<open-dialog
						bind-input-to="model"
						close-on-backdrop="false"
						dialog-view="login.view.xml"
					/>
				</action>
			</button>
		</case>
		<default>
			<!--
				The children are the trigger, the commands are the entries.

				Leaving the session is the first group, everything about the account that stays
				logged in follows after a separator.
			-->
			<menu>
				<avatar input="currentUser"/>
				<text css-class="tlUserMenu__name"
					input="currentUser"
					overflow="ellipsis"
				/>

				<commands>
					<!--
						Leaving comes first. It is the one entry a user looks for rather than browses
						to, and the only one whose position should never depend on what a module
						contributed below it.
					-->
					<logout-command image="css:bi bi-box-arrow-right">
						<label>
							<en>Logout</en>
							<de>Abmelden</de>
						</label>
					</logout-command>
				</commands>

				<groups>
					<group>
						<!-- What describes the account, and what secures it. -->
						<generic-command image="css:bi bi-sliders">
							<label>
								<en>Settings</en>
								<de>Einstellungen</de>
							</label>
							<open-dialog dialog-view="settings.view.xml"/>
						</generic-command>

						<!--
							Where the user begins. One entry for both directions: invoked on the page
							that is already the start page it clears the choice.
						-->
						<generic-command image="css:bi bi-pin-angle">
							<label>
								<en>Start on this page</en>
								<de>Auf dieser Seite beginnen</de>
							</label>
							<remember-start-page/>
						</generic-command>

						<!-- Puts the presentation back the way it looks to somebody who has never used the application. -->
						<generic-command image="css:bi bi-arrow-counterclockwise">
							<label>
								<en>Reset personal settings</en>
								<de>Persönliche Einstellungen zurücksetzen</de>
							</label>
							<confirm expr="x -> #('Discard the theme, column widths and everything else you have adjusted?'@en, 'Das Theme, die Spaltenbreiten und alles weitere Angepasste verwerfen?'@de)"/>
							<reset-personal-configuration/>
						</generic-command>
					</group>
				</groups>

				<!--
					The one-decision preferences, an entry each rather than a form field: one entry
					per language the application supports, and one per theme configured in
					UIThemeService, labelled and iconed by the theme itself. Both mark the active
					choice by offering it as disabled, both head their group with a label naming the
					choice, and both contribute nothing when there is only one of them - so an
					application with a single theme and a single language sees none of this.
				-->
				<command-sources>
					<language-commands/>
					<theme-commands/>
				</command-sources>
			</menu>
		</default>
	</switch>
</view>
