<?xml version="1.0" encoding="utf-8" ?>

<!--
	The notes of a project, pushed by the Notes tile of the project cockpit. The toolbar adds a
	note to the project; the table observes notes, so a created note appears without a reload.
	
	The view sits behind a tile of the cockpit and is reachable from no root view, so it is shown
	within the frame the tile pushed.
	
	The panel fills the frame, so the table spans the height of the page and scrolls its rows
	internally: a frame of the drill-down stack is only as high as its content unless that content
	fills.
-->
<view>
	<channels>
		<channel name="project"/>
	</channels>

	<panel fill="true">
		<title>
			<en>Notes</en>
			<de>Notizen</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				input="project"
				placement="TOOLBAR"
			>
				<label>
					<en>New Note</en>
					<de>Neue Notiz</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<create-transient
					container="project"
					reference="notes"
					type="tl.demo.projectManagement:Note"
				/>
				<open-dialog
					bind-input-to="model"
					dialog-view="demo/create-note.view.xml"
				>
					<bind
						channel="container"
						to="project"
					/>
				</open-dialog>
			</generic-command>
		</commands>
		<table
			observed-types="tl.demo.projectManagement:Note"
			types="tl.demo.projectManagement:Note"
		>
			<columns>
				<column attribute="text"/>
			</columns>
			<inputs>
				<input channel="project"/>
			</inputs>
			<rows>p -&gt; if($p == null, [], $p.get(`tl.demo.projectManagement:ProjectScope#notes`))</rows>
		</table>
	</panel>
</view>