<?xml version="1.0" encoding="utf-8" ?>

<!--
	Secrets of a local development deployment, listed as devel-secrets.xml in the metaConf.txt of
	deploy/local of an application: a system property or environment variable named like the secret
	takes precedence, otherwise the file named like the secret in the folder ~/.top-logic/secrets of
	the developer delivers it (e.g. translation_api_key), otherwise the value given here. The only
	value given here is the password of the development database ./tmp/h2.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.credential.SecretStoreService">
			<instance class="com.top_logic.basic.credential.SecretStoreService">
				<store class="com.top_logic.basic.credential.ChainSecretStore">
					<stores>
						<env-store/>
						<directory-store directory="%DEVEL_SECRETS_DIR%"/>
						<literal-store>
							<secrets>
								<secret name="h2_passwd"
									value="unencrypted:password"
								/>
							</secrets>
						</literal-store>
					</stores>
				</store>
			</instance>
		</config>
	</services>
</application>
