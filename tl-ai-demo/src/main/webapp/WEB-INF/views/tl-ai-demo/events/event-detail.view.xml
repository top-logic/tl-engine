<?xml version="1.0" encoding="utf-8" ?>

<!--
	One event, on tabs: an overview with the figures the model computes and the master data, then
	its four compositions - the programme, the registrations, the sponsors and the invoices.

	One form around the whole <tab-bar>: the event is edited and saved as one, whichever tab the
	user changes it on. A <composition-table> adds, edits and removes rows of a composite reference,
	saved with that form. A session and an invoice have parts of their own (speakers, invoice
	lines), so their rows open a detail dialog that edits those in turn.

	The content of each tab is a view file of its own (event-<tab id>.view.xml), so that a command
	can open the tab with <show-view> - the agent's command "openEventTab" in tl-chat/albert.view.xml.
	The <view-ref> hands the form on to the fields of that file.
-->
<view>
	<channels>
		<channel name="event"/>
	</channels>

	<panel fill="true">
		<title>
			<en>Event</en>
			<de>Veranstaltung</de>
		</title>
		<!--
			What this page has open, for the chat (Issue #928). It draws nothing, and the chat states
			"none" again when the page leaves the screen. See app.view.xml, <chat-channels>.
		-->
		<page-selection to="pageSelection">
			<inputs>
				<input channel="event"/>
			</inputs>
		</page-selection>
		<form input="event"
			with-inset="true"
		>
			<tab-bar active-tab="overview">
				<tab id="overview">
					<label>
						<en>Overview</en>
						<de>Übersicht</de>
					</label>
					<view-ref view="tl-ai-demo/events/event-overview.view.xml"/>
				</tab>
				<tab id="sessions">
					<label>
						<en>Programme</en>
						<de>Programm</de>
					</label>
					<view-ref view="tl-ai-demo/events/event-sessions.view.xml"/>
				</tab>
				<tab id="registrations">
					<label>
						<en>Registrations</en>
						<de>Anmeldungen</de>
					</label>
					<view-ref view="tl-ai-demo/events/event-registrations.view.xml"/>
				</tab>
				<tab id="sponsorships">
					<label>
						<en>Sponsors</en>
						<de>Sponsoren</de>
					</label>
					<view-ref view="tl-ai-demo/events/event-sponsorships.view.xml"/>
				</tab>
				<tab id="invoices">
					<label>
						<en>Invoices</en>
						<de>Rechnungen</de>
					</label>
					<view-ref view="tl-ai-demo/events/event-invoices.view.xml"/>
				</tab>
			</tab-bar>
		</form>
	</panel>
</view>
