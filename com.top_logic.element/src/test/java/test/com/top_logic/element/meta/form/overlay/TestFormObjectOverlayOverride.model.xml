<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="testFormObjectOverlayOverride">
		<datatype name="String"
			db_type="varchar"
			kind="String"
		>
			<storage-mapping class="com.top_logic.element.meta.kbbased.storage.mappings.DirectMapping"
				application-type="java.lang.String"
			/>
			<annotations>
				<field-provider impl="com.top_logic.element.meta.form.fieldprovider.StringFieldProvider"/>
			</annotations>
		</datatype>

		<interface name="Base">
			<attributes>
				<property name="value"
					type="String"
				/>
			</attributes>
		</interface>

		<class name="Derived">
			<generalizations>
				<generalization type="Base"/>
			</generalizations>
			<attributes>
				<property name="value"
					override="true"
					type="String"
				/>
				<property name="other"
					type="String"
				/>
			</attributes>
		</class>

		<class name="Foreign">
			<attributes>
				<property name="value"
					type="String"
				/>
			</attributes>
		</class>
	</module>
</model>
