<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient NewAccessToken model bound to the form. -->
		<channel name="model"/>
		<!-- The issued token, published by the issue action and displayed once. -->
		<channel name="secret"/>
	</channels>
	<window
		resizable="false"
		width="460px"
	>
		<title>
			<en>New access token</en>
			<de>Neues Zugriffstoken</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
		>
			<field attribute="label"/>
			<field attribute="validHours"/>
			<field attribute="mayAct"/>
			<text>
				<label>
					<en>Without acting permission the agent may only read this session.</en>
					<de>Ohne Handlungsberechtigung darf der Agent diese Sitzung nur lesen.</de>
				</label>
			</text>
			<text input="secret"/>
			<text>
				<label>
					<en>Copy the token now: it is shown this one time and cannot be read again.</en>
					<de>Kopieren Sie das Token jetzt: Es wird nur dieses eine Mal angezeigt und ist danach nicht mehr lesbar.</de>
				</label>
			</text>
			<commands>
				<generic-command
					image="css:bi bi-key"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Issue token</en>
						<de>Token ausstellen</de>
					</label>
					<store-form-state/>
					<issue-access-token/>
					<write-channel name="secret"/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>