<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="currentStep"/>
		<channel name="conciergeStep"/>
		<channel name="scriptedStep"/>
		<channel name="questions"/>
	</channels>
	<panel title="Dynamic Steps Test">
		<wizard
			current-step="currentStep"
			progress="false"
		>
			<step id="welcome"
				auto-advance="2s"
				label="wizard.welcome"
			/>
			<dynamic-steps steps="questions">
				<text input="element"/>
			</dynamic-steps>
			<step id="summary"
				auto-advance="2s"
				label="wizard.summary"
			/>
		</wizard>
		<wizard
			current-step="conciergeStep"
			progress="false"
		>
			<step id="welcome"
				label="wizard.welcome"
			/>
			<dynamic-steps steps="questions">
				<text input="element"/>
			</dynamic-steps>
		</wizard>
		<wizard
			current-step="scriptedStep"
			progress="false"
		>
			<dynamic-steps
				auto-advance="if($q == 'a', 2000, null)"
				element-channel="question"
				icon="'css:fa-solid fa-circle-question'"
				inputs="questions as all"
				label="$q.toUpperCase() + $all.size()"
				step-as="q"
				steps="questions"
			>
				<text input="question"/>
			</dynamic-steps>
		</wizard>
	</panel>
</view>