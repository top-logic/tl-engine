<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="selectedSplit"/>
		<channel name="selectedDrawer"/>
		<channel name="selectedSized"/>
		<channel name="selectedRemainder"/>
	</channels>

	<panel title="Adaptive Detail Test">
		<!-- Nothing said about the detail display: the detail divides the width with the selector. -->
		<adaptive-detail selection="selectedSplit">
			<selector>
				<panel title="Selector"/>
			</selector>
			<detail>
				<panel title="Detail"/>
			</detail>
		</adaptive-detail>

		<!-- The detail overlays the selector in a drawer 360 pixels wide. -->
		<adaptive-detail
			detail-display="drawer"
			drawer-size="360"
			selection="selectedDrawer"
		>
			<selector>
				<panel title="Selector"/>
			</selector>
			<detail>
				<panel title="Detail"/>
			</detail>
		</adaptive-detail>

		<!-- Both sides sized explicitly: taken as given. -->
		<adaptive-detail selection="selectedSized">
			<selector
				min-size="200"
				size="300"
				unit="px"
			>
				<panel title="Selector"/>
			</selector>
			<detail
				min-size="400"
				size="70"
				unit="%"
			>
				<panel title="Detail"/>
			</detail>
		</adaptive-detail>

		<!-- Only the selector sized: the detail takes the rest of the 100 percent. -->
		<adaptive-detail selection="selectedRemainder">
			<selector size="55">
				<panel title="Selector"/>
			</selector>
			<detail>
				<panel title="Detail"/>
			</detail>
		</adaptive-detail>
	</panel>
</view>