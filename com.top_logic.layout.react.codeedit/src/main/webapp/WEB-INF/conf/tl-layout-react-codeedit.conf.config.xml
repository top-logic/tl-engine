<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<module-script name="tl-code-editor"
						resource="/script/tl-code-editor.js"
						specifier="tl-code-editor"
						requires="tl-react-bridge"
					/>
					<!--
						Unlayered: the stylesheet overrides the base theme CodeMirror writes into the page
						at runtime, which is unlayered and would win against every rule of a layer.
					-->
					<stylesheet name="tl-code-editor-css"
						resource="/style/tlCodeEditor.css"
					/>
				</resources>
			</instance>
		</config>

		<config service-class="com.top_logic.layout.configedit.ConfigControlService">
			<instance>
				<annotation-controls>
					<annotation-control annotation="com.top_logic.layout.form.values.edit.annotation.Code">
						<impl class="com.top_logic.layout.react.codeedit.CodeConfigProvider"/>
					</annotation-control>
				</annotation-controls>
			</instance>
		</config>
	</services>
</application>
