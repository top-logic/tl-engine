<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/TestTLScriptSecurity.model.xml"/>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="TestTLScriptSecurity.ProjectReader"/>
					<role name="TestTLScriptSecurity.ProposalReader"/>
					<role name="TestTLScriptSecurity.ProposalApprover"/>
					<role name="TestTLScriptSecurity.ProjectResponsible"/>
					<role name="TestTLScriptSecurity.PathReader"/>
					<role name="TestTLScriptSecurity.PathViewer"/>
					<role name="TestTLScriptSecurity.NoteWriter"/>
					<role name="TestTLScriptSecurity.PathWriter"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.simple.CommandGroupRegistry">
			<instance class="com.top_logic.tool.boundsec.simple.CommandGroupRegistry">
				<group name="Approve" type="write"/>
				<!-- Operations declared on the test types, see TestOperationDeclarations. -->
				<group name="Show" type="read"/>
				<group name="Inspect" type="read"/>
				<group name="Review" type="write"/>
				<group name="Audit" type="read"/>
			</instance>
		</config>

		<config service-class="com.top_logic.model.search.configured.ConfiguredTLScriptFunctions">
			<instance class="com.top_logic.model.search.configured.ConfiguredTLScriptFunctions">
				<scripts>
					<!-- Writes the name of a proposal, which an approver may not write directly. -->
					<privileged-script name="testPrivilegedRename"
						command-group="Approve"
						security-object="$proposal"
					>
						<parameters>
							<parameter name="proposal"/>
							<parameter name="name"/>
						</parameters>
						<implementation>$proposal.set(`TestTLScriptSecurity:PathNode#name`, $name)</implementation>
					</privileged-script>
					<!-- Delivers all proposals, also those the caller may not discover. -->
					<privileged-script name="testPrivilegedAll"
						command-group="Approve"
						security-object="$proposal"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>all(`TestTLScriptSecurity:Proposal`)</implementation>
					</privileged-script>
					<!-- Delivers the proposal with the given name, also one the caller may not discover. -->
					<privileged-script name="testPrivilegedByName"
						command-group="Approve"
						security-object="$proposal"
					>
						<parameters>
							<parameter name="proposal"/>
							<parameter name="name"/>
						</parameters>
						<implementation>all(`TestTLScriptSecurity:Proposal`).filter(x -> $x.get(`TestTLScriptSecurity:PathNode#name`) == $name).firstElement()</implementation>
					</privileged-script>
					<!-- Delivers the unfiltered number of all proposals. -->
					<privileged-script name="testPrivilegedCount"
						command-group="Approve"
						security-object="$proposal"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>all(`TestTLScriptSecurity:Proposal`).size()</implementation>
					</privileged-script>
					<!-- Denies every secured call: the security object is always null. -->
					<privileged-script name="testPrivilegedNever"
						command-group="Approve"
						security-object="null"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>$proposal.get(`TestTLScriptSecurity:PathNode#name`)</implementation>
					</privileged-script>
					<!-- Calls a privileged script that denies every secured call. -->
					<privileged-script name="testPrivilegedOuter"
						command-group="Approve"
						security-object="$proposal"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>testPrivilegedNever($proposal)</implementation>
					</privileged-script>
					<privileged-script name="testPrivilegedOnDeniedValue"
						command-group="Approve"
						security-object="$proposal"
						on-denied="'denied:' + $proposal.get(`TestTLScriptSecurity:PathNode#name`)"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>'allowed'</implementation>
					</privileged-script>
					<!-- The number is computed inside on-denied: it only counts what the caller may discover. -->
					<privileged-script name="testPrivilegedOnDeniedCount"
						command-group="Approve"
						security-object="$proposal"
						on-denied="all(`TestTLScriptSecurity:Proposal`).size()"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>'allowed'</implementation>
					</privileged-script>
					<privileged-script name="testPrivilegedOnDeniedThrow"
						command-group="Approve"
						security-object="$proposal"
						on-denied="throw('custom denial')"
					>
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>'allowed'</implementation>
					</privileged-script>
					<!-- Checks every element of the given collection. -->
					<privileged-script name="testPrivilegedCollection"
						command-group="Approve"
						security-object="$proposals"
					>
						<parameters>
							<parameter name="proposals"/>
						</parameters>
						<implementation>'allowed'</implementation>
					</privileged-script>
					<privileged-script name="testPrivilegedDefault"
						command-group="Approve"
						security-object="$target"
					>
						<parameters>
							<parameter name="proposal"/>
							<parameter name="target">
								<default-value>null</default-value>
							</parameter>
						</parameters>
						<implementation>$target</implementation>
					</privileged-script>
					<configured-script name="testPlainScript">
						<parameters>
							<parameter name="proposal"/>
						</parameters>
						<implementation>$proposal.get(`TestTLScriptSecurity:PathNode#name`)</implementation>
					</configured-script>
				</scripts>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<module name="TestTLScriptSecurity">
						<!-- Applies to every class of the module. -->
						<operations>
							<operation name="Audit"/>
						</operations>
					</module>
					<class name="TestTLScriptSecurity:Project">
						<!--
							Whoever reads a project may show it; the application layer adds Inspect,
							implied by Show. Only the responsible may approve a project.
						-->
						<operations>
							<operation name="Show"
								implied-by="Read"
							/>
							<operation name="Approve"/>
						</operations>
						<grant
							inherit="true"
							operation="Approve"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
						<!-- Both roles may read; only the responsible may write and delete. -->
						<grant
							inherit="true"
							operation="Read"
							roles="TestTLScriptSecurity.ProjectResponsible, TestTLScriptSecurity.ProjectReader"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
						<grant
							inherit="true"
							operation="Delete"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:Proposal">
						<operations>
							<operation name="Approve"/>
						</operations>
						<!-- A reader reads a proposal, an approver reads it and may approve it. -->
						<grant
							inherit="true"
							operation="Read"
							roles="TestTLScriptSecurity.ProposalReader, TestTLScriptSecurity.ProposalApprover"
						/>
						<grant
							inherit="true"
							operation="Approve"
							roles="TestTLScriptSecurity.ProposalApprover"
						/>
					</class>
					<class name="TestTLScriptSecurity:Employee">
						<!-- The responsible may create employees (create condition 1). -->
						<grant
							inherit="true"
							operation="Create"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:ProjectTask">
						<!--
							A task follows the project its assignee is responsible for. Approve and
							Show are checked on the project; Review, which the project does not
							declare, is held by whoever may write the project.
						-->
						<operations>
							<operation name="Approve"/>
							<operation name="Show"
								implied-by="Read"
							/>
							<operation name="Review"
								implied-by="Write"
							/>
						</operations>
						<access-parent>
							<script expr="t -> $t.get(`TestTLScriptSecurity:ProjectTask#assignee`).referers(`TestTLScriptSecurity:Project#responsible`)"/>
						</access-parent>
					</class>
					<class name="TestTLScriptSecurity:ExternalEmployee">
						<!-- The create right inherited from Employee is withdrawn: nobody may create an
							external employee, even where creating an employee is allowed. -->
						<revoke
							operation="Create"
							roles="TestTLScriptSecurity.ProjectResponsible"
						/>
					</class>
					<class name="TestTLScriptSecurity:UnsecuredData"
						without-security="true"
					>
						<!-- No grant at all: access is nevertheless allowed for everybody (type
							without security), also for objects of the specialization
							UnsecuredDataSub. -->
					</class>
					<part name="TestTLScriptSecurity:Project#secret">
						<!-- Present grant with no roles: reading and writing this attribute is denied
							for every role (only a bypassing super-user is unaffected). -->
						<grant operation="Read"/>
						<grant operation="Write"/>
					</part>
					<class name="TestTLScriptSecurity:PathC">
						<!-- The reader of a C reads it completely. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
					</class>
					<class name="TestTLScriptSecurity:PathNote">
						<!-- A note writer may create notes in a B (Create implies Discover on the container B). -->
						<grant
							operation="Create"
							roles="TestTLScriptSecurity.NoteWriter"
						/>
					</class>
					<!-- The path role reads only the structure attributes; by R2 that implies Discover. -->
					<part name="TestTLScriptSecurity:PathRoot#as">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
					<part name="TestTLScriptSecurity:PathA#bs">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
					<!-- The path writer may set the enumeration attributes of a B. -->
					<part name="TestTLScriptSecurity:PathB#priority">
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</part>
					<part name="TestTLScriptSecurity:PathB#tags">
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</part>
					<part name="TestTLScriptSecurity:PathB#cs">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
						<!-- The path writer may replace the cs of a B. -->
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</part>
					<class name="TestTLScriptSecurity:PathHome">
						<!-- By the class rights alone, whoever discovers a home may read it. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
					</class>
					<singleton name="TestTLScriptSecurity#HOME">
						<!-- Whoever may write the home may review it. -->
						<operations>
							<operation name="Review"
								implied-by="Write"
							/>
						</operations>
						<!-- The singleton additionally grants Write without Read. -->
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathReader"
						/>
						<grant
							operation="Write"
							roles="TestTLScriptSecurity.PathWriter"
						/>
					</singleton>
					<singleton name="TestTLScriptSecurity#OFFICE">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.ProjectReader"
						/>
					</singleton>
					<part name="TestTLScriptSecurity:PathOffice#title">
						<grant
							operation="Read"
							roles="TestTLScriptSecurity.PathViewer"
						/>
					</part>
				</security-config>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule
							id="740b6ea4-adac-41e3-b5f8-53a75906c356"
							meta-element="TestTLScriptSecurity:Project"
							role="TestTLScriptSecurity.ProjectResponsible"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Project#responsible"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="f8459b10-d13b-406a-9d7b-7550d5eb0dd8"
							meta-element="TestTLScriptSecurity:Project"
							role="TestTLScriptSecurity.ProjectReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Project#members"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c01"
							meta-element="TestTLScriptSecurity:PathC"
							role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathC#readers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c02"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.NoteWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#writers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c06"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.PathWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#editors"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c07"
							meta-element="TestTLScriptSecurity:PathHome"
							role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathHome#readers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c08"
							meta-element="TestTLScriptSecurity:PathHome"
							role="TestTLScriptSecurity.PathWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathHome#editors"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c09"
							meta-element="TestTLScriptSecurity:PathOffice"
							role="TestTLScriptSecurity.PathViewer"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathOffice#viewers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c0a"
							meta-element="TestTLScriptSecurity:PathOffice"
							role="TestTLScriptSecurity.NoteWriter"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathOffice#writers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="5b7d3c9e-2a41-4d6f-8e0b-7c1a9f3d2e55"
							meta-element="TestTLScriptSecurity:Proposal"
							role="TestTLScriptSecurity.ProposalApprover"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Proposal#approvers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<rule
							id="5b7d3c9e-2a41-4d6f-8e0b-7c1a9f3d2e56"
							meta-element="TestTLScriptSecurity:Proposal"
							role="TestTLScriptSecurity.ProposalReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:Proposal#readers"/>
								<step attribute="TestTLScriptSecurity:Employee#account"/>
							</path>
						</rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c03"
							meta-element="TestTLScriptSecurity:PathB"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c04"
							meta-element="TestTLScriptSecurity:PathA"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathA#bs"/>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
						<inheritance-rule
							id="3c1f5e0a-9a77-4f0e-9a51-1b7e6a2d4c05"
							meta-element="TestTLScriptSecurity:PathRoot"
							role="TestTLScriptSecurity.PathViewer"
							source-role="TestTLScriptSecurity.PathReader"
						>
							<path>
								<step attribute="TestTLScriptSecurity:PathRoot#as"/>
								<step attribute="TestTLScriptSecurity:PathA#bs"/>
								<step attribute="TestTLScriptSecurity:PathB#cs"/>
							</path>
						</inheritance-rule>
					</rules>
				</role-rules>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/TestTLScriptSecurityMeta.xml"/>
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
