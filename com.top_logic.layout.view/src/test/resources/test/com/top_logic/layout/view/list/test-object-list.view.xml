<?xml version="1.0" encoding="utf-8" ?>
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
  <channels>
    <channel name="catalogue"/>
    <channel name="season"/>
  </channels>

  <object-list
    inputs="catalogue, season"
    items="catalogue -&gt; season -&gt; [$catalogue, $season]"
    layout="grid"
    max-columns="3"
    min-column-width="18rem"
  >
    <item>
      <text input="element"/>
    </item>
  </object-list>
</view>
