<?xml version="1.0" encoding="utf-8" ?>

<!--
	Secrets of the installation: every secret the configurations of the running services refer to
	(SecretReferences), and whether it is available - never the secret itself.
	- The secrets channel holds the snapshot the table displays: the list of references, each
	checked once when the list was read (secretReferences). While the channel is empty, the table
	reads a snapshot of its own; Refresh writes a new one, e.g. after a variable was defined or the
	secret storage service was reconfigured.
	- The table is grouped by the service holding the secret, the group headers showing the service
	in the first column. Per row: the path of the secret property in the service configuration
	(wide enough for nested paths such as the options of a connection pool), the kind of source,
	how the source identifies the secret (a secret name, a variable, a file, a vault secret; a
	secret kept in the configuration as such), what delivers a secret given by its name
	(an override of the secret storage service, or its store), the status and, for a secret that is
	not available, the reason. Missing secrets are tinted as warning, unreadable ones as error. The
	filter bar searches the displayed columns.
	- "Set secret" and "Remove secret" act on the row selected in the table (selection channel). Both
	are disabled unless the selected reference gives its secret by name and the secret storage
	service can store a secret of this name (secretStorable): no override configured for it, a
	writable store, and no store in front of it holding the name. "Remove secret" additionally needs
	the writable store to hold the secret (secretRemovable). "Set secret" opens the dialog
	set-secret.view.xml with the reference and the secrets and selection channels bound into it; the
	dialog writes the secret (secretStore) and a new snapshot. "Remove secret" asks for
	confirmation, removes the secret (secretRemove) and writes a new snapshot to the secrets channel.
	A snapshot consists of new references, which the table does not take for the selected one; so
	after writing it, both commands select the reference of the new snapshot with the service and
	property path of the selected one. A failure of the secret storage is reported as error of the
	command.
	- "Encrypt value" and "Decrypt value" open the dialogs encrypt-value.view.xml and
	decrypt-value.view.xml, which convert a value from and to a form a configuration accepts
	encrypted (secretEncrypt, secretDecrypt).
	- A titled <panel> is used (not the chrome-less <full-page>) because the view carries toolbar
	commands.
-->
<view>
	<channels>
		<channel name="secrets"/>
		<channel name="selection"/>
	</channels>
	<panel id="panel"
		fill="true"
	>
		<title>
			<en>Secrets</en>
			<de>Geheimnisse</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-arrow-clockwise"
				placement="TOOLBAR"
			>
				<label>
					<en>Refresh</en>
					<de>Aktualisieren</de>
				</label>
				<tooltip>
					<en>Checks the secrets again, e.g. after a secret was provided or the secret storage was reconfigured.</en>
					<de>Prüft die Geheimnisse erneut, z. B. nachdem ein Geheimnis bereitgestellt oder die Geheimnisablage umkonfiguriert wurde.</de>
				</tooltip>
				<execute-script function="secretReferences()">
					<with-result>
						<write-channel name="secrets"/>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-key"
				inputs="selection as reference"
				placement="TOOLBAR"
			>
				<label>
					<en>Set secret</en>
					<de>Geheimnis setzen</de>
				</label>
				<tooltip>
					<en>Writes the secret of the selected reference to the writable secret storage of the installation.</en>
					<de>Schreibt das Geheimnis des ausgewählten Verweises in die beschreibbare Geheimnisablage der Installation.</de>
				</tooltip>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="if(secretStorable($reference), null, #('The secret is not given by its name, an override is configured for it, the installation has no writable secret storage, or a store in front of it holds the name.'@en, 'Das Geheimnis ist nicht über seinen Namen angegeben, für es ist eine Überschreibung konfiguriert, die Installation hat keine beschreibbare Geheimnisablage, oder eine vorgeschaltete Ablage enthält den Namen.'@de))"/>
				</executability>
				<open-dialog
					bind-input-to="reference"
					dialog-view="admin/system/set-secret.view.xml"
				>
					<bind
						channel="secrets"
						to="secrets"
					/>
					<bind
						channel="selection"
						to="selection"
					/>
				</open-dialog>
			</generic-command>
			<generic-command
				clique="delete"
				image="css:bi bi-trash"
				inputs="selection as reference"
				placement="TOOLBAR"
			>
				<label>
					<en>Remove secret</en>
					<de>Geheimnis entfernen</de>
				</label>
				<tooltip>
					<en>Removes the secret of the selected reference from the writable secret storage of the installation.</en>
					<de>Entfernt das Geheimnis des ausgewählten Verweises aus der beschreibbaren Geheimnisablage der Installation.</de>
				</tooltip>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="if(secretStorable($reference), if(secretRemovable($reference), null, #('The writable secret storage does not hold the secret.'@en, 'Die beschreibbare Geheimnisablage enthält das Geheimnis nicht.'@de)), #('The secret is not given by its name, an override is configured for it, the installation has no writable secret storage, or a store in front of it holds the name.'@en, 'Das Geheimnis ist nicht über seinen Namen angegeben, für es ist eine Überschreibung konfiguriert, die Installation hat keine beschreibbare Geheimnisablage, oder eine vorgeschaltete Ablage enthält den Namen.'@de))"/>
				</executability>
				<confirm expr="#('Remove the secret {0} from the secret storage?'@en, 'Das Geheimnis {0} aus der Geheimnisablage entfernen?'@de).fill(secretReference($reference))"/>
				<execute-script function="secretRemove($reference)"/>
				<execute-script function="secretReferences()">
					<with-result as="snapshot">
						<write-channel name="secrets"/>
						<execute-script function="$snapshot.filter(r -> secretService($r) == secretService($reference) and secretPath($r) == secretPath($reference)).firstElement()">
							<with-result>
								<write-channel name="selection"/>
							</with-result>
						</execute-script>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-lock"
				placement="TOOLBAR"
			>
				<label>
					<en>Encrypt value</en>
					<de>Wert verschlüsseln</de>
				</label>
				<tooltip>
					<en>Encrypts a value, e.g. a password, in a form a configuration accepts.</en>
					<de>Verschlüsselt einen Wert, z. B. ein Passwort, in einer Form, die eine Konfiguration akzeptiert.</de>
				</tooltip>
				<open-dialog dialog-view="admin/system/encrypt-value.view.xml"/>
			</generic-command>
			<generic-command
				image="css:bi bi-unlock"
				placement="TOOLBAR"
			>
				<label>
					<en>Decrypt value</en>
					<de>Wert entschlüsseln</de>
				</label>
				<tooltip>
					<en>Decrypts a value written encrypted into a configuration.</en>
					<de>Entschlüsselt einen verschlüsselt in eine Konfiguration eingetragenen Wert.</de>
				</tooltip>
				<open-dialog dialog-view="admin/system/decrypt-value.view.xml"/>
			</generic-command>
		</commands>
		<table id="table"
			filter-bar="true"
			group-by="service"
			inputs="secrets"
			personalization-key="admin-secrets"
			selection="selection"
		>
			<columns>
				<computed-column name="path"
					type="tl.core:String"
					width="480"
				>
					<label>
						<en>Property</en>
						<de>Eigenschaft</de>
					</label>
					<value>secretPath($row)</value>
				</computed-column>
				<computed-column name="service"
					type="tl.core:String"
					visible="false"
				>
					<label>
						<en>Service</en>
						<de>Dienst</de>
					</label>
					<value>secretService($row)</value>
				</computed-column>
				<computed-column name="kind"
					type="tl.core:String"
				>
					<label>
						<en>Source</en>
						<de>Quelle</de>
					</label>
					<value>secretKind($row)</value>
				</computed-column>
				<computed-column name="reference"
					type="tl.core:String"
				>
					<label>
						<en>Reference</en>
						<de>Verweis</de>
					</label>
					<value>secretReference($row)</value>
				</computed-column>
				<computed-column name="resolvedBy"
					type="tl.core:String"
				>
					<label>
						<en>Resolved by</en>
						<de>Aufgelöst durch</de>
					</label>
					<value>secretResolvedBy($row)</value>
				</computed-column>
				<computed-column name="status"
					type="tl.core:String"
				>
					<label>
						<en>Status</en>
						<de>Status</de>
					</label>
					<value>secretStatus($row)</value>
				</computed-column>
				<computed-column name="message"
					type="tl.core:String"
				>
					<label>
						<en>Message</en>
						<de>Meldung</de>
					</label>
					<value>secretMessage($row)</value>
				</computed-column>
			</columns>
			<rows>$secrets == null ? secretReferences() : $secrets</rows>
			<row-class>secretAvailable($row) ? null : (secretMissing($row) ? 'tl-status-warning' : 'tl-status-error')</row-class>
		</table>
	</panel>
</view>