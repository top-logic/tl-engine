<?xml version="1.0" encoding="utf-8" ?>

<!--
	Displays a freshly issued access token. The token is held by a transient IssuedAccessToken that
	the issue action hands over; it is shown in an editable field so that it can be selected and
	copied, which a plain text rendering does not allow. This dialog is the one and only place the
	token is readable - it is stored as a hash and cannot be recovered.
-->
<view>
	<channels>
		<channel name="model"/>
	</channels>
	<window width="560px">
		<title>
			<en>Access token issued</en>
			<de>Zugriffstoken ausgestellt</de>
		</title>
		<inset>
			<form
				initial-edit-mode="true"
				input="model"
				mode-switch="false"
			>
				<field attribute="secret"/>
				<text>
					<label>
						<en>Copy the token now: it is shown this one time and cannot be read again.</en>
						<de>Kopieren Sie das Token jetzt: Es wird nur dieses eine Mal angezeigt und ist danach nicht mehr lesbar.</de>
					</label>
				</text>
			</form>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-check-lg"
				>
					<label>
						<en>Done</en>
						<de>Fertig</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>