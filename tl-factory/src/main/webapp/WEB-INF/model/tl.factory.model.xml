<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.factory">
		<types>
			<!--
				The state of a workspace: the states of its container, the operations running on it,
				and the error that ended an operation. Mirrors com.top_logic.factory.project.WorkspaceStatus.
			-->
			<enum name="WorkspaceStatus">
				<classifier name="CREATED"/>
				<classifier name="BUILDING"/>
				<classifier name="STARTING"/>
				<classifier name="RUNNING"/>
				<classifier name="APP_STOPPED"/>
				<classifier name="STOPPING"/>
				<classifier name="STOPPED"/>
				<classifier name="REMOVING"/>
				<classifier name="UPDATING"/>
				<classifier name="ERROR"/>
				<classifier name="UNKNOWN"/>
			</enum>

			<!-- A TopLogic application managed by the control application. -->
			<class name="Project">
				<annotations>
					<main-properties properties="name,groupId,artifactId,engineVersion,workspace"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="groupId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> 'com.example'"/>
							</default-value>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckGroupId($value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<property name="artifactId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckArtifactId($value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<property name="engineVersion"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<default-value>
								<default-by-expression value="ctx -> factoryEngineVersion()"/>
							</default-value>
						</annotations>
					</property>
					<!--
						The repository of the project on the git hosting service, its full name
						owner/name. The workspace pushes to it through the git route of the workspace
						proxy. When the project is created, an existing repository may be entered,
						also as clone URL; empty, the first workspace creates one. The first workspace
						records the repository under its full name. Editable only on the draft of a
						new project, read-only once the project is stored.
					-->
					<property name="repository"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="editable"/>
							<visibility value="read-only"/>
							<constraints>
								<constraint-by-expression>
									<check>value -&gt; object -&gt; factoryCheckRepository($object, $value)</check>
								</constraint-by-expression>
							</constraints>
						</annotations>
					</property>
					<!-- The page of the repository in the web interface of the git hosting service. -->
					<property name="repositoryUrl"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The job of the project on the CI server, which builds the default branch of its
						repository; set by the control application when it sets up the job.
					-->
					<property name="ciJob"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The page of the CI job in the web interface of the CI server. -->
					<property name="ciJobUrl"
						type="tl.core:String"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<reference name="workspace"
						composite="true"
						kind="forwards"
						type="Workspace"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!-- The container the application of a project is built and run in. -->
			<class name="Workspace">
				<annotations>
					<id-column value="workspaceId"/>
					<main-properties properties="workspaceId,status,previewUrl"/>
				</annotations>
				<attributes>
					<property name="workspaceId"
						mandatory="true"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<reference name="status"
						mandatory="true"
						type="WorkspaceStatus"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</reference>
					<property name="hostPort"
						type="tl.core:Integer"
					>
						<annotations>
							<!-- A port, displayed without grouping separator. -->
							<format>
								<decimal pattern="0"/>
							</format>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<property name="previewUrl"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The initial password of the account root of the application of a development
						workspace. It is no longer valid once the password is changed in the application.
					-->
					<property name="initialPassword"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!--
						The image the container of the workspace was created from. A workspace without
						image or with another one than the current workspace image is outdated.
					-->
					<property name="image"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<property name="log"
						type="tl.core:Text"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The conversations with the coding agent working in the workspace. -->
					<reference name="conversations"
						composite="true"
						inverse-reference="workspace"
						kind="forwards"
						multiple="true"
						navigate="true"
						ordered="true"
						type="AgentConversation"
					>
						<annotations>
							<create-visibility value="hidden"/>
							<visibility value="read-only"/>
						</annotations>
					</reference>
				</attributes>
			</class>

			<!--
				A conversation with the coding agent of a workspace: the subject of the chat that talks
				to the agent, started with a task given to the agent. The agent keeps the conversation
				itself; a new process of it continues the conversation stored under the session ID.
			-->
			<class name="AgentConversation">
				<annotations>
					<main-properties properties="createdAt,task,sessionId"/>
				</annotations>
				<attributes>
					<reference name="workspace"
						aggregate="true"
						inverse-reference="conversations"
						kind="backwards"
						navigate="true"
						type="Workspace"
					/>
					<property name="createdAt"
						type="tl.core:DateTime"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
					<!-- The task the conversation was started with, its first message to the agent. -->
					<property name="task"
						mandatory="true"
						type="tl.core:Text"
					>
						<annotations>
							<multi-line/>
						</annotations>
					</property>
					<!--
						The ID under which the agent keeps the conversation, empty before its first
						answer.
					-->
					<property name="sessionId"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="read-only"/>
						</annotations>
					</property>
				</attributes>
			</class>
		</types>
	</module>
</model>