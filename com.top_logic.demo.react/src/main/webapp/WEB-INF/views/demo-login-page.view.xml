<?xml version="1.0" encoding="utf-8" ?>

<!--
	What a session that belongs to no account sees in place of the application: the framework's
	login page, and below it a link to the page such a visitor may browse without logging in.
	
	The link is absolute below the context path, so it holds wherever the application is deployed.
-->
<view>
	<channels>
		<derived-channel name="browseLink">
			<expr><![CDATA[{{{<a href="{contextPath() + '/view/browse.view.xml'}">{#('Browse anonymously'@en, 'Anonym stöbern'@de)}</a>}}}]]></expr>
		</derived-channel>
	</channels>
	<stack
		align="center"
		direction="column"
		gap="default"
	>
		<view-ref view="login-page.view.xml"/>
		<html input="browseLink"/>
	</stack>
</view>