<?xml version="1.0" encoding="utf-8" ?>

<!--
	Model editor (admin hub, Model section). A master/detail editor over the application model:
	the module type tree (left) lists the modules with their classes and enumerations; the class
	diagram (center) shows the module of the selected element and selects the module's types and
	their attributes (references between the module's types as edges, references to types of other
	modules as attribute lines). Tree and diagram share one selection, selectedPart: a type chosen in
	the tree is highlighted in the diagram, a type clicked in the diagram is chosen in the tree, and a
	click on the free area of the diagram selects the module. The module shown is derived from the
	selection (selectedModule). The detail form (bottom) edits the selected model element. The
	toolbars create and delete modules, types and attributes, and the class form adds and removes
	generalizations, through the ModelEditAction. The context menu of the diagram offers the same
	commands on the element right-clicked, and Del deletes the selected node or edge (a reference, or
	a generalization, which the diagram represents by a transient tl.devtools:Generalization). A type
	of another module dragged out of the tree onto the diagram is drawn there as an external node
	(externalTypes), linked to the module's types by their generalizations and references; selecting
	it keeps the diagram at its module, "Hide" in its context menu removes it again, a change of the
	module shown drops it, and it cannot be deleted there. The diagram observes the model types it draws, so
	it follows every model change, also one made in another session. Beside the diagram, the Instances tab lists all instances of
	the class selected in the diagram, edits them in place, exports them to Excel or XML and imports an
	XML file written by that export (admin/model/import-instances.view.xml).
-->
<view>
	<channels>
		<channel name="selectedPart"/>
		<!--
			The types of other modules dragged out of the tree onto the diagram, together with the module
			the diagram showed then: {'module': <module>, 'types': [<types>]}. The diagram draws them as
			external nodes while it shows that module. A change of the module shown empties the channel;
			selecting one of the external types keeps the module and therefore the external types.
		-->
		<channel name="externalTypes"
			init="null"
			inputs="selectedModule"
		/>
		<!--
			The module the diagram shows: the module the external types were dropped on while one of
			them is selected, otherwise the selected module itself, the module of a selected type, or
			the module of the owner of a selected attribute, reference or classifier, or of the
			specialization of a selected generalization.
		-->
		<derived-channel name="selectedModule"
			expr="$externalTypes != null &amp;&amp; $externalTypes['types'].containsElement($selectedPart) ? $externalTypes['module'] : ($selectedPart == null ? null : ($selectedPart.instanceOf(`tl.model:TLModule`) ? $selectedPart : ($selectedPart.instanceOf(`tl.model:TLType`) ? $selectedPart.get(`tl.model:TLType#module`) : ($selectedPart.instanceOf(`tl.model:TLStructuredTypePart`) ? $selectedPart.get(`tl.model:TLStructuredTypePart#owner`).get(`tl.model:TLType#module`) : ($selectedPart.instanceOf(`tl.model:TLClassifier`) ? $selectedPart.get(`tl.model:TLClassifier#owner`).get(`tl.model:TLType#module`) : ($selectedPart.instanceOf(`tl.devtools:Generalization`) ? $selectedPart.get(`tl.devtools:Generalization#specialization`).get(`tl.model:TLType#module`) : null))))))"
			inputs="selectedPart, externalTypes"
		/>
		<!--
			The module the diagram shows and the external types it draws there, in the form of
			externalTypes; no types while the external types were dropped on another module.
		-->
		<derived-channel name="diagramTypes"
			expr="{'module': $selectedModule, 'types': ($externalTypes != null &amp;&amp; $selectedModule != null &amp;&amp; $externalTypes['module'] == $selectedModule ? $externalTypes['types'] : list())}"
			inputs="selectedModule, externalTypes"
		/>
		<channel name="selectedInstances"/>
		<!-- Bumped after an import, so the instance table reads its rows again. -->
		<channel name="instancesReload"/>
		<!--
			The selected instances that belong to the selected class. The instance table is built anew
			for every class, but leaves a selection it has no rows for alone, so the selection made for
			another class is not exported.
		-->
		<derived-channel name="exportedInstances"
			expr="$selectedPart == null || !$selectedPart.instanceOf(`tl.model:TLClass`) ? null : { sel = $selectedInstances.filter(o -> $o.instanceOf($selectedPart)); $sel.isEmpty() ? null : $sel }"
			inputs="selectedPart, selectedInstances"
		/>
		<!--
			The association end implementing the selected reference. A reference reads its cardinality
			from its end, so the cardinality of a reference is edited there.
		-->
		<derived-channel name="selectedEnd"
			expr="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLReference`) ? $selectedPart.get(`tl.model:TLReference#end`) : null"
			inputs="selectedPart"
		/>
		<!--
			Kind and opposite of the selected reference, for display only: they are fixed when the
			reference is created. A composition is marked at the destination end of the reference, an
			aggregation at the end pointing to the owner.
		-->
		<derived-channel name="selectedReferenceDetails"
			expr="$selectedPart == null || !$selectedPart.instanceOf(`tl.model:TLReference`) ? null : { details = new(`tl.devtools:ReferenceDetails`, transient: true); kind = $selectedPart.get(`tl.model:TLReference#end`).get(`tl.model:TLAssociationEnd#composite`) ? `tl.devtools:ReferenceKind#composition` : ($selectedPart.get(`tl.model:TLReference#oppositeEnd`).get(`tl.model:TLAssociationEnd#aggregate`) ? `tl.devtools:ReferenceKind#aggregation` : `tl.devtools:ReferenceKind#normal`); $details.set(`tl.devtools:ReferenceDetails#referenceKind`, $kind); $details.set(`tl.devtools:ReferenceDetails#opposite`, $selectedPart.get(`tl.model:TLReference#opposite`)); $details }"
			inputs="selectedPart"
		/>
		<!-- The generalization selected in the generalization table of the class form. -->
		<channel name="selectedGeneralization"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				size="25"
				unit="%"
			>
				<panel fill="true">
					<title>
						<en>Model</en>
						<de>Modell</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-plus-lg"
							placement="TOOLBAR"
						>
							<label>
								<en>New module</en>
								<de>Neues Modul</de>
							</label>
							<execute-script function="new(`tl.devtools:NewModule`, transient: true)">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="admin/model/create-module.view.xml"
									>
										<bind
											channel="selection"
											to="selectedPart"
										/>
									</open-dialog>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-trash"
							inputs="selectedPart"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete module</en>
								<de>Modul löschen</de>
							</label>
							<executability>
								<disabled-if expr="if($selectedPart == null || !$selectedPart.instanceOf(`tl.model:TLModule`), #('Select a module.'@en, 'Wählen Sie ein Modul.'@de))"/>
							</executability>
							<confirm expr="#('Delete the selected module and all its contents?'@en, 'Das ausgewählte Modul und seinen gesamten Inhalt löschen?'@de)"/>
							<with-transaction>
								<action class="com.top_logic.dev.tools.model.ModelEditAction"
									mode="DELETE"
								/>
							</with-transaction>
							<write-channel name="selectedPart"
								clear="true"
							/>
						</generic-command>
					</commands>
					<!--
						The model is the invisible root, its children are the modules, and the children of a
						module are its classes and enumerations - the types the diagram draws, those with the
						module as scope -, each level sorted by name, ignoring case. The parents lead from a type to its module
						and from a module to the model, so that a type selected in the diagram is found in the
						tree. Modules and types are dragged as "modelType"; the diagram takes a type of another
						module.
					-->
					<tree-table
						children="$node.instanceOf(`tl.model:TLModel`) ? $node.get(`tl.model:TLModel#modules`).sort(comparator(x -> $x.get(`tl.model:TLNamedPart#name`).toLowerCase())) : ($node.instanceOf(`tl.model:TLModule`) ? $node.get(`tl.model:TLModule#types`).filter(t -> $t.get(`tl.model:TLType#scope`) == $node &amp;&amp; ($t.instanceOf(`tl.model:TLClass`) || $t.instanceOf(`tl.model:TLEnumeration`))).sort(comparator(x -> $x.get(`tl.model:TLNamedPart#name`).toLowerCase())) : list())"
						initial-expansion-depth="0"
						observed-types="tl.model:TLModule, tl.model:TLClass, tl.model:TLEnumeration"
						parents="$node.instanceOf(`tl.model:TLType`) ? $node.get(`tl.model:TLType#module`) : ($node.instanceOf(`tl.model:TLModule`) ? $node.get(`tl.model:TLModule#model`) : null)"
						root="all(`tl.model:TLModel`).firstElement()"
						selection="selectedPart"
						types="tl.model:TLNamedPart"
					>
						<drag kind="modelType"/>
						<columns>
							<column attribute="name"/>
						</columns>
					</tree-table>
				</panel>
			</pane>
			<pane
				size="75"
				unit="%"
			>
				<split-panel
					orientation="vertical"
					resizable="true"
				>
					<panes>
						<pane
							size="70"
							unit="%"
						>
							<tab-bar active-tab="diagram">
								<tabs>
									<tab id="diagram"
										icon="css:bi bi-diagram-3"
									>
										<label>
											<en>Diagram</en>
											<de>Diagramm</de>
										</label>
										<panel fill="true">
											<title>
												<en>Types</en>
												<de>Typen</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-plus-lg"
													inputs="selectedModule"
													placement="TOOLBAR"
												>
													<label>
														<en>New type</en>
														<de>Neuer Typ</de>
													</label>
													<executability>
														<null-input-disabled/>
													</executability>
													<execute-script function="new(`tl.devtools:NewType`, transient: true)">
														<with-result>
															<open-dialog
																bind-input-to="model"
																dialog-view="admin/model/create-type.view.xml"
															>
																<bind
																	channel="selection"
																	to="selectedPart"
																/>
																<bind
																	channel="container"
																	to="selectedModule"
																/>
															</open-dialog>
														</with-result>
													</execute-script>
												</generic-command>
												<generic-command
													image="css:bi bi-node-plus"
													inputs="selectedPart"
													placement="TOOLBAR"
												>
													<label>
														<en>New attribute</en>
														<de>Neues Attribut</de>
													</label>
													<executability>
														<visible-if expr="$selectedPart != null &amp;&amp; ($selectedPart.instanceOf(`tl.model:TLClass`) || $selectedPart.instanceOf(`tl.model:TLStructuredTypePart`))"/>
													</executability>
													<execute-script function="new(`tl.devtools:NewAttribute`, transient: true)">
														<with-result>
															<open-dialog
																bind-input-to="model"
																dialog-view="admin/model/create-attribute.view.xml"
															>
																<bind
																	channel="selection"
																	to="selectedPart"
																/>
																<bind
																	channel="container"
																	to="selectedPart"
																/>
															</open-dialog>
														</with-result>
													</execute-script>
												</generic-command>
												<generic-command
													image="css:bi bi-tag"
													inputs="selectedPart"
													placement="TOOLBAR"
												>
													<label>
														<en>New classifier</en>
														<de>Neuer Klassifikator</de>
													</label>
													<executability>
														<visible-if expr="$selectedPart != null &amp;&amp; ($selectedPart.instanceOf(`tl.model:TLEnumeration`) || $selectedPart.instanceOf(`tl.model:TLClassifier`))"/>
													</executability>
													<execute-script function="new(`tl.devtools:NewClassifier`, transient: true)">
														<with-result>
															<open-dialog
																bind-input-to="model"
																dialog-view="admin/model/create-classifier.view.xml"
															>
																<bind
																	channel="selection"
																	to="selectedPart"
																/>
																<bind
																	channel="container"
																	to="selectedPart"
																/>
															</open-dialog>
														</with-result>
													</execute-script>
												</generic-command>
												<!--
													Del deletes the element selected in the diagram, a node or an edge, and selects what the
													deleted element belonged to: the module of a type, the type of an attribute, the
													enumeration of a classifier, the specialization of a generalization. A type of
													another module, drawn as external node, is not deleted here.
												-->
												<generic-command key="Delete"
													clique="more"
													image="css:bi bi-trash"
													inputs="selectedPart, selectedModule"
													placement="TOOLBAR"
												>
													<label>
														<en>Delete</en>
														<de>Löschen</de>
													</label>
													<executability>
														<null-input-disabled/>
														<disabled-if expr="if($selectedPart.instanceOf(`tl.model:TLModule`), #('A module is deleted with &quot;Delete module&quot; in the model tree.'@en, 'Ein Modul wird mit &quot;Modul löschen&quot; im Modellbaum gelöscht.'@de), if($selectedPart.instanceOf(`tl.model:TLType`) &amp;&amp; $selectedPart.get(`tl.model:TLType#module`) != $selectedModule, #('A type of another module is not deleted here. Select it in the model tree to show and delete it in its own module.'@en, 'Ein Typ eines anderen Moduls wird hier nicht gelöscht. Wählen Sie ihn im Modellbaum, um ihn in seinem eigenen Modul zu zeigen und zu löschen.'@de)))"/>
													</executability>
													<confirm expr="#('Delete the selected model element?'@en, 'Das ausgewählte Modellelement löschen?'@de)"/>
													<with-transaction>
														<action class="com.top_logic.dev.tools.model.ModelEditAction"
															mode="DELETE"
														/>
													</with-transaction>
													<write-channel name="selectedPart"/>
												</generic-command>
											</commands>
											<!--
												The diagram observes the model types it draws: a type, attribute,
												classifier or generalization created, changed or deleted - in this
												session or another one - redraws it. A generalization is a link
												between two classes, whose change is announced as a change of both.
												A type of another module dropped from the tree is drawn as an external
												node while the diagram shows the module it was dropped on: a box with
												a dashed grey border, the name of its module and its own name. The
												generalizations and references between the drawn types are edges in
												both directions, those to types not drawn are left out.
											-->
											<context-menu input="selectedPart">
												<flow-diagram
													empty-area-selection="$module"
													observed-types="tl.model:TLModule, tl.model:TLClass, tl.model:TLEnumeration, tl.model:TLClassifier, tl.model:TLReference, tl.model:TLAssociationEnd, tl.model:TLProperty"
													selection="selectedPart"
												>
													<inputs>
														<input
															as="module"
															channel="selectedModule"
														/>
														<input
															as="external"
															channel="externalTypes"
														/>
													</inputs>
													<createChart><![CDATA[{
	allTypes = $module == null ? list() : $module.get(`tl.model:TLModule#types`)
		.filter(t -> $t.get(`tl.model:TLType#scope`).instanceOf(`tl.model:TLModule`));
	classes = $allTypes.filter(t -> $t.instanceOf(`tl.model:TLClass`));
	enums = $allTypes.filter(t -> $t.instanceOf(`tl.model:TLEnumeration`));
	dropped = $module == null || $external == null || $external["module"] != $module
		? list()
		: $external["types"];
	droppedClasses = $dropped.filter(t -> $t.instanceOf(`tl.model:TLClass`));
	shown = list($classes, $enums, $dropped).flatten().indexBy(t -> $t);

	classNodes = $classes.map(c -> {
		props = $c.get(`tl.model:TLStructuredType#localParts`)
			.filter(p -> $p.instanceOf(`tl.model:TLProperty`)
				|| $p.instanceOf(`tl.model:TLReference`) && $shown[$p.get(`tl.model:TLStructuredTypePart#type`)] == null);
		allGens = $c.get(`tl.model:TLClass#generalizations`);
		externalGens = $allGens
			.filter(g -> $shown[$g] == null)
			.map(g -> $g.get(`tl.model:TLType#module`).get(`tl.model:TLNamedPart#name`)
				+ ":" + $g.get(`tl.model:TLNamedPart#name`));

		reactFlowSelection(userObject: $c,
			content: reactFlowBorder(cssClass: "tlSelectionStroke",
				content: reactFlowFill(fill: "white", cssClass: "tlSelectionFill",
					content: reactFlowVertical(gap: 0, contents: [
						reactFlowPadding(all: 6, content: reactFlowAlign(hAlign: "middle",
							content: reactFlowVertical(gap: 2, contents: [
								$c.get(`tl.model:TLClass#abstract`)
									? reactFlowText("«abstract»", fontSize: 10, fillStyle: "#888")
									: reactFlowEmpty(),
								reactFlowText($c.get(`tl.model:TLNamedPart#name`), fontWeight: "bold"),
								$externalGens.isEmpty() ? reactFlowEmpty()
									: reactFlowText("extends " + $externalGens.toString(), fontSize: 9, fillStyle: "#888")
							])
						)),
						$props.isEmpty() ? reactFlowEmpty()
							: reactFlowBorder(top: true, left: false, right: false, bottom: false,
								content: reactFlowPadding(all: 6,
									content: reactFlowVertical(gap: 0, contents: $props.map(a ->
										reactFlowSelection(userObject: $a,
											content: reactFlowFill(fill: "transparent", cssClass: "tlSelectionFill",
												content: reactFlowPadding(top: 1, bottom: 1,
													content: reactFlowText(
														($a.get(`tl.model:DerivedTLTypePart#derived`) ? "/" : "")
															+ $a.get(`tl.model:TLNamedPart#name`)
															+ " : "
															+ $a.get(`tl.model:TLStructuredTypePart#type`).get(`tl.model:TLNamedPart#name`),
														fontSize: 11,
														fillStyle: $a.get(`tl.model:DerivedTLTypePart#derived`) ? "#888" : "black"))))))))
					]))))
	});

	enumNodes = $enums.map(e -> {
		classifiers = $e.get(`tl.model:TLEnumeration#classifiers`);

		reactFlowSelection(userObject: $e,
			content: reactFlowBorder(cssClass: "tlSelectionStroke",
				content: reactFlowFill(fill: "#FFFFF0", cssClass: "tlSelectionFill",
					content: reactFlowVertical(gap: 0, contents: [
						reactFlowPadding(all: 6, content: reactFlowAlign(hAlign: "middle",
							content: reactFlowVertical(gap: 2, contents: [
								reactFlowText("«enumeration»", fontSize: 10, fillStyle: "#888"),
								reactFlowText($e.get(`tl.model:TLNamedPart#name`), fontWeight: "bold")
							])
						)),
						$classifiers.isEmpty() ? reactFlowEmpty()
							: reactFlowBorder(top: true, left: false, right: false, bottom: false,
								content: reactFlowPadding(all: 6,
									content: reactFlowVertical(gap: 0, contents: $classifiers.map(cl ->
										reactFlowSelection(userObject: $cl,
											content: reactFlowFill(fill: "transparent", cssClass: "tlSelectionFill",
												content: reactFlowPadding(top: 1, bottom: 1,
													content: reactFlowText($cl.get(`tl.model:TLNamedPart#name`), fontSize: 11))))))))
					]))))
	});

	externalNodes = $dropped.map(t ->
		reactFlowSelection(userObject: $t,
			content: reactFlowBorder(stroke: "#999", dashes: [4, 3], cssClass: "tlSelectionStroke",
				content: reactFlowFill(fill: "white", cssClass: "tlSelectionFill",
					content: reactFlowPadding(all: 6, content: reactFlowAlign(hAlign: "middle",
						content: reactFlowVertical(gap: 2, contents: [
							reactFlowText("«" + $t.get(`tl.model:TLType#module`).get(`tl.model:TLNamedPart#name`) + "»",
								fontSize: 10, fillStyle: "#888"),
							reactFlowText($t.get(`tl.model:TLNamedPart#name`), fontWeight: "bold")
						])))))));

	nodes = list($classNodes, $enumNodes, $externalNodes).flatten();
	nodeByType = $nodes.indexBy(n -> $n["userObject"]);
	edgeSources = list($classes, $droppedClasses).flatten();

	genEdges = $edgeSources
		.map(c -> $c.get(`tl.model:TLClass#generalizations`)
			.filter(g -> $nodeByType[$g] != null)
			.map(g -> reactFlowGraphEdge(
				$nodeByType[$g],
				$nodeByType[$c],
				priority: 3, sourceSymbol: "CLOSED_ARROW",
				selectable: true,
				userObject: {
					link = new(`tl.devtools:Generalization`, transient: true);
					$link.set(`tl.devtools:Generalization#specialization`, $c);
					$link.set(`tl.devtools:Generalization#generalization`, $g);
					$link
				})))
		.flatten();

	refEdges = $edgeSources
		.map(c -> $c.get(`tl.model:TLStructuredType#localParts`)
			.filter(p -> $p.instanceOf(`tl.model:TLReference`))
			.filter(p -> !$p.get(`tl.model:TLReference#backwards`))
			.filter(p -> $nodeByType[$p.get(`tl.model:TLStructuredTypePart#type`)] != null)
			.map(p -> {
				targetType = $p.get(`tl.model:TLStructuredTypePart#type`);
				rawName = $p.get(`tl.model:TLNamedPart#name`);
				mandatory = $p.get(`tl.model:TLStructuredTypePart#mandatory`);
				multiple = $p.get(`tl.model:TLStructuredTypePart#multiple`);
				card = $mandatory ? ($multiple ? "1..*" : "1") : ($multiple ? "*" : "0..1");
				composite = $p.get(`tl.model:TLReference#end`).get(`tl.model:TLAssociationEnd#composite`);
				aggregate = !$composite && $p.get(`tl.model:TLReference#oppositeEnd`).get(`tl.model:TLAssociationEnd#aggregate`);
				isOverride = $p.get(`tl.model:TLStructuredTypePart#override`);
				isDerived = $p.get(`tl.model:DerivedTLTypePart#derived`);

				refName = $isDerived ? "/" + $rawName : $rawName;

				redefinesLabel = $isOverride ? {
					defOwner = $p.get(`tl.model:TLStructuredTypePart#definition`)
						.get(`tl.model:TLStructuredTypePart#owner`)
						.get(`tl.model:TLNamedPart#name`);
					"\n{redefines " + $defOwner + "}"
				} : "";

				opposite = $p.get(`tl.model:TLReference#opposite`);
				targetLabel = reactFlowDecoration(
					reactFlowPadding(reactFlowText($refName + "\n" + $card + $redefinesLabel, fontSize: 10), all: 4),
					linePosition: 1.0);
				decos = $opposite != null ? {
					oppName = $opposite.get(`tl.model:TLNamedPart#name`);
					oppMandatory = $opposite.get(`tl.model:TLStructuredTypePart#mandatory`);
					oppMultiple = $opposite.get(`tl.model:TLStructuredTypePart#multiple`);
					oppCard = $oppMandatory ? ($oppMultiple ? "1..*" : "1") : ($oppMultiple ? "*" : "0..1");
					list(
						reactFlowDecoration(
							reactFlowPadding(reactFlowText($oppName + "\n" + $oppCard, fontSize: 10), all: 4),
							linePosition: 0.0),
						$targetLabel)
				} : list($targetLabel);

				reactFlowGraphEdge(
					$nodeByType[$c],
					$nodeByType[$targetType],
					priority: $composite || $aggregate ? 2 : 1,
					sourceSymbol: $composite ? "FILLED_DIAMOND" : ($aggregate ? "DIAMOND" : null),
					targetSymbol: $composite || $aggregate ? null : "ARROW",
					strokeStyle: $isDerived ? "#bbbbbb" : "black",
					decorations: $decos,
					selectable: true,
					userObject: $p)
			}))
		.flatten();

	$nodes.isEmpty()
		? reactFlowChart()
		: reactFlowChart(
			root: reactFlowPadding(all: 20,
				content: reactFlowGraphLayout($nodes,
					list($genEdges, $refEdges).flatten())))
}]]></createChart>
													<!--
														A type of another module dragged out of the tree onto the diagram is added to the external
														types of the module shown: to their list, or as a new list where the external types were
														dropped on another module. The point of the drop is not used, the layout places the node. A
														module, a type of the module shown and a type shown already are refused, with the reason at the
														pointer.
													-->
													<drop
														accept="modelType"
														as="dropped"
														input="diagramTypes as shown"
														target="diagram"
													>
														<refuse-if><![CDATA[{
	module = $shown["module"];
	if($module == null,
		#("Select a module to show first."@en, "Wählen Sie zuerst ein Modul zur Anzeige."@de),
		if(!$dropped.filter(t -> !$t.instanceOf(`tl.model:TLType`)).isEmpty(),
			#("A module cannot be added to the diagram, only a type of another module."@en, "Ein Modul kann nicht ins Diagramm aufgenommen werden, nur ein Typ eines anderen Moduls."@de),
			if(!$dropped.filter(t -> $t.get(`tl.model:TLType#module`) == $module).isEmpty(),
				#("A type of the module shown is already part of the diagram."@en, "Ein Typ des gezeigten Moduls ist bereits Teil des Diagramms."@de),
				if(!$dropped.filter(t -> $shown["types"].containsElement($t)).isEmpty(),
					#("The type is already shown in the diagram."@en, "Der Typ wird bereits im Diagramm gezeigt."@de),
					null))))
}]]></refuse-if>
														<execute-script function="{'module': $shown['module'], 'types': list($shown['types'], $dropped).flatten()}">
															<with-result>
																<write-channel name="externalTypes"/>
															</with-result>
														</execute-script>
													</drop>
												</flow-diagram>
												<!--
													The menu offers the commands of the toolbar on what was right-clicked, through the same
													dialogs and ModelEditAction modes: on the free area (where the right-click selects the
													module, see empty-area-selection) a new class or enumeration in the module, on a class or
													attribute a new attribute, on an enumeration or classifier a new classifier, and on any
													element its deletion. A deletion selects what the deleted element belonged to. A module is
													deleted in the model tree only, a type of another module drawn as external node in its own
													module only. "Hide" removes an external node from the diagram and selects the module
													shown, so the diagram stays with it.
												-->
												<commands>
													<generic-command
														image="css:bi bi-plus-lg"
														inputs="selectedModule, selectedPart"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>New class</en>
															<de>Neue Klasse</de>
														</label>
														<executability>
															<visible-if expr="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLModule`)"/>
														</executability>
														<execute-script function="{ type = new(`tl.devtools:NewType`, transient: true); $type.set(`tl.devtools:NewType#kind`, `tl.devtools:TypeKind#class`); $type }">
															<with-result>
																<open-dialog
																	bind-input-to="model"
																	dialog-view="admin/model/create-type.view.xml"
																>
																	<bind
																		channel="selection"
																		to="selectedPart"
																	/>
																	<bind
																		channel="container"
																		to="selectedModule"
																	/>
																</open-dialog>
															</with-result>
														</execute-script>
													</generic-command>
													<generic-command
														image="css:bi bi-list-ul"
														inputs="selectedModule, selectedPart"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>New enumeration</en>
															<de>Neue Aufzählung</de>
														</label>
														<executability>
															<visible-if expr="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLModule`)"/>
														</executability>
														<execute-script function="{ type = new(`tl.devtools:NewType`, transient: true); $type.set(`tl.devtools:NewType#kind`, `tl.devtools:TypeKind#enumeration`); $type }">
															<with-result>
																<open-dialog
																	bind-input-to="model"
																	dialog-view="admin/model/create-type.view.xml"
																>
																	<bind
																		channel="selection"
																		to="selectedPart"
																	/>
																	<bind
																		channel="container"
																		to="selectedModule"
																	/>
																</open-dialog>
															</with-result>
														</execute-script>
													</generic-command>
													<generic-command
														image="css:bi bi-node-plus"
														inputs="selectedPart"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>New attribute</en>
															<de>Neues Attribut</de>
														</label>
														<executability>
															<visible-if expr="$selectedPart != null &amp;&amp; ($selectedPart.instanceOf(`tl.model:TLClass`) || $selectedPart.instanceOf(`tl.model:TLStructuredTypePart`))"/>
														</executability>
														<execute-script function="new(`tl.devtools:NewAttribute`, transient: true)">
															<with-result>
																<open-dialog
																	bind-input-to="model"
																	dialog-view="admin/model/create-attribute.view.xml"
																>
																	<bind
																		channel="selection"
																		to="selectedPart"
																	/>
																	<bind
																		channel="container"
																		to="selectedPart"
																	/>
																</open-dialog>
															</with-result>
														</execute-script>
													</generic-command>
													<generic-command
														image="css:bi bi-tag"
														inputs="selectedPart"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>New classifier</en>
															<de>Neuer Klassifikator</de>
														</label>
														<executability>
															<visible-if expr="$selectedPart != null &amp;&amp; ($selectedPart.instanceOf(`tl.model:TLEnumeration`) || $selectedPart.instanceOf(`tl.model:TLClassifier`))"/>
														</executability>
														<execute-script function="new(`tl.devtools:NewClassifier`, transient: true)">
															<with-result>
																<open-dialog
																	bind-input-to="model"
																	dialog-view="admin/model/create-classifier.view.xml"
																>
																	<bind
																		channel="selection"
																		to="selectedPart"
																	/>
																	<bind
																		channel="container"
																		to="selectedPart"
																	/>
																</open-dialog>
															</with-result>
														</execute-script>
													</generic-command>
													<generic-command
														image="css:bi bi-eye-slash"
														inputs="selectedPart, diagramTypes"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>Hide</en>
															<de>Ausblenden</de>
														</label>
														<executability>
															<visible-if expr="$selectedPart != null &amp;&amp; $diagramTypes['types'].containsElement($selectedPart)"/>
														</executability>
														<execute-script function="$diagramTypes['module']">
															<with-result>
																<write-channel name="selectedPart"/>
															</with-result>
														</execute-script>
														<execute-script function="{'module': $diagramTypes['module'], 'types': $diagramTypes['types'].filter(t -> $t != $selectedPart)}">
															<with-result>
																<write-channel name="externalTypes"/>
															</with-result>
														</execute-script>
													</generic-command>
													<generic-command
														clique="delete"
														image="css:bi bi-trash"
														inputs="selectedPart, selectedModule"
														placement="CONTEXT_MENU"
													>
														<label>
															<en>Delete</en>
															<de>Löschen</de>
														</label>
														<executability>
															<null-input-hidden/>
															<disabled-if expr="if($selectedPart.instanceOf(`tl.model:TLModule`), #('A module is deleted with &quot;Delete module&quot; in the model tree.'@en, 'Ein Modul wird mit &quot;Modul löschen&quot; im Modellbaum gelöscht.'@de), if($selectedPart.instanceOf(`tl.model:TLType`) &amp;&amp; $selectedPart.get(`tl.model:TLType#module`) != $selectedModule, #('A type of another module is not deleted here. Select it in the model tree to show and delete it in its own module.'@en, 'Ein Typ eines anderen Moduls wird hier nicht gelöscht. Wählen Sie ihn im Modellbaum, um ihn in seinem eigenen Modul zu zeigen und zu löschen.'@de)))"/>
														</executability>
														<confirm expr="#('Delete the selected model element?'@en, 'Das ausgewählte Modellelement löschen?'@de)"/>
														<with-transaction>
															<action class="com.top_logic.dev.tools.model.ModelEditAction"
																mode="DELETE"
															/>
														</with-transaction>
														<write-channel name="selectedPart"/>
													</generic-command>
												</commands>
											</context-menu>
										</panel>
									</tab>
									<!--
										All instances of the selected class, those of its subclasses included, so an
										abstract class shows the instances of its concrete specializations. The table is
										built anew for every selected class, since its columns and the types offered for
										a new row are derived from the class when it is built.
									-->
									<tab id="instances"
										icon="css:bi bi-table"
									>
										<label>
											<en>Instances</en>
											<de>Instanzen</de>
										</label>
										<switch
											input="selectedPart"
											rebuild="true"
										>
											<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLClass`)">
												<panel fill="true">
													<title>
														<en>Instances</en>
														<de>Instanzen</de>
													</title>
													<title-content>
														<text input="selectedPart"/>
													</title-content>
													<commands>
														<generic-command
															clique="export"
															image="css:bi bi-filetype-xml"
															inputs="exportedInstances"
															placement="TOOLBAR"
														>
															<label>
																<en>Export instances</en>
																<de>Instanzen exportieren</de>
															</label>
															<tooltip>
																<en>Downloads the selected instances as XML file, which "Import instances" reads in again.</en>
																<de>Lädt die ausgewählten Instanzen als XML-Datei herunter, die "Instanzen importieren" wieder einliest.</de>
															</tooltip>
															<executability>
																<null-input-disabled/>
															</executability>
															<execute-script function="instanceExport($exportedInstances)">
																<with-result>
																	<download/>
																</with-result>
															</execute-script>
														</generic-command>
														<generic-command
															image="css:bi bi-upload"
															inputs="selectedPart"
															placement="TOOLBAR"
														>
															<label>
																<en>Import instances</en>
																<de>Instanzen importieren</de>
															</label>
															<tooltip>
																<en>Creates the objects of an XML file written by "Export instances".</en>
																<de>Legt die Objekte einer mit "Instanzen exportieren" geschriebenen XML-Datei an.</de>
															</tooltip>
															<open-dialog
																bind-input-to="type"
																dialog-view="admin/model/import-instances.view.xml"
															>
																<bind
																	channel="reload"
																	to="instancesReload"
																/>
															</open-dialog>
														</generic-command>
													</commands>
													<!--
														The form edits the rows of the table: in edit mode the selected rows are
														edited, rows are added of the class or, for an abstract one, of a
														concrete subclass chosen from a menu, and removed rows are deleted on
														save. The instancesReload channel is bumped after an import, since the
														table observes no fixed types.
													-->
													<form input="selectedPart">
														<table
															create-type-expr="$type"
															inputs="selectedPart as type, instancesReload"
															on-remove="DELETE"
															row-edit="SELECTED"
															selection="selectedInstances"
															selection-mode="multi"
															types-expr="$type"
														>
															<rows>all($type)</rows>
															<export download-name="label($type)">
																<sheet-name>
																	<en>Instances</en>
																	<de>Instanzen</de>
																</sheet-name>
															</export>
														</table>
													</form>
												</panel>
											</case>
											<default>
												<panel>
													<title>
														<en>Instances</en>
														<de>Instanzen</de>
													</title>
													<inset>
														<text>
															<label>
																<en>Select a class to see its instances.</en>
																<de>Wählen Sie eine Klasse, um ihre Instanzen zu sehen.</de>
															</label>
														</text>
													</inset>
												</panel>
											</default>
										</switch>
									</tab>
								</tabs>
							</tab-bar>
						</pane>
						<pane
							size="30"
							unit="%"
						>
							<!--
								What a model element is decides what there is to say about it, so the
								detail panel is chosen by the kind of the selection rather than
								showing the lowest common denominator of all of them. The default
								covers everything with no panel of its own - an enumeration, a
								classifier, a datatype - with what every model part has.
							-->
							<switch input="selectedPart">
								<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLModule`)">
									<panel>
										<title>
											<en>Module</en>
											<de>Modul</de>
										</title>
										<form
											input="selectedPart"
											with-inset="true"
											withEditMode="true"
										>
											<field attribute="name"/>
											<field
												attribute="annotations"
												full-line="true"
											/>
										</form>
									</panel>
								</case>
								<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLReference`)">
									<stack>
										<panel>
											<title>
												<en>Reference</en>
												<de>Referenz</de>
											</title>
											<form
												input="selectedPart"
												with-inset="true"
												withEditMode="true"
											>
												<field attribute="name"/>
												<field
													attribute="annotations"
													full-line="true"
												/>
											</form>
										</panel>
										<!--
											Kind and opposite are fixed when the reference is created (making a
											reference a composition later requires migrating its data), so they are
											shown read-only.
										-->
										<panel>
											<title>
												<en>Kind and opposite</en>
												<de>Art und Gegenrichtung</de>
											</title>
											<form
												input="selectedReferenceDetails"
												with-inset="true"
											>
												<edit-executability>
													<visible-if expr="false"/>
												</edit-executability>
												<field attribute="referenceKind"/>
												<field attribute="opposite"/>
											</form>
										</panel>
										<panel>
											<title>
												<en>Cardinality</en>
												<de>Kardinalität</de>
											</title>
											<form
												input="selectedEnd"
												with-inset="true"
												withEditMode="true"
											>
												<field attribute="mandatory"/>
												<field attribute="multiple"/>
											</form>
										</panel>
									</stack>
								</case>
								<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLStructuredTypePart`)">
									<panel>
										<title>
											<en>Attribute</en>
											<de>Attribut</de>
										</title>
										<form
											input="selectedPart"
											with-inset="true"
											withEditMode="true"
										>
											<field attribute="name"/>
											<field attribute="mandatory"/>
											<field attribute="multiple"/>
											<field
												attribute="annotations"
												full-line="true"
											/>
										</form>
									</panel>
								</case>
								<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLClass`)">
									<stack>
										<panel>
											<title>
												<en>Class</en>
												<de>Klasse</de>
											</title>
											<form
												input="selectedPart"
												with-inset="true"
												withEditMode="true"
											>
												<field attribute="name"/>
												<field attribute="abstract"/>
												<field attribute="final"/>
												<field
													attribute="annotations"
													full-line="true"
												/>
											</form>
										</panel>
										<!--
											The direct generalizations of the class. Adding and removing them goes
											through the ModelEditAction, which refuses a final class and a cycle.
											A change of the generalizations is announced as a change of the class
											on the input, so the table reads them again. The panel is as high as
											its few rows (fill="false"), so the stack below the class form keeps
											its natural height and the detail pane scrolls it as a whole.
										-->
										<panel fill="false">
											<title>
												<en>Generalizations</en>
												<de>Generalisierungen</de>
											</title>
											<commands>
												<generic-command
													image="css:bi bi-plus-lg"
													inputs="selectedPart"
													placement="TOOLBAR"
												>
													<label>
														<en>Add generalization</en>
														<de>Generalisierung hinzufügen</de>
													</label>
													<executability>
														<null-input-disabled/>
													</executability>
													<execute-script function="new(`tl.devtools:NewGeneralization`, transient: true)">
														<with-result>
															<open-dialog
																bind-input-to="model"
																dialog-view="admin/model/add-generalization.view.xml"
															>
																<bind
																	channel="container"
																	to="selectedPart"
																/>
															</open-dialog>
														</with-result>
													</execute-script>
												</generic-command>
												<generic-command
													image="css:bi bi-dash-lg"
													inputs="selectedGeneralization"
													placement="TOOLBAR"
												>
													<label>
														<en>Remove generalization</en>
														<de>Generalisierung entfernen</de>
													</label>
													<executability>
														<null-input-disabled/>
													</executability>
													<with-transaction>
														<commitMessage>
															<en>Removed generalization {0}.</en>
															<de>Generalisierung {0} entfernt.</de>
														</commitMessage>
														<action class="com.top_logic.dev.tools.model.ModelEditAction"
															container="selectedPart"
															mode="REMOVE_GENERALIZATION"
														/>
													</with-transaction>
													<write-channel name="selectedGeneralization"
														clear="true"
													/>
												</generic-command>
											</commands>
											<table
												inputs="selectedPart as specialization"
												selection="selectedGeneralization"
											>
												<rows>$specialization == null || !$specialization.instanceOf(`tl.model:TLClass`) ? list() : $specialization.get(`tl.model:TLClass#generalizations`)</rows>
												<columns>
													<computed-column name="generalization">
														<label>
															<en>Generalization</en>
															<de>Generalisierung</de>
														</label>
														<value>$row.get(`tl.model:TLType#module`).get(`tl.model:TLNamedPart#name`) + ":" + $row.get(`tl.model:TLNamedPart#name`)</value>
													</computed-column>
												</columns>
											</table>
										</panel>
									</stack>
								</case>
								<!--
									A generalization edge selected in the diagram: the two classes it links. The link is added
									and removed, never edited, so it is shown read-only.
								-->
								<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.devtools:Generalization`)">
									<panel>
										<title>
											<en>Generalization</en>
											<de>Generalisierung</de>
										</title>
										<form
											input="selectedPart"
											with-inset="true"
										>
											<edit-executability>
												<visible-if expr="false"/>
											</edit-executability>
											<field attribute="specialization"/>
											<field attribute="generalization"/>
										</form>
									</panel>
								</case>
								<default>
									<panel>
										<title>
											<en>Details</en>
											<de>Details</de>
										</title>
										<form
											input="selectedPart"
											with-inset="true"
											withEditMode="true"
										>
											<field attribute="name"/>
											<field
												attribute="annotations"
												full-line="true"
											/>
										</form>
									</panel>
								</default>
							</switch>
						</pane>
					</panes>
				</split-panel>
			</pane>
		</panes>
	</split-panel>
</view>