<?xml version="1.0" encoding="utf-8" ?>

<!--
	Purpose-built example model for the agent security end-to-end test.

	Two classes with deliberately different exposure:
	  * "Note"   - the type the agent is allowed to work with (grants exist for it).
	  * "Secret" - the type no demo role may touch (no grant at all, hence deny-by-default).

	The model is only declared when the "secdemo.config.xml" aspect is enabled; see
	"WEB-INF/conf/metaConf.txt" and "doc/security/e2e-security-test.md".
-->
<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="secdemo">
		<class name="Note">
			<attributes>
				<property name="title"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="body"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<class name="Secret">
			<attributes>
				<property name="label"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="value"
					type="tl.core:String"
				/>
			</attributes>
		</class>
	</module>
</model>
