<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<configs>
		<!-- A React-only application: its entry point is the view shell at /view/. -->
		<config config:interface="com.top_logic.base.accesscontrol.ApplicationPages$Config">
			<startPage>/view/</startPage>
		</config>
		<!--
			The control application shows nothing to a session without an account: whatever URL is
			asked for, the login page is displayed, and the requested URL is the one the user lands
			on after the login.
		-->
		<config config:interface="com.top_logic.layout.view.ViewConfig"
			login-view="login-page.view.xml"
		/>
	</configs>

	<services>
		<!--
			The built-in git connection of the installation, configured from the environment: a Gitea
			server offered to every tenant, switched off as long as tl_factory_gitea_url is empty. Each
			tenant gets an organization of its own there, named by the owner and the tenant. The requests
			are authenticated with the access token in the secret tl_factory_gitea_token.
		-->
		<config service-class="com.top_logic.factory.git.GitHostingService">
			<instance class="com.top_logic.factory.git.GitHostingService">
				<connections>
					<connection name="gitea"
						owner="%FACTORY_GITEA_OWNER%"
						provider-type="gitea"
						token-secret="tl_factory_gitea_token"
						url="%FACTORY_GITEA_URL%"
					/>
				</connections>
			</instance>
		</config>

		<!--
			The provider whose API key the workspace proxy adds to the LLM requests of the workspaces
			(the LLM route of the WorkspaceProxyService, provider "anthropic"); the key is read from the
			environment variable tl_anthropic_api_key. It exposes no models: the control application runs
			no agent itself; the chats of the Agent tab are answered by the coding agents in the
			workspaces. The list replaces the providers tl-ai-core ships, which would expose their default
			models.
		-->
		<config service-class="com.top_logic.tl.ai.core.provider.LLMProviderService">
			<instance class="com.top_logic.tl.ai.core.provider.LLMProviderService">
				<providers config:override="true">
					<provider class="com.top_logic.tl.ai.core.provider.anthropic.AnthropicProviderConfig"
						name="anthropic"
					>
						<api-key name="tl_anthropic_api_key"/>
					</provider>
				</providers>
				<model-catalog fetch-remote-catalog="false"/>
			</instance>
		</config>
	</services>
</application>
