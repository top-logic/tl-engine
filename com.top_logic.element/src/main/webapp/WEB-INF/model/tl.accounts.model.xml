		</class>
		<class name="Person">
			<generalizations>
				<generalization type="tl.core:Author"/>
				<generalization type="GroupMember"/>
			</generalizations>
			<annotations>
				<implementation-binding class-name="com.top_logic.knowledge.wrap.person.Person"/>
				<instance-presentation
					icon="theme:mime.tl.accounts.Person"
					large-icon="theme:mime.tl.accounts.Person.large"
				/>
				<main-properties properties="name,firstName,lastName"/>
				<table name="Person"/>
				<object-initializers>
					<initializer class="com.top_logic.knowledge.wrap.person.PersonGroupsInitializer"/>
				</object-initializers>
			</annotations>
			<attributes>
				<property name="name"
					override="true"
					type="tl.core:String"
				>
					<annotations>
						<delete-protected/>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<property name="locale"
					type="tl.core:String"
				>
					<annotations>
						<delete-protected/>
						<storage-algorithm>
							<derived-storage>
								<expression-evaluation>
									<method-call method="com.top_logic.knowledge.wrap.person.Person#computeLocale()"/>
								</expression-evaluation>
							</derived-storage>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="language"
					type="tl.util:Language"
				>
					<annotations>
						<delete-protected/>
						<default-value>
							<provider class="com.top_logic.model.provider.DefaultLocaleDefault"/>
						</default-value>
						<options>
							<config-reference name="supportedLocales"/>
						</options>
					</annotations>
				</property>
				<property name="country"
					type="tl.util:Country"
				>
					<annotations>
						<delete-protected/>
						<default-value>
							<provider class="com.top_logic.model.provider.DefaultCountryDefault"/>
						</default-value>
					</annotations>
				</property>
				<property name="timezone"
					mandatory="true"
					type="tl.util:TimeZone"
				>
					<annotations>
						<delete-protected/>
						<default-value>
							<provider class="com.top_logic.model.provider.UserTimeZoneDefault"/>
						</default-value>
					</annotations>
				</property>
				<property name="unusedNotified"
					type="tl.core:Boolean"
				>
					<annotations>
						<delete-protected/>
					</annotations>
				</property>
				<property name="authDeviceID"
					type="tl.core:String"
				>
					<annotations>
						<delete-protected/>
					</annotations>
				</property>
				<property name="restrictedUser"
					type="tl.core:Boolean"
				>
					<annotations>
						<delete-protected/>
					</annotations>
				</property>
				<property name="admin"
					type="tl.core:Boolean"
				>
					<annotations>
						<delete-protected/>
						<!-- Changed only by an administrator, who cannot revoke his own administrator flag. -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.element.layout.formeditor.implementation.additional.AdministrativeAttributeModeSelector"/>
						</dynamic-visibility>
					</annotations>
				</property>
				<reference name="representativeGroup"
					kind="forwards"
					type="Group"
				>
					<annotations>
						<storage-algorithm>
							<singleton-link-storage
								monomorphic-table="true"
								table="definesGroup"
							/>
						</storage-algorithm>
						<delete-protected/>
					</annotations>
				</reference>
				<reference name="groups"
					inverse-reference="members"
					kind="backwards"
					multiple="true"
					type="Group"
				/>
				<property name="firstName"
					type="tl.core:String"
				/>
				<property name="lastName"
					type="tl.core:String"
				/>
				<reference name="deputyFor"
					kind="forwards"
					multiple="true"
					navigate="true"
					type="GroupMember"
				/>
				<property name="mfaSecret"
					type="tl.core:Password"
				>
					<annotations>
						<delete-protected/>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<property name="mfaRequirement"
					type="MfaRequirement"
				/>
				<property name="locked"
					type="tl.core:Boolean"
				>
					<annotations>
						<delete-protected/>
						<!-- Changed only by an administrator, who cannot lock his own account. -->
						<dynamic-visibility>
							<mode-selector class="com.top_logic.element.layout.formeditor.implementation.additional.AdministrativeAttributeModeSelector"/>
						</dynamic-visibility>
					</annotations>
				</property>
			</attributes>
		</class>
