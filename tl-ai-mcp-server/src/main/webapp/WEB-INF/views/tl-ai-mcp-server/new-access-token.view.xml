<?xml version="1.0" encoding="utf-8" ?>

<!--
	Creating a personal access token (Issue #671). The model is a transient
	tl.ai.mcp.server:AccessTokenRequest; Create stores the token's hash, writes the token itself onto
	that transient object only, and replaces this dialog by the one that shows it - once.
-->
<view>
	<channels>
		<!-- Transient AccessTokenRequest bound to the form. -->
		<channel name="model"/>
	</channels>
	<window
		resizable="false"
		width="420px"
	>
		<title>
			<en>New access token</en>
			<de>Neues Zugriffstoken</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<text>
				<label>
					<en>An MCP client such as Claude Code acts as you with this token, with all your rights.</en>
					<de>Ein MCP-Client wie Claude Code handelt mit diesem Token als Sie, mit all Ihren Rechten.</de>
				</label>
			</text>
			<field attribute="name"/>
			<field attribute="validForDays"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<with-transaction>
						<execute-script>
							<function><![CDATA[r -> $r..set(`tl.ai.mcp.server:AccessTokenRequest#token`,
								mcpAccessTokenCreate(
									$r.get(`tl.ai.mcp.server:AccessTokenRequest#name`),
									$r.get(`tl.ai.mcp.server:AccessTokenRequest#validForDays`)))]]></function>
						</execute-script>
					</with-transaction>
					<close-dialog/>
					<open-dialog
						bind-input-to="model"
						dialog-view="tl-ai-mcp-server/access-token-created.view.xml"
					/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
