<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="demo.calendar">
			<class name="Appointment">
				<annotations>
					<main-properties properties="name, start, end, category"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="start"
						mandatory="true"
						type="tl.core:DateTime"
					/>
					<property name="end"
						type="tl.core:DateTime"
					/>
					<property name="allDay"
						type="tl.core:Boolean"
					/>
					<property name="category"
						type="tl.core:String"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>
