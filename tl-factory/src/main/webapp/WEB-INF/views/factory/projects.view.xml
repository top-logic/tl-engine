<?xml version="1.0" encoding="utf-8" ?>

<!--
	The projects of the control application and their workspaces: a list of the projects of the tenant
	of the user - of all tenants for an operator - with the
	state of each workspace and the address of its running application, and beside it the selected
	project with the link to its repository, its CI job and last CI build, its workspace and the output
	of the last operation on it (factory/project-detail.view.xml).
	While the project has a workspace, the project panel shows these in a tab "Details", beside it a
	tab "Agent" with the conversations with the coding agent of the workspace
	(factory/workspace-agent.view.xml) and a tab "Application log" with the log of the application
	running in the workspace (factory/app-log.view.xml). "Give a task" starts a conversation with the
	agent (factory/assign-task.view.xml).
	
	The operations on a workspace run in the background (ProjectWorkspaces) and commit their output
	and state while they run. The source channel "commits" brings these commits to the window as
	soon as they are made, so the list, the state and the output follow the operation without a
	click. The commands are offered according to the state of the selected workspace. A project gets
	no CI with its workspace: "Set up CI" sets it up for a project without CI job; "Start CI build",
	"Refresh CI build" and the CI job in the details are shown only for a project with one. The last
	CI build is asked from the CI server when the project is selected or a CI command asks for it,
	not in the background.
-->
<view>
	<channels>
		<!--
			The tenant of the user, empty for an operator: a project created here belongs to it, and it
			is the context the right to create the project is checked in.
		-->
		<channel name="tenant">
			<init>factoryCurrentTenant()</init>
		</channel>
		<channel name="project"/>
		<source-channel name="commits"
			update-interval="1000"
		>
			<source class="com.top_logic.layout.view.channel.CommitSource"
				types="tl.factory:Project, tl.factory:Workspace"
			/>
		</source-channel>
		<derived-channel name="workspace"
			expr="$project.get(`tl.factory:Project#workspace`)"
			inputs="project"
			observed-types="tl.factory:Workspace"
		/>
		<!--
			Why the coding agent cannot work in the selected workspace now, empty when it can: what
			"Give a task" says while it is disabled.
		-->
		<derived-channel name="agentUnavailable"
			expr="factoryAgentUnavailable($workspace)"
			inputs="workspace"
			observed-types="tl.factory:Workspace"
		/>
		<!--
			The agent conversation shown in the Agent tab: the newest one of the selected workspace,
			the one a task just started, or the one the user opens.
		-->
		<channel name="conversation"
			inputs="workspace"
		>
			<init><![CDATA[if($workspace == null, null,
	$workspace.get(`tl.factory:Workspace#conversations`)
		.sort((c -> $c.get(`tl.factory:AgentConversation#createdAt`)).comparator().desc())
		.firstElement())]]></init>
		</channel>
		<!--
			The chat of the current user about that conversation, empty for a conversation the user
			has not talked in yet: the first message then starts a chat about it, which continues the
			conversation of the agent.
		-->
		<channel name="agentSession"
			inputs="conversation"
		>
			<init><![CDATA[if($conversation == null, null,
	$conversation.referers(`tl.ai.execution:AgentSession#subject`)
		.filter(s -> $s.get(`tl.ai.execution:AgentSession#owner`) == currentUser())
		.sort((s -> $s.get(`tl.ai.execution:AgentSession#lastUpdated`)).comparator().desc())
		.firstElement())]]></init>
		</channel>
		<derived-channel name="status"
			expr="$workspace.get(`tl.factory:Workspace#status`)"
			inputs="workspace"
		/>
		<!--
			Whether the container of the workspace was created from an older image than the current
			one; false while it has no container.
		-->
		<derived-channel name="outdated"
			expr="if($workspace == null, false, factoryImageOutdated($workspace))"
			inputs="workspace"
			observed-types="tl.factory:Workspace"
		/>
		<!--
			The repository of the selected project as link to its page on the git hosting service; empty
			while the project has none.
		-->
		<derived-channel name="repositoryLink"
			inputs="project"
			observed-types="tl.factory:Project"
		>
			<expr><![CDATA[{
	url = $project.get(`tl.factory:Project#repositoryUrl`);
	name = $project.get(`tl.factory:Project#repository`);
	if($url == null, null, {{{<p>{#('Repository'@en, 'Repository'@de)}: <a href="{$url}" target="_blank" rel="noopener">{$name}</a></p>}}});
}]]></expr>
		</derived-channel>
		<!--
			Why the CI of the selected project cannot be set up, empty when it can: what "Set up CI" says
			while it is disabled.
		-->
		<derived-channel name="ciSetUpUnavailable"
			expr="factoryCiSetUpUnavailable($project)"
			inputs="project"
			observed-types="tl.factory:Project"
		/>
		<!--
			Why no CI build of the selected project can be started, empty when one can: what
			"Start CI build" says while it is disabled.
		-->
		<derived-channel name="ciUnavailable"
			expr="factoryCiUnavailable($project)"
			inputs="project"
			observed-types="tl.factory:Project"
		/>
		<!-- Written by the CI commands to ask the CI server again for the last build. -->
		<channel name="ciRefresh"/>
		<!--
			The CI job of the selected project as link to its page on the CI server, with its last build
			asked from the CI server when the project is selected or changes, or a CI command asks for it;
			empty while the project has no CI job.
		-->
		<derived-channel name="ciBuild"
			inputs="project, ciRefresh"
			observed-types="tl.factory:Project"
		>
			<expr><![CDATA[{
	jobUrl = $project.get(`tl.factory:Project#ciJobUrl`);
	job = $project.get(`tl.factory:Project#ciJob`);
	build = if($jobUrl == null, null, factoryLastBuild($project));
	last = if($build == null,
		{{{<p>{#('No CI build yet.'@en, 'Noch kein CI-Build.'@de)}</p>}}},
		if($build['error'] != null,
			{{{<p>{#('The CI server cannot be asked: {0}'@en, 'Der CI-Server kann nicht gefragt werden: {0}'@de).fill($build['error'])}</p>}}},
			{{{<p>{#('Last CI build'@en, 'Letzter CI-Build'@de)}: <a href="{$build['url']}" target="_blank" rel="noopener">{#('Build {0}'@en, 'Build {0}'@de).fill($build['number'])}</a> {$build['stateLabel']}, {$build['startTime']} ({$build['durationSeconds']} s)</p>}}}));
	if($jobUrl == null, null, {{{<p>{#('CI job'@en, 'CI-Job'@de)}: <a href="{$jobUrl}" target="_blank" rel="noopener">{$job}</a></p>{$last}}}});
}]]></expr>
		</derived-channel>
		<derived-channel name="previewLink"
			inputs="workspace"
		>
			<expr><![CDATA[{
	url = $workspace.get(`tl.factory:Workspace#previewUrl`);
	if($url == null, null, {{{<a href="{$url}" target="_blank" rel="noopener">{$url}</a>}}});
}]]></expr>
		</derived-channel>
	</channels>

	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="320"
				size="45"
				unit="%"
			>
				<panel>
					<title>
						<en>Projects</en>
						<de>Projekte</de>
					</title>
					<commands>
						<generic-command name="createApplication"
							image="css:bi bi-plus-lg"
							placement="TOOLBAR"
						>
							<label>
								<en>Create application</en>
								<de>Anwendung anlegen</de>
							</label>
							<create-transient
								container="tenant"
								type="tl.factory:Project"
							>
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="factory/create-project.view.xml"
									>
										<bind
											channel="selection"
											to="project"
										/>
										<bind
											channel="tenant"
											to="tenant"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command name="createWorkspace"
							clique="edit"
							image="css:bi bi-box-seam"
							inputs="project, workspace"
							placement="TOOLBAR"
						>
							<label>
								<en>Create workspace</en>
								<de>Workspace anlegen</de>
							</label>
							<executability>
								<visible-if expr="$project != null &amp;&amp; $workspace == null"/>
								<model-access operation="Write"/>
							</executability>
							<execute-script function="factoryCreateWorkspace($project)"/>
						</generic-command>
						<generic-command name="startWorkspace"
							clique="edit"
							image="css:bi bi-play-fill"
							inputs="project, status"
							placement="TOOLBAR"
						>
							<label>
								<en>Start</en>
								<de>Starten</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if([`tl.factory:WorkspaceStatus#STOPPED`, `tl.factory:WorkspaceStatus#CREATED`, `tl.factory:WorkspaceStatus#APP_STOPPED`, `tl.factory:WorkspaceStatus#UNKNOWN`].containsElement($status), null, #('Neither the workspace nor its application is stopped.'@en, 'Weder der Workspace noch seine Anwendung ist gestoppt.'@de))"/>
								<model-access operation="Write"/>
							</executability>
							<execute-script function="factoryStart($project)"/>
						</generic-command>
						<generic-command name="stopWorkspace"
							clique="edit"
							image="css:bi bi-stop-fill"
							inputs="project, status"
							placement="TOOLBAR"
						>
							<label>
								<en>Stop</en>
								<de>Stoppen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if([`tl.factory:WorkspaceStatus#RUNNING`, `tl.factory:WorkspaceStatus#APP_STOPPED`, `tl.factory:WorkspaceStatus#UNKNOWN`, `tl.factory:WorkspaceStatus#ERROR`].containsElement($status), null, #('The workspace is not running.'@en, 'Der Workspace läuft nicht.'@de))"/>
								<model-access operation="Write"/>
							</executability>
							<execute-script function="factoryStop($project)"/>
						</generic-command>
						<generic-command name="updateWorkspace"
							clique="edit"
							image="css:bi bi-arrow-repeat"
							inputs="project, status, outdated"
							placement="TOOLBAR"
						>
							<label>
								<en>Update workspace</en>
								<de>Workspace aktualisieren</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if($status == null, #('The project has no workspace.'@en, 'Das Projekt hat keinen Workspace.'@de), if([`tl.factory:WorkspaceStatus#BUILDING`, `tl.factory:WorkspaceStatus#STARTING`, `tl.factory:WorkspaceStatus#STOPPING`, `tl.factory:WorkspaceStatus#REMOVING`, `tl.factory:WorkspaceStatus#UPDATING`].containsElement($status), #('An operation is running on the workspace.'@en, 'Auf dem Workspace läuft eine Operation.'@de), if($outdated, null, #('The workspace runs on the current image.'@en, 'Der Workspace läuft auf dem aktuellen Image.'@de))))"/>
								<model-access operation="Write"/>
							</executability>
							<confirm expr="#('Create the container of {0} anew on the current image? Sources, Maven repository, database and the conversations of the agent are kept, a running application is restarted.'@en, 'Den Container von {0} auf dem aktuellen Image neu anlegen? Quellen, Maven-Repository, Datenbank und die Unterhaltungen des Agenten bleiben erhalten, eine laufende Anwendung wird neu gestartet.'@de).fill($project)"/>
							<execute-script function="factoryUpdate($project)"/>
						</generic-command>
						<generic-command name="cleanupWorkspace"
							clique="delete"
							image="css:bi bi-eraser"
							inputs="project, status"
							placement="TOOLBAR"
						>
							<label>
								<en>Clean up</en>
								<de>Aufräumen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if($status == null, #('The project has no workspace.'@en, 'Das Projekt hat keinen Workspace.'@de), if([`tl.factory:WorkspaceStatus#BUILDING`, `tl.factory:WorkspaceStatus#STARTING`, `tl.factory:WorkspaceStatus#STOPPING`, `tl.factory:WorkspaceStatus#REMOVING`, `tl.factory:WorkspaceStatus#UPDATING`].containsElement($status), #('An operation is running on the workspace.'@en, 'Auf dem Workspace läuft eine Operation.'@de), null))"/>
								<model-access operation="Write"/>
							</executability>
							<confirm expr="#('Remove the workspace of {0} with its container, sources and database? The project is kept.'@en, 'Den Workspace von {0} mit Container, Quellen und Datenbank entfernen? Das Projekt bleibt erhalten.'@de).fill($project)"/>
							<execute-script function="factoryCleanup($project)"/>
						</generic-command>
						<generic-command name="deleteProject"
							clique="delete"
							image="css:bi bi-trash"
							inputs="project, workspace"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete project</en>
								<de>Projekt löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
								<disabled-if expr="if($workspace != null, #('Clean up the workspace first.'@en, 'Zuerst den Workspace aufräumen.'@de), null)"/>
							</executability>
							<confirm expr="#('Delete project {0}?'@en, 'Projekt {0} löschen?'@de).fill($project)"/>
							<delete-object/>
							<write-channel name="project"
								clear="true"
							/>
						</generic-command>
					</commands>
					<table
						observed-types="tl.factory:Project, tl.factory:Workspace"
						personalization-key="tl-factory-projects"
						selection="project"
						types="tl.factory:Project"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="tenant"/>
							<column attribute="artifactId"/>
							<column attribute="engineVersion"/>
							<computed-column name="status"
								type="tl.factory:WorkspaceStatus"
							>
								<label>
									<en>Status</en>
									<de>Status</de>
								</label>
								<value>$row.get(`tl.factory:Project#workspace`).get(`tl.factory:Workspace#status`)</value>
							</computed-column>
							<computed-column name="preview"
								type="tl.core:String"
							>
								<label>
									<en>Preview</en>
									<de>Vorschau</de>
								</label>
								<value>$row.get(`tl.factory:Project#workspace`).get(`tl.factory:Workspace#previewUrl`)</value>
							</computed-column>
						</columns>
						<rows>factoryProjects()</rows>
						<row-class><![CDATA[{
	status = $row.get(`tl.factory:Project#workspace`).get(`tl.factory:Workspace#status`);
	if($status == `tl.factory:WorkspaceStatus#ERROR`, 'tl-status-error',
		if($status == `tl.factory:WorkspaceStatus#RUNNING`, 'tl-status-success',
			if($status == `tl.factory:WorkspaceStatus#APP_STOPPED`, 'tl-status-warning',
				if([`tl.factory:WorkspaceStatus#BUILDING`, `tl.factory:WorkspaceStatus#STARTING`, `tl.factory:WorkspaceStatus#STOPPING`, `tl.factory:WorkspaceStatus#REMOVING`, `tl.factory:WorkspaceStatus#UPDATING`].containsElement($status), 'tl-status-info', null))));
}]]></row-class>
					</table>
				</panel>
			</pane>
			<pane
				size="55"
				unit="%"
			>
				<panel>
					<title>
						<en>Project</en>
						<de>Projekt</de>
					</title>
					<!-- Commands about the agent of the selected workspace and the CI build of the project. -->
					<commands>
						<!--
							Offered while CI is switched on and the selected project has no CI job; disabled with the
							reason while its CI cannot be set up, e.g. for a project on a git connection of its
							tenant or one whose repository has no application yet.
						-->
						<generic-command name="setUpCI"
							image="css:bi bi-gear-wide-connected"
							inputs="project, ciSetUpUnavailable"
							placement="TOOLBAR"
						>
							<label>
								<en>Set up CI</en>
								<de>CI einrichten</de>
							</label>
							<executability>
								<visible-if expr="$project != null &amp;&amp; $project.get(`tl.factory:Project#ciJob`) == null &amp;&amp; factoryCiEnabled()"/>
								<disabled-if expr="$ciSetUpUnavailable"/>
								<model-access operation="Write"/>
							</executability>
							<confirm expr="#('Set up the CI of {0}? The repository gets the default pipeline definition unless it has one, the pipeline file is protected, and the CI job is created and builds the application.'@en, 'Die CI von {0} einrichten? Das Repository erhält die Standard-Pipeline-Definition, sofern es keine hat, die Pipeline-Datei wird geschützt, und der CI-Job wird angelegt und baut die Anwendung.'@de).fill($project)"/>
							<execute-script function="factorySetUpCI($project)">
								<with-result>
									<notify expr="$result"/>
								</with-result>
							</execute-script>
							<execute-script function="now()">
								<with-result>
									<write-channel name="ciRefresh"/>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command name="startBuild"
							image="css:bi bi-hammer"
							inputs="project, ciUnavailable"
							placement="TOOLBAR"
						>
							<label>
								<en>Start CI build</en>
								<de>CI-Build starten</de>
							</label>
							<executability>
								<visible-if expr="$project != null &amp;&amp; $project.get(`tl.factory:Project#ciJob`) != null"/>
								<disabled-if expr="$ciUnavailable"/>
								<model-access operation="Write"/>
							</executability>
							<execute-script function="factoryStartBuild($project)">
								<with-result>
									<notify expr="$result"/>
								</with-result>
							</execute-script>
							<execute-script function="now()">
								<with-result>
									<write-channel name="ciRefresh"/>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command name="refreshBuild"
							image="css:bi bi-arrow-clockwise"
							inputs="project"
							placement="TOOLBAR"
						>
							<label>
								<en>Refresh CI build</en>
								<de>CI-Build aktualisieren</de>
							</label>
							<executability>
								<visible-if expr="$project != null &amp;&amp; $project.get(`tl.factory:Project#ciJob`) != null"/>
							</executability>
							<execute-script function="now()">
								<with-result>
									<write-channel name="ciRefresh"/>
								</with-result>
							</execute-script>
						</generic-command>
						<generic-command name="assignTask"
							image="css:bi bi-robot"
							inputs="workspace, agentUnavailable"
							placement="TOOLBAR"
						>
							<label>
								<en>Give a task</en>
								<de>Auftrag erteilen</de>
							</label>
							<executability>
								<visible-if expr="$workspace != null"/>
								<disabled-if expr="$agentUnavailable"/>
								<model-access operation="Write"/>
							</executability>
							<create-transient type="tl.factory:AgentConversation">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="factory/assign-task.view.xml"
									>
										<bind
											channel="workspace"
											to="workspace"
										/>
										<bind
											channel="conversation"
											to="conversation"
										/>
										<bind
											channel="agentSession"
											to="agentSession"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
					</commands>
					<switch input="workspace">
						<case test="$workspace != null">
							<tab-bar active-tab="details">
								<tab id="details"
									icon="css:bi bi-card-list"
									route="none"
								>
									<label>
										<en>Details</en>
										<de>Details</de>
									</label>
									<view-ref view="factory/project-detail.view.xml">
										<bind
											channel="project"
											to="project"
										/>
										<bind
											channel="workspace"
											to="workspace"
										/>
										<bind
											channel="outdated"
											to="outdated"
										/>
										<bind
											channel="previewLink"
											to="previewLink"
										/>
										<bind
											channel="repositoryLink"
											to="repositoryLink"
										/>
										<bind
											channel="ciBuild"
											to="ciBuild"
										/>
									</view-ref>
								</tab>
								<!-- The conversations with the coding agent working in the workspace. -->
								<tab id="agent"
									icon="css:bi bi-robot"
									route="none"
								>
									<label>
										<en>Agent</en>
										<de>Agent</de>
									</label>
									<view-ref view="factory/workspace-agent.view.xml">
										<bind
											channel="workspace"
											to="workspace"
										/>
										<bind
											channel="conversation"
											to="conversation"
										/>
										<bind
											channel="agentSession"
											to="agentSession"
										/>
										<bind
											channel="agentUnavailable"
											to="agentUnavailable"
										/>
									</view-ref>
								</tab>
								<!-- The log of the application running in the workspace. -->
								<tab id="app-log"
									icon="css:bi bi-terminal"
									route="none"
								>
									<label>
										<en>Application log</en>
										<de>Anwendungs-Log</de>
									</label>
									<view-ref view="factory/app-log.view.xml">
										<bind
											channel="workspace"
											to="workspace"
										/>
									</view-ref>
								</tab>
							</tab-bar>
						</case>
						<default>
							<view-ref view="factory/project-detail.view.xml">
								<bind
									channel="project"
									to="project"
								/>
								<bind
									channel="workspace"
									to="workspace"
								/>
								<bind
									channel="outdated"
									to="outdated"
								/>
								<bind
									channel="previewLink"
									to="previewLink"
								/>
								<bind
									channel="repositoryLink"
									to="repositoryLink"
								/>
								<bind
									channel="ciBuild"
									to="ciBuild"
								/>
							</view-ref>
						</default>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>