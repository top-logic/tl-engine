<?xml version="1.0" encoding="utf-8" ?>

<application>
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/TestViewModelAccess.model.xml"/>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="TestViewModelAccess.Responsible"/>
					<role name="TestViewModelAccess.Reader"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="TestViewModelAccess:Project">
						<!-- The responsible may do everything with a project. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Create"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Delete"
							roles="TestViewModelAccess.Responsible"
						/>
						<!-- The responsible may finish a project (a custom command group). -->
						<grant
							operation="Finish"
							roles="TestViewModelAccess.Responsible"
						/>
					</class>
					<class name="TestViewModelAccess:Task">
						<!-- The responsible of a project may do everything with its tasks. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Create"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Delete"
							roles="TestViewModelAccess.Responsible"
						/>
					</class>
					<class name="TestViewModelAccess:Category">
						<!-- A category may only be read, by its reader. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Reader"
						/>
					</class>
					<part name="TestViewModelAccess:Project#secret">
						<!--
							Present grant with no roles: writing this attribute is denied for every
							role, only a bypassing super-user may write it.
						-->
						<grant operation="Write"/>
					</part>
				</security-config>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="TestViewModelAccess_Project_Responsible"
							meta-element="TestViewModelAccess:Project"
							role="TestViewModelAccess.Responsible"
						>
							<path>
								<step attribute="TestViewModelAccess:Project#responsible"/>
							</path>
						</rule>
						<inheritance-rule id="TestViewModelAccess_Task_Responsible"
							meta-element="TestViewModelAccess:Task"
							role="TestViewModelAccess.Responsible"
						>
							<path>
								<step
									attribute="TestViewModelAccess:Project#tasks"
									inverse="true"
								/>
							</path>
						</inheritance-rule>
						<rule id="TestViewModelAccess_Category_Reader"
							meta-element="TestViewModelAccess:Category"
							role="TestViewModelAccess.Reader"
						>
							<path>
								<step attribute="TestViewModelAccess:Category#reader"/>
							</path>
						</rule>
					</rules>
				</role-rules>
			</instance>
		</config>
	</services>
</application>