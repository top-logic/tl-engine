<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.top-logic</groupId>
		<artifactId>tl-bom</artifactId>
		<version>8.0.0-SNAPSHOT</version>
		<relativePath>tl-bom</relativePath>
	</parent>

	<artifactId>tl-parent-all</artifactId>

	<name>${project.artifactId}</name>
	<description>Aggregator module that builds the complete TopLogic application engine.</description>

	<packaging>pom</packaging>

	<properties>
		<!-- renovate: datasource=node-version depName=node -->
		<node.version>24.21.0</node.version>
		
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>

		<!-- 
			JavaDoc check of javac. Engine modules set it to "-Xdoclint:reference/private" to fail on 
			JavaDoc references ({@link}, @see, @throws, {@value}) that do not resolve. 
		-->
		<tl.javac.doclint>-Xdoclint:none</tl.javac.doclint>

		<!-- 
			Whether to skip the check for unused imports. Engine modules set it to "false" to fail on an 
			import that is not used. 
		-->
		<tl.unused-imports.skip>true</tl.unused-imports.skip>

		<skipTests>true</skipTests>
		<skipDependencyCheck>false</skipDependencyCheck>
		<skipNormalizeLayouts>true</skipNormalizeLayouts>
		
		<tl.layoutDir>${basedir}/src/main/webapp/WEB-INF/layouts</tl.layoutDir>
		<tl.confDir>${basedir}/src/main/webapp/WEB-INF</tl.confDir>

		<maven.javadoc.skip>false</maven.javadoc.skip>

		<!-- 
			Directory into which the framework modules write their JavaDoc to combine it into one tree. 
			
			With -Dtl.javadoc.aggregate=false, the "javadoc-module-local" profiles of tl-parent-build and 
			tl-parent-engine keep the JavaDoc of each module in its own build directory and skip the index. 
		-->
		<tl.javadoc.aggregateDir>${basedir}/../tl-doc/javadoc</tl.javadoc.aggregateDir>
		
		<!-- Whether to skip indexing the combined JavaDoc tree in tl-parent-engine. -->
		<tl.javadoc.skipIndex>${maven.javadoc.skip}</tl.javadoc.skipIndex>

		<!--
			Comma-separated build and test features of this engine version that the CI pipelines of the
			repository tl-ci use if present (an application inherits them from its engine version):

			scripted-shards: Test selection TestAll.scripted, TestAll.shardModules and TestAll.scratchDir.
			db-workers: Database test selection TestAll.db and TestAll.dbWorkers.
			javadoc-local: Module-local JavaDoc build with -Dtl.javadoc.aggregate=false.
		-->
		<tl.ci.features>scripted-shards,db-workers,javadoc-local</tl.ci.features>
	</properties>

	<modules>
		<!-- Dependency versions and publishing settings: the parent of this POM. -->
		<module>tl-bom</module>

		<!-- Archetypes -->
		<module>tl-archetype-app</module>

		<!-- Module parents -->
		<module>tl-parent-app</module>
		<module>tl-parent-core</module>
		<module>tl-parent-build</module>
		<module>tl-parent-gwt</module>
	</modules>

	<profiles>
		<profile>
			<!--
				Builds the engine modules. Active unless skipFullBuild is set or the profile is deactivated
				explicitly (-P !full-build). A property activation is used instead of activeByDefault, because
				Maven deactivates an activeByDefault profile as soon as any other profile of this POM is active
				(e.g. no-multi-module-directory in an embedded Maven such as the Jenkins Maven integration).
			-->
			<id>full-build</id>
			<activation>
				<property>
					<name>!skipFullBuild</name>
				</property>
			</activation>

			<modules>
				<!-- TopLogic aggregator -->
				<module>tl-parent-engine</module>
			</modules>			
		</profile>

		<profile>
			<id>has-layouts</id>
		    <activation>
		        <file>
		            <exists>${tl.layoutDir}</exists>
		        </file>
    		</activation>
    		
    		<properties>
				<skipNormalizeLayouts>false</skipNormalizeLayouts>
    		</properties>
		</profile>

		<profile>
			<!--
				The property maven.multiModuleProjectDirectory is set by the mvn launcher script, but not by
				every embedded Maven (e.g. Eclipse m2e without a .mvn directory). Unresolved, the expression
				ends up literally in the Node install path and creates a directory named
				"${maven.multiModuleProjectDirectory}" in each frontend module. Install Node into the
				module's build directory instead.
			-->
			<id>no-multi-module-directory</id>
			<activation>
				<property>
					<name>!maven.multiModuleProjectDirectory</name>
				</property>
			</activation>

			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>com.github.eirslett</groupId>
							<artifactId>frontend-maven-plugin</artifactId>
							<configuration>
								<installDirectory>${project.build.directory}/node/${node.version}</installDirectory>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
	</profiles>

	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
	  	<dependency>
		    <groupId>org.apache.maven</groupId>
			<artifactId>maven-model-builder</artifactId>
			<scope>test</scope>
	  	</dependency>
	</dependencies>

	<build>
		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
			<testResource>
				<directory>src/test/java</directory>
				<excludes>
					<exclude>.srcexclude</exclude>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>

		<resources>
			<resource>
				<directory>src/main/resources</directory>
			</resource>
			<resource>
				<directory>src/main/java</directory>
				<excludes>
					<exclude>.srcexclude</exclude>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>

		<plugins>
	  		<plugin>
	  			<groupId>org.apache.maven.plugins</groupId>
	  			<artifactId>maven-resources-plugin</artifactId>
	  		</plugin>

			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<parameters>true</parameters>
					<useIncrementalCompilation>false</useIncrementalCompilation>
					<forceJavacCompilerUse>true</forceJavacCompilerUse>
					<compilerArgs>
	                    <arg>-parameters</arg>
	                    <arg>${tl.javac.doclint}</arg>
	                </compilerArgs>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<executions>
					<execution>
						<id>unused-imports</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
						<configuration>
							<skip>${tl.unused-imports.skip}</skip>
							<checkstyleRules>
								<module name="Checker">
									<module name="TreeWalker">
										<!-- An import used only in JavaDoc counts as used, as in Eclipse. -->
										<module name="UnusedImports">
											<property name="processJavadoc" value="true" />
										</module>
									</module>
								</module>
							</checkstyleRules>
							<includeTestSourceDirectory>true</includeTestSourceDirectory>
							<!-- Checkstyle cannot parse module declarations. -->
							<excludes>**/module-info.java</excludes>
							<consoleOutput>true</consoleOutput>
							<violationSeverity>warning</violationSeverity>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.4.0</version>

				<configuration>
					<excludes>**/.srcexclude</excludes>
				</configuration>

				<executions>
					<execution>
						<id>attach-sources</id>
						<!--
							Attached in the package phase, so that the signing of the profile maven-central (inherited
							from tl-bom, bound to verify) covers the source archives.
						-->
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
							<goal>test-jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<skipTests>${skipTests}</skipTests>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-release-plugin</artifactId>
				<version>3.3.1</version>
				<configuration>
					<autoVersionSubmodules>true</autoVersionSubmodules>
					<tagNameFormat>TL_@{project.version}</tagNameFormat>
					<preparationGoals>clean install</preparationGoals>
				</configuration>
			</plugin>
			
			<plugin>
		        <groupId>org.codehaus.mojo</groupId>
		        <artifactId>exec-maven-plugin</artifactId>
		        
		        <executions>
					<execution>
						<id>normalize-layouts</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<skip>${skipNormalizeLayouts}</skip>
							
							<mainClass>com.top_logic.basic.xml.XMLPrettyPrinter</mainClass>
							<arguments>
								<argument>${tl.layoutDir}</argument>
							</arguments>
							
							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>false</addResourcesToClasspath>
						</configuration>
					</execution>

					<!--
						Inlining a templated layout. 
						
						The layout given as the `tl.layout` parameter is loaded, inlined and written back to the file 
						system. The layout must be given as path relative to the parent directory of the current module 
						(where the pom.xml is located).
						
						A valid command line would look as follows given that the module from which the goal is invoked
						is named `my-app` and the layout to inline is `my/path/to/myView.layout.xml`:
						
						mvn exec:java@inline-layout -Dtl.layout="my-app/src/main/webapp/WEB-INF/layouts/my/path/to/myView.layout.xml"
					-->
                    <execution>
						<id>inline-layout</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<mainClass>com.top_logic.layout.component.LayoutModelProcessor</mainClass>
							<arguments>
								<argument>-workspace</argument>
								<argument>${project.basedir}/..</argument>
								<argument>-webapp</argument>
								<argument>${project.basedir}/src/main/webapp</argument>
								<argument>-in</argument>
								<argument>${tl.layout}</argument>
								<argument>inline</argument>
							</arguments>

							<!-- Necessary to have servlet classes in the class path. -->							
							<classpathScope>test</classpathScope>

							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>false</addResourcesToClasspath>
						</configuration>
                    </execution>
					
					<execution>
						<id>migrate-ticket</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<mainClass>${tl.migrationClass}</mainClass>
							
							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>false</addResourcesToClasspath>
						</configuration>
					</execution>

					<!-- Run with mvn exec:java@migrate-ticket28336 -->
					<execution>
						<id>migrate-ticket28336</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<skip>${skipNormalizeLayouts}</skip>

							<mainClass>com.top_logic.layout.tools.ticket28336.UpgradeConfirmMessages</mainClass>
							<arguments>
								<argument>${tl.layoutDir}</argument>
							</arguments>
						    	
							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>true</addResourcesToClasspath>
						</configuration>
					</execution>

					<!-- Run with mvn exec:java@migrate-ticket28305 -->
					<execution>
						<id>migrate-ticket28305</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<skip>${skipNormalizeLayouts}</skip>

							<mainClass>com.top_logic.layout.tools.ticket28305.UpgradeDownloadNames</mainClass>
							<arguments>
								<argument>${tl.layoutDir}</argument>
							</arguments>
						    	
							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>true</addResourcesToClasspath>
						</configuration>
					</execution>

					<!-- Run with mvn exec:java@migrate-ticket29221 -->
					<execution>
						<id>migrate-ticket29221</id>
						<goals>
							<goal>java</goal>
						</goals>
						
						<configuration>
							<skip>${skipNormalizeLayouts}</skip>

							<mainClass>com.top_logic.layout.tools.ticket29221.MigrateTicket29221</mainClass>
							<arguments>
								<argument>${tl.layoutDir}</argument>
								<argument>${tl.confDir}</argument>
							</arguments>

							<includePluginDependencies>false</includePluginDependencies>
							<includeProjectDependencies>true</includeProjectDependencies>
							<addOutputToClasspath>true</addOutputToClasspath>
							<addResourcesToClasspath>true</addResourcesToClasspath>
						</configuration>
					</execution>
		        </executions>
			</plugin>

			<!-- Auto-update of dependencies, use: -->
			<!-- mvn versions:use-latest-releases versions:update-properties -DgenerateBackupPoms=false -->
			
			<!-- Check for plugin updates in tl-parent-all: -->
			<!-- mvn -N versions:display-plugin-updates -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>versions-maven-plugin</artifactId>
				
				<executions>
					<execution>
						<goals>
							<goal>use-latest-releases</goal>
							<goal>update-properties</goal>
						</goals>
					</execution>
				</executions>
						
				<configuration>
					<excludes>
					<!-- 
						<exclude>groupId:artifactId:*:*:version</exclude>
					-->
					</excludes>

          			<ruleSet>
						<ignoreVersions>
							<!-- Exclude alpha and milestone builds. -->
							<ignoreVersion>
								<type>regex</type>
								<version>(.+-alpha.*|.+-M\d|.+-RC.*)</version>
							</ignoreVersion>								
						</ignoreVersions>
						
						<rules>
							<rule>
								<groupId>org.apache.maven</groupId>
								
								<!-- Limit to Maven to 3.x -->
								<ignoreVersions>
									<ignoreVersion>
										<type>regex</type>
										<version>(?!3\.).*</version>
									</ignoreVersion>								
								</ignoreVersions>
							</rule>
							<rule>
								<groupId>org.apache.maven</groupId>
								<artifactId>maven-archiver</artifactId>

								<!-- Note: Newer versions have an issue with excessive memory consumption causing builds to fail when creating larger WAR artifacts. -->
								<!-- The issue declared to be fixed, but can still be observed: https://issues.apache.org/jira/browse/MSOURCES-94 -->
								<ignoreVersions>
									<ignoreVersion>
										<type>regex</type>
										<version>(?!3\.0\.0).*</version>
									</ignoreVersion>								
								</ignoreVersions>
							</rule>

							<rule>
								<groupId>org.codehaus.plexus</groupId>
								<artifactId>plexus-archiver</artifactId>
								<ignoreVersions>
									<ignoreVersion>
										<type>regex</type>
										<version>(?!2\.9\.).*</version>
									</ignoreVersion>								
								</ignoreVersions>
							</rule>
							<rule>
								<groupId>org.eclipse.jetty.ee11</groupId>
								
								<!-- Limit to Jetty 10 to avoid updating jakarta.servlet -->
								<ignoreVersions>
									<ignoreVersion>
										<type>regex</type>
										<version>(?!12\.).*</version>
									</ignoreVersion>
								</ignoreVersions>
							</rule>
							<rule>
								<groupId>org.apache.kafka</groupId>
								
								<!-- Limit to Kafka 3.9.x for compatibility -->
								<ignoreVersions>
									<ignoreVersion>
										<type>regex</type>
										<version>(?!3\.9\.).*</version>
									</ignoreVersion>
								</ignoreVersions>
							</rule>
						</rules>
					</ruleSet>					
				</configuration>
			</plugin>

			<!-- Check for well-known vulnerabilities. -->
			<!-- 
				Can be executed with `mvn dependency-check:check` in a certain module, or with 
				`dependency-check:aggregate` from the parent for all modules.
			-->
			<plugin>
			    <groupId>org.owasp</groupId>
			    <artifactId>dependency-check-maven</artifactId>
			    <version>12.2.2</version>
		        <configuration>
	                <format>ALL</format>
	                <skipProvidedScope>true</skipProvidedScope>
	                <suppressionFile>http://tl/trac/wiki/DependencyCheckSuppressions?format=txt</suppressionFile>
	                <suppressionFileServerId>tl-trac</suppressionFileServerId>
					<nvdApiServerId>nvd-api-key</nvdApiServerId>
		        </configuration>
			</plugin>
			
			<plugin>
			    <groupId>org.basepom.maven</groupId>
			    <artifactId>duplicate-finder-maven-plugin</artifactId>
			    <version>1.5.1</version>
			    
			    <configuration>
			    	<skip>${skipDependencyCheck}</skip>
			    	<ignoredResourcePatterns>
			    		<ignoredResourcePattern>about.html</ignoredResourcePattern>
			    	</ignoredResourcePatterns>
			    	<ignoredClassPatterns>
			    		<ignoredClassPattern>com\.sun\.activation\.registries\..*</ignoredClassPattern>
			    	</ignoredClassPatterns>
			    	<checkTestClasspath>false</checkTestClasspath>
			    </configuration>
			    
			    <executions>
			    	<execution>
			    		<id>check-classpath</id>
			    		
			    		<goals>
			    			<goal>check</goal>
			    		</goals>
			    	</execution>
			    </executions>
   			</plugin>
   			
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<executions>
					<execution>
						<id>enforce-maven</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireMavenVersion>
									<version>3.8.9</version>
								</requireMavenVersion>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
    
	        <plugin>
	            <groupId>org.revapi</groupId>
	            <artifactId>revapi-maven-plugin</artifactId>
	            <version>0.15.1</version>
	            <dependencies>
	                <dependency>
	                    <groupId>org.revapi</groupId>
	                    <artifactId>revapi-java</artifactId>
	                    <version>0.28.4</version>
	                </dependency>
	            </dependencies>
	            
                <configuration>
                	<failBuildOnProblemsFound>false</failBuildOnProblemsFound>

                	<!-- No compare, just consistency checks. -->
                	<oldVersion>${tl.version}</oldVersion>
					
                    <analysisConfiguration>
						<revapi.filter>
							<elements>
								<exclude>
									<item>
										<matcher>java</matcher>
										<match>@com.top_logic.basic.annotation.FrameworkInternal ^*;</match>
									</item>
									<item>
										<matcher>java</matcher>
										<match>
											match %field | %method;

											@com.top_logic.basic.annotation.FrameworkInternal
											type * {
												* %field=*;
												* %method=*(**);
											}
										</match>
									</item>
								</exclude>
							</elements>
						</revapi.filter>                    
                        <revapi.differences>
                            <differences>
                                <item>
                                    <regex>true</regex>
                                    <ignore>true</ignore>
                                    <code>java.class.externalClassExposedInAPI</code>
                                    <newArchive>.*:.*:.*</newArchive>
                                    <justification>
                                        Don't care about exposing external APIs.
                                    </justification>
                                </item>
                                <item>
                                    <regex>true</regex>
                                    <ignore>true</ignore>
                                    <code>java.class.nonPublicPartOfAPI</code>
                                    <newArchive>(?!com\.top-logic).*:.*:.*</newArchive>
                                    <justification>
                                        Don't care about exposing non-public API, if the problem is in an external dependency.
                                    </justification>
                                </item>
                                <item>
                                    <regex>true</regex>
                                    <ignore>true</ignore>
                                    <code>java.class.nonPublicPartOfAPI</code>
                                    <new>.*\.PackageProtected|.*\.Unimplementable</new>
                                    <justification>
                                        Here a non-public type is used explicitly to prevent direct usage from outside.
                                    </justification>
                                </item>
                            </differences>
                        </revapi.differences>
                    </analysisConfiguration>
                </configuration>
	        </plugin>
	        
			<!-- SpotBugs -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
				<!-- overwrite dependency on spotbugs if you want to specify the version of spotbugs -->
				<!-- <dependencies>
					<dependency>
						<groupId>com.github.spotbugs</groupId>
						<artifactId>spotbugs</artifactId>
						<version>4.8.3</version>
					</dependency>
				</dependencies> -->
				
				<!-- To run SpotBugs manually, add 'spotbugs:spotbugs' to a Maven command e.g. 
					'mvn clean verify spotbugs:spotbugs' or 'mvn clean install spotbugs:spotbugs'.
					You can run those commands inside the project you want to check or in 'tl-parent-all' to run it for all projects. -->
				<!-- Uncomment the executions section if you want SpotBugs to run automatically in the maven lifecycle (verify phase). -->
				<!-- <executions>
					<execution>
						<id>spotbugs-integration</id>
						<phase>verify</phase>
						<goals>
							<goal>spotbugs</goal>
						</goals>
					</execution>
				</executions> -->
			</plugin>
		</plugins>
		
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>3.6.0</version>
					<dependencies>
						<dependency>
							<groupId>com.puppycrawl.tools</groupId>
							<artifactId>checkstyle</artifactId>
							<version>10.21.4</version>
						</dependency>
					</dependencies>
				</plugin>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>1.15.4</version>
					<configuration>
						<nodeVersion>v${node.version}</nodeVersion>

						<!--
							One Node installation per version, shared by all frontend modules of the build. A
							version change installs into a new directory, never over an existing installation.
						-->
						<installDirectory>${maven.multiModuleProjectDirectory}/node/${node.version}</installDirectory>
					</configuration>
				</plugin>
				<plugin>
					<groupId>com.top-logic</groupId>
					<artifactId>tl-maven-plugin</artifactId>
					<version>${tl.version}</version>
				</plugin>
				<plugin>
