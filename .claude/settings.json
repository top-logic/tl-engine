{
  "enabledPlugins": {
    "tl-claude-tools@toplogic": true
  },
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(mvn *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/check-unused-imports.py\" --hook",
            "statusMessage": "Checking imports",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowWrite": [
        "~/.npm",
        "/tmp"
      ]
    },
    "network": {
      "allowedHosts": [
        "registry.npmjs.org",
        "api-free.deepl.com",
        "tl.bos.local",
        "nodejs.org",
        "dev.top-logic.com",
        "repo.maven.apache.org"
      ]
    }
  }
}
