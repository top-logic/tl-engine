<?xml version="1.0" encoding="utf-8" ?>

<!--
	Picks the project ticket a comment refers to and publishes it on the result channel. The
	editor the dialog was opened from inserts a link to that ticket at the cursor of the comment
	being written.
-->
<view>
	<channels>
		<channel name="ticket"/>
		<channel name="result"/>
	</channels>

	<window width="720px">
		<title>
			<en>Reference ticket</en>
			<de>Ticket referenzieren</de>
		</title>
		<table
			observed-types="tl.demo.projectManagement:Ticket"
			selection="ticket"
			types="tl.demo.projectManagement:Ticket"
		>
			<columns>
				<column attribute="title"/>
				<column attribute="milestone"/>
				<column attribute="assignee"/>
			</columns>
			<rows>all(`tl.demo.projectManagement:Ticket`)</rows>
		</table>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					input="ticket"
				>
					<label>
						<en>Insert</en>
						<de>Einfügen</de>
					</label>
					<executability>
						<null-input-disabled/>
					</executability>
					<write-channel name="result"/>
					<close-dialog/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>