<?xml version="1.0" encoding="utf-8" ?>

<!--
	First migration of the migration module tl-layout-view-agent. It changes no data: it records the
	version of the module, so that later migrations of its data reach existing databases.

	The module tl.agent with its access tokens is deleted by the migration
	Ticket_30558_remove_agent_access_tokens of tl-element, which reaches every database storing
	these tokens.
-->
<migration config:interface="com.top_logic.knowledge.service.migration.MigrationConfig"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<version name="Ticket_30367_remove_agent_access_tokens"
		module="tl-layout-view-agent"
	/>
	<dependencies>
		<dependency name="Ticket_29492_enlarge_layout_key"
			module="tl"
		/>
		<dependency name="Ticket_30183_account_lock"
			module="tl-element"
		/>
		<dependency name="Ticket_28710_Added_TLSearch"
			module="tl-model-search"
		/>
		<dependency name="Ticket_27736_Upgrade_layout"
			module="tl-monitoring"
		/>
	</dependencies>
	<processors/>
</migration>
