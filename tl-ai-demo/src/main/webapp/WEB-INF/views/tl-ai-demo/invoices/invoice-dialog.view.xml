<?xml version="1.0" encoding="utf-8" ?>

<!--
	An invoice of an event, opened from the invoices tab of events/event-detail.view.xml: the same
	content as invoice-detail.view.xml, in a dialog that edits the row inside the event's form.
-->
<view>
	<channels>
		<channel name="invoice"/>
		<channel name="editMode"/>
	</channels>
	<window width="760px">
		<title>
			<en>Invoice</en>
			<de>Rechnung</de>
		</title>
		<form
			editMode="editMode"
			input="invoice"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="invoiceNumber"/>
			<field attribute="direction"/>
			<field attribute="status"/>
			<field attribute="invoiceDate"/>
			<field attribute="dueDate"/>
			<field attribute="counterparty"/>
			<field attribute="currency"/>
			<field attribute="taxRate"/>
			<field attribute="netAmount"/>
			<field attribute="grossAmount"/>
			<composition-table attribute="lines">
				<columns>
					<column attribute="description"/>
					<column attribute="quantity"/>
					<column attribute="unitPrice"/>
					<column attribute="lineTotal"/>
				</columns>
			</composition-table>
			<field attribute="scan"/>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>OK</en>
						<de>OK</de>
					</label>
					<store-form-state/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
