<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.units.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.units.model.xml"/>
				</declarations>
			</instance>
		</config>
		<!--
			Units and currencies inherit the roles held on the security root, so that the grants
			an application declares on the module tl.units take effect for them.
		-->
		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<security-parents>
					<rule
						id="SecRootForUnit"
						inherit="true"
						meta-element="tl.units:AbstractUnit"
					>
						<singleton module="SecurityStructure"/>
					</rule>
				</security-parents>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system 
					name="Default"
				>
					<declarations>
						<declaration resource="webinf://kbase/UnitMeta_inc.xml"/>
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>