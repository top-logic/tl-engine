<?xml version="1.0" encoding="utf-8" ?>

<!--
	Edits the access rights of one model element of the model based access definition. The rights
	channel carries the configuration the opening command produced - the entry the application
	stores for the selected type or for its module - and the configuration form writes the entries
	straight into it. What is edited here are the additions the application makes: the grants are
	appended to the grants of the underlying configuration layers, the marks override the ones those
	layers set. Save hands the configuration to the editor, which stores it in the application
	configuration, and marks the pending channel: the stored definition differs from the running one
	until the coverage display applies it.
	
	The name of the entry is the type or module the dialog was opened for, so it is shown but not
	editable (mode immutable).
	
	Save first checks the form (check-config-form): a mandatory value missing, a constraint failing
	or an entry the field rejected - a script that does not parse - is put on its field and keeps
	the dialog open; while such a problem is on display, Save is disabled (config-form-valid).
-->
<view>
	<channels>
		<channel name="rights"/>
		<channel name="pending"/>
	</channels>
	<window width="800px">
		<title>
			<en>Access rights</en>
			<de>Zugriffsrechte</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-check-lg"
				input="rights"
				placement="BUTTON_BAR"
			>
				<label>
					<en>Save</en>
					<de>Speichern</de>
				</label>
				<executability>
					<config-form-valid/>
				</executability>
				<check-config-form/>
				<action class="com.top_logic.layout.view.admin.SecurityDefinitionAction"
					mode="SAVE_ACCESS_RIGHTS"
				/>
				<write-channel name="pending"/>
				<close-dialog/>
			</generic-command>
		</commands>
		<inset>
			<config-form
				input="rights"
				withEditMode="false"
			>
				<fields>
					<field name="name"
						mode="immutable"
					/>
				</fields>
			</config-form>
		</inset>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>