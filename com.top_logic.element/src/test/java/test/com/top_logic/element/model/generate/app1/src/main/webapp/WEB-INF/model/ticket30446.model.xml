<?xml version="1.0" encoding="UTF-8"?>

<model 
	xmlns="http://www.top-logic.com/ns/dynamic-types/6.0"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<modules>
		<!-- Getter clashes with Wrapper.getLastModified() inherited by the implementation class. -->
		<module name="ticket30446.lastModified">
			<annotations>
				<annotation config:interface="com.top_logic.model.config.JavaPackage"
					interface-package="test.ticket30446.lastmodified"
					implementation-package="test.ticket30446.lastmodified.impl"
				/>
			</annotations>
			<types>
				<class name="Device">
					<attributes>
						<property name="lastModified"
							type="tl.core:DateTime"
						/>
					</attributes>
				</class>
			</types>
		</module>

		<!-- Getter clashes with TLScope.getTypes() inherited through tl.element:StructuredElement. -->
		<module name="ticket30446.types">
			<annotations>
				<annotation config:interface="com.top_logic.model.config.JavaPackage"
					interface-package="test.ticket30446.types"
					implementation-package="test.ticket30446.types.impl"
				/>
			</annotations>
			<types>
				<class name="Item"/>
				<class name="Folder">
					<generalizations>
						<generalization type="tl.element:StructuredElement"/>
					</generalizations>
					<attributes>
						<reference name="types"
							multiple="true"
							type="Item"
						/>
					</attributes>
				</class>
			</types>
		</module>

		<!-- Generated without clashes. -->
		<module name="ticket30446.valid">
			<annotations>
				<annotation config:interface="com.top_logic.model.config.JavaPackage"
					interface-package="test.ticket30446.valid"
					implementation-package="test.ticket30446.valid.impl"
				/>
			</annotations>
			<types>
				<class name="Device">
					<attributes>
						<property name="lastModified"
							type="tl.core:DateTime"
						>
							<annotations>
								<java-name value="configurationChanged"/>
							</annotations>
						</property>
					</attributes>
				</class>
				<class name="Item"/>
				<class name="Folder">
					<generalizations>
						<generalization type="tl.element:StructuredElement"/>
					</generalizations>
					<attributes>
						<reference name="types"
							multiple="true"
							type="Item"
						>
							<annotations>
								<java-name value="itemTypes"/>
							</annotations>
						</reference>
					</attributes>
				</class>
				<class name="Named">
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
					</attributes>
				</class>
				<class name="Container">
					<attributes>
						<reference name="entries"
							multiple="true"
							type="Container"
						/>
					</attributes>
				</class>
				<class name="SpecialContainer">
					<generalizations>
						<generalization type="Container"/>
					</generalizations>
					<attributes>
						<reference name="entries"
							override="true"
							type="SpecialContainer"
						/>
					</attributes>
				</class>
			</types>
		</module>
	</modules>
</model>
