<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-alpha13.827</version>
  </parent>

  <artifactId>tl-oauth-server</artifactId>
  <name>${project.artifactId}</name>
  <description>OAuth 2.1 authorization server of the application: authorization server metadata, token endpoint (authorization code with PKCE, rotating refresh tokens, resource indicators), client ID metadata documents and dynamic client registration, and an authentication scheme accepting its access tokens at MCP, A2A and OpenAPI endpoints; based on the Nimbus OAuth 2.0 SDK.</description>
  <url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
    </dependency>
    <!-- The random bearer secrets and their hashes (SecretTokens). -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-element</artifactId>
    </dependency>
    <!-- The pluggable authentication of HTTP endpoints, which the OAuth access token authentication plugs into. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-service-openapi-server</artifactId>
    </dependency>
    <!-- The TL-Script functions of the consent page. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-model-search</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>oauth2-oidc-sdk</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
    </dependency>
    <!-- Writes the protected resource metadata, see resource.proto. -->
    <dependency>
      <groupId>de.haumacher.msgbuf</groupId>
      <artifactId>msgbuf-api</artifactId>
    </dependency>
    <!-- Fetches client ID metadata documents; its DnsResolver hook pins the connection to the
         addresses checked to be public. -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic-db-schema</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.top-logic</groupId>
        <artifactId>tl-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-binding</id>
            <phase>none</phase>
            <goals>
              <goal>generate-java</goal>
            </goals>
            <configuration>
              <modules>tl.oauth.server</modules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>de.haumacher.msgbuf</groupId>
        <artifactId>msgbuf-generator-maven-plugin</artifactId>
        <version>${msgbuf.version}</version>
        <executions>
          <execution>
            <id>generate-protocols</id>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
