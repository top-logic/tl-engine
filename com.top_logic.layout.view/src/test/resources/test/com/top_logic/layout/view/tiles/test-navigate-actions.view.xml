<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="navPath"/>
		<derived-channel name="depth"
			expr="p -> $p.size()"
			inputs="navPath"
		/>
	</channels>
	<panel title="Navigate Actions Test">
		<commands>
			<generic-command name="back"
				input="depth"
			>
				<executability>
					<visible-if expr="d -> $d > 0"/>
				</executability>
				<navigate-pop/>
			</generic-command>
			<generic-command name="home">
				<navigate-pop-to depth="1"/>
			</generic-command>
			<navigate-pop name="popCommand"/>
			<navigate-pop-to name="popToCommand"
				depth="2"
			/>
		</commands>
		<tile-stack
			bind-path-to="navPath"
			initial="tiles/overview.view.xml"
			path="navPath"
		/>
	</panel>
</view>