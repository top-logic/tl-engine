<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.security.pac4j.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.security.pac4j.model.xml"/>
					<!--
						The identities of an account at external logins, added to tl.accounts:Person as a
						composite reference, so that deleting an account deletes its identities. Kept in its
						own file because it extends a type this module does not own.
					-->
					<declaration file="/WEB-INF/model/tl-security-auth-pac4j/extension.tl.accounts.model.xml"/>
				</declarations>
			</instance>
		</config>
	</services>
</application>
