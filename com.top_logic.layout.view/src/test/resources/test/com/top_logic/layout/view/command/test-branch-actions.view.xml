<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="ticket"/>
		<channel name="branchInput"/>
	</channels>
	<panel title="Branch Actions Test">
		<commands>
			<generic-command name="decide"
				input="ticket"
			>
				<if test="context -> ticket -> $ticket != null">
					<inputs>
						<input channel="branchInput"/>
					</inputs>
					<then>
						<execute-script function="t -> $t"/>
					</then>
					<else>
						<write-channel name="ticket"/>
					</else>
				</if>
				<execute-script function="t -> $t"/>
			</generic-command>
			<generic-command name="select"
				input="ticket"
			>
				<switch value="t -> $t">
					<case match="`demo.tickets:TicketStatus#closed`">
						<execute-script function="t -> $t"/>
					</case>
					<case test="s -> $s == 'open'">
						<execute-script function="t -> $t"/>
					</case>
					<default>
						<write-channel name="ticket"/>
					</default>
				</switch>
			</generic-command>
			<generic-command name="classify"
				input="ticket"
			>
				<switch>
					<case test="t -> $t == null">
						<write-channel name="ticket"/>
					</case>
				</switch>
			</generic-command>
		</commands>
	</panel>
</view>
