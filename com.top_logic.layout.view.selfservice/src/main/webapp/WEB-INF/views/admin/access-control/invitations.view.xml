<?xml version="1.0" encoding="utf-8" ?>

<!--
	The administration of the invitations (tl.security.selfservice:Invitation): all invitations
	with their state, newest first, inviting a new address, sending an invitation again and
	revoking one. An accepted invitation is the record of the account created from it and is
	deleted with that account: it is not sent again, and instead of revoking the invitation,
	"Revoke access" removes its account (the contact data of the person remain).

	Ids for overlays: the panel "list-panel" and the table "table".
-->
<view>
	<channels>
		<channel name="selectedInvitation"/>
		<!--
			What "Revoke access" deletes: the account of the selected invitation, or the invitation
			itself if it has no account.
		-->
		<derived-channel name="invitationRevokeTarget"
			expr="if($selectedInvitation == null, null, if($selectedInvitation.get(`tl.security.selfservice:Invitation#account`) == null, $selectedInvitation, $selectedInvitation.get(`tl.security.selfservice:Invitation#account`)))"
			inputs="selectedInvitation"
			observed-types="tl.security.selfservice:Invitation,tl.accounts:Person"
		/>
	</channels>
	<panel id="list-panel">
		<title>
			<en>Invitations</en>
			<de>Einladungen</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-envelope-plus"
				placement="TOOLBAR"
			>
				<label>
					<en>Invite</en>
					<de>Einladen</de>
				</label>
				<create-transient type="tl.security.selfservice:Invitation">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="admin/access-control/create-invitation.view.xml"
						>
							<bind
								channel="selection"
								to="selectedInvitation"
							/>
						</open-dialog>
					</with-result>
				</create-transient>
			</generic-command>
			<!--
				An open invitation is sent with its link, an expired one gets a new link and a new
				expiry date first (invitationResend).
			-->
			<generic-command
				image="css:bi bi-send"
				inputs="selectedInvitation"
				placement="TOOLBAR"
			>
				<label>
					<en>Send again</en>
					<de>Erneut senden</de>
				</label>
				<access>
					<operation name="Write"
						object="$selectedInvitation"
						type="tl.security.selfservice:Invitation"
					/>
				</access>
				<executability>
					<null-input-disabled/>
					<disabled-if expr="if($selectedInvitation.get(`tl.security.selfservice:Invitation#state`) == `tl.security.selfservice:InvitationState#ACCEPTED`, #('The invitation has been accepted, the account exists.'@en, 'Die Einladung wurde angenommen, das Konto besteht.'@de), null)"/>
				</executability>
				<execute-script function="invitationResend($selectedInvitation)">
					<with-result as="sent">
						<if test="$sent == false">
							<then>
								<notify
									expr="#('The invitation to {0} could not be sent.'@en, 'Die Einladung an {0} konnte nicht versendet werden.'@de).fill($selectedInvitation.get(`tl.security.selfservice:Invitation#email`))"
									kind="warning"
								/>
							</then>
							<else>
								<notify expr="#('The invitation has been sent to {0} again.'@en, 'Die Einladung wurde erneut an {0} versendet.'@de).fill($selectedInvitation.get(`tl.security.selfservice:Invitation#email`))"/>
							</else>
						</if>
					</with-result>
				</execute-script>
			</generic-command>
			<!-- Shown for an open or expired invitation, replaced by "Revoke access" for an accepted one. -->
			<generic-command
				image="css:bi bi-x-circle"
				inputs="selectedInvitation"
				placement="TOOLBAR"
			>
				<label>
					<en>Revoke invitation</en>
					<de>Zurückziehen</de>
				</label>
				<executability>
					<visible-if expr="$selectedInvitation.get(`tl.security.selfservice:Invitation#state`) != `tl.security.selfservice:InvitationState#ACCEPTED`"/>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Revoke the invitation to {0}? Its link no longer works.'@en, 'Die Einladung an {0} zurückziehen? Ihr Link funktioniert dann nicht mehr.'@de).fill($selectedInvitation.get(`tl.security.selfservice:Invitation#email`))"/>
				<delete-object/>
				<write-channel name="selectedInvitation"
					clear="true"
				/>
			</generic-command>
			<!--
				Shown for an accepted invitation: removes the login created with the invitation, which
				deletes the invitation with it. Only the account is deleted, the contact data of the
				person remain. An accepted invitation without account is deleted itself.
			-->
			<generic-command name="revoke-access"
				image="css:bi bi-person-x"
				inputs="invitationRevokeTarget, selectedInvitation"
				placement="TOOLBAR"
			>
				<label>
					<en>Revoke access</en>
					<de>Widerrufen</de>
				</label>
				<executability>
					<visible-if expr="$selectedInvitation.get(`tl.security.selfservice:Invitation#state`) == `tl.security.selfservice:InvitationState#ACCEPTED`"/>
					<null-input-disabled/>
					<disabled-if expr="if($invitationRevokeTarget == currentUser(), #('A user cannot delete himself.'@en, 'Ein Benutzer kann sich nicht selber löschen.'@de), null)"/>
					<disabled-if expr="if($invitationRevokeTarget.instanceOf(`tl.accounts:Person`) and $invitationRevokeTarget.get(`tl.accounts:Person#admin`), #('An administrator cannot be deleted.'@en, 'Ein Administrator kann nicht gelöscht werden.'@de), null)"/>
				</executability>
				<confirm expr="if($invitationRevokeTarget.instanceOf(`tl.accounts:Person`), #('Remove the login of {0}? The invitation is removed with it, the contact data is kept.'@en, 'Den Login von {0} entfernen? Die Einladung wird mit entfernt, die Kontaktdaten bleiben erhalten.'@de).fill($selectedInvitation.get(`tl.security.selfservice:Invitation#email`)), #('Remove the invitation to {0}?'@en, 'Die Einladung an {0} entfernen?'@de).fill($selectedInvitation.get(`tl.security.selfservice:Invitation#email`)))"/>
				<delete-object/>
				<write-channel name="selectedInvitation"
					clear="true"
				/>
			</generic-command>
		</commands>
		<table id="table"
			observed-types="tl.security.selfservice:Invitation"
			selection="selectedInvitation"
			types="tl.security.selfservice:Invitation"
		>
			<columns>
				<column attribute="email"
					width="200"
				/>
				<column attribute="language"
					width="120"
				/>
				<column attribute="state"
					width="140"
				/>
				<column attribute="expires"
					width="150"
				/>
				<column attribute="createdAt"
					sort="DESC"
					width="150"
				/>
				<column attribute="createdBy"
					width="160"
				/>
				<column attribute="accepted"
					width="150"
				/>
				<column attribute="account"
					width="180"
				/>
				<column attribute="mfaRequirement"
					width="190"
				/>
			</columns>
			<rows>all(`tl.security.selfservice:Invitation`)</rows>
			<export download-name="#('Invitations'@en, 'Einladungen'@de)">
				<sheet-name>
					<en>Invitations</en>
					<de>Einladungen</de>
				</sheet-name>
			</export>
		</table>
	</panel>
</view>