<?xml version="1.0" encoding="utf-8" ?>

<!--
	The kinds of column a <table> declares, each in a tab of its own, over the project-management
	model.
	
	"Map rows" shows a table whose rows are dictionaries instead of model objects: every column is
	computed, and the table needs no row type at all. "Transient rows" shows a table over objects
	that were never persisted. "Embedded columns" shows the columns of the object a row points to
	as columns of the row. "Dynamic columns" shows one column per milestone, decided by the data.
	"Conditional columns" shows columns that exist only while a switch is on. "Group order" shows
	groups ordered by a comparator the grouping column declares, "Row order" groups by a column
	declared with sortable="false", whose groups follow the order of the rows.
	"Editable column" edits a computed column through its update function. "Default columns" shows
	what a table displays when it declares no columns: the main properties of its row type. "Mixed
	row types" shows milestones and tickets in one table, each attribute column taking its label, sort
	order and filter from the row type that holds the attribute.
	
	A column declared with visible="false" ("Share" in "Map rows", "Due date" in "Transient rows"),
	and a dynamic column its column-visible function rejects ("M3" in "Dynamic columns"), starts out
	hidden and is offered in the column selection.
-->
<view>
	<channels>
		<!-- Anchor object of the editable table's form: the edit session locks on it. -->
		<derived-channel name="editAnchor"
			expr="currentUser()"
		/>
		<!-- Whether the conditional columns of the "Conditional columns" tab exist. -->
		<channel name="showApproved"/>
	</channels>
	<tab-bar active-tab="map-rows">
		<tabs>
			<tab id="map-rows"
				icon="css:bi bi-braces"
			>
				<label>
					<en>Map rows</en>
					<de>Map-Zeilen</de>
				</label>
				<panel>
					<title>
						<en>Computed columns over map rows</en>
						<de>Berechnete Spalten über Map-Zeilen</de>
					</title>
					<!--
						The rows are dictionaries built per milestone, so no model type describes them and
						every column computes its value from the row. The declared type of a computed column
						decides how its values are displayed, sorted and filtered, and what a group row
						aggregates. The share column is declared with visible="false": it starts out
						hidden and is offered in the column selection.
					-->
					<table personalization-key="table-columns-map-rows">
						<columns>
							<computed-column name="name"
								sort="ASC"
								type="tl.core:String"
							>
								<label>
									<en>Milestone</en>
									<de>Meilenstein</de>
								</label>
								<value><![CDATA[$row["name"]]]></value>
							</computed-column>
							<computed-column name="count"
								type="tl.core:Integer"
							>
								<label>
									<en>Tickets</en>
									<de>Tickets</de>
								</label>
								<value><![CDATA[$row["count"]]]></value>
								<aggregate><![CDATA[$members.map(r -> $r["count"]).sum()]]></aggregate>
							</computed-column>
							<computed-column name="share"
								type="tl.core:Double"
								visible="false"
							>
								<label>
									<en>Share</en>
									<de>Anteil</de>
								</label>
								<value><![CDATA[if($row["total"] == 0, 0, $row["count"] / $row["total"])]]></value>
							</computed-column>
						</columns>
						<rows><![CDATA[{
	milestones = all(`tl.demo.projectManagement:Milestone`);
	total = $milestones.map(m -> $m.get(`tl.demo.projectManagement:Milestone#tickets`).size()).sum();
	$milestones.map(m -> {
		"name": $m.get(`tl.demo.projectManagement:Milestone#name`),
		"count": $m.get(`tl.demo.projectManagement:Milestone#tickets`).size(),
		"total": $total
	});
}]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="transient-rows"
				icon="css:bi bi-cloud"
			>
				<label>
					<en>Transient rows</en>
					<de>Transiente Zeilen</de>
				</label>
				<panel>
					<title>
						<en>Attribute and computed columns over transient rows</en>
						<de>Attribut- und berechnete Spalten über transienten Zeilen</de>
					</title>
					<!--
						The rows are milestones that were never persisted. They are displayed by the same
						columns a table of persistent milestones uses; the computed column reads a reference
						that a transient object does not hold, which is empty rather than an error. The due
						date column is declared with visible="false": it starts out hidden and is offered in
						the column selection.
					-->
					<table
						personalization-key="table-columns-transient"
						types="tl.demo.projectManagement:Milestone"
					>
						<columns>
							<column
								attribute="name"
								sort="ASC"
							/>
							<column
								attribute="dueDate"
								visible="false"
							/>
							<computed-column name="ticketCount"
								type="tl.core:Integer"
							>
								<label>
									<en>Tickets</en>
									<de>Tickets</de>
								</label>
								<value><![CDATA[$row.get(`tl.demo.projectManagement:Milestone#tickets`).size()]]></value>
							</computed-column>
						</columns>
						<rows><![CDATA[count(4).map(i -> {
	m = new(`tl.demo.projectManagement:Milestone`, transient: true);
	$m.set(`tl.demo.projectManagement:Milestone#name`, "Draft " + ($i + 1));
	$m.set(`tl.demo.projectManagement:Milestone#dueDate`, date(2026, ($i * 3) + 1, 15));
	$m;
})]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="embedded-columns"
				icon="css:bi bi-box-arrow-in-down-right"
			>
				<label>
					<en>Embedded columns</en>
					<de>Eingebettete Spalten</de>
				</label>
				<panel>
					<title>
						<en>Columns of a referenced object</en>
						<de>Spalten eines referenzierten Objekts</de>
					</title>
					<!--
						The assignee's name is shown as a column of the ticket: the embedding names the
						reference, the nested declaration resolves against the person contact type, and the
						header reads "Assignee / Name". The remaining attributes of the contact are
						offered in the column selection, hidden until the user picks one. The second
						embedding walks two references, the last of them holding several objects, so its
						cells collect the titles of all tickets of the ticket's milestone. The computed
						column beside it reaches the same titles through an expression and declares that
						its cells hold several values, so each of them is shown as a value of its own.
					-->
					<table
						observed-types="tl.demo.projectManagement:Ticket"
						personalization-key="table-columns-embedded"
						types="tl.demo.projectManagement:Ticket"
					>
						<columns>
							<column
								attribute="title"
								sort="ASC"
							/>
							<embedded-columns reference="assignee">
								<column attribute="name"/>
							</embedded-columns>
							<embedded-columns reference="milestone.tickets">
								<column attribute="title"/>
							</embedded-columns>
							<computed-column name="milestoneTitles"
								multiple="true"
								type="tl.core:String"
								width="240"
							>
								<label>
									<en>Titles in the milestone</en>
									<de>Titel im Meilenstein</de>
								</label>
								<value><![CDATA[$row.get(`tl.demo.projectManagement:Ticket#milestone`)
	.get(`tl.demo.projectManagement:Milestone#tickets`)
	.map(x -> $x.get(`tl.demo.projectManagement:Ticket#title`))]]></value>
							</computed-column>
						</columns>
						<rows><![CDATA[all(`tl.demo.projectManagement:Ticket`)]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="dynamic-columns"
				icon="css:bi bi-layout-three-columns"
			>
				<label>
					<en>Dynamic columns</en>
					<de>Dynamische Spalten</de>
				</label>
				<panel>
					<title>
						<en>One column per milestone</en>
						<de>Eine Spalte je Meilenstein</de>
					</title>
					<!--
						Which columns there are is decided by the data: one per milestone, each showing how
						many tickets assigned to the contact belong to it. The table starts grouped by the
						computed initial column, so the sum every milestone column aggregates over the rows
						of a group is visible in its header row. The column-visible function hides the
						column of milestone M3 at the start (M1 and M2 are shown); it is offered in the
						column selection.
					-->
					<table
						group-by="initial"
						observed-types="Contacts:PersonContact,tl.demo.projectManagement:Ticket"
						personalization-key="table-columns-dynamic"
						row-as="contact"
						types="Contacts:PersonContact"
					>
						<columns>
							<column
								attribute="name"
								sort="ASC"
							/>
							<computed-column name="initial"
								type="tl.core:String"
								width="120"
							>
								<label>
									<en>Initial</en>
									<de>Anfangsbuchstabe</de>
								</label>
								<value><![CDATA[$contact.get(`Contacts:PersonContact#name`).subString(0, 1)]]></value>
							</computed-column>
							<dynamic-columns name="milestones"
								column-as="milestone"
								readonly="true"
								type="tl.core:Integer"
								width="120"
							>
								<columns><![CDATA[all(`tl.demo.projectManagement:Milestone`)]]></columns>
								<column-name><![CDATA[$milestone.get(`tl.demo.projectManagement:Milestone#name`)]]></column-name>
								<column-label><![CDATA[$milestone.get(`tl.demo.projectManagement:Milestone#name`)]]></column-label>
								<column-visible><![CDATA[$milestone.get(`tl.demo.projectManagement:Milestone#name`) != "M3"]]></column-visible>
								<value><![CDATA[$contact.referers(`tl.demo.projectManagement:Ticket#assignee`)
	.filter(t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`) == $milestone)
	.size()]]></value>
								<aggregate><![CDATA[$members
	.map(c -> $c.referers(`tl.demo.projectManagement:Ticket#assignee`)
		.filter(t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`) == $milestone)
		.size())
	.sum()]]></aggregate>
							</dynamic-columns>
						</columns>
						<rows><![CDATA[all(`Contacts:PersonContact`)]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="conditional-columns"
				icon="css:bi bi-toggles"
			>
				<label>
					<en>Conditional columns</en>
					<de>Bedingte Spalten</de>
				</label>
				<panel with-inset="true">
					<title>
						<en>Columns that exist while a switch is on</en>
						<de>Spalten, die existieren, solange ein Schalter an ist</de>
					</title>
					<!--
						The switch writes the channel showApproved. While it is off, the ticket total column
						(exists-if) and the columns of approved milestones (column-exists-if, per milestone)
						do not exist: they are neither displayed nor offered in the column selection. Both
						declarations name the channel as their input, as a computed or dynamic column sees
						only its own inputs. Turning the switch on adds them to the table without building
						it again; the user's arrangement of them is kept while they are absent.
					-->
					<fields>
						<value-input
							type="tl.core:Boolean"
							value="showApproved"
						>
							<label>
								<en>Show totals and approved milestones</en>
								<de>Summen und freigegebene Meilensteine anzeigen</de>
							</label>
							<input-control class="com.top_logic.layout.view.form.BooleanControlProvider"
								display="switch"
							/>
						</value-input>
					</fields>
					<table
						observed-types="Contacts:PersonContact,tl.demo.projectManagement:Ticket"
						personalization-key="table-columns-conditional"
						row-as="contact"
						types="Contacts:PersonContact"
					>
						<columns>
							<column
								attribute="name"
								sort="ASC"
							/>
							<computed-column name="total"
								exists-if="$showApproved"
								inputs="showApproved"
								type="tl.core:Integer"
								width="120"
							>
								<label>
									<en>Tickets in total</en>
									<de>Tickets insgesamt</de>
								</label>
								<value><![CDATA[$contact.referers(`tl.demo.projectManagement:Ticket#assignee`).size()]]></value>
							</computed-column>
							<dynamic-columns name="milestones"
								column-as="milestone"
								column-exists-if="$showApproved || !$milestone.get(`tl.demo.projectManagement:Milestone#approved`)"
								inputs="showApproved"
								readonly="true"
								type="tl.core:Integer"
								width="120"
							>
								<columns><![CDATA[all(`tl.demo.projectManagement:Milestone`)]]></columns>
								<column-name><![CDATA[$milestone.get(`tl.demo.projectManagement:Milestone#name`)]]></column-name>
								<column-label><![CDATA[$milestone.get(`tl.demo.projectManagement:Milestone#name`)]]></column-label>
								<value><![CDATA[$contact.referers(`tl.demo.projectManagement:Ticket#assignee`)
	.filter(t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`) == $milestone)
	.size()]]></value>
							</dynamic-columns>
						</columns>
						<rows><![CDATA[all(`Contacts:PersonContact`)]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="group-order"
				icon="css:bi bi-sort-down"
			>
				<label>
					<en>Group order</en>
					<de>Gruppenreihenfolge</de>
				</label>
				<panel>
					<title>
						<en>Groups in a declared order</en>
						<de>Gruppen in deklarierter Reihenfolge</de>
					</title>
					<!--
						The table starts grouped by the computed load column, which classifies a contact
						by the number of assigned tickets. Its comparator orders the classes none, few, many -
						alphabetically they would read few, many, none. The ticket column sums the tickets
						of a group in its header row.
					-->
					<table
						group-by="load"
						observed-types="Contacts:PersonContact,tl.demo.projectManagement:Ticket"
						personalization-key="table-columns-group-order"
						types="Contacts:PersonContact"
					>
						<columns>
							<column
								attribute="name"
								sort="ASC"
							/>
							<computed-column name="load"
								type="tl.core:String"
								width="120"
							>
								<label>
									<en>Load</en>
									<de>Auslastung</de>
								</label>
								<value><![CDATA[{
	count = $row.referers(`tl.demo.projectManagement:Ticket#assignee`).size();
	switch {
		$count == 0: "none";
		$count <= 2: "few";
		default: "many";
	};
}]]></value>
								<comparator><![CDATA[{
	rank = load -> switch ($load) {
		"none": 0;
		"few": 1;
		default: 2;
	};
	compare($rank($left), $rank($right));
}]]></comparator>
							</computed-column>
							<computed-column name="tickets"
								type="tl.core:Integer"
								width="120"
							>
								<label>
									<en>Tickets</en>
									<de>Tickets</de>
								</label>
								<value><![CDATA[$row.referers(`tl.demo.projectManagement:Ticket#assignee`).size()]]></value>
								<aggregate><![CDATA[$members
	.map(c -> $c.referers(`tl.demo.projectManagement:Ticket#assignee`).size())
	.sum()]]></aggregate>
							</computed-column>
						</columns>
						<rows><![CDATA[all(`Contacts:PersonContact`)]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="row-order"
				icon="css:bi bi-list-ol"
			>
				<label>
					<en>Row order</en>
					<de>Zeilenreihenfolge</de>
				</label>
				<panel>
					<title>
						<en>Groups in the order of their rows</en>
						<de>Gruppen in der Reihenfolge ihrer Zeilen</de>
					</title>
					<!--
						The table starts grouped by the milestone column, which is declared with
						sortable="false": it offers no sorting, and its groups come in the order of the rows
						the table is given. The rows are the tickets in descending order of their title, so the
						milestone of the last ticket in alphabetical order comes first, not the milestones in
						alphabetical order. Sorting the table by the title keeps the groups in that order and
						only orders the tickets within each group.
					-->
					<table
						group-by="milestone"
						personalization-key="table-columns-row-order"
						types="tl.demo.projectManagement:Ticket"
					>
						<columns>
							<column attribute="title"/>
							<column
								attribute="milestone"
								sortable="false"
							/>
						</columns>
						<rows><![CDATA[all(`tl.demo.projectManagement:Ticket`)
	.sort(x -> y -> compare($y.get(`tl.demo.projectManagement:Ticket#title`), $x.get(`tl.demo.projectManagement:Ticket#title`)))]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="editable-column"
				icon="css:bi bi-pencil-square"
			>
				<label>
					<en>Editable column</en>
					<de>Editierbare Spalte</de>
				</label>
				<panel>
					<title>
						<en>Editing a computed column</en>
						<de>Bearbeiten einer berechneten Spalte</de>
					</title>
					<!--
						The mail column computes its value from the contact and writes an edited one back
						through its update function. The control the value is entered with follows from the
						declared type; the edit is buffered on the row and applied when the form is saved.
					-->
					<form input="editAnchor">
						<table
							observed-types="Contacts:PersonContact,tl.demo.projectManagement:Ticket"
							personalization-key="table-columns-editable"
							row-edit="ALL"
							types="Contacts:PersonContact"
						>
							<columns>
								<column
									attribute="name"
									sort="ASC"
								/>
								<computed-column name="mail"
									type="tl.core:String"
								>
									<label>
										<en>Mail</en>
										<de>Mail</de>
									</label>
									<value><![CDATA[$row.get(`Contacts:PersonContact#email`)]]></value>
									<update><![CDATA[$row.set(`Contacts:PersonContact#email`, $value)]]></update>
									<can-update><![CDATA[$row.get(`Contacts:PersonContact#name`) != null]]></can-update>
								</computed-column>
							</columns>
							<rows><![CDATA[all(`Contacts:PersonContact`)]]></rows>
						</table>
					</form>
				</panel>
			</tab>
			<tab id="default-columns"
				icon="css:bi bi-card-checklist"
			>
				<label>
					<en>Default columns</en>
					<de>Standardspalten</de>
				</label>
				<panel>
					<title>
						<en>The columns a table derives from its row type</en>
						<de>Die Spalten, die eine Tabelle aus ihrem Zeilentyp ableitet</de>
					</title>
					<!--
						The table declares no columns, so it shows the main properties of the milestone type
						and offers the rest of its attributes in the column selection.
					-->
					<table
						observed-types="tl.demo.projectManagement:Milestone"
						personalization-key="table-columns-default"
						types="tl.demo.projectManagement:Milestone"
					>
						<rows><![CDATA[all(`tl.demo.projectManagement:Milestone`)]]></rows>
					</table>
				</panel>
			</tab>
			<tab id="mixed-row-types"
				icon="css:bi bi-intersect"
			>
				<label>
					<en>Mixed row types</en>
					<de>Gemischte Zeilentypen</de>
				</label>
				<panel>
					<title>
						<en>Attribute columns over rows of two types</en>
						<de>Attributspalten über Zeilen zweier Typen</de>
					</title>
					<!--
						The rows are all milestones and all tickets. Each attribute column is resolved at the
						first row type holding the attribute: name and due date at the milestone, title and
						number at the ticket, although the milestone is the first row type of the table. The
						column takes its label, its sort order and its filter from that attribute, so the
						number column sorts and filters numerically. A row whose type lacks the attribute
						shows an empty cell, which comes last in both sort directions.
					-->
					<table
						observed-types="tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
						personalization-key="table-columns-mixed-types"
						types="tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="title"/>
							<column attribute="number"/>
							<column attribute="dueDate"/>
						</columns>
						<rows><![CDATA[concat(all(`tl.demo.projectManagement:Milestone`), all(`tl.demo.projectManagement:Ticket`))]]></rows>
					</table>
				</panel>
			</tab>
		</tabs>
	</tab-bar>
</view>