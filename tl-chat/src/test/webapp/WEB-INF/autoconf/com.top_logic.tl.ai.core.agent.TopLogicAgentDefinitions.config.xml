<?xml version="1.0" encoding="utf-8" ?>

<!--
	An installation's override of one shipped agent, for TestChatRunAccess.

	The same shape tl-ai-core's own test application carries, and for the other half of the claim:
	that the renamed agent reaches the client. It sets one scalar - the display name of
	TL_ModelExplorer, in both languages - so the summary the endpoint reports beside it is still the
	shipped one, and the identifier a request names is untouched.

	In autoconf rather than in WEB-INF/conf, because that is the layer an application overrides a
	framework default in, and because it is where the service editor of "TopLogic-Agents and Skills"
	writes what an administrator saved.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tl.ai.core.agent.TopLogicAgentDefinitions">
			<instance class="com.top_logic.tl.ai.core.agent.TopLogicAgentDefinitions">
				<agents>
					<agent name="TL_ModelExplorer">
						<display-name>
							<en>Model Scout</en>
							<de>Modell-Späher</de>
						</display-name>
					</agent>
				</agents>
			</instance>
		</config>
	</services>
</application>
