<?xml version="1.0" encoding="UTF-8"?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="it.app">
			<annotations>
				<package-binding
					implementation-package="it.app.impl"
					interface-package="it.app"
				/>
			</annotations>
			<class name="Item">
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<reference name="parts"
						multiple="true"
						type="Item"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>
