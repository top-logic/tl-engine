<?xml version="1.0" encoding="utf-8"?>

<!-- 
	Configuration options for testing tl-ai-mcp-server with JUnit.
 -->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<configs>
		<config config:interface="test.com.top_logic.basic.util.AbstractBasicTestAll$GlobalConfig"
			test-layouts-normalized="true"
			test-jsp-content="true"
		/>

		<!-- Generated by msgbuf from discovery/card.proto. -->
		<config config:interface="test.com.top_logic.basic.TestComment$Config">
			<ignore>
				<entry value="com.top_logic.ai.mcp.server.discovery.ServerCard" />
				<entry value="com.top_logic.ai.mcp.server.discovery.ServerRemote" />
				<entry value="com.top_logic.ai.mcp.server.discovery.RemoteHeader" />
			</ignore>
		</config>
	</configs>
</application>
