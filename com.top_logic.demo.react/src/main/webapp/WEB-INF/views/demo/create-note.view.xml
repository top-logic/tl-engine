<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a tl.demo.projectManagement:Note inside a project.
	
	"model" carries the transient Note (bound by the opening command); "container" is the project
	the note belongs to. The Create button persists the note and links it from the container side,
	via ProjectScope#notes.
	
	The Create command takes the container as a leading positional argument (via <inputs>); the
	form model is the trailing (chained) argument.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="container"/>
	</channels>
	<window width="500px">
		<title>
			<en>New Note</en>
			<de>Neue Notiz</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
		>
			<field attribute="text"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Erstellen</de>
					</label>
					<store-form-state/>
					<with-transaction>
						<execute-script function="container -> model -> { created = $model.copy(transient: false); $container.add(`tl.demo.projectManagement:ProjectScope#notes`, $created); $created }">
							<inputs>
								<input channel="container"/>
							</inputs>
						</execute-script>
					</with-transaction>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>