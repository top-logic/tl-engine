<?xml version="1.0" encoding="utf-8" ?>

<!--
	The document viewer of the React UI: the table on the left lists the documents, the pane on the
	right previews the selected one. The preview has one panel per kind of document - a picture in
	the image element (<image>), a PDF in the PDF viewer (<pdf>), an HTML file as a document of its
	own (<html display="document">) - chosen by a <switch> on the content type of the document that
	stands directly in the split pane, so the panel shown spans the whole pane. Without a selected
	document, a preview panel with a hint stands there instead. Above its viewer, each document panel
	shows the file of the selected document in a read-only binary field
	(<value-input type="tl.core:Binary">) with a download link. The toolbar of the list uploads
	further documents and deletes the selected one; an uploaded file becomes a document named after
	the file and is selected right away.
	
	Every viewer reads the "data" channel, which is derived from the "document" channel the
	<switch> switches on. They therefore change within the same notification - the viewer being
	replaced sees the new document value before its container replaces it.
-->
<view>
	<channels>
		<channel name="document"/>
		<derived-channel name="data"
			expr="$document.get(`demo.documents:Document#data`)"
			inputs="document"
		/>
		<derived-channel name="name"
			expr="$document.get(`demo.documents:Document#name`)"
			inputs="document"
		/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="220"
				size="30"
				unit="%"
			>
				<panel>
					<title>
						<en>Documents</en>
						<de>Dokumente</de>
					</title>
					<commands>
						<upload-command
							accept="image/*,.pdf,.html,text/html"
							image="css:bi bi-upload"
							multiple="true"
							placement="TOOLBAR"
						>
							<label>
								<en>Upload</en>
								<de>Hochladen</de>
							</label>
							<access>
								<create type="demo.documents:Document"/>
							</access>
							<with-transaction>
								<commitMessage>
									<en>Uploaded document {0}.</en>
									<de>Dokument {0} hochgeladen.</de>
								</commitMessage>
								<execute-script function="{ doc = new(`demo.documents:Document`); $doc.set(`demo.documents:Document#name`, label($file)); $doc.set(`demo.documents:Document#data`, $file); $doc; }"/>
								<with-result>
									<write-channel name="document"/>
								</with-result>
							</with-transaction>
						</upload-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="document"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<delete-object/>
							<write-channel name="document"
								clear="true"
							/>
						</generic-command>
					</commands>
					<inset>
						<text>
							<label>
								<en>Upload a picture, a PDF file or an HTML file to add it to the list. The document selected here is shown in the preview beside it.</en>
								<de>Laden Sie ein Bild, eine PDF-Datei oder eine HTML-Datei hoch, um sie der Liste hinzuzufügen. Das hier gewählte Dokument wird in der Vorschau daneben angezeigt.</de>
							</label>
						</text>
					</inset>
					<table
						observed-types="demo.documents:Document"
						selection="document"
						types="demo.documents:Document"
					>
						<columns>
							<column attribute="name"/>
						</columns>
						<rows>all(`demo.documents:Document`)</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="70"
				unit="%"
			>
				<switch input="document">
					<case test="$document != null &amp;&amp; binaryContentType($document.get(`demo.documents:Document#data`)).stringStartsWith('image/')">
						<panel>
							<title>
								<en>Picture</en>
								<de>Bild</de>
							</title>
							<title-content>
								<text input="name"/>
							</title-content>
							<inset>
								<fields>
									<value-input
										readonly="true"
										type="tl.core:Binary"
										value="data"
									>
										<label>
											<en>File</en>
											<de>Datei</de>
										</label>
									</value-input>
								</fields>
							</inset>
							<image input="data">
								<alt>
									<en>The selected picture.</en>
									<de>Das gewählte Bild.</de>
								</alt>
							</image>
						</panel>
					</case>
					<case test="$document != null &amp;&amp; binaryContentType($document.get(`demo.documents:Document#data`)).stringStartsWith('application/pdf')">
						<panel>
							<title>
								<en>PDF document</en>
								<de>PDF-Dokument</de>
							</title>
							<title-content>
								<text input="name"/>
							</title-content>
							<inset>
								<fields>
									<value-input
										readonly="true"
										type="tl.core:Binary"
										value="data"
									>
										<label>
											<en>File</en>
											<de>Datei</de>
										</label>
									</value-input>
								</fields>
							</inset>
							<pdf input="data"/>
						</panel>
					</case>
					<case test="$document != null &amp;&amp; binaryContentType($document.get(`demo.documents:Document#data`)).stringStartsWith('text/html')">
						<panel>
							<title>
								<en>HTML document</en>
								<de>HTML-Dokument</de>
							</title>
							<title-content>
								<text input="name"/>
							</title-content>
							<inset>
								<fields>
									<value-input
										readonly="true"
										type="tl.core:Binary"
										value="data"
									>
										<label>
											<en>File</en>
											<de>Datei</de>
										</label>
									</value-input>
								</fields>
							</inset>
							<html
								display="document"
								input="data"
								print="true"
							/>
						</panel>
					</case>
					<default>
						<panel>
							<title>
								<en>Preview</en>
								<de>Vorschau</de>
							</title>
							<title-content>
								<text input="name"/>
							</title-content>
							<inset>
								<text>
									<label>
										<en>Select a document in the table; pictures are shown inline, PDF files in the PDF viewer, HTML files as a document of their own.</en>
										<de>Wählen Sie ein Dokument in der Tabelle; Bilder werden direkt angezeigt, PDF-Dateien im PDF-Viewer, HTML-Dateien als eigenständiges Dokument.</de>
									</label>
								</text>
							</inset>
						</panel>
					</default>
				</switch>
			</pane>
		</panes>
	</split-panel>
</view>