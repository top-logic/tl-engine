<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<module key="com.top_logic.factory.workspace.WorkspaceService$Module" value="true"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.factory.workspace.WorkspaceService">
			<instance class="com.top_logic.factory.workspace.WorkspaceService">
				<provider class="com.top_logic.factory.workspace.docker.DockerWorkspaceProvider"
					docker-host="%FACTORY_DOCKER_HOST%"
					network="%FACTORY_DOCKER_NETWORK%"
					public-host="%FACTORY_PUBLIC_HOST%"
					host-port-min="%FACTORY_HOST_PORT_MIN%"
					host-port-max="%FACTORY_HOST_PORT_MAX%"
				/>
				<applications
					engine-version="%FACTORY_ENGINE_VERSION%"
					image-repository="%FACTORY_IMAGE_REPOSITORY%"
					repository-url="%FACTORY_REPOSITORY_URL%"
					start-timeout="%FACTORY_START_TIMEOUT%"
				/>
			</instance>
		</config>
	</services>
</application>
