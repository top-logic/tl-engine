<?xml version="1.0" encoding="utf-8" ?>

<!--
	First migration of the migration module tl-layout-view (Ticket #30419). It creates the model
	modules tl.view, tl.login and tl.admin, which up to now reached existing databases only through
	the automatic model upgrade, which an application may prevent.

	A module without a stored version counts as new and without data (MigrationUtil.getNewVersions):
	on an existing database this migration only runs, if the application lists tl-layout-view in the
	minimum-modules of the MigrationService. Otherwise its version is only stored, and the automatic
	model upgrade creates the model elements. A database that already has them keeps them: the
	processors skip what already exists.
-->
<migration config:interface="com.top_logic.knowledge.service.migration.MigrationConfig"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<version name="Ticket_30419_tl_layout_view_migration_module"
		module="tl-layout-view"
	/>
