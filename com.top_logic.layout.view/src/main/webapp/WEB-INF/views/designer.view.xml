<?xml version="1.0" encoding="utf-8" ?>

<view xmlns="http://www.top-logic.com/ns/view/1.0">
	<channels>
		<channel name="designSession"/>
		<channel name="designPath"/>
		<channel name="selectedNode"/>
	</channels>

	<panel>
		<title>
			<en>View Designer</en>
			<de>View-Designer</de>
		</title>
		<commands>
			<save-design
				placement="TOOLBAR"
				session="designSession"
			>
				<label>
					<en>Apply</en>
					<de>Anwenden</de>
				</label>
			</save-design>
			<revert-design
				placement="TOOLBAR"
				session="designSession"
			>
				<label>
					<en>Revert</en>
					<de>Verwerfen</de>
				</label>
			</revert-design>
			<select-view
				placement="TOOLBAR"
				selection="selectedNode"
				session="designSession"
			>
				<label>
					<en>Select view</en>
					<de>Sicht auswählen</de>
				</label>
				<tooltip>
					<en>Pick a view in the main window to open it here.</en>
					<de>Eine Sicht im Hauptfenster anklicken, um sie hier zu öffnen.</de>
				</tooltip>
			</select-view>
		</commands>

		<split-panel
			orientation="horizontal"
			resizable="true"
		>
			<panes>
				<pane
					min-size="200"
					size="40"
					unit="%"
				>
					<panel fill="true">
						<title-content>
							<breadcrumb path="designPath"/>
						</title-content>
						<design-tree
							selection="selectedNode"
							session="designSession"
						/>
					</panel>
				</pane>
				<pane
					size="60"
					unit="%"
				>
					<inset>
						<config-editor input="selectedNode"/>
					</inset>
				</pane>
			</panes>
		</split-panel>
	</panel>
</view>