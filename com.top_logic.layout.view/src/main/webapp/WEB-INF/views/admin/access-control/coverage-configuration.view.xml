<?xml version="1.0" encoding="utf-8" ?>

<!--
	Shows the security parents proposed by the coverage analysis, as the XML that belongs into the
	access manager configuration. The content channel receives the rendered rules from the command
	that opens the dialog - the whole configuration, or the rule of the selected type.
-->
<view>
	<channels>
		<channel name="content"/>
	</channels>
	<window width="800px">
		<title>
			<en>Security parents</en>
			<de>Sicherheitsväter</de>
		</title>
		<html input="content"/>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>