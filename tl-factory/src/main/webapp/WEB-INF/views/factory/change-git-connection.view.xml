<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog changing a git connection of a tenant: the form edits the transient input in "model", the
	connection and its new name, type, URL and owner (factoryUpdateGitConnection). Type, URL and owner
	stay as they are while projects live on the connection; the access token is replaced by "Replace
	token" (factory/replace-git-token.view.xml).
-->
<view>
	<channels>
		<channel name="model"/>
	</channels>
	<window width="520px">
		<title>
			<en>Edit git connection</en>
			<de>Git-Verbindung bearbeiten</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="providerType"/>
			<field attribute="url"/>
			<field attribute="owner"/>
			<commands>
				<generic-command key="ENTER"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Save</en>
						<de>Speichern</de>
					</label>
					<store-form-state/>
					<execute-script function="factoryUpdateGitConnection($model.get(`tl.factory.input:ChangedGitConnection#connection`), $model.get(`tl.factory.input:GitConnectionData#name`), $model.get(`tl.factory.input:GitConnectionData#providerType`), $model.get(`tl.factory.input:GitConnectionData#url`), $model.get(`tl.factory.input:GitConnectionData#owner`))"/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>