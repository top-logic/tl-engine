<?xml version="1.0" encoding="utf-8" ?>

<!--
	The deliverables of a project, pushed by the Deliverables tile of the project cockpit.
	
	A deliverable is a specification, a prototype or a report: the type Deliverable is abstract. The
	user chooses the kind first, then "New deliverable" creates a draft of that kind and opens the
	create dialog. The command declares the creation in its access without a type: the type of the
	reference ProjectScope#deliverables is the abstract Deliverable, so the command is offered where
	at least one kind may be created in the project. The kind chooser offers only the kinds the user
	may create there (canCreate): a project administrator creates every kind, a project member
	specifications only.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="kind"/>
	</channels>

	<panel>
		<title>
			<en>Deliverables</en>
			<de>Liefergegenstände</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project, kind"
				placement="TOOLBAR"
			>
				<label>
					<en>New deliverable</en>
					<de>Neuer Liefergegenstand</de>
				</label>
				<access>
					<create
						in="$project"
						reference="tl.demo.projectManagement:ProjectScope#deliverables"
					/>
				</access>
				<executability>
					<disabled-if expr="if($kind == null, #('Choose the kind of the deliverable first.'@en, 'Wählen Sie zuerst die Art des Liefergegenstands.'@de))"/>
				</executability>
				<execute-script function="new($kind, context: $project, transient: true)">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="demo/create-deliverable.view.xml"
						>
							<bind
								channel="container"
								to="project"
							/>
						</open-dialog>
					</with-result>
				</execute-script>
			</generic-command>
		</commands>
		<fields>
			<value-input
				inputs="project"
				options="[`tl.demo.projectManagement:Specification`, `tl.demo.projectManagement:Prototype`, `tl.demo.projectManagement:Report`].filter(t -> $project != null &amp;&amp; $project.canCreate(`tl.demo.projectManagement:ProjectScope#deliverables`, $t))"
				type="tl.model:TLClass"
				value="kind"
			>
				<label>
					<en>Kind</en>
					<de>Art</de>
				</label>
			</value-input>
		</fields>
		<table
			observed-types="tl.demo.projectManagement:Deliverable"
			types="tl.demo.projectManagement:Deliverable"
		>
			<columns>
				<column attribute="name"/>
				<computed-column name="kind"
					type="tl.core:String"
				>
					<label>
						<en>Kind</en>
						<de>Art</de>
					</label>
					<value>$row.type().label()</value>
				</computed-column>
			</columns>
			<inputs>
				<input channel="project"/>
			</inputs>
			<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#deliverables`))</rows>
		</table>
	</panel>
</view>