<?xml version="1.0" encoding="utf-8" ?>

<!--
	Every access token of every account, for an administrator. Revoking one here is what to do when
	a token leaked or an account must lose the access of its clients at once; the hint column is
	what a token found in a file or a log is matched against.
-->
<view>
	<channels>
		<channel name="selectedToken"/>
	</channels>
	<panel>
		<title>
			<en>Access tokens</en>
			<de>Zugriffstokens</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-x-circle"
				inputs="selectedToken as token"
				placement="TOOLBAR"
			>
				<label>
					<en>Revoke</en>
					<de>Widerrufen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Revoke the token {0} of {1}? A client that uses it is refused from now on.'@en, 'Das Token {0} von {1} widerrufen? Ein Client, der es verwendet, wird ab sofort abgewiesen.'@de).fill($token.get(`tl.accounts:AccessToken#name`), $token.get(`tl.accounts:AccessToken#owner`))"/>
				<with-transaction>
					<execute-script function="accessTokenRevoke($token)"/>
					<with-result>
						<write-channel name="selectedToken"
							clear="true"
						/>
					</with-result>
				</with-transaction>
			</generic-command>
		</commands>
		<table
			observed-types="tl.accounts:AccessToken"
			selection="selectedToken"
			types="tl.accounts:AccessToken"
		>
			<columns>
				<column
					attribute="owner"
					width="160"
				/>
				<column
					attribute="name"
					width="200"
				/>
				<column
					attribute="hint"
					width="110"
				/>
				<column
					attribute="permissions"
					width="180"
				/>
				<column
					attribute="createdAt"
					width="150"
				/>
				<column
					attribute="expiresAt"
					width="150"
				/>
				<column
					attribute="lastUsed"
					width="150"
				/>
			</columns>
			<rows><![CDATA[all(`tl.accounts:AccessToken`)
				.sort((t -> $t.get(`tl.accounts:AccessToken#createdAt`)).comparator().desc())]]></rows>
		</table>
	</panel>
</view>
