<?xml version="1.0" encoding="utf-8" ?>

<application>
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/TestMaskedObjectLinks.model.xml"/>
				</declarations>
			</instance>
		</config>

		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="TestMaskedObjectLinks.Reader"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<!-- A topic may be read, and thereby discovered, by its reader only. -->
					<class name="TestMaskedObjectLinks:Topic">
						<grant
							operation="Read"
							roles="TestMaskedObjectLinks.Reader"
						/>
					</class>
				</security-config>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="TestMaskedObjectLinks_Topic_Reader"
							meta-element="TestMaskedObjectLinks:Topic"
							role="TestMaskedObjectLinks.Reader"
						>
							<path>
								<step attribute="TestMaskedObjectLinks:Topic#reader"/>
							</path>
						</rule>
					</rules>
				</role-rules>
			</instance>
		</config>
	</services>
</application>
