<?xml version="1.0" encoding="utf-8" ?>

<!--
	Create dialog for a test.flowchart:Product of the flow diagram demo. "model" carries the
	transient product (bound by the opening command). The Create button persists it and writes it
	to "selection" (bound to the demo's selectedProduct), so the diagram draws the new product's
	plan - empty until build steps are added to it.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>New product</en>
			<de>Neues Produkt</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<persist-transient>
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</persist-transient>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>