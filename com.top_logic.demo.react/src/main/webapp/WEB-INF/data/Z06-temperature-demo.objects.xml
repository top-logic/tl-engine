<?xml version="1.0" encoding="utf-8" ?>

<objects>
	<!-- Sites of the temperature demo in different units. The temperatures are given in degrees Celsius, the unit they are stored in. -->
	<object id="site-1"
		type="demo.temperature:DemoSite"
	>
		<attribute name="name"
			value="Stuttgart"
		/>
		<attribute name="temperatureUnit">
			<model-ref name="demo.temperature:TemperatureUnit#CELSIUS"/>
		</attribute>
		<attribute name="sensors">
			<object id="sensor-1"
				type="demo.temperature:DemoSensor"
			>
				<attribute name="name"
					value="Cold store"
				/>
				<attribute name="minTemperature"
					value="-25"
				/>
				<attribute name="maxTemperature"
					value="-18"
				/>
			</object>
			<object id="sensor-2"
				type="demo.temperature:DemoSensor"
			>
				<attribute name="name"
					value="Office"
				/>
				<attribute name="minTemperature"
					value="19"
				/>
				<attribute name="maxTemperature"
					value="24.5"
				/>
			</object>
		</attribute>
	</object>
	<object id="site-2"
		type="demo.temperature:DemoSite"
	>
		<attribute name="name"
			value="Houston"
		/>
