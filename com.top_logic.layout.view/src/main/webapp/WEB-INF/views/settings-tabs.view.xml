<?xml version="1.0" encoding="utf-8" ?>

<!--
	The tabs of the settings dialog (settings.view.xml), which opens this as its content.

	At the root of a view of its own, so that a module contributes a tab by dropping a same-path
	overlay (WEB-INF/views/settings-tabs.view.xml) into its own module and adding an entry to the
	<tabs> list; the ViewLoader merges all copies in dependency order. See tl-layout-view-contact,
	which adds the profile of the person behind the account.

	Deliberately small. What a user changes with a single decision - the language, the theme, where
	they start - is an entry of the user menu (user-menu.view.xml), one click from the app bar, so
	this dialog holds only what wants a form or belongs with the account's security.

	The account is read here rather than passed in: a <view-ref> gives its content a channel
	namespace of its own, and the session's own account is what every tab edits.
-->
<view>
	<channels>
		<!-- The account being edited: the session's own, always. -->
		<derived-channel name="account"
			expr="currentUser()"
		/>
		<!--
			The group whose members act in the account's name, on a channel of its own because a
			channel observes the object it holds: adding a deputy changes the group, not the
			account, so a display computed straight from the account would not follow it.
		-->
		<derived-channel name="representativeGroup"
			expr="account -> $account.get(`tl.accounts:Person#representativeGroup`)"
			inputs="account"
		/>
		<!-- The accounts that may act in the name of this account. -->
		<derived-channel name="deputies"
			expr="group -> $group.get(`tl.accounts:Group#members`)"
			inputs="representativeGroup"
		/>
		<!--
			The accounts this account may act for: those whose representative group it is a member
			of. Asked of the accounts rather than of the groups, because a representative group
			names its owner only through the back-reference of the owner's own attribute, and that
			navigation answers with what the user may read - which for a group they are only a
			member of is nothing.
		-->
		<derived-channel name="deputyFor"
			expr="account -> all(`tl.accounts:Person`).filter(other -> $account.get(`tl.accounts:Person#groups`).containsElement($other.get(`tl.accounts:Person#representativeGroup`)))"
			inputs="account"
		/>
	</channels>
	<tab-bar active-tab="account">
		<tabs>
			<tab id="account"
				icon="css:bi bi-person"
			>
				<label>
					<en>Account</en>
					<de>Konto</de>
				</label>
				<!--
					Save reaches the dialog's own button bar, beside Cancel, because a form puts its
					commands into the enclosing scope for as long as it is displayed - and a tab
					that is not the active one is not. The other tabs therefore do not offer it.
					Saving closes the dialog: what was to be done here is done.
				-->
				<form
					initial-edit-mode="true"
					input="account"
					mode-switch="false"
				>
					<field attribute="timezone"/>
					<field attribute="country"/>
					<commands>
						<generic-command image="css:bi bi-check-lg"
							placement="BUTTON_BAR"
						>
							<label>
								<en>Save</en>
								<de>Speichern</de>
							</label>
							<with-transaction>
								<store-form-state/>
							</with-transaction>
							<close-dialog/>
						</generic-command>
					</commands>
				</form>
			</tab>

			<!--
				Each entry here acts on the account rather than holding a value of it, so the tab is
				a list of buttons and not a form. They stretch across the tab because the list is
				what the tab is - nothing else competes for the width, and a row of differently
				sized buttons would only invite guessing which one matters. The <inset> gives the
				list the breathing room a form brings along by itself, so both tabs of this dialog
				hold their content at the same distance from the border.
			-->
			<tab id="security"
				icon="css:bi bi-shield-lock"
			>
				<label>
					<en>Security</en>
					<de>Sicherheit</de>
				</label>
				<inset>
					<stack
						align="stretch"
						direction="column"
						gap="compact"
					>
						<!--
							The state of the second factor, stated rather than left to be inferred
							from which of the two buttons below is offered. Having a second factor is
							having a secret stored, the same condition the buttons are offered by.
						-->
						<switch input="account">
							<case test="account -> $account.get(`tl.accounts:Person#mfaSecret`) != null">
								<text>
									<label>
										<en>Two-factor authentication: active</en>
										<de>Zwei-Faktor-Authentifizierung: aktiv</de>
									</label>
								</text>
							</case>
							<default>
								<text>
									<label>
										<en>Two-factor authentication: not active</en>
										<de>Zwei-Faktor-Authentifizierung: nicht aktiv</de>
									</label>
								</text>
							</default>
						</switch>

						<!--
							Offered only to an account whose password this application holds: a device
							that keeps it elsewhere - a directory service, an identity provider - refuses
							to change it, and a button leading to that refusal is one the user has no way
							of knowing not to press. The action itself refuses the same accounts, so what
							is hidden here is not what is guarded.
						-->
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-key"
								input="account"
							>
								<label>
									<en>Change password</en>
									<de>Passwort ändern</de>
								</label>
								<executability>
									<visible-if expr="account -> $account.accountPasswordChangeAllowed()"/>
								</executability>
								<execute-script function="x -> new(`tl.login:PasswordChange`, transient: true)"/>
								<open-dialog
									bind-input-to="model"
									dialog-view="change-password.view.xml"
								/>
							</action>
						</button>

						<!--
							Who acts in the account's name, and for whom the account acts. Naming a
							deputy is an action of its own and not a field of the account form: it
							hands the deputy every role the account holds, which is a decision taken
							deliberately and confirmed with the password, not one saved along with a
							time zone. The state is stated here for the same reason the second factor
							is - what the button changes is what the line above it names.
						-->
						<switch input="deputies">
							<case test="deputies -> !$deputies.isEmpty()">
								<stack direction="row"
									gap="compact"
								>
									<text>
										<label>
											<en>Deputies:</en>
											<de>Stellvertreter:</de>
										</label>
									</text>
									<text input="deputies"/>
								</stack>
							</case>
							<default>
								<text>
									<label>
										<en>Deputies: none</en>
										<de>Stellvertreter: keine</de>
									</label>
								</text>
							</default>
						</switch>

						<!--
							Shown only where there is something to show: an account nobody named as
							their deputy stands in for nobody, and a line saying so would be noise.
						-->
						<switch input="deputyFor">
							<case test="accounts -> !$accounts.isEmpty()">
								<stack direction="row"
									gap="compact"
								>
									<text>
										<label>
											<en>You stand in for:</en>
											<de>Sie vertreten:</de>
										</label>
									</text>
									<text input="deputyFor"/>
								</stack>
							</case>
						</switch>

						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-people"
								input="representativeGroup"
							>
								<label>
									<en>Name deputies</en>
									<de>Stellvertreter benennen</de>
								</label>
								<open-dialog
									bind-input-to="model"
									dialog-view="deputies.view.xml"
								/>
							</action>
						</button>

						<!--
							Setting a second factor up happens here and now, in the same enrollment
							dialog the login flow uses: the account keeps its requirement, since a
							factor the user chose is one they may drop again. Each button is offered
							only in the state where it means something - by whether a secret is stored,
							which is what having a second factor is. An account required to use one
							keeps it whatever this view offers, which the action itself enforces.
						-->
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-shield-plus"
								input="account"
							>
								<label>
									<en>Set up two-factor authentication</en>
									<de>Zwei-Faktor-Authentifizierung einrichten</de>
								</label>
								<executability>
									<visible-if expr="account -> $account.get(`tl.accounts:Person#mfaSecret`) == null"/>
								</executability>
								<enroll-mfa/>
							</action>
						</button>
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-shield-minus"
								input="account"
							>
								<label>
									<en>Switch two-factor authentication off</en>
									<de>Zwei-Faktor-Authentifizierung abschalten</de>
								</label>
								<executability>
									<visible-if expr="account -> $account.get(`tl.accounts:Person#mfaSecret`) != null"/>
								</executability>
								<confirm expr="account -> #('Log in with your password alone from now on?'@en, 'Künftig nur noch mit dem Passwort anmelden?'@de)"/>
								<disable-mfa/>
							</action>
						</button>
					</stack>
				</inset>
			</tab>
		</tabs>
	</tab-bar>
</view>
