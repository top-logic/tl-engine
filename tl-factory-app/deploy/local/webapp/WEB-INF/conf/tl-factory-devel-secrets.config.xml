<?xml version="1.0" encoding="utf-8" ?>

<!--
	The writable secret store of a local development deployment of the control application, listed
	after devel-secrets.xml in metaConf.txt: the database store is appended to the chain of
	devel-secrets.config.xml (environment, ~/.top-logic/secrets, the development database password),
	so that the access tokens of the git connections of the tenants are kept AES/GCM-encrypted in the
	development database. Its key is the secret tl_secret_store_key, which tl-factory-devel.sh
	generates into ~/.top-logic/secrets.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.credential.SecretStoreService">
			<instance class="com.top_logic.basic.credential.SecretStoreService">
				<store class="com.top_logic.basic.credential.ChainSecretStore">
					<stores>
						<database-store/>
					</stores>
				</store>
			</instance>
		</config>
	</services>
</application>
