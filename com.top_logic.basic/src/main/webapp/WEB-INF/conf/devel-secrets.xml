<?xml version="1.0"?>
<root>
	<alias>
		<!--
			Folder with the secrets of the developer, shared by all workspaces, see
			devel-secrets.config.xml. The variable tl_devel_secrets_dir moves it.
		-->
		<entry name="%DEVEL_SECRETS_DIR%" value="${env:tl_devel_secrets_dir:~/.top-logic/secrets}" />
	</alias>
</root>
