<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="ticket"/>
		<channel name="branchInput"/>
	</channels>
	<panel title="Branch Actions Test">
		<commands>
			<generic-command name="decide"
				inputs="ticket"
			>
				<if test="$branchInput != null &amp;&amp; $ticket != null">
					<inputs>
						<input channel="branchInput"/>
					</inputs>
					<then>
						<execute-script function="$ticket"/>
					</then>
					<else>
						<write-channel name="ticket"/>
					</else>
				</if>
				<execute-script function="$ticket"/>
			</generic-command>
			<generic-command name="select"
				inputs="ticket"
			>
				<switch value="$ticket">
					<case match="`demo.tickets:TicketStatus#closed`">
						<execute-script function="$ticket"/>
					</case>
					<case test="$value == 'open'">
						<execute-script function="$ticket"/>
					</case>
					<default>
						<write-channel name="ticket"/>
					</default>
				</switch>
			</generic-command>
			<generic-command name="classify"
				inputs="ticket"
			>
				<switch>
					<case test="$value == null">
						<write-channel name="ticket"/>
					</case>
				</switch>
			</generic-command>
		</commands>
	</panel>
</view>