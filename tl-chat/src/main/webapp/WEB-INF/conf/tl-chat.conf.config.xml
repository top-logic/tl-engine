<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<!--
						Converts legacy tl.ai.chat:ChatSession rows to tl.ai.execution:AgentSession.
						The legacy model itself is gone (Refs #230), so this service has nothing
						left to do. Remove it together with LegacyChatSessionMigration once every
						deployment is known to have booted a version containing it.
					-->
					<module key="com.top_logic.ai.chat.history.LegacyChatSessionMigration$Module" value="true"/>
					<!--
						Pushes a running agent's writes into the open chat windows, so a model-bound
						element beside the transcript follows the run instead of waiting for the SSE
						heartbeat.
					-->
					<module key="com.top_logic.ai.chat.view.AgentViewRefreshService$Module" value="true"/>
				</modules>
			</instance>
		</config>
		<config service-class="com.top_logic.ai.chat.view.AgentViewRefreshService">
			<instance class="com.top_logic.ai.chat.view.AgentViewRefreshService"/>
		</config>
		<!--
			The "present" tool: the agent puts model objects onto a channel of the page it is on.
			Registered here rather than in tl-ai-core because it needs the view layer - a channel
			only exists in a rendered window. Every application that depends on tl-chat therefore
			has the tool; which channel it may write is still the page's own decision
			(<chat-conversation present="..."/>), and a page that names none allows nothing.
		-->
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance>
				<tool-factories>
					<factory name="present">
						<implementation class="com.top_logic.tl.ai.tool.api.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.chat.tools.PresentTool"
						/>
					</factory>
				</tool-factories>
			</instance>
		</config>
		<!--
			The shipped chat entry point gets the tool. A per-entry keyed list, so this adds one
			tool to the agent tl-ai-core defines without restating its list. An application that
			ships its own agents names "present.present" in their <tools> the same way.
		-->
		<config service-class="com.top_logic.tl.ai.core.agent.TopLogicAgentDefinitions">
			<instance>
				<agents>
					<agent name="TL_SingleAgent">
						<tools>
							<tool name="present.present"/>
						</tools>
					</agent>
				</agents>
			</instance>
		</config>
	</services>
</application>
