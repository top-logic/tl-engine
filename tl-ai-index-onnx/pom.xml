<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-alpha12</version>
  </parent>

  <artifactId>tl-ai-index-onnx</artifactId>
  <name>${project.artifactId}</name>
  <description>An in-process embedder for tl-ai-index: ONNX Runtime and the Hugging Face tokenizer on the CPU, no server needed.</description>
  <url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-index</artifactId>
    </dependency>
    <!--
      ONNX Runtime (MIT) and the Hugging Face tokenizers of DJL (Apache-2.0). Both jars carry their
      native libraries for linux-x64, linux-aarch64, macOS aarch64 and Windows x64 - together about
      73 MB, which is why they are a module of their own: an application that embeds through an
      HTTP endpoint does not ship them.
    -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.djl.huggingface</groupId>
      <artifactId>tokenizers</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The tests live in packages mirroring the production code, see the comment in tl-ai-core/pom.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>%regex[test[/.]TestAll(\.class)?]</include>
            <include>%regex[com[/.]top_logic[/.](ai|tl[/.]ai)[/.](.*[/.])?(Test[A-Z0-9][^/.$]*|[^/.$]*Test)(\.class)?]</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
