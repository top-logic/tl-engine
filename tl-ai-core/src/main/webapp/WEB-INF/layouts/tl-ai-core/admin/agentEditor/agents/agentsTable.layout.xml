<?xml version="1.0" encoding="utf-8" ?>

<config:template-call
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
	template="com.top_logic/table.template.xml"
>
	<arguments
		size="300px"
		type="tl.ai.core:Agent"
	>
		<dialogs>
			<layout-reference resource="tl-ai-core/admin/agentEditor/agents/createObject/dialog.layout.xml">
				<content-layouting class="com.top_logic.layout.structure.ContentLayouting">
					<contextMenuFactory class="com.top_logic.layout.basic.contextmenu.component.factory.PlainComponentContextMenuFactory">
						<titleProvider class="com.top_logic.layout.provider.label.NoLabelProvider"/>
						<customCommands class="com.top_logic.layout.basic.contextmenu.config.NoContextMenuCommands"/>
					</contextMenuFactory>
				</content-layouting>
			</layout-reference>
		</dialogs>
		<name key="dynamic.eb2567d2-02cc-4c0c-b52e-dd13ca760766">
			<en>Agents</en>
			<de>Agenten</de>
		</name>
		<modelBuilder class="com.top_logic.model.search.providers.ListModelByExpression"
			elements="model->all(`tl.ai.core:Agent`)"
		/>
		<buttons>
			<button id="exportExcel"
				class="com.top_logic.layout.table.export.ExcelExportHandler"
			>
				<downloadNameProvider class="com.top_logic.layout.table.export.ComponentDownloadName"/>
			</button>
			<button id="deleteSelection"
				class="com.top_logic.layout.component.GenericDeleteCommandHandler"
				target="selection(self())"
			>
				<confirmation class="com.top_logic.tool.boundsec.confirm.DefaultDeleteConfirmation"/>
			</button>
			<button id="exportToDevEnv"
				class="com.top_logic.tl.ai.core.agent.ExportToDataFolderCommand"
				file-name="agents.objects.xml"
				type-name="tl.ai.core:Agent"
			>
				<resourceKey key="dynamic.exportToDevEnv">
					<en>Apply to development environment</en>
					<de>In Entwicklungsumgebung übernehmen</de>
				</resourceKey>
			</button>
		</buttons>
		<contextMenu class="com.top_logic.layout.basic.contextmenu.component.factory.adapter.SelectableContextMenuProvider">
			<contextMenuFactory>
				<titleProvider class="com.top_logic.layout.provider.MetaLabelProvider"/>
				<customCommands class="com.top_logic.layout.basic.contextmenu.config.MetaContextMenuCommandsProvider"/>
			</contextMenuFactory>
		</contextMenu>
	</arguments>
</config:template-call>