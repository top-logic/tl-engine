<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-alpha13.823</version>
  </parent>

  <artifactId>tl-ai-browser</artifactId>
  <name>${project.artifactId}</name>
  <description>Browser tools of the AI agents: a real Chromium (through Playwright) that reads JavaScript-rendered pages, clicks, types, takes screenshots and keeps logins in encrypted cookie pools. Optional, because Playwright brings its browser driver into the application.</description>
  <url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <!-- The tool system, the web tools whose policies the browser shares (SSRF check, filtering
         proxy, browsing policy, URL provenance), and the screenshot storage. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
    </dependency>

    <!-- Drives a real Chromium so the agent can read JavaScript-rendered pages that the static
         webFetch cannot. The Chromium binary is installed separately (see the developer article
         ai/browser). -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- AssumptionAwareRunner and the test fixtures of the web tools (RecordingServer, the
         screenshot fixtures) live in tl-ai-core's test sources. -->
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-ai-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The tests live in packages mirroring the production code, see the comment in tl-ai-core/pom.xml. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>%regex[test[/.]TestAll(\.class)?]</include>
            <include>%regex[com[/.]top_logic[/.](ai|tl[/.]ai)[/.](.*[/.])?(Test[A-Z0-9][^/.$]*|[^/.$]*Test)(\.class)?]</include>
          </includes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.top-logic</groupId>
        <artifactId>tl-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-binding</id>
            <phase>none</phase>
            <goals>
              <goal>generate-java</goal>
            </goals>
            <configuration>
              <modules>tl.ai.cookiepool</modules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
