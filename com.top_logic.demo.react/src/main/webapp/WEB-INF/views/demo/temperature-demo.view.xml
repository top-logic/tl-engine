<?xml version="1.0" encoding="utf-8" ?>

<!--
	Temperatures displayed in the unit of their site: an application-defined primitive type whose
	display depends on the object owning the value.
	
	The minimum and maximum temperature of a sensor are stored in degrees Celsius. The storage of
	the type reads them in the unit of the site the sensor belongs to, so the sensor table and the
	sensor form show them in that unit, and a number typed into the form without a unit is taken in
	that unit as well. A number typed with a unit (20 °C, 68 F, 300 K) is converted.
	
	The sensor table observes the sites as well, so it follows a changed unit of its site at once;
	the sensor form shows the changed unit when it is displayed again.
	
	"New Sensor" creates a sensor in the selected site through a dialog. The sensor being created
	belongs to no site yet, so its temperatures are entered in degrees Celsius unless typed with
	another unit.
-->
<view>
	<channels>
		<channel name="site"/>
		<channel name="sensor"/>
	</channels>

	<panel>
		<title>
			<en>Temperatures</en>
			<de>Temperaturen</de>
		</title>

		<adaptive-detail selection="site">
			<home-label>
				<en>Sites</en>
				<de>Standorte</de>
			</home-label>
			<selector>
				<panel>
					<title>
						<en>Sites</en>
						<de>Standorte</de>
					</title>
					<table
						observed-types="demo.temperature:DemoSite"
						selection="site"
						types="demo.temperature:DemoSite"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="temperatureUnit"/>
						</columns>
						<rows>all(`demo.temperature:DemoSite`)</rows>
					</table>
				</panel>
			</selector>
			<detail>
				<adaptive-detail
					reset-on="site"
					selection="sensor"
				>
					<selector>
						<panel>
							<title>
								<en>Site</en>
								<de>Standort</de>
							</title>
							<commands>
								<generic-command
									image="css:bi bi-plus-lg"
									input="site"
									placement="TOOLBAR"
								>
									<label>
										<en>New Sensor</en>
										<de>Neuer Sensor</de>
									</label>
									<executability>
										<null-input-disabled/>
									</executability>
									<create-transient type="demo.temperature:DemoSensor"/>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-sensor.view.xml"
									>
										<bind
											channel="container"
											to="site"
										/>
										<bind
											channel="selection"
											to="sensor"
										/>
									</open-dialog>
								</generic-command>
							</commands>
							<form
								input="site"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="temperatureUnit"/>
							</form>
							<table
								observed-types="demo.temperature:DemoSite,demo.temperature:DemoSensor"
								selection="sensor"
								types="demo.temperature:DemoSensor"
							>
								<columns>
									<column attribute="name"/>
									<column attribute="minTemperature"/>
									<column attribute="maxTemperature"/>
								</columns>
								<inputs>
									<input channel="site"/>
								</inputs>
								<rows>site -&gt; if($site == null, [], $site.get(`demo.temperature:DemoSite#sensors`))</rows>
							</table>
						</panel>
					</selector>
					<detail>
						<panel>
							<title>
								<en>Sensor</en>
								<de>Sensor</de>
							</title>
							<form
								input="sensor"
								with-inset="true"
							>
								<field attribute="name"/>
								<field attribute="minTemperature"/>
								<field attribute="maxTemperature"/>
							</form>
						</panel>
					</detail>
				</adaptive-detail>
			</detail>
		</adaptive-detail>
	</panel>
</view>