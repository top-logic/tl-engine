<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="rootInput"/>
		<channel name="selectedNode"/>
	</channels>

	<tree
		node-as="parent"
		selection="selectedNode"
		selection-mode="multi"
	>
		<inputs>
			<input
				as="input"
				channel="rootInput"
			/>
		</inputs>
		<root>$input</root>
		<children>list($parent, "child1", "child2")</children>
		<parents>if($parent == $input, null, $input)</parents>
	</tree>
</view>