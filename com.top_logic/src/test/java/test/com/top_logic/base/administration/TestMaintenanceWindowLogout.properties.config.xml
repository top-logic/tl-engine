<?xml version="1.0" encoding="utf-8" ?>

<!-- typed configuration for TestMaintenanceWindowLogout -->

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">

	<services>

		<config service-class="com.top_logic.base.cluster.ClusterManager">
			<instance cluster="false" />
		</config>

		<config service-class="com.top_logic.base.accesscontrol.Login">
			<instance>
				<!-- The test has no layouts that could grant the right to leave the maintenance mode. -->
				<component-leaving-maintenance-mode></component-leaving-maintenance-mode>
			</instance>
		</config>

	</services>

</application>
