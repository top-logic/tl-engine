<?xml version="1.0" encoding="utf-8" ?>

<!--
	Third frame of the project drill-down: the tickets of the milestone the frame was opened for,
	ordered by their number within the project.
	The assignee cell is a link to the person contact, because the application declares a display
	target for person contacts. Activating a row - a double-click, Enter on the row carrying the
	keyboard cursor, or its chevron button - pushes the ticket's detail, announced with the
	ticket's title.
	
	The toolbar creates a ticket in the project of the milestone and deletes the selected one. The
	project is derived from the milestone, whose container it is. The draft of a created ticket
	belongs to the milestone of the list, so the dialog shows it preset. The table observes tickets,
	so both are reflected in the rows without a reload. A created ticket draws the next number of
	its project, because it is created in the context of the project.
-->
<view>
	<channels>
		<channel name="milestone"/>
		<channel name="ticket"/>
		<derived-channel name="project"
			expr="m -> if($m == null, null, $m.container())"
			inputs="milestone"
		/>
	</channels>

	<panel>
		<title>
			<en>Tickets</en>
			<de>Tickets</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project, milestone"
				placement="TOOLBAR"
			>
				<label>
					<en>New Ticket</en>
					<de>Neues Ticket</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<create-transient
					as="draft"
					container="project"
					reference="tickets"
					type="tl.demo.projectManagement:Ticket"
				>
					<execute-script function="$draft.set(`tl.demo.projectManagement:Ticket#milestone`, $milestone)"/>
					<open-dialog
						bind-input-to="model"
						dialog-view="demo/create-ticket.view.xml"
					>
						<bind
							channel="container"
							to="project"
						/>
						<bind
							channel="selection"
							to="ticket"
						/>
					</open-dialog>
				</create-transient>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="ticket"
				placement="TOOLBAR"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Delete ticket {0}?'@en, 'Ticket {0} löschen?'@de).fill($ticket.get(`tl.demo.projectManagement:Ticket#title`))"/>
				<delete-object/>
				<write-channel name="ticket"
					clear="true"
				/>
			</generic-command>
		</commands>
		<table
			observed-types="tl.demo.projectManagement:Ticket"
			selection="ticket"
			types="tl.demo.projectManagement:Ticket"
		>
			<columns>
				<column
					attribute="number"
					sort="ASC"
					width="100"
				/>
				<column attribute="title"/>
				<column attribute="assignee"/>
			</columns>
			<inputs>
				<input channel="milestone"/>
			</inputs>
			<rows>m -&gt; if($m == null, [], $m.get(`tl.demo.projectManagement:Milestone#tickets`))</rows>
			<on-activate class="com.top_logic.layout.view.tiles.NavigatePushCommand"
				bind-input-to="ticket"
				view="projects/ticket-detail.view.xml"
			>
				<frame-label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="t -> $t.get(`tl.demo.projectManagement:Ticket#title`)"
					inputs="ticket"
				/>
			</on-activate>
		</table>
	</panel>
</view>