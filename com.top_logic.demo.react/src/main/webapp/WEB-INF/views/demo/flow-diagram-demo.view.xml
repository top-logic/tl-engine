<?xml version="1.0" encoding="utf-8" ?>

<!--
	Flow diagram demo, laid out as a dashboard of four tiles over two channels: the
	selected product (selectedProduct) and the selected build step (selectedNode).
	
	The Products tile selects the product whose construction plan the diagram draws.
	The Construction Plan tile spans two grid rows, so the diagram gets twice the height
	of the tiles beside it; its <createChart> script builds a tree of the product's build
	instructions, one node per build step, each showing its marker, its name, the parts
	it consumes and its image.
	
	The Build steps tile lists all build steps flat. There are more steps than fit a
	one-row tile, which is what the tile shows: the dashboard gives its grid a definite
	row height, so the table resolves its height against the tile and scrolls inside it
	instead of growing the page with its rows.
	
	The diagram and the Build steps table share the selectedNode channel, both in
	selection-mode="multi": clicking a node in the diagram marks its row in Build steps, and
	picking rows in Build steps marks their nodes in the diagram - when the steps belong to
	the product the diagram draws; a step of another product stays selected while the
	diagram has no node to mark for it. A click with Ctrl (or Shift) in the diagram adds a
	node to the selection and keeps the selected steps of other products, a click without a
	modifier replaces the whole selection. Dragging with Ctrl held draws a rectangle and adds
	every node inside it to the selection.
	
	The Details form shows the selected step through the derived channel detailNode, which
	has a value only while exactly one step is selected.
	
	Products are created, edited (also by a double click on the row) and deleted in the Products
	tile; deleting a product deletes its build steps, which are parts of it. A build step is created
	in the selected product from the Build steps tile and becomes the only selected step, so Details
	shows it; Delete in the Build steps tile deletes all selected steps. The steps a build step is
	built from are its inputs, which the diagram draws as its connections - an input of another
	product has no node in the diagram and is left out. The tables and the diagram observe the types
	they display, so an object created, edited or deleted shows everywhere right away.
-->
<view>
	<channels>
		<channel name="selectedProduct"/>
		<channel name="selectedNode"/>
		<derived-channel name="detailNode"
			expr="$selectedNode.size() == 1 ? $selectedNode.singleElement() : null"
			inputs="selectedNode"
		/>
	</channels>
	<dashboard id="flow-diagram">
		<tile id="products"
			width="third"
		>
			<panel fill="true">
				<title>
					<en>Products</en>
					<de>Produkte</de>
				</title>
				<commands>
					<generic-command
						image="css:bi bi-plus-lg"
						placement="TOOLBAR"
					>
						<label>
							<en>New</en>
							<de>Neu</de>
						</label>
						<create-transient type="test.flowchart:Product">
							<with-result>
								<open-dialog
									bind-input-to="model"
									dialog-view="demo/create-flow-product.view.xml"
								>
									<bind
										channel="selection"
										to="selectedProduct"
									/>
								</open-dialog>
							</with-result>
						</create-transient>
					</generic-command>
					<generic-command
						image="css:bi bi-pencil"
						inputs="selectedProduct"
						placement="TOOLBAR"
					>
						<label>
							<en>Edit</en>
							<de>Bearbeiten</de>
						</label>
						<executability>
							<null-input-disabled/>
						</executability>
						<open-dialog
							bind-input-to="model"
							close-on-backdrop="true"
							dialog-view="demo/edit-flow-product.view.xml"
						/>
					</generic-command>
					<!-- Deleting a product deletes its build steps with it: they are parts of it. -->
					<generic-command
						image="css:bi bi-trash"
						inputs="selectedProduct"
						placement="TOOLBAR"
					>
						<label>
							<en>Delete</en>
							<de>Löschen</de>
						</label>
						<executability>
							<null-input-disabled/>
						</executability>
						<delete-object/>
						<write-channel name="selectedProduct"
							clear="true"
						/>
						<write-channel name="selectedNode"
							clear="true"
						/>
					</generic-command>
				</commands>
				<table
					observed-types="test.flowchart:Product"
					selection="selectedProduct"
					types="test.flowchart:Product"
				>
					<columns>
						<column attribute="name"/>
					</columns>
					<rows>all(`test.flowchart:Product`)</rows>
					<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
						image="css:bi bi-pencil"
					>
						<label>
							<en>Edit</en>
							<de>Bearbeiten</de>
						</label>
						<open-dialog
							bind-input-to="model"
							close-on-backdrop="true"
							dialog-view="demo/edit-flow-product.view.xml"
						/>
					</on-activate>
				</table>
			</panel>
		</tile>
		<tile id="plan"
			row-span="2"
			width="two-thirds"
		>
			<panel fill="true">
				<title>
					<en>Construction Plan</en>
					<de>Bauplan</de>
				</title>
				<flow-diagram
					observed-types="test.flowchart:FlowNode"
					selection="selectedNode"
					selection-mode="multi"
				>
					<inputs>
						<input
							as="product"
							channel="selectedProduct"
						/>
					</inputs>
					<createChart><![CDATA[{
parts = $product == null ? list() : $product.get(`test.flowchart:Product#buildInstructions`);

nodes = $parts.map(p -> reactFlowSelection(
    userObject: $p,
    content: reactFlowBorder(stroke: "#eccf33", thickness: 2, cssClass: "tlSelectionMarker",
    content: reactFlowFill(fill: "#ffee95", cssClass: "tlSelectionMarker",
    content: reactFlowPadding(all: 3,
    content: reactFlowVertical(
        contents: [
            $p.get(`test.flowchart:FlowNode#marker`).with(marker ->
                $marker.isEmpty()
                    ? reactFlowEmpty()
                    : reactFlowPadding(bottom: 8, content: reactFlowAlign(
                        hAlign: "middle",
                        content:
                            reactFlowBorder(
                                stroke: "red",
                                dashes: [5, 5],
                                content: reactFlowPadding(
                                    all: 4,
                                    content: reactFlowText($marker)))))
            ),

            reactFlowAlign(
                hAlign: "middle",
                content: reactFlowPadding(
                    all: 4,
                    content: reactFlowText(
                        fontWeight: "bold",
                        text: $p.get(`test.flowchart:FlowNode#name`))
            )),

            reactFlowAlign(
                hAlign: "middle", content: reactFlowGrid(
                gapY: -1,
                contents: $p.get(`test.flowchart:FlowNode#locations`).map(l -> [
                    $l.get(`test.flowchart:Location#count`).with(count ->
                        $count == null
                        ? reactFlowEmpty()
                        : reactFlowBorder(
                            right: false,
                            content: reactFlowPadding(all: 3, content: reactFlowText($count)))
                    ),
                    reactFlowBorder(
                        content: reactFlowFill(
                            fill: $l.get(`test.flowchart:Location#part`)
                                .get(`test.flowchart:Part#color`),
                            content:
                                reactFlowPadding(all: 3, content: reactFlowText($l.get(`test.flowchart:Location#part`)))
                        )
                    ),
                    {
                        usages = $l.get(`test.flowchart:Location#usages`);
                        $usages.isEmpty()
                            ? reactFlowEmpty()
                            : reactFlowAlign(
                                content: reactFlowBorder(
                                    left: false,
                                    content: reactFlowPadding(all: 3, content: reactFlowText($usages))))
                    }
                ])
            )),

            $p.get(`test.flowchart:FlowNode#image`).with(image ->
                $image == null
                    ? reactFlowEmpty()
                    : reactFlowPadding(
                        top: 8,
                        content: reactFlowBorder(reactFlowImage($image)))
            )
        ]))))
    )
);

nodeByPart = $nodes.indexBy(n -> $n["userObject"]);

$parts.isEmpty()
    ? reactFlowChart()
    : reactFlowChart(
        root: reactFlowPadding(all: 16,
            content: reactFlowTree(
                nodes: $nodes,
                connections: $parts
                    .filter(p -> !$p.get(`test.flowchart:FlowNode#inputs`).isEmpty())
                    .map(p -> $p
                        .get(`test.flowchart:FlowNode#inputs`)
                        .filter(c -> $nodeByPart[$c] != null)
                        .map(c -> reactFlowConnection(
                            parent: $nodeByPart[$p],
                            child: $nodeByPart[$c])))
                    .flatten()
            )
        )
    )
}]]></createChart>
				</flow-diagram>
			</panel>
		</tile>
		<tile id="steps"
			width="third"
		>
			<panel fill="true">
				<title>
					<en>Build steps</en>
					<de>Bauschritte</de>
				</title>
				<commands>
					<!-- A build step is part of a product: it is created in the product selected in Products. -->
					<generic-command
						image="css:bi bi-plus-lg"
						inputs="selectedProduct"
						placement="TOOLBAR"
					>
						<label>
							<en>New</en>
							<de>Neu</de>
						</label>
						<executability>
							<null-input-disabled/>
						</executability>
						<create-transient
							container="selectedProduct"
							reference="buildInstructions"
							type="test.flowchart:FlowNode"
						>
							<with-result>
								<open-dialog
									bind-input-to="model"
									dialog-view="demo/create-flow-step.view.xml"
								>
									<bind
										channel="container"
										to="selectedProduct"
									/>
									<bind
										channel="selection"
										to="selectedNode"
									/>
								</open-dialog>
							</with-result>
						</create-transient>
					</generic-command>
					<generic-command
						image="css:bi bi-trash"
						inputs="selectedNode"
						placement="TOOLBAR"
					>
						<label>
							<en>Delete</en>
							<de>Löschen</de>
						</label>
						<executability>
							<null-input-disabled/>
						</executability>
						<delete-object/>
						<write-channel name="selectedNode"
							clear="true"
						/>
					</generic-command>
				</commands>
				<table
					observed-types="test.flowchart:FlowNode"
					selection="selectedNode"
					selection-mode="multi"
					types="test.flowchart:FlowNode"
				>
					<columns>
						<column attribute="name"/>
						<column attribute="marker"/>
					</columns>
					<rows>all(`test.flowchart:FlowNode`)</rows>
				</table>
			</panel>
		</tile>
		<tile id="details"
			width="full"
		>
			<panel>
				<title>
					<en>Details</en>
					<de>Details</de>
				</title>
				<form
					input="detailNode"
					with-inset="true"
				>
					<field attribute="name"/>
					<field attribute="marker"/>
					<field attribute="inputs"/>
					<field attribute="image"/>
				</form>
			</panel>
		</tile>
	</dashboard>
</view>