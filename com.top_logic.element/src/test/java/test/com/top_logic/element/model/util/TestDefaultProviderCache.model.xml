<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="testDefaultProviderCache">
		<datatype name="String"
			db_type="varchar"
			kind="String"
		>
			<storage-mapping class="com.top_logic.element.meta.kbbased.storage.mappings.DirectMapping"
				application-type="java.lang.String"
			/>
		</datatype>

		<class name="Base"
			abstract="true"
		>
			<attributes>
				<property name="plain"
					type="String"
				/>
				<property name="withDefault"
					type="String"
				>
					<annotations>
						<default-value>
							<string value="hello"/>
						</default-value>
					</annotations>
				</property>
				<property name="other"
					type="String"
				/>
				<property name="derived"
					abstract="true"
					type="String"
				>
					<annotations>
						<default-value>
							<string value="derived default"/>
						</default-value>
					</annotations>
				</property>
			</attributes>
		</class>

		<class name="Concrete">
			<generalizations>
				<generalization type="Base"/>
			</generalizations>
			<attributes>
				<property name="derived"
					override="true"
					type="String"
				/>
			</attributes>
		</class>
	</module>
</model>
