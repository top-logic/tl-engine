<?xml version="1.0" encoding="utf-8" ?>

<!--
	Personal settings of the logged-in user, in two tabs: what describes them, and what secures
	their account.

	Deliberately small. What a user changes with a single decision - the language, the theme, where
	they start - is an entry of the user menu (user-menu.view.xml), one click from the app bar, so
	this dialog holds only what wants a form or belongs with the account's security.

	The form is over the account (tl.accounts:Person), so this module carries no dependency on the
	Contacts model. A module that has it - or the application - contributes the profile fields
	through a same-path overlay (WEB-INF/views/settings.view.xml of its own module) merged by the
	ViewLoader in dependency order, the way tl-model-search-react extends admin/admin.view.xml; see
	tl-layout-view-contact for the one that adds the person's contact data.
-->
<view>
	<channels>
		<!-- The account being edited: the session's own, always. -->
		<derived-channel name="account"
			expr="currentUser()"
		/>
	</channels>
	<window resizable="false"
		width="560px"
	>
		<title>
			<en>Settings</en>
			<de>Einstellungen</de>
		</title>
		<tab-bar active-tab="account">
			<tabs>
				<tab id="account"
					icon="css:bi bi-person"
				>
					<label>
						<en>Account</en>
						<de>Konto</de>
					</label>
					<!--
						A panel of its own, so that the form's Save belongs to this tab: a panel
						establishes the command scope its button bar is built from, while a form
						placed directly in the tab would contribute to the enclosing window and
						offer Save from the security tab as well.
					-->
					<panel>
						<form
							initial-edit-mode="true"
							input="account"
							mode-switch="false"
						>
							<field attribute="timezone"/>
							<field attribute="country"/>
							<commands>
								<generic-command image="css:bi bi-check-lg"
									placement="BUTTON_BAR"
								>
									<label>
										<en>Save</en>
										<de>Speichern</de>
									</label>
									<with-transaction>
										<store-form-state/>
									</with-transaction>
								</generic-command>
							</commands>
						</form>
					</panel>
				</tab>

				<!--
					Each entry here acts on the account rather than holding a value of it, so the
					tab is a list of buttons and not a form. They stretch across the tab because
					the list is what the tab is - nothing else competes for the width, and a row of
					differently sized buttons would only invite guessing which one matters.
				-->
				<tab id="security"
					icon="css:bi bi-shield-lock"
				>
					<label>
						<en>Security</en>
						<de>Sicherheit</de>
					</label>
					<stack
						align="stretch"
						direction="column"
						gap="compact"
					>
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-key"
							>
								<label>
									<en>Change password</en>
									<de>Passwort ändern</de>
								</label>
								<execute-script function="x -> new(`tl.login:PasswordChange`, transient: true)"/>
								<open-dialog
									bind-input-to="model"
									dialog-view="change-password.view.xml"
								/>
							</action>
						</button>

						<!--
							Enabling asks the next login to set the second factor up, so there is
							nothing to enter here; disabling takes it off again. Each is offered
							only in the state where it means something. An account that is required
							to use a second factor cannot switch it off, which the action itself
							refuses - that is a question about the account, not about this view.
						-->
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-shield-plus"
								input="account"
							>
								<label>
									<en>Enable two-factor authentication</en>
									<de>Zwei-Faktor-Authentifizierung aktivieren</de>
								</label>
								<executability>
									<visible-if expr="account -> $account.get(`tl.accounts:Person#mfaSecret`) == null"/>
								</executability>
								<enable-mfa/>
							</action>
						</button>
						<button>
							<action class="com.top_logic.layout.view.command.GenericViewCommand"
								image="css:bi bi-shield-minus"
								input="account"
							>
								<label>
									<en>Disable two-factor authentication</en>
									<de>Zwei-Faktor-Authentifizierung deaktivieren</de>
								</label>
								<executability>
									<visible-if expr="account -> $account.get(`tl.accounts:Person#mfaSecret`) != null"/>
								</executability>
								<confirm expr="account -> #('Log in with your password alone from now on?'@en, 'Künftig nur noch mit dem Passwort anmelden?'@de)"/>
								<disable-mfa/>
							</action>
						</button>
					</stack>
				</tab>
			</tabs>
		</tab-bar>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Close</en>
						<de>Schließen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
