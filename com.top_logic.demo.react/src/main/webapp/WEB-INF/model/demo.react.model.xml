<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="demo.react">
			<enum name="Priority">
				<classifier name="low"/>
				<classifier name="medium"/>
				<classifier name="high"/>
			</enum>
			<class name="Demo">
				<annotations>
					<main-properties properties="name, string, priority, active, date, owner"/>
				</annotations>
				<attributes>
					<!-- Text -->
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<property name="string"
						type="tl.core:String"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="multiLine"
						type="tl.core:Text"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<multi-line rows="4"/>
						</annotations>
					</property>
					<property name="html"
						type="tl.model.wysiwyg:Html"
					/>
					<property name="i18n"
						type="tl.model.i18n:I18NString"
					/>
					<property name="i18nMultiline"
						type="tl.model.i18n:I18NString"
					>
						<annotations>
							<multi-line rows="4"/>
						</annotations>
					</property>
					<property name="i18nHtml"
						type="tl.model.i18n:I18NHtml"
					/>
					<property name="password"
						type="tl.core:String"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<input-control>
								<impl class="com.top_logic.layout.view.form.PasswordInputControlProvider"/>
							</input-control>
						</annotations>
					</property>

					<property name="aliases"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:String"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="notes"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:String"
					>
						<annotations>
							<multi-line rows="3"/>
						</annotations>
					</property>

					<!-- Source code -->
					<property name="xmlSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="XML"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="jsonSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="JSON"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="cssSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="CSS"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="javascriptSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="JAVASCRIPT"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="htmlSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="HTML"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="markdownSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="MARKDOWN"
								/>
							</input-control>
						</annotations>
					</property>
					<property name="plainSource"
						type="tl.core:Text"
					>
						<annotations>
							<input-control>
								<impl class="com.top_logic.layout.react.codeedit.CodeEditorControlProvider"
									language="PLAIN"
								/>
							</input-control>
						</annotations>
					</property>

					<!-- Numbers -->
					<property name="count"
						type="tl.core:Integer"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="size"
						type="tl.core:Long"
					/>
					<property name="amount"
						type="tl.core:Double"
					/>
					<property name="price"
						type="tl.core:Double"
					>
						<annotations>
							<format>
								<decimal pattern="#,##0.00"/>
							</format>
						</annotations>
					</property>
					<property name="ratio"
						type="tl.core:Double"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<value-range
								max="100.0"
								min="0.0"
							/>
						</annotations>
					</property>

					<property name="scores"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:Integer"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="ratios"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:Double"
					>
						<annotations>
							<format>
								<decimal pattern="#,##0.00"/>
							</format>
						</annotations>
					</property>

					<!-- Boolean / Tristate -->
					<property name="active"
						type="tl.core:Boolean"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="tri"
						type="tl.core:Tristate"
					/>
					<property name="activeRadio"
						type="tl.core:Boolean"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<boolean-display presentation="radio"/>
						</annotations>
					</property>
					<property name="activeSelect"
						type="tl.core:Boolean"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<boolean-display presentation="select"/>
						</annotations>
					</property>

					<property name="locked"
						type="tl.core:Boolean"
					/>

					<property name="flags"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:Boolean"
					/>

					<!-- Date / Time -->
					<property name="date"
						type="tl.core:Date"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="dateTime"
						type="tl.core:DateTime"
					/>
					<property name="dateTimeShort"
						type="tl.core:DateTime"
					>
						<annotations>
							<format>
								<date-time
									date-style="short"
									time-style="short"
								/>
							</format>
						</annotations>
					</property>
					<property name="time"
						type="tl.core:Time"
					/>
					<property name="duration"
						type="tl.core:Duration"
					/>

					<property name="deadlines"
						bag="true"
						multiple="true"
						ordered="true"
						type="tl.core:Date"
					/>

					<!-- Visual / complex value types -->
					<property name="icon"
						type="tl.core:Icon"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="color"
						type="tl.util:Color"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<property name="country"
						type="tl.util:Country"
					/>
					<property name="language"
						type="tl.util:Language"
					/>
					<property name="timeZone"
						type="tl.util:TimeZone"
					/>
					<property name="url"
						type="tl.util:URL"
					/>
					<property name="email"
						type="tl.util:EMail"
					/>
					<property name="phone"
						type="tl.util:Phone"
					/>
					<property name="json"
						type="tl.util:JSON"
					/>
					<property name="image"
						type="tl.core:Binary"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<input-control>
								<impl class="com.top_logic.layout.view.form.BinaryControlProvider"/>
							</input-control>
						</annotations>
					</property>

					<!-- Enumeration / classification -->
					<reference name="priority"
						kind="forwards"
						type="Priority"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<default-value>
								<classifier value="medium"/>
							</default-value>
						</annotations>
					</reference>
					<reference name="tags"
						kind="forwards"
						multiple="true"
						type="Priority"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<classification-display value="checklist"/>
						</annotations>
					</reference>
					<reference name="priorityRadio"
						kind="forwards"
						type="Priority"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
							<classification-display value="radio-inline"/>
						</annotations>
					</reference>

					<!-- References -->
					<reference name="owner"
						kind="forwards"
						type="tl.accounts:Person"
					/>
					<reference name="watchers"
						kind="forwards"
						multiple="true"
						type="tl.accounts:Person"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="obj -> if($obj.get(`demo.react:Demo#locked`), &quot;disabled&quot;, &quot;default&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</reference>
					<reference name="related"
						kind="forwards"
						multiple="true"
						ordered="true"
						type="tl.accounts:Person"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>