<?xml version="1.0" encoding="utf-8" ?>

<!--
	What the eval's agents are told the application is. TestInitSkill copies this file into the
	application source it saves the application context into.
-->
<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tl.ai.core.agent.AgentApplicationService">
			<instance class="com.top_logic.tl.ai.core.agent.AgentApplicationService">
				<environment>
					<application>
						<en>Project management eval fixture (tl-ai-eval)</en>
						<de>Projektverwaltung, Eval-Testdaten (tl-ai-eval)</de>
					</application>
				</environment>
			</instance>
		</config>
	</services>
</application>
