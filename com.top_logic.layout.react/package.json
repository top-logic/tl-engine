{
  "name": "tl-react-bridge",
  "version": "7.11.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && vite build --config vite.config.bridge.ts && vite build --config vite.config.controls.ts",
    "dev": "vite build --config vite.config.bridge.ts --watch"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@floating-ui/react": "^0.27.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
