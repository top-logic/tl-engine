<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.admin.people.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.admin.people.model.xml"/>
				</declarations>
			</instance>
		</config>
		<!--
			The transient form object of the "new person" dialog is handled by the view code only and
			never on behalf of a user through the access check, so it carries no access definition.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<module name="tl.admin.people"
						internal="true"
					/>
				</security-config>
			</instance>
		</config>
	</services>
</application>