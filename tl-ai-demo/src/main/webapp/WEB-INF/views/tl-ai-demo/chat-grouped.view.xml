<?xml version="1.0" encoding="utf-8" ?>

<!--
	The chat built from view elements instead of the one-element <agent-chat/> (Issue #415).

	The page is one <chat chat-id="chat">: it names the conversation once, and every chat element
	inside it joins that one without repeating the id, so two of them can no longer be written to
	disagree. In every other respect it is the <stack direction="row"> that held the three columns
	before: a <data-list> of this user's chats on the left (a generic list - it reaches the
	conversation over the "chatSession" channel, not by chat-id, and would work the same outside the
	<chat>), the <chat-conversation/> (transcript plus prompt field) in the middle, and a
	<chat-rail/> on the right. The rail is a shell - what it shows is configured here, and the
	"Belege" section is an ordinary <data-list>, which is the point: any view element is a section,
	so an application puts its own views beside the transcript without the chat knowing about them.
-->
<view>
	<channels>
		<channel name="chatSession"/>
		<!--
			What the rail's pane is showing, written by the "Belege" list, by the agent's `present`
			tool, or by both. Empty means the sections; the pane's close button empties it again.
			It holds one invoice or several - "show me the three most expensive" puts three there.
		-->
		<channel name="paneObject"/>
		<!--
			The same value split by how many objects stand on it, because a record is a form and a
			set of records is a list, and neither element can render the other's value: <form>
			resolves its input to one object. The rail shows the <pane> for the first and the
			<list-pane> for the second, so exactly one of the two ever has something to show.
		-->
		<derived-channel name="paneInvoice"
			inputs="paneObject"
		>
			<expr><![CDATA[v -> ifElse($v.size() == 1, $v.singleElement(), null)]]></expr>
		</derived-channel>
		<derived-channel name="paneInvoices"
			inputs="paneObject"
		>
			<expr><![CDATA[v -> ifElse($v.size() > 1, $v, list())]]></expr>
		</derived-channel>
		<!-- The counts the rail shows on the section headers and the strip icons. -->
		<channel name="progressBadge"/>
		<channel name="sourcesBadge"/>
		<channel name="memoriesBadge"/>
		<!--
			The composer's unsent text, and the object a command puts into it as a reference token.
			Declared here so this page works on its own; app.view.xml binds its own "chatDraft" over
			this one (<view-ref><bind/></view-ref>), which is what lets the Belege page write it too -
			see "Writing a channel across a view boundary" in tl-chat/CLAUDE.md.
		-->
		<channel name="chatDraft"/>
		<channel name="chatReference"/>
	</channels>
	<chat chat-id="chat"
		direction="row"
	>
		<!--
			The session list and the conversation share one two-way "chatSession" channel: the list
			writes the picked session, the conversation follows it and writes its own session back (so a
			new chat is highlighted). "Neuer Chat" just clears the channel (create-action); the
			conversation shows its empty state when nothing is selected - no extra binding element.
		-->
		<data-list
			collapsible="true"
			observed-types="tl.ai.execution:AgentSession"
			row-actions="hover"
			row-channel="session"
			search="true"
			selection="chatSession"
		>
			<!--
				The "New chat" button is an ordinary view command: it writes null to the selection
				channel, which deselects the list and shows the conversation's empty state. Any custom
				action (execute-script, open-dialog, with-transaction, ...) can be configured the same way.
			-->
			<commands>
				<generic-command image="css:bi bi-plus-lg">
					<label>
						<en>New chat</en>
						<de>Neuer Chat</de>
					</label>
					<write-channel name="chatSession"/>
				</generic-command>
			</commands>
			<empty-text>
				<en>No chats yet</en>
				<de>Noch keine Chats</de>
			</empty-text>
			<group-by><![CDATA[s -> {
				d = $s.get(`tl.ai.execution:AgentSession#lastUpdated`).toSystemCalendar();
				t = today().toSystemCalendar();
				switch {
					$d.isDateEqual($t): #("Today"@en, "Heute"@de);
					$d.isDateEqual($t.withDayAdded(-1)): #("Yesterday"@en, "Gestern"@de);
					$d.isDateGreater($t.withDayAdded(-7)): #("Previous 7 days"@en, "Letzte 7 Tage"@de);
					default: #("Older"@en, "Älter"@de);
				}
			}]]></group-by>
			<lines>
				<line attribute="title"/>
			</lines>
			<!--
				What a row offers besides being opened. Ordinary view commands: they reach the row
				the menu was opened on over the "session" channel this list registers, so an
				<executability> rule sees it too. Both write through the aiSession* functions rather
				than touching the attribute, because those are what bump the chat's lastUpdated - its
				group in this very list - and tell a second browser tab.
			-->
			<row-commands>
				<generic-command
					image="css:bi bi-pencil"
					input="session"
				>
					<label>
						<en>Rename</en>
						<de>Umbenennen</de>
					</label>
					<open-dialog close-on-backdrop="false"
						bind-input-to="model"
						dialog-view="tl-ai-demo/rename-session.view.xml"
					/>
				</generic-command>
				<generic-command
					clique="delete"
					image="css:bi bi-trash"
					input="session"
				>
					<label>
						<en>Delete</en>
						<de>Löschen</de>
					</label>
					<!--
						Hidden while the chat still has a run in it. Deleting one is safe - the
						function asks the run to stop first - but a chat that is being answered is
						not a chat anyone means to throw away, and the rule re-evaluates every time
						the menu opens.
					-->
					<executability>
						<visible-if>
							<expr><![CDATA[s -> isEmpty($s)
								|| $s.referers(`tl.ai.execution:AgentExecution#session`)
									.filter(e -> $e.get(`tl.ai.execution:AgentExecution#status`)
										== `tl.ai.execution:ExecutionStatus#RUNNING`)
									.isEmpty()]]></expr>
						</visible-if>
					</executability>
					<!-- Names the chat, and names the outcomes rather than answering Yes/No. -->
					<confirm>
						<cancel-label>
							<en>Keep</en>
							<de>Behalten</de>
						</cancel-label>
						<confirm-label>
							<en>Delete</en>
							<de>Löschen</de>
						</confirm-label>
						<title>
							<en>Delete chat</en>
							<de>Chat löschen</de>
						</title>
						<expr><![CDATA[s -> {
							title = $s.get(`tl.ai.execution:AgentSession#title`);
							{
								"en": "Delete “" + $title + "”? This cannot be undone.",
								"de": "„" + $title + "“ löschen? Das kann nicht rückgängig gemacht werden."
							}.internationalize();
						}]]></expr>
					</confirm>
					<!--
						Clears the open conversation only when it *is* the deleted chat: the value
						the chain ends with is what <write-channel> writes, so deleting some other
						chat writes the open one back unchanged and the transcript stays put.
					-->
					<execute-script>
						<inputs>
							<input channel="chatSession"/>
						</inputs>
						<function><![CDATA[open -> s -> {
							aiSessionDelete($s);
							ifElse($s == $open, null, $open);
						}]]></function>
					</execute-script>
					<write-channel name="chatSession"/>
				</generic-command>
			</row-commands>
			<rows><![CDATA[all(`tl.ai.execution:AgentSession`)
				.filter(s -> $s.get(`tl.ai.execution:AgentSession#owner`) == currentUser())
				.filter(s -> $s.get(`tl.ai.execution:AgentSession#kind`) == `tl.ai.execution:SessionKind#CHAT`)
				.sort((s -> $s.get(`tl.ai.execution:AgentSession#lastUpdated`)).comparator().desc())]]></rows>
			<title>
				<en>Chats</en>
				<de>Chats</de>
			</title>
		</data-list>
		<!--
			The <panel> is what bounds the conversation's height so it scrolls inside its column
			rather than growing with the transcript. Its own header stays empty here, which the dark
			theme shows as a bare strip above the conversation's header - an untitled panel should
			render no toolbar at all, but that is the engine's to decide.
		-->
		<panel fill="true">
			<!--
				`present` is the allow list of the tool of the same name: it names the one channel
				this page lets the agent write. "Show me invoice X" then ends as that invoice in the
				rail's pane. Deny by default - without this attribute no run reaches any channel of
				this view, and a `present` call naming another channel is refused.
			-->
			<chat-conversation
				citations="true"
				draft="chatDraft"
				input="chatSession"
				present="paneObject"
				prompt-improver-agent="TL_PromptImprover"
				reference="chatReference"
				trace="summary"
			>
				<!--
					The composer's idle invitation, in this application's own words (Issue #420). The
					chat's own German addresses the user with "du", which an application that says
					"Sie" everywhere else cannot have on its most-read control. Idle only: while the
					agent works the field keeps saying "Nächste Nachricht schreiben …", which is
					about the run rather than about this application.
				-->
				<placeholder>
					<en>Ask about these invoices, their amounts or who they are from.</en>
					<de>Fragen Sie nach diesen Belegen, ihren Beträgen oder ihren Absendern.</de>
				</placeholder>
				<actions rate="true"/>
				<controls
					agent-picker="true"
					attachments="true"
					auto-approve="true"
					enter-hint="true"
					mcp="true"
					model-picker="true"
					thinking="true"
					trace-picker="true"
				/>
				<!--
					What this page states about the situation the user is asking in (Issue #437). The
					server evaluates these when the page's channels change and they travel with every
					message; the message text itself is never touched.

					"Application" is stable, so it is rendered into the environment block of the system
					prompt - which has to stay byte-identical across the turns of one conversation, or
					the provider's prompt cache misses on every one of them. "Open invoice" and
					"Open invoice amount" follow the user's clicks in the rail, so they are not: they go
					into the per-turn <turn-context> block, which travels in the turn itself, beside the
					user's text (#438).

					The dock in app.view.xml states the same facts, because it is the same conversation:
					a page that states them and a dock that does not would flip the environment block
					between the turns of one chat, and would leave every question asked from the dock
					without the selection (#494).

					Every fact takes the <inputs> as its leading arguments, the way <data-list> binds
					its rows - which is why the stable one names the channel it does not use.
				-->
				<context>
					<inputs>
						<input channel="paneObject"/>
					</inputs>
					<fact name="Application"
						stable="true"
					>
						<value><![CDATA[open -> "Invoice management demo (tl-ai-demo)"]]></value>
					</fact>
					<fact name="Open invoice amount"
						stable="false"
					>
						<value><![CDATA[open -> ifElse(isEmpty($open), "none",
							$open.get(`tl.ai.demo.imageclassification:Invoice#amountLabel`))]]></value>
					</fact>
				</context>
				<!--
					And the one line that says WHICH object the user is looking at (Issue #494). It
					states the same channel the pane renders - label, type and the identifier every
					tool reads back - so "what have I selected?" is answered and "change its date" is
					possible. The <fact> above could have said the label; it could not have said the
					identifier without this page knowing how this product spells one.
				-->
				<selection name="Open invoice"
					channel="paneObject"
				/>
				<!--
					Declarative @-mention: typing "@" offers this application's invoices, no TypeScript.
					Each mention carries the invoice's id and puts its description into the message as the
					quoted text the agent reads.
				-->
				<mention observed-types="tl.ai.demo.imageclassification:Invoice">
					<rows><![CDATA[all(`tl.ai.demo.imageclassification:Invoice`)
						.sort((i -> $i.get(`tl.ai.demo.imageclassification:Invoice#date`)).comparator().desc())]]></rows>
					<label><![CDATA[i -> $i.get(`tl.ai.demo.imageclassification:Invoice#description`)]]></label>
					<text><![CDATA[i -> $i.get(`tl.ai.demo.imageclassification:Invoice#description`)
						+ " (" + $i.get(`tl.ai.demo.imageclassification:Invoice#amountLabel`) + ")"]]></text>
				</mention>
			</chat-conversation>
		</panel>
		<!--
			The rail. Its badge channels carry the counts that the transcript's rail button adds up,
			so a closed rail still says how much is new.
		-->
		<chat-rail input="paneObject"
			open="true"
			strip="true"
		>
			<section name="progress"
				badge="progressBadge"
				icon="css:bi bi-list-check"
				open="true"
			>
				<label>
					<en>Progress</en>
					<de>Fortschritt</de>
				</label>
				<!--
					The agent's plan, as an ordinary <data-list> over the AgentTask objects the run
					writes - no chat-specific element, no badge round trip through the browser, and
					the same rows after a reload. The rows are reached from the session the
					conversation is showing, so this list can only ever show what that session owns.
				-->
				<data-list
					collapsible="false"
					count="progressBadge"
					observed-types="tl.ai.execution:AgentTask"
					search="false"
				>
					<!--
						The row's state as a CSS class. <data-list> knows nothing about tasks; the
						three class names are the generic row states its stylesheet defines.
					-->
					<css-class><![CDATA[t -> switch {
						$t.get(`tl.ai.execution:AgentTask#status`) == "completed": "is-done";
						$t.get(`tl.ai.execution:AgentTask#status`) == "in_progress": "is-running";
						default: "is-pending";
					}]]></css-class>
					<empty-text>
						<en>Nothing planned yet</en>
						<de>Noch nichts geplant</de>
					</empty-text>
					<inputs>
						<input channel="chatSession"/>
					</inputs>
					<lines>
						<line attribute="subject"/>
						<line emphasis="secondary">
							<value><![CDATA[t -> switch {
								$t.get(`tl.ai.execution:AgentTask#status`) == "completed": #("Done"@en, "Erledigt"@de);
								$t.get(`tl.ai.execution:AgentTask#status`) == "in_progress": #("In progress"@en, "Läuft"@de);
								default: #("Pending"@en, "Offen"@de);
							}]]></value>
						</line>
					</lines>
					<rows><![CDATA[session -> ifElse(isEmpty($session), list(),
						$session.referers(`tl.ai.execution:AgentTask#session`)
							.sort((t -> $t.get(`tl.ai.execution:AgentTask#ordinal`)).comparator()))]]></rows>
				</data-list>
			</section>
			<section name="sources"
				badge="sourcesBadge"
				icon="css:bi bi-quote"
			>
				<label>
					<en>Sources</en>
					<de>Quellen</de>
				</label>
				<chat-sources badge="sourcesBadge"/>
			</section>
			<!--
				Nothing chat-specific: an ordinary <data-list> of this application's own objects, in a
				rail section. Picking one writes it to "paneObject", which is what opens the pane.
			-->
			<section name="invoices"
				icon="css:bi bi-receipt"
			>
				<label>
					<en>Invoices</en>
					<de>Belege</de>
				</label>
				<data-list
					collapsible="false"
					observed-types="tl.ai.demo.imageclassification:Invoice"
					row-actions="hover"
					row-channel="invoice"
					search="false"
					selection="paneObject"
				>
					<empty-text>
						<en>No invoices yet</en>
						<de>Noch keine Belege</de>
					</empty-text>
					<!--
						What issue #440 is about: two ordinary view commands put a question about this
						row into the composer, with no chat-specific code and no new command class.
						The first writes a whole German sentence to the "chatDraft" channel; the
						second writes the invoice itself to "chatReference", which the composer turns
						into one atomic reference token at the caret - what picking it with "@" does.
						Neither sends: the user reads the sentence and presses send.
					-->
					<row-commands>
						<generic-command
							image="css:bi bi-chat-left-text"
							input="invoice"
						>
							<label>
								<en>Ask about this</en>
								<de>Dazu fragen</de>
							</label>
							<execute-script>
								<function><![CDATA[i -> {
									"en": "Please explain the invoice “"
										+ $i.get(`tl.ai.demo.imageclassification:Invoice#description`)
										+ "” over " + $i.get(`tl.ai.demo.imageclassification:Invoice#amountLabel`) + ".",
									"de": "Bitte erkläre die Rechnung „"
										+ $i.get(`tl.ai.demo.imageclassification:Invoice#description`)
										+ "“ über " + $i.get(`tl.ai.demo.imageclassification:Invoice#amountLabel`) + "."
								}.internationalize()]]></function>
							</execute-script>
							<write-channel name="chatDraft"/>
						</generic-command>
						<generic-command
							image="css:bi bi-quote"
							input="invoice"
						>
							<label>
								<en>Quote in the message</en>
								<de>In die Nachricht übernehmen</de>
							</label>
							<write-channel name="chatReference"/>
						</generic-command>
					</row-commands>
					<lines>
						<line attribute="description"/>
						<line attribute="amountLabel"
							emphasis="secondary"
						/>
					</lines>
					<rows><![CDATA[all(`tl.ai.demo.imageclassification:Invoice`)
						.sort((i -> $i.get(`tl.ai.demo.imageclassification:Invoice#date`)).comparator().desc())]]></rows>
				</data-list>
			</section>
			<!--
				What the agent has kept about this user (Issue #439), as an ordinary <data-list> over
				the UserMemory objects - no chat-specific element. The rows are filtered by owner, so
				this list can only ever show what belongs to the account looking at it, and the Delete
				command goes through aiMemoryDelete, which refuses a row of somebody else even when a
				channel happens to hold one.

				A memory written during this conversation shows up here at once - the store tells the
				open windows - while the agent is told about it only in the NEXT conversation: the
				environment block it sits in has to stay byte-identical across the turns of one
				conversation, or the provider's prompt cache misses on every one of them.
			-->
			<section name="memories"
				badge="memoriesBadge"
				icon="css:bi bi-bookmark-heart"
			>
				<label>
					<en>Memory</en>
					<de>Gedächtnis</de>
				</label>
				<data-list
					collapsible="false"
					count="memoriesBadge"
					observed-types="tl.ai.execution:UserMemory"
					row-actions="hover"
					row-channel="memory"
					search="false"
				>
					<empty-text>
						<en>Nothing remembered yet</en>
						<de>Noch nichts gemerkt</de>
					</empty-text>
					<lines>
						<line attribute="text"/>
						<line emphasis="secondary">
							<value><![CDATA[m -> {
								kind = $m.get(`tl.ai.execution:UserMemory#kind`);
								created = $m.get(`tl.ai.execution:UserMemory#createdAt`);
								ifElse(isEmpty($kind), "", $kind.label())
									+ ifElse(isEmpty($created), "",
										" - " + dateFormat("yyyy-MM-dd").format($created));
							}]]></value>
						</line>
					</lines>
					<row-commands>
						<generic-command
							clique="delete"
							image="css:bi bi-trash"
							input="memory"
						>
							<label>
								<en>Forget</en>
								<de>Vergessen</de>
							</label>
							<!-- Names what is about to be forgotten rather than asking Yes/No. -->
							<confirm>
								<cancel-label>
									<en>Keep</en>
									<de>Behalten</de>
								</cancel-label>
								<confirm-label>
									<en>Forget</en>
									<de>Vergessen</de>
								</confirm-label>
								<title>
									<en>Forget this</en>
									<de>Das vergessen</de>
								</title>
								<expr><![CDATA[m -> {
									text = $m.get(`tl.ai.execution:UserMemory#text`);
									{
										"en": "Forget “" + $text + "”? Albert will no longer know it.",
										"de": "„" + $text + "“ vergessen? Albert weiß es dann nicht mehr."
									}.internationalize();
								}]]></expr>
							</confirm>
							<execute-script>
								<function><![CDATA[m -> { aiMemoryDelete($m); null; }]]></function>
							</execute-script>
						</generic-command>
					</row-commands>
					<rows><![CDATA[all(`tl.ai.execution:UserMemory`)
						.filter(m -> $m.get(`tl.ai.execution:UserMemory#owner`) == currentUser())
						.sort((m -> $m.get(`tl.ai.execution:UserMemory#createdAt`)).comparator().desc())]]></rows>
				</data-list>
			</section>
			<!--
				The pane's content, shown in place of the sections while "paneObject" holds one
				object - picked in the "Belege" list, or presented by the agent.
			-->
			<pane>
				<form input="paneInvoice">
					<field attribute="date"/>
					<field attribute="description"/>
					<field attribute="amount"/>
					<field attribute="data"/>
				</form>
			</pane>
			<!--
				And what it shows instead when several objects stand there, which is what the agent
				does for "show me the three most expensive invoices". An ordinary <data-list> over
				the collection - the agent named the objects, this page decided they are a list.
			-->
			<list-pane>
				<data-list
					collapsible="false"
					search="false"
				>
					<empty-text>
						<en>Nothing to show</en>
						<de>Nichts anzuzeigen</de>
					</empty-text>
					<inputs>
						<input channel="paneInvoices"/>
					</inputs>
					<lines>
						<line attribute="description"/>
						<line attribute="amountLabel"
							emphasis="secondary"
						/>
					</lines>
					<rows><![CDATA[shown -> $shown]]></rows>
				</data-list>
			</list-pane>
		</chat-rail>
	</chat>
</view>