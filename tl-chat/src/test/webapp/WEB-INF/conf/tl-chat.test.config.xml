<?xml version="1.0" encoding="utf-8"?>

<!-- 
	Configuration options for testing tlchat with JUnit.
 -->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<!--
			An agent with no <summary>, which the picker must then offer by its name alone. The agents
			tl-ai ships all carry one, so without this there would be nothing to test the empty case
			against.
		-->
		<config service-class="com.top_logic.tl.ai.core.agent.TopLogicAgentDefinitions">
			<instance>
				<agents>
					<agent name="TestAgentWithoutSummary"
						description="Delegate here to test that an agent without a user-facing line is offered by its name alone."
					>
						<system-prompt>You are a test agent.</system-prompt>
					</agent>
					<!--
						Loads a skill and writes a plan, on the scripted model: what a chat run keeps
						for its chat beyond the transcript. For TestRunStaysInItsChat.
					-->
					<agent name="TestChatPlanner"
						description="Delegate here to test which chat a run keeps its skills and its plan in."
					>
						<system-prompt>You are a test agent.</system-prompt>
						<skills>
							<skill name="TL_taskManagement"/>
						</skills>
					</agent>
					<!--
						Makes one write the user has to approve, on the scripted model. For
						TestApprovalInAReopenedWindow.
					-->
					<agent name="TestChatWriter"
						description="Delegate here to test where the frames of a run go that waits for an approval."
					>
						<system-prompt>You are a test agent.</system-prompt>
						<tools>
							<tool name="test-approved-write.approvedWrite"/>
						</tools>
					</agent>
					<!--
						Assigned the model of a provider without its key. For TestChatRunAccess.
					-->
					<agent name="TestGatedAgent"
						description="Delegate here to test that the model picker leaves out a model whose provider has no key."
					>
						<system-prompt>You are a test agent.</system-prompt>
					</agent>
				</agents>
			</instance>
		</config>
		<!--
			A write that asks for an approval and changes nothing. For TestApprovalInAReopenedWindow.
		-->
		<config service-class="com.top_logic.tl.ai.tool.api.registry.ToolRegistryService">
			<instance>
				<tool-factories>
					<factory name="test-approved-write">
						<implementation class="com.top_logic.tl.ai.tool.api.registry.ReflectiveToolFactory"
							tool-class="com.top_logic.ai.chat.layout.ApprovedWriteTool"
						/>
					</factory>
				</tool-factories>
			</instance>
		</config>
		<!--
			Claims the conversations a test installs a backend for. For TestChatBackend.
		-->
		<config service-class="com.top_logic.ai.chat.backend.ConversationBackendService">
			<instance>
				<resolvers>
					<resolver class="com.top_logic.ai.chat.layout.ScriptedBackend"/>
				</resolvers>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="test.com.top_logic.basic.TestComment$Config">
			<ignore>
				<entry value="com.top_logic.ai.chat.api.messages" />
			</ignore>
		</config>
	</configs>
</application>