<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="comment"/>
		<channel name="ticket"/>
		<!-- The files to attach to the new comment. -->
		<channel name="files"/>
	</channels>
	<anchor name="composer">
		<panel appearance="card">
			<title>
				<en>New comment</en>
				<de>Neuer Kommentar</de>
			</title>
			<form
				initial-edit-mode="true"
				input="comment"
				mode-switch="false"
				with-inset="true"
			>
				<field attribute="cited"/>
				<field
					attribute="content"
					label-position="hide-label"
				>
					<input-control class="com.top_logic.layout.react.wysiwyg.WysiwygControlProvider"
						insert-channel="insert"
					>
						<commands>
							<generic-command
								image="css:ri-links-line"
								inputs="ticket"
							>
								<label>
									<en>Reference ticket...</en>
									<de>Ticket referenzieren...</de>
								</label>
								<executability>
									<null-input-disabled/>
								</executability>
								<open-dialog dialog-view="tickets/reference-ticket.view.xml">
									<bind
										channel="context"
										to="ticket"
									/>
									<bind
										channel="result"
										to="insert"
									/>
								</open-dialog>
							</generic-command>
						</commands>
					</input-control>
				</field>
				<value-input
					label="model.demo.tickets.Comment.attachments"
					multiple="true"
					type="tl.core:Binary"
					value="files"
				/>
				<commands>
					<generic-command
						image="css:bi bi-send"
						placement="TOOLBAR"
					>
						<label>
							<en>Add comment</en>
							<de>Kommentar hinzufügen</de>
						</label>
						<store-form-state>
							<with-result>
								<link-element>
									<with-result as="comment">
										<with-transaction>
											<execute-script
												function="demoTicketsStoreAttachments($comment, $files)"
												inputs="files"
											/>
										</with-transaction>
										<execute-script function="[]">
											<with-result>
												<write-channel name="files"/>
											</with-result>
										</execute-script>
									</with-result>
								</link-element>
							</with-result>
						</store-form-state>
					</generic-command>
				</commands>
			</form>
		</panel>
	</anchor>
</view>