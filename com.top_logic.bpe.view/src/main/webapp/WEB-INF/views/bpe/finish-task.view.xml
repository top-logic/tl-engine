<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the task screen (bpe/task.view.xml) choosing how a task is finished. The model channel
	holds the task (a tl.bpe.execution:Token), the table lists its options (bpeOptions) with the
	errors blocking each of them; the default option is preselected.

	An option with a form type (bpeFormType) asks for additional data: the form below the table
	edits a transient object of that type (the channel additional) with a field for each attribute
	the type declares itself (viewFields).

	"Finish" refuses a blocked option, confirms the warnings of the chosen one, stores the form into
	the transient object - an error such as a missing mandatory value stops here -, finishes the
	task with the option and the object as additional data (bpeFinish, handing it to the operations
	of the path) and writes the task that follows for the user, or nothing, to the channel next,
	which the task screen binds to its task.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="option"
			init="$model == null ? null : bpeDefaultOption($model)"
			inputs="model"
		/>
		<channel name="next"/>
		<derived-channel name="additional"
			expr="$option == null ? null : { type = bpeFormType($model, $option); $type == null ? null : new($type, transient: true); }"
			inputs="model, option"
		/>
		<derived-channel name="optionErrors"
			expr="$option == null ? null : bpeErrors($model, $option).join('\n')"
			inputs="model, option"
		/>
	</channels>
	<window width="600px">
		<title>
			<en>Finish task</en>
			<de>Aufgabe abschließen</de>
		</title>
		<inset>
			<text>
				<label>
					<en>How does the process continue?</en>
					<de>Wie geht der Prozess weiter?</de>
				</label>
			</text>
		</inset>
		<table
			inputs="model as token"
			selection="option"
			types="tl.bpe.bpml:Edge"
		>
			<columns>
				<computed-column name="label"
					inputs="model as token"
					type="tl.core:String"
				>
					<label>
						<en>Option</en>
						<de>Option</de>
					</label>
					<value>bpeOptionLabel($token, $row).localize()</value>
				</computed-column>
				<computed-column name="errors"
					inputs="model as token"
					type="tl.core:String"
				>
					<label>
						<en>Not possible because</en>
						<de>Nicht möglich, weil</de>
					</label>
					<value>bpeErrors($token, $row).join(', ')</value>
				</computed-column>
			</columns>
			<rows>$token == null ? list() : bpeOptions($token)</rows>
		</table>
		<form
			initial-edit-mode="true"
			input="additional"
			mode-switch="false"
			with-inset="true"
		>
			<noModelMessage>
				<en>No further information.</en>
				<de>Keine weiteren Angaben.</de>
			</noModelMessage>
			<dynamic-view
				inputs="additional"
				view="$additional == null ? null : viewFields($additional.type())"
			/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					inputs="option, model as token, optionErrors as errors, additional"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Finish</en>
						<de>Abschließen</de>
					</label>
					<executability>
						<null-input-disabled/>
						<disabled-if expr="if($errors == null || $errors.isEmpty(), null, $errors)"/>
					</executability>
					<confirm expr="bpeWarnings($token, $option).join('\n')"/>
					<store-form-state/>
					<with-transaction>
						<commitMessage>
							<en>Finished a task.</en>
							<de>Aufgabe abgeschlossen.</de>
						</commitMessage>
						<execute-script function="bpeFinish($token, $option, $additional)"/>
						<with-result>
							<write-channel name="next"/>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
