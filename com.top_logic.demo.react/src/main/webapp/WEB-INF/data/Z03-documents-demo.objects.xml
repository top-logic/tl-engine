<?xml version="1.0" encoding="utf-8" ?>

<objects>
	<!-- The documents the document viewer shows out of the box: a picture and a PDF for the PDF viewer. -->
	<object id="doc-sample-picture"
		type="demo.documents:Document"
	>
		<attribute name="name"
			value="Sample picture"
		/>
		<attribute name="data"
			value="data:image/svg+xml;name=Sample%20picture.svg;base64,"
		/>
	</object>
	<object id="doc-document-viewer"
		type="demo.documents:Document"
	>
		<attribute name="name"
			value="Document Viewer"
		/>
		<attribute name="data"
			value="data:application/pdf;name=Document%20Viewer.pdf;base64,"
		/>
	</object>
</objects>