<?xml version="1.0" encoding="utf-8"?>

<!-- Main configuration file -->
<root>
	<alias>
		<!-- The Brave search key of research.config.xml; give it with the prefix "unencrypted:". -->
		<entry name="%BRAVE_API_KEY%" value="${env:tl_brave_api_key:unencrypted:}"/>
		<!-- The embedding model of ai-index.config.xml: model_int8.onnx and tokenizer.json. -->
		<entry name="%AI_INDEX_MODEL_DIR%" value="${env:tl_ai_index_model_dir:%VAR_PATH%/models/snowflake-arctic-embed-m-v2.0}"/>
	</alias>
</root>
