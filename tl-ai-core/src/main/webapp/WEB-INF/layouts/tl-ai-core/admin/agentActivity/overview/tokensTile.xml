<?xml version="1.0" encoding="utf-8" ?>

<!--
	"Token (30 Tage)". Billable tokens - input plus output - kept apart from the cache traffic,
	because the cached share is what makes a run cheap and mixing the two hides exactly that.
	
	Deliberately not a euro figure: see the note in overviewView.xml.
-->
<securityLayout name="aiOverviewTokensTile"
	titleKey="admin.ai.agentActivity.overview.tokens.label"
>
	<tile-info name="aiOverviewTokens"
		label="admin.ai.agentActivity.overview.tokens.label"
	>
		<preview class="com.top_logic.model.search.tiles.ModelBasedTilePreview">
			<description class="com.top_logic.model.search.tiles.DynamicTilePreviewText">
				<text><![CDATA[
					model -> {
						recent = all(`tl.ai.execution:AgentExecution`)
							.filter(e -> $e.get(`tl.ai.execution:AgentExecution#startedAt`)
								>= now().toSystemCalendar().withDayAdded(-30).toDate());
						value = a -> e -> ifElse(isEmpty($e.get($a)), 0, $e.get($a));
						billable = $recent.map(e -> $value(`tl.ai.execution:AgentExecution#inputTokens`)($e)
							+ $value(`tl.ai.execution:AgentExecution#outputTokens`)($e)).sum();
						cached = $recent.map(e -> $value(`tl.ai.execution:AgentExecution#cacheReadTokens`)($e)).sum();
						// A seven-digit number is not a number a reader takes in at a glance; the exact value is one
						// click away in the table behind this tile.
						short = v -> $v >= 1000000
							? numberFormat('#,##0.0').format($v / 1000000) + ' Mio.'
							: numberFormat('#,##0').format($v);
						{{{
							<div class="aiKpi">
								<div class="aiKpiValue">{$short($billable)}</div>
								<div class="aiKpiNote">
									{#('billable, {0} from the cache'@en, 'abrechenbar, {0} aus dem Cache'@de).fill($short($cached))}
								</div>
							</div>
						}}};
					}
				]]></text>
			</description>
		</preview>
	</tile-info>
	<components>
		<tableView name="aiOverviewTokensTable"
			objectType="tl.ai.execution:AgentExecution"
			securityObject="securityRoot"
			titleKey="admin.ai.agentActivity.overview.tokens.title"
		>
			<modelBuilder class="com.top_logic.model.search.providers.ListModelByExpression">
				<elements><![CDATA[
					model -> all(`tl.ai.execution:AgentExecution`)
						.filter(e -> $e.get(`tl.ai.execution:AgentExecution#startedAt`)
							>= now().toSystemCalendar().withDayAdded(-30).toDate())
				]]></elements>
				<supportsElement>element -> $element.instanceOf(`tl.ai.execution:AgentExecution`)</supportsElement>
			</modelBuilder>
			<table
				defaultColumns="displayName,agentName,model,startedAt,inputTokens,outputTokens,thinkingTokens,cacheReadTokens,cacheWriteTokens"
				defaultSortOrder="startedAt:descending"
				fixedColumns="1"
			>
				<columns>
					<column name="displayName"
						columnWidth="280px"
						visibility="mandatory"
					/>
					<column name="agentName"
						columnWidth="160px"
					/>
					<column name="model"
						columnWidth="170px"
					/>
					<column name="startedAt"
						columnWidth="150px"
					/>
					<column name="inputTokens"
						columnWidth="120px"
					/>
					<column name="outputTokens"
						columnWidth="125px"
					/>
					<column name="thinkingTokens"
						columnWidth="115px"
					/>
					<column name="cacheReadTokens"
						columnWidth="140px"
					/>
					<column name="cacheWriteTokens"
						columnWidth="145px"
					/>
					<column name="transcript"
						visibility="excluded"
					/>
					<column name="transcriptHtml"
						visibility="excluded"
					/>
					<column name="response"
						visibility="excluded"
					/>
				</columns>
			</table>
			<buttons>
				<button id="refreshTokens"
					class="com.top_logic.layout.form.component.InvalidateCommand"
				/>
				<button id="exportExcel"
					class="com.top_logic.layout.table.export.ExcelExportHandler"
				/>
			</buttons>
		</tableView>
	</components>
</securityLayout>
