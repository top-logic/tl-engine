<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tl.ai.core.provider.LLMProviderService"
			config:override="true"
		>
			<instance class="com.top_logic.tl.ai.core.provider.LLMProviderService">
				<providers>
					<provider class="com.top_logic.tl.ai.core.provider.anthropic.AnthropicProviderConfig"
						models="claude-haiku-4-5-20251001,claude-opus-4-7,claude-sonnet-4-6"
						name="anthropic"
					>
						<api-key name="tl_anthropic_api_key"/>
					</provider>
					<provider class="com.top_logic.tl.ai.core.provider.mistral.MistralProviderConfig"
						name="mistral"
					>
						<api-key name="tl_mistral_api_key"/>
					</provider>
					<provider class="com.top_logic.tl.ai.core.provider.openai.OpenAIProviderConfig"
						name="openai"
					>
						<api-key name="tl_openai_api_key"/>
					</provider>
					<provider class="com.top_logic.tl.ai.core.provider.xai.XAIProviderConfig"
						name="xai"
					>
						<api-key name="tl_xai_api_key"/>
					</provider>
				</providers>
				<model-catalog/>
			</instance>
		</config>
	</services>
</application>