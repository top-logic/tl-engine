<?xml version="1.0" encoding="utf-8" ?>

<!--
	Revision / audit monitor: the recent commits across all users as a single sortable, filterable
	table. Rows are tl.changelog:ChangeSet model objects (also shown by the "My latest changes"
	dialog) produced by the changeLog() TL-Script function; the global, system-wide log is requested
	by passing no object and the range of commit numbers to display. The revision column shows the
	commit number as a number, so that it sorts numerically, written without grouping separators by
	its format annotation; date, author and message are the ChangeSet attributes. Activating a row
	opens a dialog listing what the commit changed. A <full-page> hosts the filter row and the table:
	the enclosing tab already labels the view, so no panel title is rendered and the table fills the
	remaining area.
	
	The filter row selects the displayed commits either by a time range or, with the "Revision range"
	switch on, by a range of commit numbers. In both cases the start is inclusive and the end
	exclusive. The points in time default to today 00:00 and tomorrow 00:00 in the time zone of the
	user: their input channels start empty, and the derived channels the inputs are bound to replace
	an empty value by the default. Clearing an input writes the marker 'cleared' to its input channel,
	so that the default does not come back and the range stays open on that side, as it does for a
	missing commit number. The inputs of the mode that is not selected are hidden, and their values
	are ignored. Changes committed by the system (no person as author) and change sets that do not
	change a model object are only displayed on request.
	
	The table is not updated while the filter is edited: the "Refresh" button writes the current
	filter values together with the current time as a query to queryInput, and the rows are computed
	from the query alone. The time makes every query a new value, so that the button also displays
	the commits made since the last refresh. Before the first refresh, the default query (today, no
	system changes) is displayed.
-->
<view>
	<channels>
		<channel name="revisionRange"/>
		<channel name="fromInput"/>
		<channel name="toInput"/>
		<derived-channel name="from"
			expr="x -> switch { $x == null: now().toUserCalendar().withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(); $x == 'cleared': null; default: $x; }"
			inputs="fromInput"
			reverse="x -> if($x == null, 'cleared', $x)"
		/>
		<derived-channel name="to"
			expr="x -> switch { $x == null: now().toUserCalendar().withDayAdded(1).withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(); $x == 'cleared': null; default: $x; }"
			inputs="toInput"
			reverse="x -> if($x == null, 'cleared', $x)"
		/>
		<channel name="fromRevision"/>
		<channel name="toRevision"/>
		<channel name="showSystemChanges"/>
		<channel name="showTechnical"/>
		<channel name="queryInput"/>
		<derived-channel name="query"
			inputs="queryInput"
		>
			<expr><![CDATA[q -> if($q == null, {
	"byRevision": false,
	"from": now().toUserCalendar().withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(),
	"to": now().toUserCalendar().withDayAdded(1).withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(),
	"showSystemChanges": false,
	"showTechnical": false
}, $q)]]></expr>
		</derived-channel>
	</channels>
	<full-page>
		<inset>
			<stack
				align="center"
				direction="row"
				wrap="true"
			>
				<value-input
					label-position="after-value"
					type="tl.core:Boolean"
					value="revisionRange"
				>
					<label>
						<en>Revision range</en>
						<de>Revisionsbereich</de>
					</label>
					<input-control class="com.top_logic.layout.view.form.BooleanControlProvider"
						display="switch"
					/>
				</value-input>
				<visible-if
					expr="r -> !$r"
					input="revisionRange"
				>
					<stack gap="compact">
						<value-input
							type="tl.core:DateTime"
							value="from"
						>
							<label>
								<en>From (inclusive)</en>
								<de>Von (inklusiv)</de>
							</label>
						</value-input>
						<value-input
							type="tl.core:DateTime"
							value="to"
						>
							<label>
								<en>To (exclusive)</en>
								<de>Bis (exklusiv)</de>
							</label>
						</value-input>
					</stack>
				</visible-if>
				<visible-if
					expr="r -> $r"
					input="revisionRange"
				>
					<stack gap="compact">
						<value-input
							type="tl.core:Long"
							value="fromRevision"
						>
							<label>
								<en>From revision (inclusive)</en>
								<de>Von Revision (inklusiv)</de>
							</label>
							<annotations>
								<format>
									<decimal pattern="0"/>
								</format>
							</annotations>
						</value-input>
						<value-input
							type="tl.core:Long"
							value="toRevision"
						>
							<label>
								<en>To revision (exclusive)</en>
								<de>Bis Revision (exklusiv)</de>
							</label>
							<annotations>
								<format>
									<decimal pattern="0"/>
								</format>
							</annotations>
						</value-input>
					</stack>
				</visible-if>
				<stack gap="compact">
					<value-input
						label-position="after-value"
						type="tl.core:Boolean"
						value="showSystemChanges"
					>
						<label>
							<en>Show system changes</en>
							<de>Systemänderungen anzeigen</de>
						</label>
					</value-input>
					<value-input
						label-position="after-value"
						type="tl.core:Boolean"
						value="showTechnical"
					>
						<label>
							<en>Show system objects</en>
							<de>Systemobjekte anzeigen</de>
						</label>
					</value-input>
				</stack>
				<button>
					<action class="com.top_logic.layout.view.command.GenericViewCommand"
						image="css:bi bi-arrow-clockwise"
					>
						<label>
							<en>Refresh</en>
							<de>Aktualisieren</de>
						</label>
						<execute-script inputs="revisionRange, from, to, fromRevision, toRevision, showSystemChanges, showTechnical">
							<function><![CDATA[byRevision -> from -> to -> fromRevision -> toRevision -> showSystemChanges -> showTechnical -> x -> {
	"byRevision": $byRevision,
	"from": $from,
	"to": $to,
	"fromRevision": $fromRevision,
	"toRevision": $toRevision,
	"showSystemChanges": $showSystemChanges,
	"showTechnical": $showTechnical,
	"time": now()
}]]></function>
						</execute-script>
						<write-channel name="queryInput"/>
					</action>
				</button>
			</stack>
		</inset>
		<table types="tl.changelog:ChangeSet">
			<inputs>
				<input channel="query"/>
			</inputs>
			<columns>
				<computed-column name="revision"
					sort="DESC"
					type="tl.core:Long"
				>
					<label>
						<en>Revision</en>
						<de>Revision</de>
					</label>
					<annotations>
						<format>
							<decimal pattern="0"/>
						</format>
					</annotations>
					<value><![CDATA[cs -> $cs.get(`tl.changelog:ChangeSet#revision`).get(`tl.core:Revision#revision`)]]></value>
				</computed-column>
				<column attribute="date"/>
				<column attribute="author"/>
				<column attribute="message"/>
			</columns>
			<rows><![CDATA[q -> {
	byRevision = $q["byRevision"];
	from = $q["from"];
	to = $q["to"];
	fromRevision = $q["fromRevision"];
	toRevision = $q["toRevision"];
	last = revisionAt(now()).get(`tl.core:Revision#revision`);
	start = if($byRevision,
		if($fromRevision == null, 1, $fromRevision),
		if($from == null, 1, revisionAt(toDate(toMillis($from) - 1)).get(`tl.core:Revision#revision`) + 1));
	stop = if($byRevision,
		if($toRevision == null, $last, $toRevision - 1),
		if($to == null, $last, revisionAt(toDate(toMillis($to) - 1)).get(`tl.core:Revision#revision`)));
	if($start > $stop || $start > $last, list(),
		changeLog(null, 0, true, $start, $stop, null, $q["showTechnical"])
			.filter(cs -> $q["showSystemChanges"] || $cs.get(`tl.changelog:ChangeSet#author`) != null));
}]]></rows>
			<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
				image="css:bi bi-list-ul"
			>
				<label>
					<en>Show changes</en>
					<de>Änderungen anzeigen</de>
				</label>
				<open-dialog
					bind-input-to="changeSet"
					close-on-backdrop="true"
					dialog-view="admin/monitoring/revision-details.view.xml"
				/>
			</on-activate>
		</table>
	</full-page>
</view>