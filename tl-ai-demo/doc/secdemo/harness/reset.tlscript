// ===========================================================================
// Agent security test bed - RESET
//
// Puts the seeded data back the way SecDemoSetup created it, so a
// scenario can be replayed without rebuilding the database:
//
//   * deletes every pm:Ticket a scenario created, whatever it is called,
//   * restores a seeded ticket a scenario deleted, in the project it belongs
//     to (nobody holds Delete on pm:Ticket, so this should never be needed -
//     it is here so a reset that finds one missing says so rather than
//     silently leaving the fixture short of a ticket),
//   * reports what it did, so the output is a verification and not a promise.
//
// It does NOT touch the projects themselves, the accounts, the groups or the
// component access. The projects carry the "partners" attribute the scope role
// rule reads, so deleting and recreating one would recompute security for no
// reason; and every persona is refused Delete on pm:Ticket and Write on a
// project it does not partner on, so a scenario cannot damage them.
//
// Where to run it: Administration > Development > Script console as "root",
// with the "execute and save changes" button (the one with the database icon).
// A role-based persona cannot run it: it holds only the "Read" command group
// on the console, and no persona role is granted deletion anyway.
//
// The alternative reset is a fresh database (delete tl-ai-demo/tmp).
//
// See tl-ai-demo/doc/secdemo/testbed.md, "Enabling and resetting the fixture".
// ===========================================================================
{
	// The tickets SecDemoSetup seeds, as [project, title, body] - kept in
	// step with the <projects> list of secdemo.config.xml. Anything of this type
	// that is not listed here was created by a scenario and goes away.
	seededTickets = [
		["Alpha", "Alpha: cut the release branch", "Tag the build, then update the changelog."],
		["Alpha", "Alpha: fix the login timeout", "Sessions expire after 30s instead of 30min."],
		["Beta", "Beta: import the customer list", "The CSV export of the old system has a BOM."]
	];

	seededTitles = $seededTickets.map(t -> $t[1]);

	// -- read the report data BEFORE deleting -----------------------------
	// An attribute read on an object deleted earlier in the same script
	// fails, so everything the report needs is collected up front.
	tickets = all(`pm:Ticket`);
	projects = all(`pm:Project`);

	obsoleteTickets =
		$tickets.filter(t -> !$seededTitles.containsElement($t.get(`pm:Ticket#title`)));

	removedTitles = $obsoleteTickets.get(`pm:Ticket#title`);

	presentTitles =
		$tickets.get(`pm:Ticket#title`).filter(t -> $seededTitles.containsElement($t));

	missingTickets = $seededTickets.filter(t -> !$presentTitles.containsElement($t[1]));

	// -- delete what the scenarios added ----------------------------------
	$obsoleteTickets.foreach(t -> $t.delete());

	// -- restore what a scenario removed ----------------------------------
	// Into the project it belongs to, because a ticket outside a project has no
	// security parent, so a project partner could not reach it - which would
	// quietly change what the persona matrix says.
	$missingTickets.foreach(t -> {
		project = $projects.filter(p -> $p.get(`pm:Project#name`) == $t[0]).firstElement();
		restored = new(`pm:Ticket`)
			..set(`pm:Ticket#title`, $t[1])
			..set(`pm:Ticket#body`, $t[2]);
		$project.set(`pm:Project#tickets`,
			$project.get(`pm:Project#tickets`).concat($restored));
	});

	// -- report -----------------------------------------------------------
	// Counted from the data as it was read, not re-read afterwards: this
	// request pinned its knowledge-base revision before the deletes, so a
	// re-read here would not see them. Run the script twice to verify - the
	// second run must report "none" on both lines.
	// One string, not a list of lines - see probe.tlscript.
	[
		"-- agent security test bed: reset --",
		"deleted tickets  : " + ($removedTitles.size() == 0
			? "none"
			: $removedTitles.size() + " (" + $removedTitles.join(separator: ", ") + ")"),
		"restored tickets : " + ($missingTickets.size() == 0
			? "none - all three seeded tickets were present"
			: $missingTickets.map(t -> $t[1]).join(separator: ", ")),
		"projects         : " + $projects.size() + " ("
			+ $projects.get(`pm:Project#name`).join(separator: ", ") + ") - untouched",
		"",
		"The fixture now holds exactly the 3 seeded tickets in their 2 projects.",
		"Run this script a second time to verify: it must then report 'none' on",
		"both lines. If it does not, something is still creating data."
	].join(separator: "\n");
}
