<?xml version="1.0" encoding="utf-8" ?>

<!--
	Second frame of the project drill-down: the home of the project the frame was opened for. Its
	tabs show a cockpit of the project and its milestones, the latter embedded as a view of its own
	so that a display target can reveal that tab within this frame.
	
	The cockpit is a dashboard of three tiles. The Project tile displays the project and nothing
	else. The Milestones and Notes tiles are entry points: pressing one pushes the frame listing
	that collection, announced by a label of its own. The Notes tile is refused while the project
	has no notes and gives that as its reason. The New Milestone button inside the Milestones tile
	answers a press itself, so it opens the create dialog instead of pushing the milestone list.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="milestone"/>
		<derived-channel name="milestoneCount"
			expr="p -> if($p == null, 0, $p.get(`tl.demo.projectManagement:ProjectScope#milestones`).size())"
			inputs="project"
		/>
		<derived-channel name="noteCount"
			expr="p -> if($p == null, 0, $p.get(`tl.demo.projectManagement:ProjectScope#notes`).size())"
			inputs="project"
		/>
	</channels>

	<tab-bar active-tab="overview">
		<tabs>
			<tab id="overview"
				icon="css:bi bi-info-circle"
			>
				<label>
					<en>Overview</en>
					<de>Überblick</de>
				</label>
				<panel>
					<title>
						<en>Cockpit</en>
						<de>Cockpit</de>
					</title>
					<dashboard id="project-cockpit">
						<tile id="project"
							width="half"
						>
							<panel>
								<title>
									<en>Project</en>
									<de>Projekt</de>
								</title>
								<form input="project">
									<field attribute="name"/>
									<field attribute="description"/>
								</form>
							</panel>
						</tile>
						<tile id="milestones"
							width="quarter"
						>
							<card>
								<title>
									<en>Milestones</en>
									<de>Meilensteine</de>
								</title>
								<text input="milestoneCount"/>
								<button>
									<action class="com.top_logic.layout.view.command.GenericViewCommand"
										image="css:bi bi-plus-lg"
										input="project"
									>
										<label>
											<en>New Milestone</en>
											<de>Neuer Meilenstein</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<execute-script function="x -> new(`tl.demo.projectManagement:Milestone`, transient: true)"/>
										<open-dialog
											bind-input-to="model"
											dialog-view="demo/create-milestone.view.xml"
										>
											<bind
												channel="container"
												to="project"
											/>
											<bind
												channel="selection"
												to="milestone"
											/>
										</open-dialog>
									</action>
								</button>
							</card>
							<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
								bind-input-to="project"
								input="project"
								view="projects/milestone-list.view.xml"
							>
								<executability>
									<null-input-disabled/>
								</executability>
								<frame-label class="com.top_logic.layout.view.tiles.StaticTileLabel">
									<value>
										<en>Milestones</en>
										<de>Meilensteine</de>
									</value>
								</frame-label>
							</action>
						</tile>
						<tile id="notes"
							width="quarter"
						>
							<card>
								<title>
									<en>Notes</en>
									<de>Notizen</de>
								</title>
								<text input="noteCount"/>
							</card>
							<action class="com.top_logic.layout.view.tiles.NavigatePushCommand"
								bind-input-to="project"
								input="project"
								view="projects/notes.view.xml"
							>
								<executability>
									<disabled-if expr="p -> if($p == null || $p.get(`tl.demo.projectManagement:ProjectScope#notes`).isEmpty(), #('The project has no notes.'@en, 'Das Projekt hat keine Notizen.'@de))"/>
								</executability>
								<frame-label class="com.top_logic.layout.view.tiles.StaticTileLabel">
									<value>
										<en>Notes</en>
										<de>Notizen</de>
									</value>
								</frame-label>
							</action>
						</tile>
					</dashboard>
				</panel>
			</tab>
			<tab id="milestones"
				icon="css:bi bi-flag"
			>
				<label>
					<en>Milestones</en>
					<de>Meilensteine</de>
				</label>
				<view-ref view="projects/milestone-list.view.xml">
					<bind
						channel="project"
						to="project"
					/>
					<bind
						channel="milestone"
						to="milestone"
					/>
				</view-ref>
			</tab>
		</tabs>
	</tab-bar>
</view>