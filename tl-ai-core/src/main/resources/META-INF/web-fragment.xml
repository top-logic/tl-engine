<?xml version="1.0" encoding="UTF-8"?>
<web-fragment xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-fragment_3_1.xsd"
	version="3.1">
	<name>tl-ai-core</name>

	<servlet>
		<servlet-name>GeneratedHtmlPageServlet</servlet-name>
		<servlet-class>com.top_logic.tl.ai.core.htmlpages.GeneratedHtmlPageServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>GeneratedHtmlPageServlet</servlet-name>
		<url-pattern>/html/*</url-pattern>
	</servlet-mapping>

	<!--
		The mapping above shadows the static PDF.js viewer resources that
		ext-org-mozilla-pdfjs deploys below /html/pdfjs/, because a servlet mapping wins
		over the container's handling of static web resources. The more specific prefix
		below takes precedence over /html/* and hands that sub-tree back to a plain
		resource delivery. See PdfJsResourceServlet.
	-->
	<servlet>
		<servlet-name>PdfJsResourceServlet</servlet-name>
		<servlet-class>com.top_logic.tl.ai.core.htmlpages.PdfJsResourceServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>PdfJsResourceServlet</servlet-name>
		<url-pattern>/html/pdfjs/*</url-pattern>
	</servlet-mapping>

	<!--
		Serves a captured screenshot to the account that captured it (issue #216). Unlike
		/html/*, this route requires a login: see ScreenshotServlet.
	-->
	<servlet>
		<servlet-name>ScreenshotServlet</servlet-name>
		<servlet-class>com.top_logic.tl.ai.core.screenshots.ScreenshotServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>ScreenshotServlet</servlet-name>
		<url-pattern>/screenshot/*</url-pattern>
	</servlet-mapping>
</web-fragment>
