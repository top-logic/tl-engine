<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.security.selfservice">
		<annotations>
			<package-binding
				implementation-package="com.top_logic.security.selfservice.model.impl"
				interface-package="com.top_logic.security.selfservice.model"
			/>
		</annotations>
		<enum name="InvitationState">
			<classifier name="OPEN"/>
			<classifier name="EXPIRED"/>
			<classifier name="ACCEPTED"/>
		</enum>
		<enum name="RegistrationState">
			<classifier name="PENDING"/>
			<classifier name="APPROVED"/>
		</enum>
		<class name="Invitation">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<table name="Invitation"/>
				<id-column value="email"/>
			</annotations>
			<attributes>
				<property name="id"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
						<default-value>
							<provider class="com.top_logic.model.provider.SecureStringDefaultProvider"
								size="32"
							/>
						</default-value>
					</annotations>
				</property>
				<property name="email"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint-by-expression>
								<check><![CDATA[email -> {
  lowerCaseMail = $email.toLowerCase();
  existingAccount = all(`tl.accounts:Person`)
    .filter(account -> $account.get(`tl.accounts:Person#name`).toLowerCase() == $lowerCaseMail)
    .firstElement();
  $existingAccount != null ?
  #("Es gibt bereits einen Zugang für die E-Mail-Adresse {0}."@de, "There is already an account for the email address {0}."@en).fill($existingAccount.get(`tl.accounts:Person#name`)) :
  null;
}]]></check>
							</constraint-by-expression>
							<constraint-by-expression>
								<check><![CDATA[email -> invitationEmailRefusal($email)]]></check>
							</constraint-by-expression>
							<constraint-by-expression>
								<check><![CDATA[email -> self -> {
  lowerCaseMail = $email.toLowerCase();
  existingInvitation = all(`tl.security.selfservice:Invitation`)
    .filter(invitation -> $invitation != $self)
    .filter(invitation -> $invitation.get(`tl.security.selfservice:Invitation#state`) == `tl.security.selfservice:InvitationState#OPEN`)
    .filter(invitation -> $invitation.get(`tl.security.selfservice:Invitation#email`).toLowerCase() == $lowerCaseMail)
    .firstElement();
  $existingInvitation != null ? 
  #("Es gibt bereits eine Einladung für die E-Mail-Adresse {0}."@de, "There is already an invitation for the email address {0}."@en).fill($existingInvitation.get(`tl.security.selfservice:Invitation#email`)) :
  null;
}]]></check>
							</constraint-by-expression>
						</constraints>
					</annotations>
				</property>
				<property name="mfaRequirement"
					type="tl.accounts:MfaRequirement"
				/>
				<property name="createCallback"
					type="tl.model.search:Expr"
				>
					<annotations>
						<storage-algorithm>
							<query expr="invitation -> person -> null"/>
						</storage-algorithm>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<property name="createdAt"
					type="tl.core:DateTime"
				>
					<annotations>
						<search-range value="false"/>
						<delete-protected/>
						<storage-algorithm>
							<derived-storage>
								<expression-evaluation>
									<method-call method="com.top_logic.security.selfservice.model.impl.InvitationImpl#calculateCreatedAt()"/>
								</expression-evaluation>
							</derived-storage>
						</storage-algorithm>
					</annotations>
				</property>
				<reference name="createdBy"
					kind="forwards"
					navigate="true"
					type="tl.accounts:Person"
				>
					<annotations>
						<search-range value="false"/>
						<delete-protected/>
						<storage-algorithm>
							<derived-storage>
								<expression-evaluation>
									<method-call method="com.top_logic.security.selfservice.model.impl.InvitationImpl#calculateCreatedBy()"/>
								</expression-evaluation>
							</derived-storage>
						</storage-algorithm>
					</annotations>
				</reference>
				<property name="expires"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
						<default-value>
							<provider class="com.top_logic.security.selfservice.invitation.InvitationExpiryDefault"/>
						</default-value>
					</annotations>
				</property>
				<property name="accepted"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<reference name="account"
					kind="forwards"
					navigate="true"
					type="tl.accounts:Person"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</reference>
				<reference name="state"
					kind="forwards"
					type="InvitationState"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[invitation ->
  $invitation.get(`tl.security.selfservice:Invitation#accepted`) != null ? `tl.security.selfservice:InvitationState#ACCEPTED` : (
    $invitation.get(`tl.security.selfservice:Invitation#expires`) != null && $invitation.get(`tl.security.selfservice:Invitation#expires`) <= now() ?
      `tl.security.selfservice:InvitationState#EXPIRED` :
      `tl.security.selfservice:InvitationState#OPEN`
  )]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
			</attributes>
		</class>
		<class name="Registration">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<table name="Registration"/>
				<id-column value="email"/>
			</annotations>
			<attributes>
				<property name="email"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<reference name="account"
					deletion-policy="delete-referer"
					kind="forwards"
					navigate="true"
					type="tl.accounts:Person"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</reference>
				<property name="createdAt"
					type="tl.core:DateTime"
				>
					<annotations>
						<search-range value="false"/>
						<delete-protected/>
						<storage-algorithm>
							<query>
								<expr><![CDATA[registration -> $registration.createRevision().get(`tl.core:Revision#date`)]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</property>
				<property name="approved"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<reference name="approvedBy"
					kind="forwards"
					navigate="true"
					type="tl.accounts:Person"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</reference>
				<reference name="state"
					kind="forwards"
					type="RegistrationState"
				>
					<annotations>
						<storage-algorithm>
							<query>
								<expr><![CDATA[registration ->
  $registration.get(`tl.security.selfservice:Registration#approved`) != null ?
    `tl.security.selfservice:RegistrationState#APPROVED` :
    `tl.security.selfservice:RegistrationState#PENDING`]]></expr>
							</query>
						</storage-algorithm>
					</annotations>
				</reference>
			</attributes>
		</class>
	</module>
</model>