<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.tl.ai.core.mcp.McpServerRegistry"
    config:override="true">
    <instance class="com.top_logic.tl.ai.core.mcp.McpServerRegistry">
        <servers>
            <server name="everything">
                <transport class="com.top_logic.tl.ai.core.mcp.StdioMcpTransport"
                    command="npx"
                    args="-y,@modelcontextprotocol/server-everything"
                />
            </server>
        </servers>
    </instance>
</config>
	</services>
</application>