<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog creating a tenant: the form edits the transient input in "model", the name of the tenant
	and the account of its first administrator. Creating makes the tenant, the account and the
	membership in one transaction (factoryCreateTenant) and writes the new tenant to "selection".
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selection"/>
	</channels>
	<window width="500px">
		<title>
			<en>Create tenant</en>
			<de>Mandant anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="tenantName"/>
			<field attribute="login"/>
			<field attribute="firstName"/>
			<field attribute="lastName"/>
			<field attribute="email"/>
			<field attribute="password"/>
			<commands>
				<generic-command key="ENTER"
					inputs="model"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<execute-script function="factoryCreateTenant($model.get(`tl.factory.input:NewTenant#tenantName`), $model.get(`tl.factory.input:Account#login`), $model.get(`tl.factory.input:Account#firstName`), $model.get(`tl.factory.input:Account#lastName`), $model.get(`tl.factory.input:Account#email`), $model.get(`tl.factory.input:Account#password`))">
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</execute-script>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>