<?xml version="1.0" encoding="utf-8" ?>

<application config:interface="com.top_logic.basic.config.ApplicationConfig$Config"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<module key="com.top_logic.element.accesstoken.AccessTokenPermissions$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>
		<!--
			The permissions an access token can grant. Modules that offer an endpoint for access tokens
			contribute theirs here.
		-->
		<config service-class="com.top_logic.element.accesstoken.AccessTokenPermissions">
			<instance class="com.top_logic.element.accesstoken.AccessTokenPermissions"/>
		</config>
		<!--
			Who may read an access token: its owner, plus administrators. Model access is
			deny-by-default, so without this an account that is no administrator could not even list
			its own tokens.

			The technical role "AccessTokenOwner", held by nobody globally, is derived per token from
			its "owner" by a role rule, and the security configuration grants Read to that role.
			Administrators bypass the check. Revoking goes through accessTokenRevoke, which checks
			owner or administrator itself, so no Delete grant is written here.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="AccessTokenOwner"/>
				</roles>
			</instance>
		</config>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.accounts.messages"/>
				</bundles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.accounts.model.xml"/>
				</declarations>
			</instance>
		</config>
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance class="com.top_logic.model.security.SecurityConfigurationService">
				<security-config>
					<part name="tl.accounts:Person#admin">
						<!-- Deny writing for all. -->
						<grant operation="Write"/>
					</part>
					<!-- See the role AccessTokenOwner above. -->
					<class name="tl.accounts:AccessToken">
						<grant
							inherit="true"
							operation="Read"
							roles="AccessTokenOwner"
						/>
					</class>
				</security-config>
			</instance>
		</config>
		<!--
			Groups and addresses inherit the roles held on the security root, so that the grants on
			the module tl.accounts take effect for them. An account gets its roles through its contact
			(see com.top_logic.contact).
		-->
		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<!-- See the role AccessTokenOwner above. -->
						<rule id="tl.accounts.accessToken.owner"
							inherit="true"
							meta-element="tl.accounts:AccessToken"
							role="AccessTokenOwner"
							type="reference"
						>
							<path>
								<step attribute="tl.accounts:AccessToken#owner"/>
							</path>
						</rule>
					</rules>
				</role-rules>
				<security-parents>
					<rule
						id="SecRootForGroup"
						inherit="true"
						meta-element="tl.accounts:Group"
					>
						<singleton module="SecurityStructure"/>
					</rule>
					<rule
						id="SecRootForAddress"
						inherit="true"
						meta-element="tl.accounts:Address"
					>
						<singleton module="SecurityStructure"/>
					</rule>
				</security-parents>
			</instance>
		</config>
		<config service-class="com.top_logic.tool.execution.service.CommandApprovalService">
			<instance class="com.top_logic.tool.execution.service.ConfiguredCommandApprovalService">
				<check type="tl.accounts:Person">
					<!-- The anonymous account must neither be modified nor deleted in any view. -->
					<rule>
						<contexts>
							<command-with-group command-group="Write"/>
							<command-with-group command-group="Delete"/>
						</contexts>
						<executability>
							<anonymous-account-disabled/>
						</executability>
					</rule>
				</check>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/PersonMeta_inc.xml"/>
						<declaration resource="webinf://kbase/BoundSecMeta_inc.xml"/>
						<declaration resource="webinf://kbase/AccessTokenMeta_inc.xml"/>
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>