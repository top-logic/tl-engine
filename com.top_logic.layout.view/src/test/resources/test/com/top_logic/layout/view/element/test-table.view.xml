<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="testInput"/>
		<channel name="selectedRow"/>
		<channel name="dropTarget"/>
		<channel name="activeFilter"/>
		<channel name="searchTerm"/>
	</channels>

	<table
		activation-button="false"
		active-preset="activeFilter"
		filter-bar="true"
		group-by="owner"
		personalization-key="test-table"
		search-term="searchTerm"
		selection="selectedRow"
		selection-mode="multi"
		types="demo.test:Row"
	>
		<drag kind="row"/>
		<drop>
			<execute-script function="$objects"/>
		</drop>
		<drop
			accept="row, other"
			target="row"
			target-channel="dropTarget"
		>
			<execute-script function="$objects"/>
		</drop>
		<inputs>
			<input channel="testInput"/>
		</inputs>
		<presets initial="all-active">
			<preset
				count="true"
				css-class="tl-preset--mine"
				name="mine"
			>
				<label>
					<en>My rows</en>
					<de>Meine Zeilen</de>
				</label>
				<criterion
					column="owner"
					expr="currentUser()"
				/>
				<criterion
					column="active"
					expr="true"
				/>
			</preset>
			<preset name="all-active">
				<criterion
					column="active"
					expr="true"
				/>
			</preset>
			<preset name="typed">
				<criterion column="name">
					<text
						case-sensitive="true"
						pattern="'Alice'"
						whole-field="true"
					/>
				</criterion>
				<criterion
					column="active"
					inverted="true"
				>
					<boolean accept="true"/>
				</criterion>
			</preset>
		</presets>
		<columns>
			<column
				attribute="name"
				sort="ASC"
				width="220"
			>
				<label>
					<en>Row name</en>
					<de>Zeilenname</de>
				</label>
				<comparator>compare($left.toLowerCase(), $right.toLowerCase())</comparator>
			</column>
			<column attribute="active"/>
			<column
				attribute="owner"
				compact="false"
				readonly="true"
			/>
			<computed-column name="total"
				type="tl.core:Double"
			>
				<inputs>
					<input
						as="factor"
						channel="testInput"
					/>
				</inputs>
				<value>$factor * $row.get(`demo.test:Row#amount`)</value>
				<update>$row.set(`demo.test:Row#amount`, $value / $factor)</update>
				<can-update>$row.get(`demo.test:Row#amount`) != null</can-update>
				<aggregate>$members.size()</aggregate>
				<comparator>$right - $left</comparator>
			</computed-column>
			<embedded-columns reference="owner.contact">
				<column attribute="name"/>
				<computed-column name="mail"
					type="tl.core:String"
				>
					<value>$row.get(`demo.test:Contact#email`).toLowerCase()</value>
				</computed-column>
			</embedded-columns>
			<embedded-columns name="accounts"
				multiple="true"
				type="demo.test:Account"
			>
				<label>
					<en>Account</en>
					<de>Konto</de>
				</label>
				<object>$row.get(`demo.test:Row#accounts`)</object>
				<column attribute="number"/>
			</embedded-columns>
			<dynamic-columns name="milestones"
				column-as="col"
				readonly="true"
				type="tl.core:Double"
				width="90"
			>
				<aggregate>$members.size()</aggregate>
				<can-update>$row.get(`demo.test:Row#amount`) != null</can-update>
				<column-label>$col.get(`demo.test:Milestone#name`)</column-label>
				<column-name>$col.get(`demo.test:Milestone#name`)</column-name>
				<column-visible>$col.get(`demo.test:Milestone#name`) != "hidden"</column-visible>
				<comparator>$right - $left</comparator>
				<columns>all(`demo.test:Milestone`)</columns>
				<inputs>
					<input
						as="factor"
						channel="testInput"
					/>
				</inputs>
				<update>$row.set(`demo.test:Row#amount`, $value)</update>
				<value>$factor * $row.get(`demo.test:Row#amount`)</value>
			</dynamic-columns>
		</columns>
		<rows>list($testInput)</rows>
	</table>
</view>