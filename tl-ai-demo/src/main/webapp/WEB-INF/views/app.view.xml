<?xml version="1.0" encoding="utf-8" ?>

<!--
	Root view of the tl-ai demo, served under /view/ and resolved through ViewConfig#getDefaultView.

	The shell holds the agent chat, which is what the demo is about and therefore the start item,
	the event-management domain the agent works on (events, venues, invoices of the demo.events
	model), the user's settings and the framework's administration.

	Everything here is built from the standard view elements, the chat included, so the demo shows
	what an application gets for free rather than what this module wrote itself.
-->
<view>
	<channels>
		<!-- Feeds the app bar; read-only, recomputed per session. -->
		<derived-channel name="currentPerson"
			expr="currentUser()"
		/>

		<!--
			The dock's wiring, declared here because the dock lives in the shell's footer.

			Its conversation is "chat" - the SAME one the Chat page shows. The dock is a second
			PLACE for that conversation, not a second conversation, and it hides itself (launcher
			included) while the Chat page has it on screen: two views of one conversation would give
			its draft channel two composers and its remembered layout two rails. A dock on a chat
			id of its own would be a second conversation and would work - since #502 every /chat/*
			call names its conversation beside its window, and the server holds an active session,
			a run and a stream for each.

			The channels are the dock's own, because the page declares its own in
			tl-ai-demo/chat-grouped.view.xml and the two are never on screen together.
		-->
		<channel name="dockSession"/>
		<channel name="dockPaneObject"/>
		<!--
			What the page BEHIND the dock has selected (Issue #494). Declared in the shell, because
			the dock floats over every page and the pages are <view-ref>s with channel namespaces of
			their own: each page hands its own selection channel over with one <bind> below, and the
			dock states whatever stands here as the turn's "Selected object".

			Nothing writes it but the page that is on screen, and a page that binds nothing simply
			leaves it holding what it held - which is why a page that has a selection to state binds
			it, and the Chat page, where the dock stands down entirely, does not.
		-->
		<channel name="pageSelection"/>
		<channel name="dockProgressBadge"/>
		<channel name="dockSourcesBadge"/>
		<!--
			The chat composer's unsent text, declared at the top so that two *different* pages can
			reach it (Issue #440). Every <view-ref> gets its own channel namespace, so a page sees a
			channel of the enclosing view only where a <bind> hands it over - which is what the two
			nav items below do. See "Writing a channel across a view boundary" in tl-chat/CLAUDE.md.
		-->
		<channel name="chatDraft"/>
	</channels>

	<app-shell>
		<header>
			<app-bar variant="flat">
				<title>
					<en>Albert</en>
					<de>Albert</de>
				</title>
				<children>
					<text
						css-class="tlAppBarUser"
						input="currentPerson"
						overflow="ellipsis"
					/>
				</children>
				<commands>
					<!--
						Two commands, one visible button: a ViewCommand's theme id is static
						configuration, not a runtime read of the current theme, so each theme needs
						its own command. The demo's stylesheet (style/tl-ai-demo-shell.css) hides
						whichever of the two would set the theme already in force - keyed on the
						icons below - so what the user sees is a single toggle onto the other theme.
						SetThemeCommand persists the pick as the user's PersonalConfiguration and
						flips the client's data-theme attribute without a reload; the chat's
						stylesheet is written entirely in the design tokens those themes define, so
						it follows along.
					-->
					<set-theme theme="default"
						image="css:bi bi-sun"
						placement="TOOLBAR"
					>
						<label>
							<en>Light theme</en>
							<de>Helles Design</de>
						</label>
					</set-theme>
					<set-theme theme="dark"
						image="css:bi bi-moon-stars"
						placement="TOOLBAR"
					>
						<label>
							<en>Dark theme</en>
							<de>Dunkles Design</de>
						</label>
					</set-theme>
					<open-designer
						image="css:bi bi-pencil-square"
						placement="TOOLBAR"
					>
						<label>
							<en>Layout designer</en>
							<de>Layout-Designer</de>
						</label>
					</open-designer>
					<generic-command
						image="css:bi bi-box-arrow-in-right"
						placement="TOOLBAR"
					>
						<label>
							<en>Login</en>
							<de>Anmeldung</de>
						</label>
						<executability>
							<anonymous-only/>
						</executability>
						<execute-script function="x -> new(`tl.login:Credentials`, transient: true)"/>
						<open-dialog
							bind-input-to="model"
							close-on-backdrop="false"
							dialog-view="login.view.xml"
						/>
					</generic-command>
					<logout-command
						image="css:bi bi-box-arrow-right"
						placement="TOOLBAR"
					>
						<label>
							<en>Logout</en>
							<de>Abmeldung</de>
						</label>
						<executability>
							<authenticated-only/>
						</executability>
					</logout-command>
				</commands>
			</app-bar>
		</header>
		<content>
			<sidebar active-item="chat">
				<!--
					The chat first and active on entry: this application exists to demonstrate the
					agent, and the events are the data it works on rather than the point.

					It is built from view elements; the one-element form that used to exist is gone -
					a <data-list> of this user's chats, a <chat-conversation>, and a <chat-rail>
					whose sections are configured (Issue #415). See
					tl-ai-demo/chat-grouped.view.xml.
				-->
				<nav-item id="chat"
					icon="css:bi bi-chat-dots"
				>
					<label>
						<en>Chat</en>
						<de>Chat</de>
					</label>
					<!--
						The chat page declares a "chatDraft" of its own, so it also works standalone;
						this binding hands it *this* view's channel instead, which is the one the
						Events and Invoices pages below write.
					-->
					<view-ref view="tl-ai-demo/chat-grouped.view.xml">
						<bind channel="chatDraft"
							to="chatDraft"
						/>
					</view-ref>
				</nav-item>

				<!--
					The event-management domain, one page per kind of thing the user looks for.
					Each page's own selection channel IS the shell's "pageSelection", so the dock's
					conversation states what the page behind it has selected without knowing the
					page exists (Issue #494); the Events and Invoices pages also write the chat's
					draft with their "Ask about this" command (Issue #440).
				-->
				<nav-item id="events"
					icon="css:bi bi-calendar-event"
				>
					<label>
						<en>Events</en>
						<de>Veranstaltungen</de>
					</label>
					<view-ref view="tl-ai-demo/events/events.view.xml">
						<bind channel="chatDraft"
							to="chatDraft"
						/>
						<bind channel="selectedEvent"
							to="pageSelection"
						/>
					</view-ref>
				</nav-item>

				<nav-item id="venues"
					icon="css:bi bi-geo-alt"
				>
					<label>
						<en>Venues</en>
						<de>Veranstaltungsorte</de>
					</label>
					<view-ref view="tl-ai-demo/venues/venues.view.xml">
						<bind channel="selectedVenue"
							to="pageSelection"
						/>
					</view-ref>
				</nav-item>

				<nav-item id="invoices"
					icon="css:bi bi-receipt"
				>
					<label>
						<en>Invoices</en>
						<de>Rechnungen</de>
					</label>
					<view-ref view="tl-ai-demo/invoices/invoices.view.xml">
						<bind channel="chatDraft"
							to="chatDraft"
						/>
						<bind channel="selectedInvoice"
							to="pageSelection"
						/>
					</view-ref>
				</nav-item>

				<!--
					What this account tells every agent about itself (Issue #437): one free-text
					field on tl.accounts:Person, which the harness renders into the environment block
					of every run this user triggers.
				-->
				<nav-item id="profile"
					icon="css:bi bi-person-gear"
				>
					<label>
						<en>My settings</en>
						<de>Meine Einstellungen</de>
					</label>
					<view-ref view="tl-ai-demo/profile.view.xml"/>
				</nav-item>

				<!--
					Administration is the framework's own view (WEB-INF/views/admin/admin.view.xml),
					extended by depending modules through overlay merge. The scope is declared by
					tl-layout-view, so with no roles assigned the entry is visible to root only.
				-->
				<nav-item id="administration"
					icon="css:bi bi-sliders"
				>
					<label>
						<en>Administration</en>
						<de>Administration</de>
					</label>
					<access-control scope="administration"/>
					<view-ref view="admin/admin.view.xml"/>
				</nav-item>
			</sidebar>
		</content>
		<!--
			The chat as a dock: a launcher in the corner of every page, and a panel over the page
			when it is opened (Issue #415).

			The <footer> is a mounting point and nothing more - the dock is fixed-position, so it
			takes no room in the shell's layout and every page keeps its full height.

			Two things about this are worth reading twice.

			The dock CONTAINS the <chat>, so - unlike every other chat element - it cannot inherit
			the id: a chat scope reaches descendants only. The id is therefore written twice, here
			and on the <chat> inside, and the two must agree. ChatJoinLog warns about an element that
			joined nobody, which is the shape a typo here produces.

			And the id is "chat", the Chat page's own: this is the SAME conversation, reachable from
			every other page without leaving it. On the Chat page itself there
			is nothing for the dock to open, so it hides - and showing it there would put two
			composers on one draft channel and two rails on one remembered layout.
		-->
		<footer>
			<chat-dock chat-id="chat"
				icon="css:bi bi-stars"
			>
				<label>
					<en>Albert</en>
					<de>Albert</de>
				</label>
				<!--
					One element inside the dock, and it is the <chat> itself: the engine's fill rule
					on a stack holding a fill panel looks one level deep, so the stack has to be the
					panel's direct child or the conversation grows with its transcript instead of
					scrolling inside the panel.
				-->
				<chat chat-id="chat"
					direction="row"
				>
					<!--
						Collapsed on arrival, like the rail: opening the dock should show the
						conversation, not three columns of chrome. Both are first-load states, so
						the strip and the collapse arrow are how the user brings the other two back.
					-->
					<data-list
						collapsed="true"
						collapsible="true"
						observed-types="tl.ai.execution:AgentSession"
						search="true"
						selection="dockSession"
					>
						<commands>
							<generic-command image="css:bi bi-plus-lg">
								<label>
									<en>New chat</en>
									<de>Neuer Chat</de>
								</label>
								<write-channel name="dockSession"/>
							</generic-command>
						</commands>
						<empty-text>
							<en>No chats yet</en>
							<de>Noch keine Chats</de>
						</empty-text>
						<lines>
							<line attribute="title"/>
						</lines>
						<rows><![CDATA[all(`tl.ai.execution:AgentSession`)
							.filter(s -> $s.get(`tl.ai.execution:AgentSession#owner`) == currentUser())
							.filter(s -> $s.get(`tl.ai.execution:AgentSession#kind`) == `tl.ai.execution:SessionKind#CHAT`)
							.sort((s -> $s.get(`tl.ai.execution:AgentSession#lastUpdated`)).comparator().desc())]]></rows>
						<title>
							<en>Chats</en>
							<de>Chats</de>
						</title>
					</data-list>
					<panel fill="true">
						<!--
							"draft" is the shell's own channel, named with no <bind> at all - this
							element sits in app.view.xml, and <app-shell> does not isolate channels.
							That is the dock half of issue #440: "Dazu fragen" on the page
							behind it writes the draft, and the question is standing here when the
							user opens the dock. The Chat page's conversation follows the same
							channel, and the two are never mounted at once (a dock steps aside for a
							page showing its conversation), so the draft simply follows the user
							from the one place to the other.
						-->
						<chat-conversation
							citations="true"
							draft="chatDraft"
							input="dockSession"
							prompt-improver-agent="TL_PromptImprover"
							trace="summary"
						>
							<!--
								What the dock states about the situation (Issue #494). It is the SAME
								conversation the Chat page shows, so "Application" is stated here too
								and with the same words: a stable fact goes into the environment block
								of the system prompt, and a block that gained or lost a line between
								two turns of one chat would miss the provider's prompt cache on every
								turn after it.

								"Open event" is this dock's own rail pane, the way it is the page's
								rail pane over there.
							-->
							<context>
								<inputs>
									<input channel="dockPaneObject"/>
								</inputs>
								<fact name="Application"
									stable="true"
								>
									<value><![CDATA[open -> "Event management demo (tl-ai-demo)"]]></value>
								</fact>
								<fact name="Open event"
									stable="false"
								>
									<value><![CDATA[open -> ifElse(isEmpty($open) || !$open.instanceOf(`demo.events:Event`), "none",
										$open.get(`demo.events:Named#name`)
											+ ": " + $open.get(`demo.events:Event#registrationCount`) + " active registrations, balance "
											+ $open.get(`demo.events:Event#balance`))]]></value>
								</fact>
							</context>
							<!--
								And what the user is actually looking at: the selection of the page the
								dock is floating over, handed to the shell by that page's <view-ref>.
								One line, and the agent is told the label, the type and the identifier
								it needs to act on the object.

								Named "Selected object", because the shell has no channel saying which
								nav item is active: this states what the Events, Venues or Invoices
								page last selected, and keeps saying so while the user reads their
								settings.
							-->
							<selection name="Selected object"
								channel="pageSelection"
							/>
						</chat-conversation>
					</panel>
					<!--
						The rail, with its pane - which is what "the pane is visible as well if
						wanted" means here: picking an event in the "Veranstaltungen" section replaces
						the section column with its form, inside the dock's panel, exactly as it does
						on the page. The pane is the rail's own and renders any type (#616).
					-->
					<chat-rail input="dockPaneObject"
						open="false"
						strip="true"
					>
						<section name="progress"
							badge="dockProgressBadge"
							icon="css:bi bi-list-check"
							open="true"
						>
							<label>
								<en>Progress</en>
								<de>Fortschritt</de>
							</label>
							<data-list
								collapsible="false"
								count="dockProgressBadge"
								observed-types="tl.ai.execution:AgentTask"
								search="false"
							>
								<row-css-class><![CDATA[t -> switch {
									$t.get(`tl.ai.execution:AgentTask#status`) == "completed": "is-done";
									$t.get(`tl.ai.execution:AgentTask#status`) == "in_progress": "is-running";
									default: "is-pending";
								}]]></row-css-class>
								<empty-text>
									<en>Nothing planned yet</en>
									<de>Noch nichts geplant</de>
								</empty-text>
								<inputs>
									<input channel="dockSession"/>
								</inputs>
								<lines>
									<line attribute="subject"/>
									<line emphasis="secondary">
										<value><![CDATA[t -> switch {
											$t.get(`tl.ai.execution:AgentTask#status`) == "completed": #("Done"@en, "Erledigt"@de);
											$t.get(`tl.ai.execution:AgentTask#status`) == "in_progress": #("In progress"@en, "Läuft"@de);
											default: #("Pending"@en, "Offen"@de);
										}]]></value>
									</line>
								</lines>
								<rows><![CDATA[session -> ifElse(isEmpty($session), list(),
									$session.referers(`tl.ai.execution:AgentTask#session`)
										.sort((t -> $t.get(`tl.ai.execution:AgentTask#ordinal`)).comparator()))]]></rows>
							</data-list>
						</section>
						<section name="sources"
							badge="dockSourcesBadge"
							icon="css:bi bi-quote"
						>
							<label>
								<en>Sources</en>
								<de>Quellen</de>
							</label>
							<chat-sources badge="dockSourcesBadge"/>
						</section>
						<section name="events"
							icon="css:bi bi-calendar-event"
						>
							<label>
								<en>Events</en>
								<de>Veranstaltungen</de>
							</label>
							<data-list
								collapsible="false"
								observed-types="demo.events:Event"
								search="false"
								selection="dockPaneObject"
							>
								<empty-text>
									<en>No events yet</en>
									<de>Noch keine Veranstaltungen</de>
								</empty-text>
								<lines>
									<line attribute="name"/>
									<line attribute="startDate"
										emphasis="secondary"
									/>
								</lines>
								<rows><![CDATA[all(`demo.events:Event`)
									.sort((e -> $e.get(`demo.events:Event#startDate`)).comparator().desc())]]></rows>
							</data-list>
						</section>
					</chat-rail>
				</chat>
			</chat-dock>
		</footer>
	</app-shell>
</view>
