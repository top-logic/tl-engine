<?xml version="1.0" encoding="utf-8" ?>

<!--
	Edit dialog for a build step (test.flowchart:FlowNode), opened on the step in "model". The Save
	button stores the form and closes the dialog. Opened by the button of a repeater card and by the
	row button of the Build steps table of the flow diagram demo, whose labels show the name of the
	step and follow a rename.
-->
<view>
	<channels>
		<channel name="model"/>
	</channels>
	<window width="500px">
		<title>
			<en>Edit build step</en>
			<de>Bauschritt bearbeiten</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="marker"/>
			<commands>
				<generic-command
					image="css:bi bi-check-lg"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Save</en>
						<de>Speichern</de>
					</label>
					<store-form-state/>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>