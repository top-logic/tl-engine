<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="model"/>
		<channel name="selected"/>
		<channel name="gridSelected"/>
		<!--
			The selection while it consists of exactly one object, and nothing while nothing or
			several objects are selected: size() counts a missing value as zero, a single object as
			one and a set as the number of its elements. A command or a form that works on one
			object binds to this channel.
		-->
		<derived-channel name="selectedSingle"
			expr="sel -> if($sel.size() == 1, $sel.singleElement(), null)"
			inputs="selected"
		/>
		<!-- Anchor object for the editable-table form: the edit session locks on it. -->
		<derived-channel name="gridAnchor"
			expr="currentUser()"
		/>
	</channels>
	<tab-bar active-tab="table">
		<tabs>
			<tab id="table"
				icon="css:bi bi-table"
			>
				<label>
					<en>Table</en>
					<de>Tabelle</de>
				</label>
				<panel>
					<title>
						<en>Demo objects</en>
						<de>Demo-Objekte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-magic"
							placement="TOOLBAR"
						>
							<label>
								<en>Generate samples</en>
								<de>Beispiele erzeugen</de>
							</label>
							<with-transaction>
								<execute-script function="x -> count(6).foreach(i -> { o = new(`demo.react:Demo`, transient: false); $o.set(`demo.react:Demo#name`, if($i % 3 == 0, 'Part ', if($i % 3 == 1, 'Tool ', 'Usage ')) + ($i + 1)); $o.set(`demo.react:Demo#string`, 'Value ' + ($i + 1)); $o.set(`demo.react:Demo#active`, $i % 2 == 0); $o.set(`demo.react:Demo#count`, ($i + 1) * 100); $o.set(`demo.react:Demo#amount`, ($i + 1) * 12.5); $o.set(`demo.react:Demo#date`, date(2026, ($i % 12) + 1, ($i % 28) + 1)); $o.set(`demo.react:Demo#priority`, if($i % 3 == 0, `demo.react:Priority#low`, if($i % 3 == 1, `demo.react:Priority#medium`, `demo.react:Priority#high`))); $o.set(`demo.react:Demo#owner`, if($i % 2 == 0, currentUser(), null)); $o.set(`demo.react:Demo#aliases`, ['Alpha ' + ($i + 1), 'Bravo ' + ($i + 1), 'Charlie ' + ($i + 1)]); $o.set(`demo.react:Demo#notes`, ['Checked on site.', 'Waiting for the supplier.']); $o.set(`demo.react:Demo#scores`, [$i + 1, $i + 3, $i + 5]); $o.set(`demo.react:Demo#ratios`, [($i + 1) * 1.5, ($i + 1) * 2.25]); $o.set(`demo.react:Demo#deadlines`, [date(2026, ($i % 12) + 1, 10), date(2026, ($i % 12) + 1, 24)]); $o.set(`demo.react:Demo#flags`, [$i % 2 == 0, $i % 3 == 0]); $o; })"/>
							</with-transaction>
						</generic-command>
						<generic-command
							image="css:bi bi-plus-lg"
							placement="TOOLBAR"
						>
							<label>
								<en>New</en>
								<de>Neu</de>
							</label>
							<execute-script function="x -> new(`demo.react:Demo`, transient: true)"/>
							<open-dialog
								bind-input-to="model"
								dialog-view="attributes-create.view.xml"
							>
								<bind
									channel="selection"
									to="selected"
								/>
							</open-dialog>
						</generic-command>
						<!--
							The detail dialog shows one object, so the command takes the selection only while
							it consists of a single one and is disabled otherwise.
						-->
						<generic-command
							image="css:bi bi-pencil"
							input="selectedSingle"
							placement="TOOLBAR"
						>
							<label>
								<en>Edit</en>
								<de>Bearbeiten</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="model"
								close-on-backdrop="true"
								dialog-view="attributes-detail.view.xml"
							/>
						</generic-command>
						<!-- delete() accepts a single object as well as a set of them. -->
						<generic-command
							image="css:bi bi-trash"
							input="selected"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="objs -> { $objs.delete(); null; }"/>
							</with-transaction>
							<write-channel name="selected"/>
						</generic-command>
					</commands>
					<table
						filter-bar="true"
						fixed-columns="1"
						observed-types="demo.react:Demo"
						personalization-key="demo-attributes"
						selection="selected"
						selection-mode="multi"
						types="demo.react:Demo"
					>
						<inputs>
							<input channel="selected"/>
						</inputs>
						<presets>
							<preset name="mine">
								<label>
									<en>My objects</en>
									<de>Meine Objekte</de>
								</label>
								<criterion
									column="owner"
									expr="currentUser()"
								/>
							</preset>
							<preset name="active">
								<label>
									<en>Active only</en>
									<de>Nur aktive</de>
								</label>
								<criterion
									column="active"
									expr="true"
								/>
							</preset>
							<preset name="small-amount">
								<label>
									<en>Amount up to 50</en>
									<de>Betrag bis 50</de>
								</label>
								<criterion
									column="amount"
									expr="list(0, 50)"
								/>
							</preset>
							<preset name="odd-values">
								<label>
									<en>Odd values (case-sensitive)</en>
									<de>Ungerade Werte (Groß-/Kleinschreibung)</de>
								</label>
								<!-- Written in the form of the column's text filter, which a single value cannot say. -->
								<criterion column="string">
									<text
										case-sensitive="true"
										pattern="'^Value [135]$'"
										regexp="true"
										whole-field="true"
									/>
								</criterion>
							</preset>
							<preset name="large-amount">
								<label>
									<en>Amount over 50</en>
									<de>Betrag über 50</de>
								</label>
								<!-- The inversion of the range the "small amount" preset selects. -->
								<criterion
									column="amount"
									inverted="true"
								>
									<range
										operator="BETWEEN"
										primary="0"
										secondary="50"
									/>
								</criterion>
							</preset>
							<preset name="same-priority">
								<label>
									<en>Same priority as the selection</en>
									<de>Gleiche Priorität wie die Auswahl</de>
								</label>
								<!--
									Selects by an input: the priorities of the selected rows. The preset is
									offered while a row is selected and follows the selection; with several
									rows selected it offers the priorities of all of them.
								-->
								<criterion column="priority">
									<options selected="sel -> $sel.get(`demo.react:Demo#priority`)"/>
								</criterion>
							</preset>
						</presets>
						<columns>
							<column
								attribute="name"
								width="220"
							>
								<!-- Application-defined filter: predefined regexp facets as checkboxes. -->
								<filter class="com.top_logic.table.filter.RegexpOptionsFilter">
									<pattern regexp="^Part">
										<label>
											<en>Parts</en>
											<de>Teile</de>
										</label>
									</pattern>
									<pattern regexp="^Tool">
										<label>
											<en>Tools</en>
											<de>Werkzeuge</de>
										</label>
									</pattern>
									<pattern regexp="^Usage">
										<label>
											<en>Usage entries</en>
											<de>Verwendungen</de>
										</label>
									</pattern>
								</filter>
							</column>
							<column
								attribute="string"
								width="200"
							/>
							<column attribute="multiLine"/>
							<column attribute="i18n"/>
							<column attribute="i18nMultiline"/>
							<column attribute="priority"/>
							<column attribute="active"/>
							<column attribute="count">
								<!--
									Model- and script-defined filter: the form is a transient
									demo.filter:LongRange instance; the match function builds a
									per-row predicate closure from it.
								-->
								<filter class="com.top_logic.layout.view.table.ScriptedFilter"
									model="demo.filter:LongRange"
								>
									<label>
										<en>Count range (scripted)</en>
										<de>Anzahl-Bereich (per Skript)</de>
									</label>
									<match><![CDATA[
										params -> value -> row -> {
											min = $params.get(`demo.filter:LongRange#min`);
											max = $params.get(`demo.filter:LongRange#max`);
											($min == null || $value >= $min) && ($max == null || $value <= $max)
										}
									]]></match>
								</filter>
							</column>
							<column attribute="amount"/>
							<column attribute="date"/>
							<column attribute="dateTimeShort"/>
							<column attribute="aliases"/>
							<column attribute="notes"/>
							<column attribute="scores"/>
							<column attribute="ratios"/>
							<column attribute="deadlines"/>
							<column attribute="flags"/>
							<column attribute="owner"/>
							<column attribute="url"/>
							<column attribute="email"/>
							<column attribute="phone"/>
						</columns>
						<rows>all(`demo.react:Demo`)</rows>
						<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
							image="css:bi bi-pencil"
						>
							<label>
								<en>Edit</en>
								<de>Bearbeiten</de>
							</label>
							<open-dialog
								bind-input-to="model"
								close-on-backdrop="true"
								dialog-view="attributes-detail.view.xml"
							/>
						</on-activate>
					</table>
				</panel>
			</tab>
			<tab id="master-detail"
				icon="css:bi bi-layout-sidebar"
			>
				<label>
					<en>Selector + Form</en>
					<de>Auswahl + Formular</de>
				</label>
				<split-panel
					orientation="horizontal"
					resizable="true"
				>
					<panes>
						<pane
							min-size="220"
							size="30"
							unit="%"
						>
							<panel>
								<title>
									<en>Demo objects</en>
									<de>Demo-Objekte</de>
								</title>
								<commands>
									<generic-command
										image="css:bi bi-plus-lg"
										placement="TOOLBAR"
									>
										<label>
											<en>New</en>
											<de>Neu</de>
										</label>
										<execute-script function="x -> new(`demo.react:Demo`, transient: true)"/>
										<open-dialog
											bind-input-to="model"
											dialog-view="attributes-create.view.xml"
										>
											<bind
												channel="selection"
												to="selected"
											/>
										</open-dialog>
									</generic-command>
									<generic-command
										image="css:bi bi-trash"
										input="selectedSingle"
										placement="TOOLBAR"
									>
										<label>
											<en>Delete</en>
											<de>Löschen</de>
										</label>
										<executability>
											<null-input-disabled/>
										</executability>
										<with-transaction>
											<execute-script function="obj -> { if($obj != null, $obj.delete(), null); null; }"/>
										</with-transaction>
										<write-channel name="selected"/>
									</generic-command>
								</commands>
								<table
									observed-types="demo.react:Demo"
									selection="selected"
									types="demo.react:Demo"
								>
									<columns>
										<column attribute="name"/>
									</columns>
									<rows>all(`demo.react:Demo`)</rows>
								</table>
							</panel>
						</pane>
						<pane
							size="70"
							unit="%"
						>
							<panel>
								<title>
									<en>Details</en>
									<de>Details</de>
								</title>
								<!--
									The form shows one object and the table beside it selects one row at a time, so
									both work on the single selection.
								-->
								<form input="selectedSingle">
									<field attribute="name"/>
									<field attribute="string"/>
									<field attribute="multiLine"/>
									<field attribute="html"/>
									<field attribute="xmlSource"/>
									<field attribute="jsonSource"/>
									<field attribute="cssSource"/>
									<field attribute="javascriptSource"/>
									<field attribute="htmlSource"/>
									<field attribute="markdownSource"/>
									<field attribute="plainSource"/>
									<field attribute="i18n"/>
									<field attribute="i18nMultiline"/>
									<field attribute="i18nHtml"/>
									<field attribute="password"/>
									<field attribute="aliases"/>
									<field attribute="notes"/>
									<field attribute="count"/>
									<field attribute="size"/>
									<field attribute="amount"/>
									<field attribute="price"/>
									<field attribute="ratio"/>
									<field attribute="scores"/>
									<field attribute="ratios"/>
									<field attribute="active"/>
									<field attribute="tri"/>
									<field attribute="activeRadio"/>
									<field attribute="activeSelect"/>
									<field attribute="flags"/>
									<field attribute="date"/>
									<field attribute="dateTime"/>
									<field attribute="dateTimeShort"/>
									<field attribute="time"/>
									<field attribute="duration"/>
									<field attribute="deadlines"/>
									<field attribute="icon"/>
									<field attribute="color"/>
									<field attribute="country"/>
									<field attribute="language"/>
									<field attribute="timeZone"/>
									<field attribute="url"/>
									<field attribute="email"/>
									<field attribute="phone"/>
									<field attribute="json"/>
									<field attribute="image"/>
									<field attribute="priority"/>
									<field attribute="tags"/>
									<field attribute="owner"/>
									<field attribute="watchers"/>
									<field attribute="related"/>
								</form>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</tab>
			<tab id="grid"
				icon="css:bi bi-pencil-square"
			>
				<label>
					<en>Editable table</en>
					<de>Editierbare Tabelle</de>
				</label>
				<panel>
					<title>
						<en>Editable table</en>
						<de>Editierbare Tabelle</de>
					</title>
					<form input="gridAnchor">
						<table
							create-type="demo.react:Demo"
							fixed-columns="2"
							observed-types="demo.react:Demo"
							on-remove="DELETE"
							row-edit="SELECTED"
							selection="gridSelected"
							types="demo.react:Demo"
						>
							<columns>
								<column attribute="name"/>
								<column attribute="string"/>
								<column attribute="aliases"/>
								<column attribute="scores"/>
								<column attribute="priority"/>
								<column attribute="active"/>
								<column attribute="amount"/>
								<column attribute="date"/>
								<column
									attribute="owner"
									readonly="true"
								/>
							</columns>
							<rows>all(`demo.react:Demo`)</rows>
						</table>
					</form>
				</panel>
			</tab>
		</tabs>
	</tab-bar>
</view>