<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="tl-bpe-app.messages" />
					<bundle name="tl.bpe.appMessages" />
				</bundles>
			</instance>
		</config>
		<!--
			The database of an application that contained tl-bpe-app before it became a migration
			module has its data, but no stored version of the module: tl-bpe-app extends the minimum
			modules of tl-bpe, so that its migrations are applied there (Ticket #30419).
		-->
		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance
				minimum-modules="tl, tl-element, tl-contact, tl-model-search, tl-model-wysiwyg, tl-search-lucene, tl-doc, tl-monitoring, tl-bpe, tl-bpe-app"
			>
				<modules>
					<module name="tl-bpe-app" />
				</modules>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/tl.bpe.app.model.xml"/>
				</declarations>
				<settings>
					<module name="SecurityStructure">
						<singletons>
							<singleton type="Root"/>
						</singletons>
					</module>
				</settings>
				<model-filter>
					<blacklist>
						<filter class="com.top_logic.model.filter.ModuleNameFilter"
							module="tl.bpe.bpml"
						 />
					</blacklist>
				</model-filter>
			</instance>
		</config>
	</services>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/tl.bpe.app.meta.xml" />
					</declarations>
				</type-system>
			</type-systems>
		</config>

		<config config:interface="com.top_logic.layout.form.control.IconInputControl$Config" width="500" height="500">
		</config>	
	</configs>
</application>
