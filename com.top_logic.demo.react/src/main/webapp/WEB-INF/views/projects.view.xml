<?xml version="1.0" encoding="utf-8" ?>

<!--
	Drill-down through the project management data: projects, their milestones, the tickets of a
	milestone, and finally one ticket. Every frame pushes the next one with the object it is
	opened for, so a display target reaching one of these frames pushes exactly the same frame
	and lands in the drill-down the user already has.
	
	The <frame> declarations put the drill-down path into the address bar, one route per frame:
	project/<id> for the cockpit of a project, milestones/<id> and notes/<id> for the lists the
	cockpit tiles open (carrying the id of the project, because a list restored from the address
	has no cockpit to take the project from), milestone/<id> for the tickets of a milestone and
	ticket/<id> for one ticket, each id the objectId of the object. A ticket reached through the
	milestone list is /view/projects/project/<id>/milestones/<id>/milestone/<id>/ticket/<id>.
	Opening such an address restores the frames, and the back button walks out of them again.
	
	The declarations also name the frames: the crumb of an object's frame is the object's name or
	title, the crumb of a list frame the name of the list. Neither the pushing frames nor the
	display targets name the frames they push, so every frame of a view carries the same label,
	however it is reached. The label of the ticket is the final title of the page.
-->
<view>
	<channels>
		<channel name="navPath"/>
	</channels>

	<stack>
		<slot-content to="appbar-content">
			<tile-breadcrumb path="navPath">
				<home-label>
					<en>Projects</en>
					<de>Projekte</de>
				</home-label>
			</tile-breadcrumb>
		</slot-content>

		<tile-stack
			initial="projects/overview.view.xml"
			path="navPath"
		>
			<frame
				route="project/:project"
				view="projects/milestones.view.xml"
			>
				<param name="project"
					expr="objectId($project)"
					reverse="$value.objectResolve(`tl.demo.projectManagement:ProjectScope`)"
				/>
				<label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="$project.get(`tl.demo.projectManagement:ProjectScope#name`)"
					inputs="project"
				/>
			</frame>
			<frame
				route="milestones/:project"
				view="projects/milestone-list.view.xml"
			>
				<param name="project"
					expr="objectId($project)"
					reverse="$value.objectResolve(`tl.demo.projectManagement:ProjectScope`)"
				/>
				<label class="com.top_logic.layout.view.tiles.StaticTileLabel">
					<value>
						<en>Milestones</en>
						<de>Meilensteine</de>
					</value>
				</label>
			</frame>
			<frame
				route="notes/:project"
				view="projects/notes.view.xml"
			>
				<param name="project"
					expr="objectId($project)"
					reverse="$value.objectResolve(`tl.demo.projectManagement:ProjectScope`)"
				/>
				<label class="com.top_logic.layout.view.tiles.StaticTileLabel">
					<value>
						<en>Notes</en>
						<de>Notizen</de>
					</value>
				</label>
			</frame>
			<frame
				route="milestone/:milestone"
				view="projects/tickets.view.xml"
			>
				<param name="milestone"
					expr="objectId($milestone)"
					reverse="$value.objectResolve(`tl.demo.projectManagement:Milestone`)"
				/>
				<label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="$milestone.get(`tl.demo.projectManagement:Milestone#name`)"
					inputs="milestone"
				/>
			</frame>
			<frame
				final-title="true"
				route="ticket/:ticket"
				view="projects/ticket-detail.view.xml"
			>
				<param name="ticket"
					expr="objectId($ticket)"
					reverse="$value.objectResolve(`tl.demo.projectManagement:Ticket`)"
				/>
				<label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="$ticket.get(`tl.demo.projectManagement:Ticket#title`)"
					inputs="ticket"
				/>
			</frame>
		</tile-stack>
	</stack>
</view>