<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog creating a git connection of the tenant in "tenant": the form edits the transient input in
	"model", the server, the owner and the access token. Creating stores the token in the secret store
	of the installation and the connection in the model (factoryCreateGitConnection) and writes the
	new connection to "selection". The token is entered in a masked field and never shown again.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="tenant"/>
		<channel name="selection"/>
	</channels>
	<window width="520px">
		<title>
			<en>Create git connection</en>
			<de>Git-Verbindung anlegen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<field attribute="name"/>
			<field attribute="providerType"/>
			<field attribute="url"/>
			<field attribute="owner"/>
			<field attribute="token"/>
			<commands>
				<generic-command key="ENTER"
					inputs="model, tenant"
					placement="BUTTON_BAR"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<store-form-state/>
					<execute-script function="factoryCreateGitConnection($tenant, $model.get(`tl.factory.input:GitConnectionData#name`), $model.get(`tl.factory.input:GitConnectionData#providerType`), $model.get(`tl.factory.input:GitConnectionData#url`), $model.get(`tl.factory.input:GitConnectionData#owner`), $model.get(`tl.factory.input:GitToken#token`))">
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</execute-script>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>