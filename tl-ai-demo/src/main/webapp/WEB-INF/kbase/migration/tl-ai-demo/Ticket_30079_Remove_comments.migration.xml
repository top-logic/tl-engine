<?xml version="1.0" encoding="utf-8" ?>

<!--
	Removes the composition demo.events:Documented#comments, whose type tl.comments:Comment the
	engine has removed in tl-element:Ticket_30079_Remove_comments. delete-reference also drops the
	stored links to the deleted comments.
-->
<migration config:interface="com.top_logic.knowledge.service.migration.MigrationConfig"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<version name="Ticket_30079_Remove_comments"
		module="tl-ai-demo"
	/>
	<dependencies>
		<dependency name="Ticket_29492_enlarge_layout_key"
			module="tl"
		/>
		<dependency name="Ticket_30079_Remove_comments"
			module="tl-element"
		/>
	</dependencies>
	<pre-processors>
		<delete-reference name="demo.events:Documented#comments"/>
	</pre-processors>
</migration>
