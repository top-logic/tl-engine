<?xml version="1.0" encoding="utf-8" ?>

<!--
	Recorded user sessions begun within a time range as a sortable, filterable table, the newest
	first. The table is an app-specific admin widget, so it is referenced by class= rather than a
	reusable <tag>; its last column shows the mark the log entries of a session carry.
	The range defaults to the last seven days including today: from today 00:00 six days ago to
	tomorrow 00:00 in the time zone of the user. The input channels start empty, and the derived
	channels the inputs are bound to replace an empty value by the default; clearing an input writes
	the marker 'cleared' to its input channel, so that the default does not come back and the range
	stays open on that side (no start, or up to now). The table is read again when a bound changes
	and on Refresh, which ticks the reload channel, so that records made since become visible. The
	export writes the displayed rows to an Excel file. A titled <panel> is used (not the chrome-less
	<full-page>) because the view carries toolbar commands.
	"Session log" opens the log entries of the selected session (session-log.view.xml), as the user
	menu does for the current session.
-->
<view>
	<channels>
		<channel name="fromInput"/>
		<channel name="toInput"/>
		<derived-channel name="from"
			expr="switch { $fromInput == null: now().toUserCalendar().withDayAdded(-6).withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(); $fromInput == 'cleared': null; default: $fromInput; }"
			inputs="fromInput"
			reverse="if($value == null, 'cleared', $value)"
		/>
		<derived-channel name="to"
			expr="switch { $toInput == null: now().toUserCalendar().withDayAdded(1).withHour(0).withMinute(0).withSecond(0).withMillisecond(0).toDate(); $toInput == 'cleared': null; default: $toInput; }"
			inputs="toInput"
			reverse="if($value == null, 'cleared', $value)"
		/>
		<channel name="reload"/>
		<channel name="selectedSession"/>
	</channels>
	<panel id="sessions"
		fill="true"
	>
		<title>
			<en>Sessions</en>
			<de>Sitzungen</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-arrow-clockwise"
				inputs="reload"
				placement="TOOLBAR"
			>
				<label>
					<en>Refresh</en>
					<de>Aktualisieren</de>
				</label>
				<execute-script function="($reload == null) ? 1 : $reload + 1">
					<with-result>
						<write-channel name="reload"/>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-journal-text"
				inputs="selectedSession"
				placement="TOOLBAR"
			>
				<label>
					<en>Session log</en>
					<de>Sitzungsprotokoll</de>
				</label>
				<tooltip>
					<en>Shows the log entries written while the requests of the selected session were handled.</en>
					<de>Zeigt die Protokolleinträge, die bei der Bearbeitung der Anfragen der ausgewählten Sitzung geschrieben wurden.</de>
				</tooltip>
				<executability>
					<null-input-disabled/>
				</executability>
				<execute-script
					function="logSessionMark($selectedSession)"
					inputs="selectedSession"
				>
					<with-result>
						<open-dialog
							bind-input-to="sessionMark"
							close-on-backdrop="true"
							dialog-view="session-log.view.xml"
						/>
					</with-result>
				</execute-script>
			</generic-command>
		</commands>
		<inset>
			<stack id="filter"
				align="center"
				direction="row"
				wrap="true"
			>
				<value-input
					type="tl.core:DateTime"
					value="from"
				>
					<label>
						<en>From (inclusive)</en>
						<de>Von (inklusiv)</de>
					</label>
				</value-input>
				<value-input
					type="tl.core:DateTime"
					value="to"
				>
					<label>
						<en>To (exclusive)</en>
						<de>Bis (exklusiv)</de>
					</label>
				</value-input>
			</stack>
		</inset>
		<child id="table"
			class="com.top_logic.layout.view.admin.monitor.UserSessionTable"
			from="from"
			reload="reload"
			selection="selectedSession"
			to="to"
		>
			<export download-name="#('Sessions'@en, 'Sitzungen'@de)"/>
		</child>
	</panel>
</view>