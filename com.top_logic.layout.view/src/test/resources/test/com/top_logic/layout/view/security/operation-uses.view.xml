<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="project"/>
	</channels>
	<tab-bar>
		<tab id="admin">
			<access-control operation="Administration"/>
			<panel id="admin-panel">
				<commands>
					<generic-command>
						<access>
							<operation name="Write"/>
						</access>
						<execute-script function="null"/>
					</generic-command>
				</commands>
			</panel>
		</tab>
		<tab id="planning">
			<access-control
				inputs="project"
				object="$project"
				operation="Finish"
				type="TestViewModelAccess:Project"
			/>
			<panel id="planning-panel">
				<commands>
					<generic-command>
						<access>
							<operation name="Delete"/>
						</access>
						<execute-script function="null"/>
					</generic-command>
					<generic-command inputs="project">
						<access>
							<operation name="Read"
								object="$project.get(`TestViewModelAccess:Project#tasks`)"
								type="TestViewModelAccess:Task"
							/>
							<create type="TestViewModelAccess:Task"/>
						</access>
						<execute-script function="null"/>
					</generic-command>
				</commands>
				<form id="planning-form"
					edit-operation="Finish"
					input="project"
				/>
			</panel>
		</tab>
		<tab id="list">
			<object-list
				element-as="task"
				inputs="project"
				items="$project.get(`TestViewModelAccess:Project#tasks`)"
				link="null"
				remove="null"
			>
				<link-access>
					<create
						in="$project"
						reference="TestViewModelAccess:Project#steps"
					/>
				</link-access>
				<remove-access>
					<operation name="Delete"
						object="$task"
						type="TestViewModelAccess:Task"
					/>
				</remove-access>
				<item>
					<text input="task"/>
				</item>
			</object-list>
		</tab>
		<tab id="free">
			<panel id="free-panel">
				<commands>
					<generic-command>
						<access>
							<operation name="Finish"/>
						</access>
						<execute-script function="null"/>
					</generic-command>
				</commands>
				<form id="default-form"
					input="project"
				/>
			</panel>
		</tab>
	</tab-bar>
</view>