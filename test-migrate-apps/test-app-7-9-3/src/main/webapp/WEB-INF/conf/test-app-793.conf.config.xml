<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="test-app-793.app-messages" />
				</bundles>
			</instance>
		</config>
		
		<!--
			The database of this application was created with TL 7.9.3, before "tl-bpe-app" and
			"tl-security-auth-pac4j" became migration modules. The minimum modules make the migrations
			of these modules run on it instead of being skipped as migrations of a module new to the
			application.

			"tl-security-selfservice", "tl-security-passkey", the AI modules ("tl-ai-core",
			"tl-ai-mcp-server", "tl-ai-views", "tl-layout-view-agent") and the React view layer
			("tl-layout-view") did not exist in TL 7.9.3. The application contains them to check their
			migrations: these build their models from scratch, so listing them makes them run on this
			database as well, and the migration test fails, if a model change of one of these modules
			lacks its migration.
		-->
		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance
				minimum-modules="tl, tl-element, tl-contact, tl-model-search, tl-model-wysiwyg, tl-layout-formeditor, tl-search-lucene, tl-doc, tl-monitoring, tl-bpe, tl-bpe-app, tl-security-auth-pac4j, tl-security-selfservice, tl-security-passkey, tl-layout-view, tl-ai-core, tl-ai-mcp-server, tl-ai-views, tl-layout-view-agent, test-app-793"
			>
				<modules>
					<module name="test-app-793" />
				</modules>
			</instance>
		</config>

		<!-- The test runs without public address (variable tl_host), passkeys need an origin. -->
		<config service-class="com.top_logic.security.passkey.PasskeyService">
			<instance class="com.top_logic.security.passkey.PasskeyService"
				origins="http://localhost:8080"
			/>
		</config>

		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<!-- Enforce explicitly describing migrations for new TL versions. -->
				<!-- Comment out when booting with version TL 7.9.3:
				 -->
				<auto-upgrade>prevent</auto-upgrade>
			</instance>
		</config>
	</services>

	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/test-app-793Meta.xml" />
					</declarations>
				</type-system>
			</type-systems>
		</config>
	</configs>
</application>
