<?xml version="1.0" encoding="utf-8" ?>

<!--
	The notes of a project, pushed by the Notes tile of the project cockpit. The toolbar adds a
	note to the project; the table observes notes, so a created note appears without a reload.
	
	The view sits behind a tile of the cockpit and is reachable from no root view, so it is shown
	within the frame the tile pushed.
-->
<view>
	<channels>
		<channel name="project"/>
	</channels>

	<panel>
		<title>
			<en>Notes</en>
			<de>Notizen</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project"
				placement="TOOLBAR"
			>
				<label>
					<en>New Note</en>
					<de>Neue Notiz</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<create-transient
					container="project"
					reference="notes"
					type="tl.demo.projectManagement:Note"
				>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="demo/create-note.view.xml"
						>
							<bind
								channel="container"
								to="project"
							/>
						</open-dialog>
					</with-result>
				</create-transient>
			</generic-command>
		</commands>
		<table
			observed-types="tl.demo.projectManagement:Note"
			types="tl.demo.projectManagement:Note"
		>
			<columns>
				<column attribute="text"/>
			</columns>
			<inputs>
				<input channel="project"/>
			</inputs>
			<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#notes`))</rows>
		</table>
	</panel>
</view>