<?xml version="1.0" encoding="utf-8" ?>

<!-- typed configuration for TestOAuthAuthorizationEndpoint -->

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.oauth.server.OAuthAuthorizationServer">
			<instance class="com.top_logic.oauth.server.OAuthAuthorizationServer"
				consent-page="/view/oauth-consent.view.xml"
				refusal-page="/view/oauth-refused.view.xml"
			>
				<!-- Answers from a map instead of the network. -->
				<client-metadata-fetcher class="test.com.top_logic.oauth.server.AbstractOAuthServerTest$StaticFetcher"/>
			</instance>
		</config>
	</services>
</application>
