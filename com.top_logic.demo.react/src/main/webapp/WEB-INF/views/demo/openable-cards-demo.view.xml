<?xml version="1.0" encoding="utf-8" ?>

<!--
	Openable cards: an <object-list> whose elements the user opens, running its <on-activate> command
	with the opened element. What opens an element follows from whether the list is selectable.
	
	The first tab lists the milestones of all projects as cards, without a selection - an entry page
	the user picks a milestone from. A click or tap on a card opens it: <show-object/> displays the
	milestone where the application shows milestones, in the Projects drill-down, with the project
	and its milestone list pushed and the milestone selected. Tab reaches each card, and Enter or
	Space opens the focused one. Pointer and highlight on hover say that a card opens. A click on the
	button of a card is the button's: it opens the project of the milestone instead; and marking the
	text of a card opens nothing.
	
	The second tab lists the projects as selectable cards beside a form of the selected project. A
	click selects a card, and the form follows; a double-click, Enter on the focused card or the
	chevron in its corner open the project (shown in the Projects page, its row selected). The
	toolbar creates a project and deletes the selected one; the cards observe the projects, so
	creating, editing and deleting are reflected at once.
-->
<view>
	<channels>
		<channel name="project"
			type="tl.demo.projectManagement:ProjectScope"
		/>
	</channels>

	<tab-bar active-tab="click">
		<tabs>
			<tab id="click"
				icon="css:bi bi-hand-index"
			>
				<label>
					<en>Click opens</en>
					<de>Klick öffnet</de>
				</label>
				<panel with-inset="true">
					<title>
						<en>Milestones</en>
						<de>Meilensteine</de>
					</title>
					<object-list
						items="all(`tl.demo.projectManagement:Milestone`)"
						layout="grid"
						max-columns="4"
						min-column-width="16rem"
						observed-types="tl.demo.projectManagement:Milestone"
					>
						<item>
							<view-ref view="demo/openable-cards/milestone-card.view.xml">
								<bind
									channel="element"
									to="element"
								/>
							</view-ref>
						</item>
						<on-activate class="com.top_logic.layout.view.command.GenericViewCommand">
							<show-object/>
						</on-activate>
						<empty-text>
							<en>There are no milestones.</en>
							<de>Es gibt keine Meilensteine.</de>
						</empty-text>
					</object-list>
				</panel>
			</tab>
			<tab id="select"
				icon="css:bi bi-cursor"
			>
				<label>
					<en>Select and open</en>
					<de>Auswählen und öffnen</de>
				</label>
				<split-panel
					orientation="horizontal"
					resizable="true"
				>
					<panes>
						<pane>
							<panel with-inset="true">
								<title>
									<en>Projects</en>
									<de>Projekte</de>
								</title>
								<commands>
									<generic-command
										image="css:bi bi-plus-lg"
										placement="TOOLBAR"
									>
										<label>
											<en>New Project</en>
											<de>Neues Projekt</de>
										</label>
										<create-transient type="tl.demo.projectManagement:ProjectScope">
											<with-result as="p">
												<execute-script function="$p.set(`tl.demo.projectManagement:ProjectScope#admins`, [currentUser()])"/>
												<open-dialog
													bind-input-to="model"
													dialog-view="demo/create-project-scope.view.xml"
												>
													<bind
														channel="selection"
														to="project"
													/>
												</open-dialog>
											</with-result>
										</create-transient>
									</generic-command>
									<generic-command
										image="css:bi bi-trash"
										inputs="project"
										placement="TOOLBAR"
									>
										<label>
											<en>Delete</en>
											<de>Löschen</de>
										</label>
										<confirm expr="#('Delete project {0}?'@en, 'Projekt {0} löschen?'@de).fill($project.get(`tl.demo.projectManagement:ProjectScope#name`))"/>
										<delete-object/>
										<write-channel name="project"
											clear="true"
										/>
									</generic-command>
								</commands>
								<object-list
									items="all(`tl.demo.projectManagement:ProjectScope`)"
									layout="grid"
									max-columns="3"
									min-column-width="14rem"
									observed-types="tl.demo.projectManagement:ProjectScope"
									selection="project"
								>
									<item>
										<view-ref view="demo/openable-cards/project-card.view.xml">
											<bind
												channel="element"
												to="element"
											/>
										</view-ref>
									</item>
									<on-activate class="com.top_logic.layout.view.command.GenericViewCommand">
										<show-object/>
									</on-activate>
									<empty-text>
										<en>There are no projects.</en>
										<de>Es gibt keine Projekte.</de>
									</empty-text>
								</object-list>
							</panel>
						</pane>
						<pane>
							<panel>
								<title>
									<en>Project</en>
									<de>Projekt</de>
								</title>
								<form
									input="project"
									with-inset="true"
								>
									<field attribute="name"/>
									<field attribute="description"/>
									<field attribute="budget"/>
								</form>
							</panel>
						</pane>
					</panes>
				</split-panel>
			</tab>
		</tabs>
	</tab-bar>
</view>