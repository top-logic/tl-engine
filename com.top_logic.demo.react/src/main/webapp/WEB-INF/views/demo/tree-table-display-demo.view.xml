<?xml version="1.0" encoding="utf-8" ?>

<!--
	Tree table display demo: how a node shows itself in the tree column of a tree table and in a
	tree, and how rows and cells are marked by their data.
	
	Both sides show the same tree: the project scopes, their milestones and the tickets of each
	milestone. They share the "selected" channel, so a node selected on one side is selected on the
	other as well.
	
	The first column of the tree table displays the row object through a ResourceDisplayByExpression,
	and the tree on the right displays its nodes through the same display as its nodeContent, so a
	node looks the same on both sides:
	- the label is computed: a scope and a milestone name the number of their children, a ticket
	shows its number in front of its title;
	- the icon is computed per kind, an approved milestone showing a check mark instead of a flag;
	- an approved milestone gets the class tlDemoApproved, which the demo's stylesheet colors;
	- the tooltip names the description of a scope, the approval state of a milestone and the
	assignee of a ticket.
	
	The "Approved" column states the approval of each milestone and marks its cell with the standard
	class tl-status-success or tl-status-warning, the "Assignee" column marks a ticket without an
	assignee with tl-status-error. The row-class of the tree table tints the rows of the tickets
	whose milestone is approved with tl-status-success.
	
	"Toggle approval" switches the approval of the selected milestone. The display, the cell class
	and the row class follow the change: the milestone's icon, label color, tooltip and "Approved"
	cell change on both sides, and the rows of its tickets are tinted or no longer tinted.
-->
<view>
	<channels>
		<channel name="selected"/>
		<derived-channel name="selectedMilestone"
			expr="if($selected.instanceOf(`tl.demo.projectManagement:Milestone`), $selected, null)"
			inputs="selected"
		/>
	</channels>
	<panel>
		<title>
			<en>Tree table display</en>
			<de>Baumtabellen-Anzeige</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-check2-square"
				inputs="selectedMilestone as milestone"
				placement="TOOLBAR"
			>
				<label>
					<en>Toggle approval</en>
					<de>Freigabe umschalten</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<with-transaction>
					<execute-script function="{ $milestone.set(`tl.demo.projectManagement:Milestone#approved`, !($milestone.get(`tl.demo.projectManagement:Milestone#approved`) == true)); null; }"/>
				</with-transaction>
			</generic-command>
		</commands>
		<split-panel
			orientation="horizontal"
			resizable="true"
		>
			<panes>
				<pane
					min-size="300"
					size="65"
					unit="%"
				>
					<tree-table
						observed-types="tl.demo.projectManagement:ProjectScope,tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
						personalization-key="tree-table-display-demo"
						selection="selected"
					>
						<root>`tl.demo.projectManagement:ProjectScope`</root>
						<children>if($node == `tl.demo.projectManagement:ProjectScope`, all(`tl.demo.projectManagement:ProjectScope`), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), $node.get(`tl.demo.projectManagement:ProjectScope#milestones`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.get(`tl.demo.projectManagement:Milestone#tickets`), [])))</children>
						<parents>if($node.instanceOf(`tl.demo.projectManagement:Ticket`), $node.get(`tl.demo.projectManagement:Ticket#milestone`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.container(), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), `tl.demo.projectManagement:ProjectScope`, null)))</parents>
						<!-- Tints the tickets of an approved milestone. -->
						<row-class>if($row.instanceOf(`tl.demo.projectManagement:Ticket`), if($row.get(`tl.demo.projectManagement:Ticket#milestone`).get(`tl.demo.projectManagement:Milestone#approved`) == true, 'tl-status-success', null), null)</row-class>
						<columns>
							<computed-column name="node"
								value="$row"
								width="320"
							>
								<label>
									<en>Node</en>
									<de>Knoten</de>
								</label>
								<display class="com.top_logic.layout.view.element.ResourceDisplayByExpression">
									<label>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), if($value.get(`tl.demo.projectManagement:Ticket#number`) == null, $value.get(`tl.demo.projectManagement:Ticket#title`), '#' + $value.get(`tl.demo.projectManagement:Ticket#number`) + ' ' + $value.get(`tl.demo.projectManagement:Ticket#title`)), if($value.instanceOf(`tl.demo.projectManagement:Milestone`), $value.get(`tl.demo.projectManagement:Milestone#name`) + ' (' + $value.get(`tl.demo.projectManagement:Milestone#tickets`).size() + ')', $value.get(`tl.demo.projectManagement:ProjectScope#name`) + ' (' + $value.get(`tl.demo.projectManagement:ProjectScope#milestones`).size() + ')'))</label>
									<icon>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), 'css:bi bi-ticket-detailed', if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, 'css:bi bi-check-circle', 'css:bi bi-flag'), 'css:bi bi-folder2-open'))</icon>
									<css-class>if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, 'tlDemoApproved', null), null)</css-class>
									<tooltip>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), if($value.get(`tl.demo.projectManagement:Ticket#assignee`) == null, #('Not assigned'@en, 'Nicht zugewiesen'@de), $value.get(`tl.demo.projectManagement:Ticket#assignee`).get(`Contacts:PersonContact#firstname`) + ' ' + $value.get(`tl.demo.projectManagement:Ticket#assignee`).get(`Contacts:PersonContact#name`)), if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, #('Approved'@en, 'Freigegeben'@de), #('Awaiting approval'@en, 'Wartet auf Freigabe'@de)), $value.get(`tl.demo.projectManagement:ProjectScope#description`)))</tooltip>
								</display>
							</computed-column>
							<computed-column name="approved"
								width="180"
							>
								<label>
									<en>Approved</en>
									<de>Freigegeben</de>
								</label>
								<value>if($row.instanceOf(`tl.demo.projectManagement:Milestone`), if($row.get(`tl.demo.projectManagement:Milestone#approved`) == true, #('Approved'@en, 'Freigegeben'@de), #('Awaiting approval'@en, 'Wartet auf Freigabe'@de)), null)</value>
								<cell-class>if($row.instanceOf(`tl.demo.projectManagement:Milestone`), if($row.get(`tl.demo.projectManagement:Milestone#approved`) == true, 'tl-status-success', 'tl-status-warning'), null)</cell-class>
							</computed-column>
							<computed-column name="assignee"
								type="Contacts:PersonContact"
							>
								<label>
									<en>Assignee</en>
									<de>Zuständig</de>
								</label>
								<value>if($row.instanceOf(`tl.demo.projectManagement:Ticket`), $row.get(`tl.demo.projectManagement:Ticket#assignee`), null)</value>
								<cell-class>if($row.instanceOf(`tl.demo.projectManagement:Ticket`), if($value == null, 'tl-status-error', null), null)</cell-class>
							</computed-column>
						</columns>
					</tree-table>
				</pane>
				<pane
					min-size="200"
					size="35"
					unit="%"
				>
					<!-- The same tree, its nodes shown through the display of the tree table's first column. -->
					<tree
						observed-types="tl.demo.projectManagement:ProjectScope,tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
						selection="selected"
					>
						<root>`tl.demo.projectManagement:ProjectScope`</root>
						<children>if($node == `tl.demo.projectManagement:ProjectScope`, all(`tl.demo.projectManagement:ProjectScope`), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), $node.get(`tl.demo.projectManagement:ProjectScope#milestones`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.get(`tl.demo.projectManagement:Milestone#tickets`), [])))</children>
						<parents>if($node.instanceOf(`tl.demo.projectManagement:Ticket`), $node.get(`tl.demo.projectManagement:Ticket#milestone`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.container(), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), `tl.demo.projectManagement:ProjectScope`, null)))</parents>
						<nodeContent class="com.top_logic.layout.view.element.ResourceDisplayByExpression">
							<label>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), if($value.get(`tl.demo.projectManagement:Ticket#number`) == null, $value.get(`tl.demo.projectManagement:Ticket#title`), '#' + $value.get(`tl.demo.projectManagement:Ticket#number`) + ' ' + $value.get(`tl.demo.projectManagement:Ticket#title`)), if($value.instanceOf(`tl.demo.projectManagement:Milestone`), $value.get(`tl.demo.projectManagement:Milestone#name`) + ' (' + $value.get(`tl.demo.projectManagement:Milestone#tickets`).size() + ')', $value.get(`tl.demo.projectManagement:ProjectScope#name`) + ' (' + $value.get(`tl.demo.projectManagement:ProjectScope#milestones`).size() + ')'))</label>
							<icon>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), 'css:bi bi-ticket-detailed', if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, 'css:bi bi-check-circle', 'css:bi bi-flag'), 'css:bi bi-folder2-open'))</icon>
							<css-class>if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, 'tlDemoApproved', null), null)</css-class>
							<tooltip>if($value.instanceOf(`tl.demo.projectManagement:Ticket`), if($value.get(`tl.demo.projectManagement:Ticket#assignee`) == null, #('Not assigned'@en, 'Nicht zugewiesen'@de), $value.get(`tl.demo.projectManagement:Ticket#assignee`).get(`Contacts:PersonContact#firstname`) + ' ' + $value.get(`tl.demo.projectManagement:Ticket#assignee`).get(`Contacts:PersonContact#name`)), if($value.instanceOf(`tl.demo.projectManagement:Milestone`), if($value.get(`tl.demo.projectManagement:Milestone#approved`) == true, #('Approved'@en, 'Freigegeben'@de), #('Awaiting approval'@en, 'Wartet auf Freigabe'@de)), $value.get(`tl.demo.projectManagement:ProjectScope#description`)))</tooltip>
						</nodeContent>
					</tree>
				</pane>
			</panes>
		</split-panel>
	</panel>
</view>