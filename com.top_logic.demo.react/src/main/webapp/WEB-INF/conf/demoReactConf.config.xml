<?xml version="1.0" encoding="utf-8" ?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<!--
					A third data language (without own UI resources, falling back to English)
					exercises multi-language features beyond the trivial two-locale case, e.g. the
					language selector of the I18N editor dialog.
				-->
				<supported-locales>
					<locale name="es"/>
				</supported-locales>
				<bundles>
					<bundle name="model.demo.react.messages"/>
					<bundle name="model.demo.tickets.messages"/>
					<bundle name="model.demo.charts.messages"/>
					<bundle name="model.test.constraints.messages"/>
					<bundle name="model.test.flowchart.messages"/>
					<bundle name="model.tl.demo.projectManagement.messages"/>
					<bundle name="model.demo.filter.messages"/>
					<bundle name="model.demo.calendar.messages"/>
					<bundle name="model.demo.documents.messages"/>
				</bundles>
			</instance>
		</config>
		<!--
			The roles of this application: the administrator role that may open the administration
			area, granted in security.xml, the account reader role that makes accounts and groups
			visible, and the project reader role that makes the projects and the tickets visible.
			The latter two are granted by the role rules below.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="demo.react.Administrator"/>
					<role name="demo.react.AccountReader"/>
					<role name="demo.react.ProjectReader"/>
				</roles>
			</instance>
		</config>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/demo.react.model.xml"/>
					<declaration file="/WEB-INF/model/demo.tickets.model.xml"/>
					<declaration file="/WEB-INF/model/DemoCharts.model.xml"/>
					<declaration file="/WEB-INF/model/test.constraints.model.xml"/>
					<declaration file="/WEB-INF/model/test.flowchart.model.xml"/>
					<declaration file="/WEB-INF/model/tl.demo.projectManagement.model.xml"/>
					<declaration file="/WEB-INF/model/demo.filter.model.xml"/>
					<declaration file="/WEB-INF/model/demo.calendar.model.xml"/>
					<declaration file="/WEB-INF/model/demo.documents.model.xml"/>
				</declarations>
			</instance>
		</config>
		<!--
			Every newly created account joins the "users" group. The administration hub shows the
			default-group flag on that group.
		-->
		<config service-class="com.top_logic.base.services.InitialGroupManager">
			<instance default-group="users">
				<groups>
					<group name="users"/>
				</groups>
			</instance>
		</config>
		<!--
			Every member of the "users" group reads every account and every group, so that the
			deputy settings can offer the other accounts and show who stands in for whom. This is a
			decision of this demo; a real application decides for itself whether and which accounts
			a user may see. The engine grants an account read access to its own account only.

			The project reader reads and writes everything of the project management module and of
			the ticket module. The role rules below grant the role on the two root types; the
			contained objects inherit it through the security parents that the coverage analysis
			generated.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="tl.accounts:Person">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.AccountReader"
						/>
					</class>
					<class name="tl.accounts:Group">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.AccountReader"
						/>
					</class>
					<module name="tl.demo.projectManagement">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.ProjectReader"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="demo.react.ProjectReader"
						/>
					</module>
					<module name="demo.tickets">
						<grant
							inherit="true"
							operation="Read"
							roles="demo.react.ProjectReader"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="demo.react.ProjectReader"
						/>
					</module>
				</security-config>
			</instance>
		</config>
		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="AccountsReadableByUsers"
							inherit="true"
							meta-element="tl.accounts:Person"
							role="demo.react.AccountReader"
						>
							<group-with-name name="users"/>
						</rule>
						<rule id="GroupsReadableByUsers"
							inherit="true"
							meta-element="tl.accounts:Group"
							role="demo.react.AccountReader"
						>
							<group-with-name name="users"/>
						</rule>
						<!--
							Every member of the "users" group reads and writes the projects of this
							demo. The role is granted on the project scope only; the milestones,
							tickets and notes it contains reach it through the security parents
							below.
						-->
						<rule id="ProjectsReadableByUsers"
							inherit="true"
							meta-element="tl.demo.projectManagement:ProjectScope"
							role="demo.react.ProjectReader"
						>
							<group-with-name name="users"/>
						</rule>
						<!--
							The same for the tickets of the ticket module, whose comments and
							attachments reach the role through the security parents below.
						-->
						<rule id="TicketsReadableByUsers"
							inherit="true"
							meta-element="demo.tickets:Ticket"
							role="demo.react.ProjectReader"
						>
							<group-with-name name="users"/>
						</rule>
					</rules>
				</role-rules>
				<!--
					The rules below are the output of the coverage analysis: the "Show
					configuration" command of the administration area (Access control, Coverage)
					proposed them for every type that has no role source of its own and is
					contained in exactly one composition, and they are taken over unchanged,
					including their generated ids.
				-->
				<security-parents>
					<rules>
						<rule id="Attachment_securityParent"
							inherit="true"
							meta-element="demo.tickets:Attachment"
						>
							<step
								attribute="demo.tickets:Comment#attachments"
								inverse="true"
							/>
						</rule>
						<rule id="Comment_securityParent"
							inherit="true"
							meta-element="demo.tickets:Comment"
						>
							<step
								attribute="demo.tickets:Ticket#comments"
								inverse="true"
							/>
						</rule>
						<rule id="Milestone_securityParent"
							inherit="true"
							meta-element="tl.demo.projectManagement:Milestone"
						>
							<step
								attribute="tl.demo.projectManagement:ProjectScope#milestones"
								inverse="true"
							/>
						</rule>
						<rule id="Note_securityParent"
							inherit="true"
							meta-element="tl.demo.projectManagement:Note"
						>
							<step
								attribute="tl.demo.projectManagement:ProjectScope#notes"
								inverse="true"
							/>
						</rule>
						<rule id="Ticket_securityParent"
							inherit="true"
							meta-element="tl.demo.projectManagement:Ticket"
						>
							<step
								attribute="tl.demo.projectManagement:ProjectScope#tickets"
								inverse="true"
							/>
						</rule>
					</rules>
				</security-parents>
			</instance>
		</config>
		<!--
			Where this application displays its business objects. A read-only value whose type is
			listed here is offered as a link; following it reveals the views below in order and
			hands each of them the values its bindings compute.
			
			The frames a target pushes carry the same channel values and the same labels as the
			frames the user's own drill-down pushes, so a target leading into a drill-down the user
			already has leaves it untouched.
			
			Each view is looked for within the view shown before it, and a view that the drill-down
			reaches by pushing a frame is named as its own step: the milestone list sits behind the
			Milestones tile of the project cockpit, so it is a frame after the cockpit frame, and
			its label is the one that tile pushes with.
		-->
		<config service-class="com.top_logic.layout.view.navigation.DisplayTargetService">
			<instance>
				<targets>
					<target type="tl.demo.projectManagement:ProjectScope">
						<show view="projects/overview.view.xml">
							<bind channel="project"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Milestone">
						<show view="projects/overview.view.xml">
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
						</show>
						<show
							label-expr="m -> $m.container().get(`tl.demo.projectManagement:ProjectScope#name`)"
							view="projects/milestones.view.xml"
						>
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
						</show>
						<show
							label-expr="m -> #('Milestones'@en, 'Meilensteine'@de)"
							view="projects/milestone-list.view.xml"
						>
							<bind
								channel="project"
								expr="m -> $m.container()"
							/>
							<bind channel="milestone"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Ticket">
						<show view="projects/overview.view.xml">
							<bind
								channel="project"
								expr="t -> $t.container()"
							/>
						</show>
						<show
							label-expr="t -> $t.container().get(`tl.demo.projectManagement:ProjectScope#name`)"
							view="projects/milestones.view.xml"
						>
							<bind
								channel="project"
								expr="t -> $t.container()"
							/>
						</show>
						<show
							label-expr="t -> #('Milestones'@en, 'Meilensteine'@de)"
							view="projects/milestone-list.view.xml"
						>
							<bind
								channel="project"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`).container()"
							/>
							<bind
								channel="milestone"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`)"
							/>
						</show>
						<show
							label-expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`).get(`tl.demo.projectManagement:Milestone#name`)"
							view="projects/tickets.view.xml"
						>
							<bind
								channel="milestone"
								expr="t -> $t.get(`tl.demo.projectManagement:Ticket#milestone`)"
							/>
						</show>
						<show
							label-expr="t -> $t.get(`tl.demo.projectManagement:Ticket#title`)"
							view="projects/ticket-detail.view.xml"
						>
							<bind channel="ticket"/>
						</show>
					</target>
					<target type="tl.demo.projectManagement:Contributor">
						<show
							dialog="true"
							view="projects/contributor-dialog.view.xml"
						>
							<bind channel="contributor"/>
						</show>
					</target>
					<target type="tl.accounts:Person">
						<show view="demo/tiles-demo/overview.view.xml">
							<bind channel="selectedPerson"/>
						</show>
						<show
							label-expr="p -> $p.get(`tl.accounts:Person#name`)"
							view="demo/tiles-demo/person-detail.view.xml"
						>
							<bind channel="person"/>
						</show>
					</target>
					<target type="demo.tickets:Ticket">
						<show view="tickets.view.xml">
							<bind channel="ticket"/>
						</show>
					</target>
				</targets>
			</instance>
		</config>
		<!--
			The themes of this application, each restyling the tokens the React controls and the
			application stylesheet are drawn from.
			
			"Flat" takes rounding and elevation away, demonstrating that the React controls take
			their corners and their shadows from the theme alone. "Glass" turns on the two tokens
			the shipped themes leave without effect - the blur behind a translucent surface and the
			glow around a highlighted one, both consumed by the glass card of the styling demo - and
			gives the headings a display face of their own.
		-->
		<config service-class="com.top_logic.layout.react.theme.UIThemeService">
			<instance>
				<themes>
					<theme name="flat"
						extends="default"
						icon="css:bi bi-square"
					>
						<label>
							<en>Flat</en>
							<de>Flach</de>
						</label>
						<length name="border-radius-02" value="0"/>
						<length name="corner-radius" value="0"/>
						<text name="shadow-dialog" value="none"/>
						<text name="shadow-menu" value="none"/>
						<text name="shadow-raised" value="none"/>
					</theme>
					<theme name="glass"
						extends="default"
						icon="css:bi bi-droplet-half"
					>
						<label>
							<en>Glass</en>
							<de>Glas</de>
						</label>
						<text name="font-family-display" value="Georgia, serif"/>
						<text name="shadow-glow" value="0 0 24px rgba(41,104,200,0.45)"/>
						<length name="surface-blur" value="12px"/>
					</theme>
				</themes>
			</instance>
		</config>
		<!--
			The stylesheet of this application, contributed to the client resources of the React UI
			behind the stylesheets of the controls, so that it overrides them. It holds the
			staggered entrance of the repeater demo's items.
		-->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="tl-demo-react-css"
						requires="tl-react-controls-css"
						resource="/style/tl-demo-react.css"
					/>
				</resources>
			</instance>
		</config>
	</services>

	<configs>
		<!--
			This is a React-only application: its entry point is the React view shell at /view/.
			The framework's start page is a singleton setting that the legacy core defaults to the
			layout servlet; the application authoritatively declares its own entry here.
		-->
		<config config:interface="com.top_logic.base.accesscontrol.ApplicationPages$Config">
			<startPage>/view/</startPage>
		</config>
		<!--
			The demo lowers the upload limit below the framework default so that the refusal of an
			oversized file can be tried out with a moderately sized file.
		-->
		<config config:interface="com.top_logic.layout.react.control.upload.UploadConfig"
			max-upload-size="10m"
		/>
		<!--
			What a session that belongs to no account sees in place of the application: the
			framework's login page, whatever the URL asks for. This demo shows its objects to
			accounts only, like a business application, and the requested URL is held while the
			login page is displayed, so a deep link leads to the page it names as soon as the
			visitor is logged in.
		-->
		<config config:interface="com.top_logic.layout.view.ViewConfig"
			login-view="login-page.view.xml"
		>
			<!--
				A second view a URL may load top-level, besides the default view: the document viewer
				is self-contained, so it shows the same thing in a browser tab of its own as it does
				inside the application shell.
			-->
			<entry-points>
				<entry-point view="demo/pdf-demo.view.xml"/>
			</entry-points>
		</config>
	</configs>
</application>