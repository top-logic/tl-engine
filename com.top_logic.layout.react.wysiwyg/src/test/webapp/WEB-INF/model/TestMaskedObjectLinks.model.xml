<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestMaskedObjectLinks">
			<types>
				<class name="Topic">
					<annotations>
						<table name="GenericObject"/>
					</annotations>
					<generalizations>
						<generalization type="tl.model:TLObject"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<reference name="reader"
							type="tl.accounts:Person"
						/>
						<property name="text"
							type="tl.model.wysiwyg:Html"
						/>
					</attributes>
				</class>
			</types>
		</module>
	</modules>
</model>
