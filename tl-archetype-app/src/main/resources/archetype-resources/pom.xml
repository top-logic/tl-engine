<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>\${groupId}</groupId>
	<artifactId>\${artifactId}</artifactId>
	<version>\${version}</version>
	<name>\${project.artifactId}</name>

#if ($moduleType == "fragment")
	<!--
		A TopLogic fragment: a library module contributing model, configuration and UI to the
		applications depending on it. The packaging tl-fragment of the tl-maven-plugin (declared
		with extensions below) builds it with the configuration of the TopLogic parent POM
		tl-parent-core, without inheriting from it.
	-->
	<packaging>tl-fragment</packaging>
#else
	<!--
		A TopLogic application. The packaging tl-app of the tl-maven-plugin (declared with
		extensions below) builds it with the configuration of the TopLogic parent POM
		tl-parent-app, without inheriting from it.
	-->
	<packaging>tl-app</packaging>
#end

#if ($ProfessionalEdition == "false")
	<licenses>
		<license>
			<name>AGPL-3.0-only</name>
			<url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
		</license>
	</licenses>
#else
	<licenses>
		<license>
			<name>BOS-TopLogic-1.0</name>
			<url>https://github.com/top-logic/.github/blob/main/LICENSES/LicenseRef-BOS-TopLogic-1.0.md</url>
		</license>
	</licenses>
#end

	<properties>
		<!-- The TopLogic version: the version of the BOM tl-bom and of the tl-maven-plugin. -->
		<tl.version>\${tlVersion}</tl.version>

		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
#if ($moduleType != "fragment")

		<!--
			Debian package of the application, built from src/main/deb by the build of the TopLogic
			parent POM tl-parent-app. Set tl.deb.skip to false to build it. The further tl.deb.*
			properties (maintainer, install directory, database schema, ...) have their defaults in
			tl-parent-app.
		-->
		<tl.deb.skip>true</tl.deb.skip>

		<!-- Deployment to APT repository. Set tl.deb.skipDeploy to false to upload the package. -->
		<tl.deb.skipDeploy>true</tl.deb.skipDeploy>
		<tl.deb.repositoryUrl>Enter URL here.</tl.deb.repositoryUrl>
#end
	</properties>

	<!-- The versions of the TopLogic modules and of the libraries they are built with. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.top-logic</groupId>
				<artifactId>tl-bom</artifactId>
				<version>\${tl.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
#if ($moduleType != "fragment")
#if ($ProfessionalEdition == "true")
		<!-- Using TopLogic Professional Edition. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-license-professional</artifactId>
		</dependency>
#else
		<!-- Using TopLogic OpenSource Edition. AGPL license conditions apply. -->
		<!-- To switch to TopLogic Professional Edition, uncomment the following dependency: -->
		<!--
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-license-professional</artifactId>
		</dependency>
		-->
#end

#end
		<!-- TopLogic -->
#if ($ui != "classic")
		<!-- React UI: the views of tl-layout-view, entry point /view/. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-starter-react</artifactId>
			<type>pom</type>
		</dependency>
#if ($useSelfService == "true")
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-layout-view-selfservice</artifactId>
		</dependency>
#end
#if ($useChartJS == "true")
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-layout-react-chartjs</artifactId>
		</dependency>
#end
#end
#if ($ui != "react")
		<!-- Classic UI: the layouts of the LayoutServlet. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-starter-classic</artifactId>
			<type>pom</type>
		</dependency>
#if ($useBPE == "true")
		<!-- The process engine has a classic UI only. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-bpe-app</artifactId>
		</dependency>
#end
#if ($useSelfService == "true")
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-security-selfservice</artifactId>
		</dependency>
#end
#if ($useChartJS == "true")
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-chart-chartjs</artifactId>
		</dependency>
#end
#end
#if ($useAI == "true")
		<!-- AI agents. The application configures the LLM providers its agents use. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-starter-ai</artifactId>
			<type>pom</type>
		</dependency>
#if ($ui != "react")
		<!-- The chat in a tab of the classic UI. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-chat-classic</artifactId>
		</dependency>
#end
#end
#if ($useAISearch == "true")
		<!-- Hybrid (full-text and semantic) search over the objects of the application. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-starter-ai-search</artifactId>
			<type>pom</type>
		</dependency>
#end
#if ($useSSO == "true")
		<!-- Single sign-on through OpenID Connect, SAML and other protocols (pac4j). -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-security-auth-pac4j</artifactId>
		</dependency>
#end
#if ($useApiClient == "true")
		<!-- Allow to integrate REST services through OpenAPI interface definitions. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-service-openapi-client</artifactId>
		</dependency>
#end
#if ($useApiServer == "true")
		<!-- Provide REST services through OpenAPI interface definitions. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-service-openapi-server</artifactId>
		</dependency>
#end

		<!-- Tests -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-basic</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-core</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
#if ($ui != "react")
		<!-- Scripted tests (*.script.xml) of the classic UI. -->
		<dependency>
			<groupId>com.top-logic</groupId>
			<artifactId>tl-layout-scripting-template</artifactId>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
#end
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>com.top-logic</groupId>
				<artifactId>tl-maven-plugin</artifactId>
				<version>\${tl.version}</version>
				<!-- Provides the packaging of this project. -->
				<extensions>true</extensions>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>my-releases</id>
			<url>fill-out-here</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>

		<snapshotRepository>
			<id>my-snapshots</id>
			<url>fill-out-here</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</snapshotRepository>
	</distributionManagement>

	<!--
		The TopLogic repositories, which resolve the BOM tl-bom, the TopLogic modules and the
		TopLogic build plugins. With them declared here, the project builds against a TopLogic
		SNAPSHOT version by only changing the property tl.version above, without any Maven
		settings.
	-->
	<repositories>
		<repository>
			<id>tl-releases</id>
			<url>https://dev.top-logic.com/nexus/repository/toplogic/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>

		<repository>
			<id>tl-snapshots</id>
			<url>https://dev.top-logic.com/nexus/repository/toplogic-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>tl-releases</id>
			<url>https://dev.top-logic.com/nexus/repository/toplogic/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</pluginRepository>

		<pluginRepository>
			<id>tl-snapshots</id>
			<url>https://dev.top-logic.com/nexus/repository/toplogic-snapshots/</url>
			<releases>
				<enabled>false</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</pluginRepository>
	</pluginRepositories>
</project>
