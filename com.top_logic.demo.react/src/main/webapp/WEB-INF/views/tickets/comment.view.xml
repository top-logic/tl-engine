<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="comment"/>
		<channel name="draft"/>
		<channel name="editMode"/>
		<!--
			The files of the comment's attachments, entered in the form and stored by its save. Filled
			again when the comment is displayed and after its attachments are stored.
		-->
		<channel name="files"
			init="$comment.get(`demo.tickets:Comment#attachments`).map(a -> $a.get(`demo.tickets:Attachment#data`))"
			inputs="comment"
			observed-types="demo.tickets:Attachment"
		/>
		<!-- The attachments are offered while the comment is edited or has any. -->
		<derived-channel name="showFiles"
			expr="$editMode || $files.size() > 0"
			inputs="editMode, files"
		/>
		<derived-channel name="author"
			expr="$comment.get(`demo.tickets:Comment#author`)"
			inputs="comment"
		/>
		<derived-channel name="date"
			expr="$comment.get(`demo.tickets:Comment#date`)"
			inputs="comment"
		/>
		<derived-channel name="cited"
			expr="$comment.get(`demo.tickets:Comment#cited`)"
			inputs="comment"
		/>
		<!-- The ticket the comment belongs to, in which a reply is created. -->
		<derived-channel name="ticket"
			expr="$comment.container()"
			inputs="comment"
		/>
	</channels>
	<anchor input="comment">
		<panel
			appearance="card"
			command-display="icon-only"
			hover-actions="true"
		>
			<title-content>
				<avatar input="author"/>
				<text
					css-class="tl-type-body-strong"
					input="author"
				/>
				<relative-time input="date"/>
				<scroll-link
					input="cited"
					label="&quot;↩ &quot; + label($cited.get(`demo.tickets:Comment#author`))"
				/>
			</title-content>
			<commands>
				<generic-command
					image="css:bi bi-reply"
					inputs="comment"
					placement="TOOLBAR"
				>
					<label>
						<en>Reply</en>
						<de>Antworten</de>
					</label>
					<executability>
						<model-access
							container="ticket"
							operation="Create"
							reference="comments"
							type="demo.tickets:Comment"
						/>
					</executability>
					<execute-script function="{ reply = new(`demo.tickets:Comment`, transient: true, context: $comment.container()); $reply.set(`demo.tickets:Comment#cited`, $comment); $reply; }">
						<with-result>
							<write-channel name="draft"/>
						</with-result>
					</execute-script>
					<scroll-to-anchor target="'composer'"/>
				</generic-command>
				<generic-command
					image="css:bi bi-trash"
					inputs="comment"
					placement="TOOLBAR"
				>
					<label>
						<en>Delete</en>
						<de>Löschen</de>
					</label>
					<executability>
						<model-access operation="Delete"/>
					</executability>
					<remove-element/>
				</generic-command>
			</commands>
			<form
				editMode="editMode"
				input="comment"
				with-inset="true"
			>
				<field
					attribute="content"
					label-position="hide-label"
				/>
				<visible-if
					expr="$showFiles"
					input="showFiles"
				>
					<value-input
						label="model.demo.tickets.Comment.attachments"
						multiple="true"
						type="tl.core:Binary"
						value="files"
					/>
				</visible-if>
				<save-action>
					<with-transaction>
						<store-form-state/>
						<execute-script
							function="demoTicketsStoreAttachments($comment, $files)"
							inputs="comment, files"
						/>
					</with-transaction>
					<leave-edit-mode/>
				</save-action>
				<cancel-action>
					<discard-form-state/>
					<execute-script
						function="$comment.get(`demo.tickets:Comment#attachments`).map(a -> $a.get(`demo.tickets:Attachment#data`))"
						inputs="comment"
					>
						<with-result>
							<write-channel name="files"/>
						</with-result>
					</execute-script>
				</cancel-action>
			</form>
		</panel>
	</anchor>
</view>