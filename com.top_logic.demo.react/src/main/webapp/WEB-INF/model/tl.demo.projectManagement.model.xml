<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.demo.projectManagement">
		<annotations>
			<display-group value="demo"/>
		</annotations>
		<class name="Deliverable"
			abstract="true"
		>
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<id-column value="name"/>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<class name="Milestone">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-flag"/>
				<main-properties properties="name, dueDate"/>
				<form-definition>
					<form>
						<field
							attribute="name"
							fullQualifiedName="tl.demo.projectManagement:Milestone#name"
							type="tl.core:String"
						/>
						<field
							attribute="dueDate"
							fullQualifiedName="tl.demo.projectManagement:Milestone#dueDate"
							type="tl.core:Date"
						/>
						<field
							attribute="approved"
							fullQualifiedName="tl.demo.projectManagement:Milestone#approved"
							type="tl.core:Boolean"
						/>
						<field
							attribute="tickets"
							fullQualifiedName="tl.demo.projectManagement:Milestone#tickets"
							type="tl.demo.projectManagement:Ticket"
						>
							<annotations>
								<reference-display value="table"/>
							</annotations>
						</field>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="dueDate"
					type="tl.core:Date"
				/>
				<property name="approved"
					type="tl.core:Boolean"
				/>
				<reference name="tickets"
					inverse-reference="milestone"
					kind="backwards"
					multiple="true"
					type="Ticket"
				>
					<annotations>
						<change-subtree/>
					</annotations>
				</reference>
			</attributes>
		</class>
		<class name="Note">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<id-column value="text"/>
				<form-definition>
					<form>
						<field
							attribute="text"
							fullQualifiedName="tl.demo.projectManagement:Note#text"
							type="tl.core:String"
						/>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="text"
					type="tl.core:String"
				/>
			</attributes>
		</class>
		<class name="ProjectScope">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-folder2"/>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.core:String"
				/>
				<property name="budget"
					type="tl.core:Double"
				/>
				<property name="reportTemplate"
					type="tl.core:Binary"
				/>
				<reference name="members"
					multiple="true"
					type="tl.accounts:Person"
				/>
				<reference name="admins"
					multiple="true"
					type="tl.accounts:Person"
				/>
				<reference name="milestones"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Milestone"
				/>
				<reference name="tickets"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Ticket"
				/>
				<reference name="notes"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Note"
				>
					<annotations>
						<change-subtree include="false"/>
					</annotations>
				</reference>
				<reference name="deliverables"
					composite="true"
					kind="forwards"
					multiple="true"
					ordered="true"
					type="Deliverable"
				/>
			</attributes>
		</class>
		<class name="Prototype">
			<generalizations>
				<generalization type="Deliverable"/>
			</generalizations>
		</class>
		<class name="Report">
			<generalizations>
				<generalization type="Deliverable"/>
			</generalizations>
		</class>
		<class name="Specification">
			<generalizations>
				<generalization type="Deliverable"/>
			</generalizations>
		</class>
		<class name="Ticket">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<instance-presentation icon="css:bi bi-ticket-perforated"/>
				<id-column value="title"/>
				<form-definition>
					<form>
						<field
							attribute="number"
							fullQualifiedName="tl.demo.projectManagement:Ticket#number"
							type="tl.core:Integer"
						/>
						<field
							attribute="title"
							fullQualifiedName="tl.demo.projectManagement:Ticket#title"
							type="tl.core:String"
						/>
						<field
							attribute="description"
							fullQualifiedName="tl.demo.projectManagement:Ticket#description"
							type="tl.model.wysiwyg:Html"
						/>
						<field
							attribute="milestone"
							fullQualifiedName="tl.demo.projectManagement:Ticket#milestone"
							type="tl.demo.projectManagement:Milestone"
						/>
						<field
							attribute="assignee"
							fullQualifiedName="tl.demo.projectManagement:Ticket#assignee"
							type="Contacts:PersonContact"
						/>
						<field
							attribute="watchers"
							fullQualifiedName="tl.demo.projectManagement:Ticket#watchers"
							type="tl.accounts:Person"
						/>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="number"
					type="tl.core:Integer"
				>
					<annotations>
						<default-value>
							<provider class="com.top_logic.element.structured.util.SequenceDefaultProvider"
								sequence-name="tl.demo.projectManagement.Ticket"
							>
								<dynamic-sequence-name class="com.top_logic.element.structured.util.ContextAwareSequenceName"/>
							</provider>
						</default-value>
						<create-visibility value="hidden"/>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<property name="title"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="description"
					type="tl.model.wysiwyg:Html"
				/>
				<reference name="milestone"
					inverse-reference="tickets"
					kind="forwards"
					type="Milestone"
				>
					<annotations>
						<options>
							<options-by-expression function="ticket -> $ticket.container().get(`tl.demo.projectManagement:ProjectScope#milestones`)"/>
						</options>
					</annotations>
				</reference>
				<reference name="assignee"
					type="Contacts:PersonContact"
				>
					<annotations>
						<change-subtree/>
					</annotations>
				</reference>
				<reference name="watchers"
					multiple="true"
					type="tl.accounts:Person"
				/>
			</attributes>
		</class>
	</module>
</model>