<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<!--
			Gitea as a type of git hosting service a git connection may name ("gitea"): the built-in
			connections of an installation and the connections of the tenants to a Gitea server get a
			GiteaHostingProvider with these settings.
		-->
		<config service-class="com.top_logic.factory.git.GitHostingService">
			<instance class="com.top_logic.factory.git.GitHostingService">
				<provider-types>
					<provider-type class="com.top_logic.factory.gitea.GiteaProviderType"
						name="gitea"
						required-approvals="%FACTORY_GITEA_REQUIRED_APPROVALS%"
					/>
				</provider-types>
			</instance>
		</config>
	</services>
</application>
