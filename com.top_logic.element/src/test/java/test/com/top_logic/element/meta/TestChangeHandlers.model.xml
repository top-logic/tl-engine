<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="test.com.top_logic.element.meta.TestChangeHandlers">
			<types>
				<class name="Holder">
					<annotations>
						<table name="PreloadTest"/>
					</annotations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</property>
						<property name="count"
							type="tl.core:Integer"
						>
							<annotations>
								<storage-algorithm>
									<primitive-storage storage-attribute="listOrder"/>
								</storage-algorithm>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</property>
						<reference name="single"
							multiple="false"
							type="Item"
						>
							<annotations>
								<storage-algorithm>
									<foreign-key-storage
										storage-attribute="inline"
										storage-type="PreloadTest"
									/>
								</storage-algorithm>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
						<reference name="others"
							multiple="true"
							type="Item"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
						<reference name="items"
							composite="true"
							multiple="true"
							type="Item"
						>
							<annotations>
								<storage-algorithm>
									<inline-set-storage container-column="containerSet"/>
								</storage-algorithm>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
						<reference name="owned"
							multiple="false"
							type="Item"
						>
							<annotations>
								<storage-algorithm>
									<reverse-foreign-key-storage container-column="inlineReverse"/>
								</storage-algorithm>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
						<property name="plain"
							type="tl.core:String"
						/>
						<property name="log"
							type="tl.core:String"
						/>
					</attributes>
				</class>
				<class name="Sub">
					<generalizations>
						<generalization type="Holder"/>
					</generalizations>
					<annotations>
						<table name="PreloadTest"/>
					</annotations>
					<attributes>
						<property name="name"
							override="true"
							type="tl.core:String"
						>
							<annotations>
								<change-handlers ignore-inherited="true">
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</property>
						<property name="count"
							override="true"
							type="tl.core:Integer"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</property>
						<property name="plain"
							override="true"
							type="tl.core:String"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</property>
					</attributes>
				</class>
				<class name="Item">
					<annotations>
						<table name="PreloadTest"/>
					</annotations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="log"
							type="tl.core:String"
						/>
						<reference name="singleHolders"
							inverse-reference="single"
							kind="backwards"
							multiple="true"
							type="Holder"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
						<reference name="otherHolders"
							inverse-reference="others"
							kind="backwards"
							multiple="true"
							type="Holder"
						>
							<annotations>
								<change-handlers>
									<handler class="test.com.top_logic.element.meta.TestChangeHandlers$Recorder"/>
								</change-handlers>
							</annotations>
						</reference>
					</attributes>
				</class>
			</types>
		</module>
	</modules>
</model>
