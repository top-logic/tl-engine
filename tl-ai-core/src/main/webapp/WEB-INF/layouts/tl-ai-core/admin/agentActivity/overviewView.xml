<?xml version="1.0" encoding="utf-8" ?>

<!--
	Überblick: five numbers over the two charts that say whether those numbers are getting better or
	worse.
	
	The numbers are tiles rather than a free grid of widgets, because that is what the framework has:
	a tile group replaces the area it occupies and builds a breadcrumb when a tile is opened, and
	there is no component that arranges independent widgets next to each other. Making the numbers
	navigable is what turns that constraint into the design - "2 Läufe laufen" is only useful if the
	next click shows which two. The count itself is written by the tile description expression as
	HTML, because that is the only slot of ModelBasedTilePreview that takes a TL-Script expression;
	style/agentActivity.css gives it the size a KPI has to have to be read at a glance.
	
	The tile navigator keeps its own band of the split, so drilling into a tile replaces that band
	and leaves the trend charts visible below the rows that explain them. That band cannot shrink to
	the height of the cards: it also has to hold a table once a tile is opened, so it is sized for
	the table and the cards leave some air under them. The split is draggable either way.
	
	One period control at the top governs the whole tab: the three counting tiles, the two charts and
	the tables behind those tiles all read the period it publishes as their model. It sits above the
	tile band rather than inside a panel because it belongs to none of them - a control per panel
	would let five numbers on one screen state five different periods. The two current-state tiles,
	"Läuft jetzt" and "Wartet auf einen Menschen", are not windowed and ignore it; a period on a
	count of what is happening right now would suggest a meaning it does not have.
	
	Everything here is evaluated when it is rendered. There is no auto-refresh anywhere in this view;
	each table behind a tile carries an Aktualisieren command, and re-entering the tab or changing
	the period re-evaluates the tiles and both charts.
	
	No cost tile of its own: the cost of the period is a line of the token tile (#722). It is what the
	runs recorded - their tokens times the catalog's or the administrator's prices, in the currency
	and at the rate the <budget> of AgentPolicyService names - and never a rate guessed here.
-->
<securityLayout name="aiAgentOverviewView"
	titleKey="admin.ai.agentActivity.overview.tabber"
	useDefaultChecker="false"
>
	<tabInfo label="admin.ai.agentActivity.overview.tabber"/>
	<components>
		<layout name="aiAgentOverviewLayout"
			horizontal="false"
			resizable="true"
		>
			<components>
				<include name="tl-ai-core/admin/agentActivity/periodSelector.xml"
					rangeName="aiOverviewPeriod"
					selectorName="aiOverviewPeriodSelector"
				/>
				<!--
					The root tile takes the period as its model only in order to be redrawn by it. A
					tile preview is written during the repaint of the tile control and registers no
					listener of its own, so the repaint has to be asked for; setting a component's
					model ends in LayoutComponent.invalidate(), and this is the component of the
					tile chain whose control is a ComponentWrappingControl, which is the one that
					listens for that and repaints. The group below it renders through a plain
					LayoutControlAdapter, which does not - a model on the group has no effect. The
					previews read the period themselves, off the same channel.
				-->
				<component class="com.top_logic.mig.html.layout.tiles.RootTileComponent"
					model="model(aiOverviewPeriod)"
					name="aiAgentOverviewRootTile"
					titleKey="admin.ai.agentActivity.overview.title"
				>
					<layoutInfo size="32%"/>
					<!--
						The toolbar carries the drill-down breadcrumb rather than a fixed title:
						opening a tile replaces this half of the tab, so without it a reader has no
						way of telling which number they are looking at the rows of.
					-->
					<title class="com.top_logic.mig.html.layout.tiles.breadcrumb.RootTileBreadcrumbControlProvider">
						<renderer class="com.top_logic.layout.tree.breadcrumb.DefaultBreadcrumbRenderer">
							<contentRenderer class="com.top_logic.layout.tree.breadcrumb.BreadcrumbContentRenderer"
								resource-provider="com.top_logic.mig.html.layout.tiles.breadcrumb.RootTileBreadcrumbControlProvider$BreadcrumbNodeResourceProvider"
								root-icon="theme:ICON_HOME"
								separator-icon="theme:com.top_logic.knowledge.gui.layout.tree.Icons.PL"
								separator-label="%BREADCRUMB_SEPARATOR_LABEL%"
							/>
						</renderer>
					</title>
					<component class="com.top_logic.mig.html.layout.tiles.GroupTileComponent"
						name="aiAgentOverviewTiles"
						securityObject="securityRoot"
						titleKey="admin.ai.agentActivity.overview.title"
					>
						<components>
							<include name="tl-ai-core/admin/agentActivity/overview/runningTile.xml"/>
							<include name="tl-ai-core/admin/agentActivity/overview/waitingTile.xml"/>
							<include name="tl-ai-core/admin/agentActivity/overview/errorsTile.xml"/>
							<include name="tl-ai-core/admin/agentActivity/overview/runsTile.xml"/>
							<include name="tl-ai-core/admin/agentActivity/overview/tokensTile.xml"/>
						</components>
					</component>
				</component>
				<layout name="aiAgentOverviewChartRow"
					horizontal="true"
					resizable="true"
				>
					<components>
						<include name="tl-ai-core/admin/agentActivity/charts/runsPerDayChart.xml"/>
						<include name="tl-ai-core/admin/agentActivity/charts/topAgentsChart.xml"/>
					</components>
				</layout>
			</components>
		</layout>
	</components>
</securityLayout>