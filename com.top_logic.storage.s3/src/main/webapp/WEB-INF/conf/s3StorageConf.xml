<?xml version="1.0" encoding="utf-8"?>

<!-- Settings of S3 blob stores, overridable through environment variables. -->
<root>
	<alias>
		<!-- URL of the S3 service; empty for AWS S3. -->
		<entry name="%S3_ENDPOINT%"               value="${env:tl_s3_endpoint:}" />
		<entry name="%S3_REGION%"                 value="${env:tl_s3_region:us-east-1}" />
		<entry name="%S3_BUCKET%"                 value="${env:tl_s3_bucket:}" />
		<entry name="%S3_PREFIX%"                 value="${env:tl_s3_prefix:}" />
		<!-- Self-hosted servers such as MinIO usually require path-style access. -->
		<entry name="%S3_PATH_STYLE_ACCESS%"      value="${env:tl_s3_path_style_access:false}" />

		<!--
			Access key and secret key; both empty to use the default credentials provider chain of the AWS SDK
			(environment variables, ~/.aws/credentials, IAM role). The secret is given encrypted, or as plain
			text with the prefix "unencrypted:".
		-->
		<entry name="%S3_ACCESS_KEY%"             value="${env:tl_s3_access_key:}" />
		<entry name="%S3_SECRET%"                 value="${env:tl_s3_secret:unencrypted:}" />

		<!-- One of "none", "sse-s3", "sse-kms". -->
		<entry name="%S3_SERVER_SIDE_ENCRYPTION%" value="${env:tl_s3_server_side_encryption:sse-s3}" />
		<entry name="%S3_KMS_KEY_ID%"             value="${env:tl_s3_kms_key_id:}" />
	</alias>

	<properties>
	</properties>
</root>
