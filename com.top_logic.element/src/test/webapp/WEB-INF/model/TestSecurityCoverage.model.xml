<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestSecurityCoverage">
			<types>
				<!-- Role rule and read grant: completely covered. -->
				<class name="Covered">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
						<reference name="children"
							composite="true"
							multiple="true"
							type="ChildOfCovered"
						/>
						<reference name="parts"
							composite="true"
							multiple="true"
							type="PartOfCovered"
						/>
						<reference name="explicitParts"
							composite="true"
							multiple="true"
							type="ExplicitPart"
						/>
					</attributes>
				</class>

				<!-- Composition part without any definition: delegates to its container by default. -->
				<class name="PartOfCovered">
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<reference name="subs"
							composite="true"
							multiple="true"
							type="SubPart"
						/>
					</attributes>
				</class>

				<!-- Composition part of a composition part: delegates along the chain of containers. -->
				<class name="SubPart"/>

				<!--
					Configured access parent: the composition holding it, navigated backwards. A role
					rule applies to it as well, which the access parent shadows.
				-->
				<class name="ExplicitPart">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<!-- Configured access parent: its own to-one reference, navigated forwards. -->
				<class name="Linked">
					<attributes>
						<reference name="target"
							type="Covered"
						/>
					</attributes>
				</class>

				<!-- Decides for itself instead of inheriting the access parent of its generalization. -->
				<class name="LinkedSub">
					<generalizations>
						<generalization type="Linked"/>
					</generalizations>
				</class>

				<!--
					Configured access parent: the container, whichever composition holds it. A role
					rule applies to it as well, which the access parent shadows.
				-->
				<class name="AnyContainerPart">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<!-- Composition part deciding for itself instead of delegating to its container. -->
				<class name="SelfDeciding"/>

				<!--
					Owner and part of the same to-one composition: the configured kind of access parent
					tells the navigation backwards to the container from the one forwards to the part.
				-->
				<class name="Recursive">
					<attributes>
						<reference name="detail"
							composite="true"
							type="Recursive"
						/>
					</attributes>
				</class>

				<!--
					Configured access parent leading from one object of the type to another: two
					objects pointing at each other form a cycle.
				-->
				<class name="Cyclic">
					<attributes>
						<reference name="next"
							type="Cyclic"
						/>
					</attributes>
				</class>

				<!-- Inherits the role rule and the grant of its generalization. -->
				<class name="CoveredSub">
					<generalizations>
						<generalization type="Covered"/>
					</generalizations>
				</class>

				<!-- Role source is a role parent rule pointing to the container. -->
				<class name="ChildOfCovered"/>

				<!-- Neither a role source nor a container. -->
				<class name="Orphan"/>

				<!-- Contained in one composition: delegates to its container by default. -->
				<class name="SingleContained"/>

				<!-- Contained in two compositions: delegates to whichever container holds it. -->
				<class name="DoubleContained"/>

				<class name="Container">
					<attributes>
						<reference name="singles"
							composite="true"
							multiple="true"
							type="SingleContained"
						/>
						<reference name="doublesA"
							composite="true"
							multiple="true"
							type="DoubleContained"
						/>
						<reference name="anys"
							composite="true"
							multiple="true"
							type="AnyContainerPart"
						/>
						<reference name="selfs"
							composite="true"
							multiple="true"
							type="SelfDeciding"
						/>
					</attributes>
				</class>

				<class name="OtherContainer">
					<attributes>
						<reference name="doublesB"
							composite="true"
							multiple="true"
							type="DoubleContained"
						/>
					</attributes>
				</class>

				<!-- Read is granted to a role that no rule delivers on this type. -->
				<class name="DeadGrant">
					<attributes>
						<reference name="owner"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<!--
					Read is granted to a role that no rule delivers, but that a test assigns
					directly on an object of this type.
				-->
				<class name="DirectlyAssigned"/>

				<!-- Excluded from access control: no finding despite the missing definitions. -->
				<class name="Unsecured"/>

				<!-- Used by the application's code only: no finding despite the missing definitions. -->
				<class name="Internal"/>

				<!-- Internal by the mark of its generalization. -->
				<class name="InternalSub">
					<generalizations>
						<generalization type="Internal"/>
					</generalizations>
				</class>
			</types>
		</module>

		<!-- Internal as a whole, by the mark of the module. -->
		<module name="TestSecurityCoverageInternal">
			<types>
				<class name="InModule"/>

				<!-- Internal by the module, and by a mark of its own. -->
				<class name="MarkedInModule"/>

				<!-- Internal by the module, and by the mark of its generalization. -->
				<class name="InternalSubInModule">
					<generalizations>
						<generalization type="TestSecurityCoverage:Internal"/>
					</generalizations>
				</class>
			</types>
		</module>

		<!-- Analyzed only when the module is not excluded. -->
		<module name="TestSecurityCoverageExcluded">
			<types>
				<class name="Ignored"/>
			</types>
		</module>
	</modules>
</model>