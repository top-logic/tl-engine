<?xml version="1.0" encoding="utf-8" ?>

<!--
	Overlay contributing the passkeys of the account to the security tab of the settings dialog of
	tl-layout-view (WEB-INF/views/settings-tabs.view.xml): a same-path overlay, placing them where
	the usage of the passkeys (option usage of the PasskeyService) puts them. Each place is wrapped
	in an <if-passkey-usage>, so the application shows only the one of its usage:
	
	- usage login: the section passkey-login-section of its own in the column of sections, the
	<stack config:ref="security-sections">, right after the section password-section, since a
	passkey is a way to sign in beside the password;
	- usage second-factor: the block passkeys in the column of the second factor methods, the
	<stack config:ref="two-factor-methods">, after the block of the authenticator app.
	
	Both are built like their neighbors: a heading, a line saying what a passkey does there, then
	the list of the passkeys with the button adding one (passkey-list.view.xml, shared by both).
-->
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<channels>
		<!-- A passkey added or deleted changes the second factors of the account. -->
		<derived-channel name="secondFactors"
			config:operation="update"
			observed-types="tl.accounts:Person, tl.security.passkey:Passkey"
		/>
	</channels>
	<stack config:ref="security-sections">
		<if-passkey-usage id="passkey-login-section"
			config:position="after"
			config:reference="password-section"
			usage="login"
		>
			<stack
				align="stretch"
				direction="column"
				gap="compact"
			>
				<text variant="title">
					<label>
						<en>Sign in with passkey</en>
						<de>Anmelden mit Passkey</de>
					</label>
				</text>
				<text>
					<label>
						<en>A passkey signs you in without user name and password, confirmed by your fingerprint, face or PIN.</en>
						<de>Ein Passkey meldet Sie ohne Benutzername und Passwort an, bestätigt mit Fingerabdruck, Gesicht oder PIN.</de>
					</label>
				</text>
				<view-ref view="passkey-list.view.xml">
					<bind
						channel="account"
						to="account"
					/>
				</view-ref>
			</stack>
		</if-passkey-usage>
	</stack>
	<stack config:ref="two-factor-methods">
		<if-passkey-usage id="passkeys"
			usage="second-factor"
		>
			<stack
				align="stretch"
				direction="column"
				gap="compact"
			>
				<text variant="label">
					<label>
						<en>Passkeys</en>
						<de>Passkeys</de>
					</label>
				</text>
				<text>
					<label>
						<en>A passkey confirms your login after the password, with your fingerprint, face or PIN.</en>
						<de>Ein Passkey bestätigt Ihre Anmeldung nach dem Passwort, mit Fingerabdruck, Gesicht oder PIN.</de>
					</label>
				</text>
				<view-ref view="passkey-list.view.xml">
					<bind
						channel="account"
						to="account"
					/>
				</view-ref>
			</stack>
		</if-passkey-usage>
	</stack>
</view>