<?xml version="1.0" encoding="utf-8" ?>

<!--
	Second frame of the project drill-down: the home of the project the frame was opened for. Its
	tabs show the project itself and its milestones, the latter embedded as a view of its own so
	that a display target can reveal that tab within this frame.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="milestone"/>
	</channels>

	<tab-bar active-tab="overview">
		<tabs>
			<tab id="overview"
				icon="css:bi bi-info-circle"
			>
				<label>
					<en>Overview</en>
					<de>Überblick</de>
				</label>
				<panel>
					<title>
						<en>Project</en>
						<de>Projekt</de>
					</title>
					<form input="project">
						<field attribute="name"/>
						<field attribute="description"/>
					</form>
				</panel>
			</tab>
			<tab id="milestones"
				icon="css:bi bi-flag"
			>
				<label>
					<en>Milestones</en>
					<de>Meilensteine</de>
				</label>
				<view-ref view="projects/milestone-list.view.xml">
					<bind
						channel="project"
						to="project"
					/>
					<bind
						channel="milestone"
						to="milestone"
					/>
				</view-ref>
			</tab>
		</tabs>
	</tab-bar>
</view>