<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
				   	<module key="com.top_logic.security.auth.pac4j.config.Pac4jConfigFactory$Module" value="true"/>
				</modules>
			</instance>
		</config>
	
        <config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles >
					<bundle name="tlPac4jMessages"/>
				</bundles>
			</instance>
		</config>

		<config service-class="com.top_logic.security.auth.pac4j.config.Pac4jConfigFactory">
			<instance class="com.top_logic.security.auth.pac4j.config.Pac4jConfigFactory">
				<callback-url>%PAC_CALLBACK_URL%</callback-url>
				<callback-url-absolute>%PAC_CALLBACK_ABSOLUTE%</callback-url-absolute>
			</instance>
		</config>

		<!--
			An identity at an external login is accessed as a part of its account: reading it is
			reading the account. Whoever may read an account sees its identities.
		-->
		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="tl.security.pac4j:OidcIdentity">
						<access-parent>
							<container reference="tl.accounts:Person#oidcIdentities"/>
						</access-parent>
					</class>
				</security-config>
			</instance>
		</config>
	</services>
	
	<configs>
		<config config:interface="com.top_logic.basic.db.schema.setup.config.ApplicationTypes">
			<type-systems>
				<type-system name="Default">
					<declarations>
						<declaration resource="webinf://kbase/tl.security.pac4j.Meta.xml"/>
					</declarations>
				</type-system>
			</type-systems>
		</config>

		<config config:interface="com.top_logic.base.accesscontrol.ExternalAuthentication"
			isEnabled="true"
			reuseSession="true"
		/>

		<!-- Surface one external login method per configured pac4j SSO client in login UIs. -->
		<config config:interface="com.top_logic.base.accesscontrol.loginmethod.LoginMethodConfig">
			<providers>
				<provider class="com.top_logic.security.auth.pac4j.login.Pac4jLoginMethodProvider"/>
			</providers>
		</config>
	</configs>
</application>
