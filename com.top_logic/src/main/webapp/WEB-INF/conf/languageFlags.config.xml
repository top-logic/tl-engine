<?xml version="1.0" encoding="utf-8" ?>

<!--
	The flag each language is labelled with.

	A language is not a country, so an entry states a convention: the flag of the country the
	language is most widely associated with, of the area it is spoken across where no single country
	carries it (Arabic), and the fallback flag where neither applies (Esperanto). An application
	that disagrees overrides the entry it disagrees with, and adds one for a language not listed.

	A region appears as an entry of its own only to be available when an application supports that
	region as a language in its own right; an application offering plain German never reaches the
	de-AT entry, because the lookup prefers language and region over language alone.
-->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
					<module key="com.top_logic.util.LanguageFlags$Module"
						value="true"
					/>
				</modules>
			</instance>
		</config>

