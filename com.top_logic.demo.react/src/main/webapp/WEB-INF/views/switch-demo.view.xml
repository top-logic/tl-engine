<?xml version="1.0" encoding="utf-8" ?>

<!--
	Demonstrates the declarative <switch> element: the detail pane (right) renders an
	input-dependent view of the selected Demo object. A high-priority object shows a <tab-bar>
	(Details + More), everything else a single detail form. Selecting rows of different priority
	re-evaluates the switch and swaps the view.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="selectedDemo"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="220"
				size="35"
				unit="%"
			>
				<panel>
					<title>
						<en>Demo objects</en>
						<de>Demo-Objekte</de>
					</title>
					<commands>
						<generic-command
							image="css:bi bi-magic"
							placement="TOOLBAR"
						>
							<label>
								<en>Generate samples</en>
								<de>Beispiele erzeugen</de>
							</label>
							<with-transaction>
								<execute-script function="x -> count(6).foreach(i -> { o = new(`demo.react:Demo`, transient: false); $o.set(`demo.react:Demo#name`, 'Sample ' + ($i + 1)); $o.set(`demo.react:Demo#string`, 'Value ' + ($i + 1)); $o.set(`demo.react:Demo#active`, $i % 2 == 0); $o.set(`demo.react:Demo#amount`, ($i + 1) * 12.5); $o.set(`demo.react:Demo#date`, date(2026, ($i % 12) + 1, ($i % 28) + 1)); $o.set(`demo.react:Demo#priority`, if($i % 3 == 0, `demo.react:Priority#low`, if($i % 3 == 1, `demo.react:Priority#medium`, `demo.react:Priority#high`))); $o; })"/>
							</with-transaction>
						</generic-command>
						<generic-command
							clique="more"
							image="css:bi bi-trash"
							input="selectedDemo"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<with-transaction>
								<execute-script function="obj -> { if($obj != null, $obj.delete(), null); null; }"/>
							</with-transaction>
							<write-channel name="selectedDemo"/>
						</generic-command>
					</commands>
					<table
						observed-types="demo.react:Demo"
						selection="selectedDemo"
						types="demo.react:Demo"
					>
						<columns>
							<column attribute="name"/>
							<column attribute="priority"/>
						</columns>
						<rows>all(`demo.react:Demo`)</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="65"
				unit="%"
			>
				<panel>
					<title>
						<en>Detail (input-dependent)</en>
						<de>Detail (eingabeabhängig)</de>
					</title>
					<switch input="selectedDemo">
						<case test="d -> $d != null &amp;&amp; $d.get(`demo.react:Demo#priority`) != null &amp;&amp; $d.get(`demo.react:Demo#priority`).get(`tl.model:TLNamedPart#name`) == 'high'">
							<tab-bar active-tab="details">
								<tab id="details"
									icon="css:bi bi-card-list"
								>
									<label>
										<en>Details</en>
										<de>Details</de>
									</label>
									<inset>
										<form
											input="selectedDemo"
											withEditMode="false"
										>
											<field attribute="name"/>
											<field attribute="string"/>
											<field attribute="priority"/>
											<field attribute="active"/>
										</form>
									</inset>
								</tab>
								<tab id="more"
									icon="css:bi bi-list-ul"
								>
									<label>
										<en>More</en>
										<de>Mehr</de>
									</label>
									<inset>
										<form
											input="selectedDemo"
											withEditMode="false"
										>
											<field attribute="count"/>
											<field attribute="amount"/>
											<field attribute="date"/>
											<field attribute="owner"/>
										</form>
									</inset>
								</tab>
							</tab-bar>
						</case>
						<default>
							<form
								input="selectedDemo"
								withEditMode="false"
							>
								<field attribute="name"/>
								<field attribute="string"/>
								<field attribute="priority"/>
								<field attribute="active"/>
							</form>
						</default>
					</switch>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>
