<?xml version="1.0" encoding="utf-8" ?>

<!--
	Revision / audit monitor: the recent commits across all users as a single sortable, filterable
	table. Rows are tl.changelog:ChangeSet model objects (also shown by the "My latest changes"
	dialog) produced by the changeLog() TL-Script function; the global, system-wide log is requested
	by passing no object and a maximum entry count. The revision column shows the commit number as a
	number, so that it sorts numerically, written without grouping separators by its format
	annotation; date, author and message are the ChangeSet attributes. Any model change re-evaluates
	the rows, so a new commit appears without reopening the view. Activating a row opens a dialog
	listing what the commit changed. A <full-page> hosts the table:
	the enclosing tab already labels the view, so no panel title is rendered and the table fills the
	whole area.
-->
<view>
	<full-page>
		<table
			observed-types="tl.model:TLObject"
			types="tl.changelog:ChangeSet"
		>
			<columns>
				<computed-column name="revision"
					sort="DESC"
					type="tl.core:Long"
				>
					<label>
						<en>Revision</en>
						<de>Revision</de>
					</label>
					<annotations>
						<format>
							<decimal pattern="0"/>
						</format>
					</annotations>
					<value><![CDATA[cs -> $cs.get(`tl.changelog:ChangeSet#revision`).get(`tl.core:Revision#revision`)]]></value>
				</computed-column>
				<column attribute="date"/>
				<column attribute="author"/>
				<column attribute="message"/>
			</columns>
			<rows>changeLog(null, 50)</rows>
			<on-activate class="com.top_logic.layout.view.command.GenericViewCommand"
				image="css:bi bi-list-ul"
			>
				<label>
					<en>Show changes</en>
					<de>Änderungen anzeigen</de>
				</label>
				<open-dialog
					bind-input-to="changeSet"
					close-on-backdrop="true"
					dialog-view="admin/monitoring/revision-details.view.xml"
				/>
			</on-activate>
		</table>
	</full-page>
</view>