<?xml version="1.0" encoding="utf-8" ?>

<view>
	<tab-bar active-tab="project">
		<tabs>
			<tab id="project">
				<visibility
					expr="$object.instanceOf(`TestViewModelAccess:Project`)"
					inputs="object"
				/>
				<access-control
					inputs="object"
					object="$object"
					operation="Read"
					type="TestViewModelAccess:Project"
				/>
				<panel/>
			</tab>
			<tab id="value">
				<visibility
					expr="$object"
					inputs="object"
				/>
				<panel/>
			</tab>
			<tab id="open">
				<panel/>
			</tab>
		</tabs>
	</tab-bar>
</view>