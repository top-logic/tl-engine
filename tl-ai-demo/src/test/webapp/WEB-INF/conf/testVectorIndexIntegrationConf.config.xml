<?xml version="1.0" encoding="utf-8"?>
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.knowledge.indexing.IndexingService">
			<instance class="com.top_logic.ai.vector.index.VectorIndexingService">
				<protocols>
					<protocol value="knowledgerepository" />
					<protocol value="knowledge" />
					<protocol value="repository" />
				</protocols>
				<meta-objects>
					<meta-object value="Document" />
					<meta-object value="GenericObject" />
					<meta-object value="luigis.pizzashop:Product" />
				</meta-objects>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.vector.index.VectorIndex" config:override="true">
			<instance class="com.top_logic.ai.vector.index.VectorIndex"
				local-store-path="${tl_basic_tmp}/test-jvector"
				vector-store-type="jvector"
				vector-index-models="luigis.pizzashop:Product"
				mistral-embed-model="mistral-embed"
				mistral-api-key="XXXX-XXXX-XXXX-XXXX"
				embedding-model-type="mistral"
			/>
		</config>
	</services>
	
	<configs>
		<config config:interface="com.top_logic.ai.vector.index.VectorIndex$VectorIndexingConfig"
			local-store-path="${tl_basic_tmp}/test-jvector"
			vector-store-type="jvector"
			vector-index-models="luigis.pizzashop:Product"
			mistral-embed-model="mistral-embed"
			mistral-api-key="XXXX-XXXX-XXXX-XXXX"
			embedding-model-type="mistral"
		/>
	</configs>
</application>
