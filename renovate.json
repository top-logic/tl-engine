{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "maven",
    "npm"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "constraints": {
    "npm": "11.19.0"
  },
  "postUpdateOptions": [
    "npmDedupe"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@tiptap/**"
      ],
      "groupName": "tiptap"
    }
  ]
}
