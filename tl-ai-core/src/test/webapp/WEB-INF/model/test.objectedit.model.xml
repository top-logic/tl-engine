<?xml version="1.0" encoding="utf-8" ?>

<!--
	Objects made of parts, for TestObjectEditTool.

	tl-ai-core's own model has no composition, and createObject has to be tested on the shapes one
	takes: a mandatory one (an order does not exist without its lines), an optional one, one that
	holds a single part, one whose parts come in several kinds (an abstract target type), and one that
	nests without end (folders in folders).
-->
<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="test.objectedit">
		<class name="Order">
			<attributes>
				<property name="number"
					mandatory="true"
					type="tl.core:String"
				/>
				<reference name="lines"
					composite="true"
					kind="forwards"
					mandatory="true"
					multiple="true"
					navigate="true"
					ordered="true"
					type="OrderLine"
				/>
			</attributes>
		</class>
		<class name="OrderLine">
			<attributes>
				<property name="product"
					mandatory="true"
					type="tl.core:String"
				/>
				<property name="quantity"
					type="tl.core:Integer"
				/>
			</attributes>
		</class>
		<class name="Folder">
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<reference name="documents"
					composite="true"
					kind="forwards"
					multiple="true"
					navigate="true"
					ordered="true"
					type="Document"
				/>
				<reference name="cover"
					composite="true"
					kind="forwards"
					navigate="true"
					type="Cover"
				/>
				<reference name="folders"
					composite="true"
					kind="forwards"
					multiple="true"
					navigate="true"
					type="Folder"
				/>
			</attributes>
		</class>
		<interface name="Document">
			<attributes>
				<property name="title"
					mandatory="true"
					type="tl.core:String"
				/>
			</attributes>
		</interface>
		<class name="Letter">
			<generalizations>
				<generalization type="Document"/>
			</generalizations>
		</class>
		<class name="Memo">
			<generalizations>
				<generalization type="Document"/>
			</generalizations>
		</class>
		<class name="Cover">
			<attributes>
				<property name="text"
					type="tl.core:String"
				/>
				<property name="caption"
					type="tl.model.i18n:I18NString"
				/>
			</attributes>
		</class>
	</module>
</model>
