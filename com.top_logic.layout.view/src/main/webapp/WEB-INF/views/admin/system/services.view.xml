<?xml version="1.0" encoding="utf-8" ?>

<!--
	Services management as a drill-down: the initial frame lists the application services (runtime
	modules) and starts / stops / restarts the selected one (services/overview.view.xml); activating
	a row pushes the detail frame of that service (services/service-detail.view.xml), which shows
	and edits its configuration.
	- The serviceNavPath channel holds the drill-down path; the breadcrumb ("Services > <service>")
	is raised into the app bar of the shell with <slot-content to="appbar-content">. Every frame
	sees the path as navPath (bind-path-to), so the detail frame offers a "Back" command.
	- The services channel holds the ServiceSnapshot the overview table displays. It is bound into
	every frame, so that a command of the detail frame (save, reset, restart) writes a new snapshot
	the covered overview frame shows when the user comes back to it.
	- The <frame id="service"> declaration is the detail frame the overview pushes (frame="service").
	It puts the frame into the address bar as .../service/<implementation class name>, and names
	its crumb by the service label.
-->
<view>
	<channels>
		<channel name="services"/>
		<channel name="serviceNavPath"/>
	</channels>

	<stack>
		<slot-content to="appbar-content">
			<tile-breadcrumb path="serviceNavPath">
				<home-label>
					<en>Services</en>
					<de>Dienste</de>
				</home-label>
			</tile-breadcrumb>
		</slot-content>

		<tile-stack
			bind-path-to="navPath"
			initial="admin/system/services/overview.view.xml"
			path="serviceNavPath"
		>
			<bindings>
				<bind
					channel="services"
					to="services"
				/>
			</bindings>
			<frame id="service"
				route="service/:module"
				view="admin/system/services/service-detail.view.xml"
			>
				<param name="module"
					expr="serviceName($module)"
					reverse="serviceByName($value)"
				/>
				<label class="com.top_logic.layout.view.tiles.ScriptedTileLabel"
					expr="serviceLabel($module)"
					inputs="module"
				/>
			</frame>
		</tile-stack>
	</stack>
</view>