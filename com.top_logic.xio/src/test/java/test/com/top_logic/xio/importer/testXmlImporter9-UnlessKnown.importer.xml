<handler>
	<tag name="data">
		<resolve-existing
			key="x -> $x.get(`test.com.top_logic.xio.importer.test9:Item#extId`)"
			objects="c -> $c.get(`test.com.top_logic.xio.importer.test9:Container#elements`)"
		>
			<dispatch>
				<tag name="item">
					<unless-known id-attribute="id">
						<object model-type="test.com.top_logic.xio.importer.test9:Item" id-attribute="id">
							<property name="extId" xml-attribute="id"/>
							<property name="name" xml-attribute="name"/>
							<reference name="other" id-attribute="other" ignore-unresolved="true"/>
							<multi-reference name="others" id-attribute="others" ignore-unresolved="true"/>
							<linking>
								<list-linking name="test.com.top_logic.xio.importer.test9:Container#elements"/>
							</linking>
							<dispatch>
								<tag name="child">
									<object model-type="test.com.top_logic.xio.importer.test9:Item" id-attribute="id">
										<property name="extId" xml-attribute="id"/>
										<linking>
											<list-linking name="test.com.top_logic.xio.importer.test9:Item#children"/>
										</linking>
										<dispatch/>
									</object>
								</tag>
							</dispatch>
						</object>
					</unless-known>
				</tag>
				<tag name="update">
					<object-ref id-attribute="ref" ignore-unresolved="true">
						<property name="note" xml-attribute="note"/>
						<dispatch/>
					</object-ref>
				</tag>
				<tag name="strict-update">
					<object-ref id-attribute="ref">
						<property name="note" xml-attribute="note"/>
						<dispatch/>
					</object-ref>
				</tag>
				<tag name="strict-item">
					<object model-type="test.com.top_logic.xio.importer.test9:Item">
						<reference name="other" id-attribute="other"/>
						<multi-reference name="others" id-attribute="others"/>
						<linking>
							<list-linking name="test.com.top_logic.xio.importer.test9:Container#elements"/>
						</linking>
						<dispatch/>
					</object>
				</tag>
			</dispatch>
		</resolve-existing>
	</tag>
</handler>
