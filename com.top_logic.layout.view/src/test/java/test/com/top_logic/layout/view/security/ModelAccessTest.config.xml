<?xml version="1.0" encoding="utf-8" ?>

<application>
	<services>
		<config service-class="com.top_logic.util.model.ModelService">
			<instance>
				<declarations>
					<declaration file="/WEB-INF/model/TestViewModelAccess.model.xml"/>
					<declaration file="/WEB-INF/model/TestViewObjectFields.model.xml"/>
					<declaration file="/WEB-INF/model/TestViewFallbackStorage.model.xml"/>
					<declaration file="/WEB-INF/model/TestViewCheckDependencies.model.xml"/>
				</declarations>
			</instance>
		</config>

		<!-- The explanation of an attribute of the test model, for the tests of attribute descriptions. -->
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.TestViewModelAccess.messages"/>
				</bundles>
			</instance>
		</config>

		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="TestViewModelAccess.Responsible"/>
					<role name="TestViewModelAccess.Reader"/>
					<role name="TestViewModelAccess.Viewer"/>
					<role name="TestViewModelAccess.Finisher"/>
					<role name="TestViewModelAccess.NameReader"/>
					<role name="TestViewModelAccess.NameKeeper"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<class name="TestViewModelAccess:Project">
						<operations>
							<operation name="Finish"/>
						</operations>
						<!-- The responsible may do everything with a project. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Create"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Delete"
							roles="TestViewModelAccess.Responsible"
						/>
						<!-- The responsible and the finisher may finish a project (a custom command group). -->
						<grant
							operation="Finish"
							roles="TestViewModelAccess.Responsible,TestViewModelAccess.Finisher"
						/>
						<!-- The viewer may only read a project. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Viewer"
						/>
					</class>
					<class name="TestViewModelAccess:Task">
						<!-- The responsible of a project may do everything with its tasks. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Create"
							roles="TestViewModelAccess.Responsible"
						/>
						<grant
							operation="Delete"
							roles="TestViewModelAccess.Responsible"
						/>
					</class>
					<!--
						A step of a project is decided by the project. Whoever may read a step may finish
						it, see TestTypeLevelPolicy.
					-->
					<class name="TestViewModelAccess:Step">
						<operations>
							<operation name="Finish"
								implied-by="Read"
							/>
						</operations>
						<access-parent>
							<container/>
						</access-parent>
					</class>
					<!-- An item of a step is decided by the step. -->
					<class name="TestViewModelAccess:Item">
						<access-parent>
							<container/>
						</access-parent>
					</class>
					<!--
						The deliverables of a project decide for themselves: the responsible creates
						specs, no role creates plans or archive entries.
					-->
					<class name="TestViewModelAccess:Deliverable">
						<access-parent>
							<self/>
						</access-parent>
					</class>
					<class name="TestViewModelAccess:Spec">
						<grant
							operation="Create"
							roles="TestViewModelAccess.Responsible"
						/>
					</class>
					<class name="TestViewModelAccess:Archive">
						<access-parent>
							<self/>
						</access-parent>
					</class>
					<!--
						The milestones of a project and the notes of a category have no configuration:
						as composition parts without a role source, they are decided by their
						container.
					-->
					<!--
						An annex delegates Read to its project and decides Write by its own grant, see
						TestTypeLevelPolicy.
					-->
					<class name="TestViewModelAccess:Annex">
						<access-parent>
							<target
								operations="Read"
								reference="TestViewModelAccess:Annex#project"
							/>
						</access-parent>
						<grant
							operation="Write"
							roles="TestViewModelAccess.Finisher"
						/>
					</class>
					<!--
						An attachment is decided by the category holding it, and delegates Read to every
						annex referring to it as well, see TestTypeLevelPolicy.
					-->
					<class name="TestViewModelAccess:Attachment">
						<access-parent>
							<any-of>
								<container/>
								<referer
									operations="Read"
									reference="TestViewModelAccess:Annex#attachments"
								/>
							</any-of>
						</access-parent>
					</class>
					<!-- A remark is decided by an access parent whose type is not known statically. -->
					<class name="TestViewModelAccess:Remark">
						<access-parent>
							<script expr="r -> $r.container()"/>
						</access-parent>
					</class>
					<class name="TestViewModelAccess:Category">
						<!-- A category may only be read, by its reader. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Reader"
						/>
						<!--
							The viewer of a project discovers its category without reading it: a
							discover-only object for the tests of labels computed unsecured.
						-->
						<grant
							operation="Discover"
							roles="TestViewModelAccess.Viewer"
						/>
					</class>
					<class name="TestViewModelAccess:Named">
						<grant
							inherit="true"
							operation="Read"
							roles="TestViewModelAccess.NameReader"
						/>
						<grant
							inherit="true"
							operation="Write"
							roles="TestViewModelAccess.NameReader"
						/>
					</class>
					<!-- NameKeeper may discover a DiscoverNamed and thereby read its name. -->
					<class name="TestViewModelAccess:DiscoverNamed"
						discover-attributes="name"
					>
						<grant
							operation="Discover"
							roles="TestViewModelAccess.NameKeeper"
						/>
					</class>
					<part name="TestViewModelAccess:Foo#name">
						<!-- Applies to Foo only, not to Bar sharing the attribute definition. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.NameKeeper"
						/>
						<grant
							operation="Write"
							roles="TestViewModelAccess.NameKeeper"
						/>
					</part>
					<part name="TestViewModelAccess:Category#name">
						<!--
							The reader of a category may rename it, although the category grants writing
							to no role.
						-->
						<grant
							operation="Write"
							roles="TestViewModelAccess.Reader"
						/>
					</part>
					<part name="TestViewModelAccess:Project#secret">
						<!--
							Present grant with no roles: writing this attribute is denied for every
							role, only a bypassing super-user may write it.
						-->
						<grant operation="Write"/>
					</part>
					<part name="TestViewModelAccess:Project#budget">
						<!-- Only the responsible of the project may read its budget. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
					</part>
					<part name="TestViewModelAccess:Project#approved">
						<!-- Only the responsible of the project may see whether it is approved. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
					</part>
					<part name="TestViewModelAccess:Project#classified">
						<!-- Nobody but a super-user may read this attribute. -->
						<grant operation="Read"/>
					</part>
					<part name="TestViewModelAccess:Project#sponsor">
						<!-- Only the responsible of the project may see its sponsor. -->
						<grant
							operation="Read"
							roles="TestViewModelAccess.Responsible"
						/>
					</part>
					<part name="TestViewModelAccess:Project#rating">
						<!-- Only the viewer of the project may rate it. -->
						<grant
							operation="Write"
							roles="TestViewModelAccess.Viewer"
						/>
					</part>
					<part name="TestViewModelAccess:Project#code">
						<!-- Only the viewer of the project may write its code, which its display makes read-only anyway. -->
						<grant
							operation="Write"
							roles="TestViewModelAccess.Viewer"
						/>
					</part>
					<part name="TestViewModelAccess:Task#note">
						<!-- Only the responsible of the task may write its note. -->
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
					</part>
					<part name="TestViewModelAccess:Step#note">
						<!-- Only the responsible of the project may write the note of its steps. -->
						<grant
							operation="Write"
							roles="TestViewModelAccess.Responsible"
						/>
					</part>
					<part name="TestViewModelAccess:Step#secret">
						<!-- Nobody but a super-user may write the secret of a step. -->
						<grant operation="Write"/>
					</part>
					<part name="TestViewModelAccess:Step#lockedItems">
						<!-- Nobody but a super-user may change the locked items of a step. -->
						<grant operation="Write"/>
					</part>
					<part name="TestViewModelAccess:Task#secret">
						<!-- Nobody but a super-user may write the secret of a task. -->
						<grant operation="Write"/>
					</part>
				</security-config>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.execution.service.CommandApprovalService">
			<instance class="com.top_logic.tool.execution.service.ConfiguredCommandApprovalService">
				<check type="TestViewModelAccess:Project">
					<!-- A frozen project cannot be modified. -->
					<rule>
						<contexts>
							<command-with-group command-group="Write"/>
						</contexts>
						<executability>
							<rule-by-expression
								decision="p -> if($p.get(`TestViewModelAccess:Project#name`) == 'frozen', 'The project is frozen.', true)"
								show-disabled="true"
							/>
						</executability>
					</rule>
					<!-- A frozen project cannot be deleted, without a reason to show. -->
					<rule>
						<contexts>
							<command-with-group command-group="Delete"/>
						</contexts>
						<executability>
							<rule-by-expression
								decision="p -> $p.get(`TestViewModelAccess:Project#name`) != 'frozen'"
								show-disabled="false"
							/>
						</executability>
					</rule>
				</check>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="TestViewModelAccess_Project_Responsible"
							meta-element="TestViewModelAccess:Project"
							role="TestViewModelAccess.Responsible"
						>
							<path>
								<step attribute="TestViewModelAccess:Project#responsible"/>
							</path>
						</rule>
						<rule id="TestViewModelAccess_Project_Viewer"
							meta-element="TestViewModelAccess:Project"
							role="TestViewModelAccess.Viewer"
						>
							<path>
								<step attribute="TestViewModelAccess:Project#viewer"/>
							</path>
						</rule>
						<rule id="TestViewModelAccess_Project_Finisher"
							meta-element="TestViewModelAccess:Project"
							role="TestViewModelAccess.Finisher"
						>
							<path>
								<step attribute="TestViewModelAccess:Project#finisher"/>
							</path>
						</rule>
						<inheritance-rule id="TestViewModelAccess_Task_Responsible"
							meta-element="TestViewModelAccess:Task"
							role="TestViewModelAccess.Responsible"
						>
							<path>
								<step
									attribute="TestViewModelAccess:Project#tasks"
									inverse="true"
								/>
							</path>
						</inheritance-rule>
						<!-- The viewer of a project is viewer of its category, see the Discover grant of a category. -->
						<rule id="TestViewModelAccess_Category_Viewer"
							meta-element="TestViewModelAccess:Category"
							role="TestViewModelAccess.Viewer"
						>
							<path>
								<step
									attribute="TestViewModelAccess:Project#category"
									inverse="true"
								/>
								<step attribute="TestViewModelAccess:Project#viewer"/>
							</path>
						</rule>
						<rule id="TestViewModelAccess_Named_NameReader"
							inherit="true"
							meta-element="TestViewModelAccess:Named"
							role="TestViewModelAccess.NameReader"
						>
							<path>
								<step attribute="TestViewModelAccess:Named#accountA"/>
							</path>
						</rule>
						<rule id="TestViewModelAccess_Named_NameKeeper"
							inherit="true"
							meta-element="TestViewModelAccess:Named"
							role="TestViewModelAccess.NameKeeper"
						>
							<path>
								<step attribute="TestViewModelAccess:Named#accountB"/>
							</path>
						</rule>
						<rule id="TestViewModelAccess_Category_Reader"
							meta-element="TestViewModelAccess:Category"
							role="TestViewModelAccess.Reader"
						>
							<path>
								<step attribute="TestViewModelAccess:Category#reader"/>
							</path>
						</rule>
					</rules>
				</role-rules>
			</instance>
		</config>
	</services>
</application>