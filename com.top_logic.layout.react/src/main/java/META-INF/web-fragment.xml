<?xml version="1.0" encoding="UTF-8"?>
<web-fragment
	xmlns="http://java.sun.com/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:web="http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
	xsi:schemaLocation="http://java.sun.com/xml/ns/javaee/web-fragment_3_0.xsd"
	id="tl-layout-react"
	version="3.0"
	metadata-complete="true"
>
	<name>tl-layout-react</name>

	<!--
		Lets the window registry of a session follow a change of the session's ID, as a login within
		a window does.
	-->
	<listener>
		<listener-class>com.top_logic.layout.react.window.SessionIdChangeListener</listener-class>
	</listener>

	<!--
		Tells a control counting down to the end of the session about every request that restarts
		the session's inactivity timeout, whichever servlet answers it.
	-->
	<filter>
		<filter-name>SessionActivityFilter</filter-name>
		<filter-class>com.top_logic.layout.react.servlet.SessionActivityFilter</filter-class>
		<async-supported>true</async-supported>
	</filter>

	<filter-mapping>
		<filter-name>SessionActivityFilter</filter-name>
		<url-pattern>/*</url-pattern>
	</filter-mapping>

	<servlet>
		<servlet-name>ReactServlet</servlet-name>
		<servlet-class>com.top_logic.layout.react.servlet.ReactServlet</servlet-class>
		<multipart-config>
			<file-size-threshold>8192</file-size-threshold>
		</multipart-config>
	</servlet>

	<servlet-mapping>
		<servlet-name>ReactServlet</servlet-name>
		<url-pattern>/react-api/*</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>SSEServlet</servlet-name>
		<servlet-class>com.top_logic.layout.react.servlet.SSEServlet</servlet-class>
		<async-supported>true</async-supported>
	</servlet>

	<servlet-mapping>
		<servlet-name>SSEServlet</servlet-name>
		<url-pattern>/react-api/events</url-pattern>
	</servlet-mapping>

	<servlet>
		<servlet-name>PollServlet</servlet-name>
		<servlet-class>com.top_logic.layout.react.servlet.PollServlet</servlet-class>
		<async-supported>true</async-supported>
	</servlet>

	<servlet-mapping>
		<servlet-name>PollServlet</servlet-name>
		<url-pattern>/react-api/poll</url-pattern>
	</servlet-mapping>

</web-fragment>
