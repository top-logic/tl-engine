<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="ch"/>
	</channels>

	<table>
		<drop accept="value">
			<target-executability>
				<null-input-disabled/>
			</target-executability>
			<execute-script function="$objects"/>
		</drop>
		<drop
			accept="value"
			before-channel="ch"
			target="table"
		>
			<execute-script function="$objects"/>
		</drop>
		<drop
			accept="value"
			before-channel="ch"
			target="row"
		>
			<execute-script function="$objects"/>
		</drop>
		<drop
			accept="value"
			target="ordered"
			target-channel="ch"
		>
			<target-executability>
				<null-input-disabled/>
			</target-executability>
			<execute-script function="$objects"/>
		</drop>
		<drop
			accept="value"
			parent-channel="ch"
			target="ordered"
		>
			<execute-script function="$objects"/>
		</drop>
		<columns>
			<computed-column name="value"
				type="tl.core:String"
			>
				<value>$row</value>
			</computed-column>
		</columns>
		<rows>['free']</rows>
	</table>
</view>