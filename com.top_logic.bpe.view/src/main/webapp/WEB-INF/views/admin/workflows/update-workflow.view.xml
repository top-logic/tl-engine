<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the workflow administration (workflows.view.xml) updating the workflow in the model
	channel from a BPML file (bpmlUpdate): the workflow becomes structurally equal to the file, its
	elements keep their identity by their BPMN ID. The application specific extensions (forms,
	actors, step views, ...) are taken from the file only on request.
-->
<view>
	<channels>
		<channel name="model"/>
		<channel name="file"/>
		<channel name="updateExtensions"
			init="false"
		/>
	</channels>
	<window
		resizable="false"
		width="560px"
	>
		<title>
			<en>Update from BPML file</en>
			<de>Aus BPML-Datei aktualisieren</de>
		</title>
		<fields
			label-position="top"
			max-columns="1"
			with-inset="true"
		>
			<text>
				<label>
					<en>Makes the workflow structurally equal to the file; its elements keep their identity by their BPMN ID. The application specific settings of the elements (forms, actors, step views, ...) are kept, unless they are to be taken from the file as well.</en>
					<de>Macht den Workflow strukturell gleich zur Datei; seine Elemente behalten ihre Identität über ihre BPMN-ID. Die anwendungsspezifischen Einstellungen der Elemente (Formulare, Bearbeiter, Schrittansichten, ...) bleiben erhalten, es sei denn, sie sollen ebenfalls aus der Datei übernommen werden.</de>
				</label>
			</text>
			<value-input
				mandatory="true"
				type="tl.core:Binary"
				value="file"
			>
				<annotations>
					<accepted-types value="*.bpmn,*.bpml,*.xml"/>
				</annotations>
				<label>
					<en>BPML file</en>
					<de>BPML-Datei</de>
				</label>
			</value-input>
			<value-input
				type="tl.core:Boolean"
				value="updateExtensions"
			>
				<label>
					<en>Update the extensions, too</en>
					<de>Auch die Erweiterungen aktualisieren</de>
				</label>
			</value-input>
		</fields>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-check-lg"
					inputs="model as workflow, file, updateExtensions"
				>
					<label>
						<en>Update</en>
						<de>Aktualisieren</de>
					</label>
					<access>
						<operation name="Write"
							object="$workflow"
							type="tl.bpe.bpml:Collaboration"
						/>
					</access>
					<executability>
						<disabled-if expr="if($file == null, #('Upload a file first.'@en, 'Laden Sie zuerst eine Datei hoch.'@de), null)"/>
					</executability>
					<with-transaction>
						<commitMessage>
							<en>Updated workflow {0} from a file.</en>
							<de>Workflow {0} aus einer Datei aktualisiert.</de>
						</commitMessage>
						<execute-script function="bpmlUpdate($workflow, $file, $updateExtensions == true)"/>
						<with-result>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
