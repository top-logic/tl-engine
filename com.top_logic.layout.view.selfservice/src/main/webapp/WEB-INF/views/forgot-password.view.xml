<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<!-- Transient ForgotPassword model (username) bound to the form. -->
		<channel name="model"/>
	</channels>
	<window
		resizable="false"
		width="400px"
	>
		<title>
			<en>Reset password</en>
			<de>Passwort zurücksetzen</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
			with-inset="true"
		>
			<text>
				<label>
					<en>Enter your user name. If an account exists, we will email a verification code you can use to set a new password.</en>
					<de>Geben Sie Ihren Benutzernamen ein. Falls ein Konto existiert, senden wir per E-Mail einen Bestätigungscode, mit dem Sie ein neues Passwort setzen können.</de>
				</label>
			</text>
			<field attribute="username"/>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Send code</en>
						<de>Code senden</de>
					</label>
					<store-form-state/>
					<request-password-reset/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>