<?xml version="1.0" encoding="utf-8" ?>

<!--
	The milestones of a project, pushed by the Milestones tile of the project cockpit. Activating a
	row - a double-click, Enter on the row carrying the keyboard cursor, or its chevron button -
	pushes the milestone's tickets, announced with the milestone's name.
	
	The speed dial in the bottom corner of the panel body creates a milestone in the project and
	deletes the selected one; the table observes milestones, so both are reflected in the rows
	without a reload. Delete and Approve are disabled while no milestone is selected, and the dial
	stays in its corner while a long list of milestones scrolls beneath it.
	The speed dial also approves the selected milestone through the privileged script
	approveMilestone. Its access declares the operation "Approve" on the project of the
	milestone, the check the script makes as well, so the command is enabled only for a user
	allowed to call it.
	
	This view is reachable from no root view, so a display target revealing a milestone finds it
	within the frame the target pushed before it.
-->
<view>
	<channels>
		<channel name="project"/>
		<channel name="milestone"/>
	</channels>

	<panel>
		<title>
			<en>Milestones</en>
			<de>Meilensteine</de>
		</title>
		<table
			observed-types="tl.demo.projectManagement:Milestone"
			selection="milestone"
			types="tl.demo.projectManagement:Milestone"
		>
			<columns>
				<column attribute="name"/>
				<column attribute="dueDate"/>
				<column attribute="approved"/>
			</columns>
			<inputs>
				<input channel="project"/>
			</inputs>
			<rows>if($project == null, [], $project.get(`tl.demo.projectManagement:ProjectScope#milestones`))</rows>
			<on-activate class="com.top_logic.layout.view.tiles.NavigatePushCommand"
				bind-input-to="milestone"
				frame="milestone"
			/>
		</table>
		<floating-action>
			<label>
				<en>Milestone actions</en>
				<de>Meilenstein-Aktionen</de>
			</label>
			<generic-command
				image="css:bi bi-plus-lg"
				inputs="project"
			>
				<label>
					<en>New Milestone</en>
					<de>Neuer Meilenstein</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<create-transient
					container="project"
					reference="milestones"
					type="tl.demo.projectManagement:Milestone"
				>
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="demo/create-milestone.view.xml"
						>
							<bind
								channel="container"
								to="project"
							/>
							<bind
								channel="selection"
								to="milestone"
							/>
						</open-dialog>
					</with-result>
				</create-transient>
			</generic-command>
			<generic-command
				image="css:bi bi-trash"
				inputs="milestone"
			>
				<label>
					<en>Delete</en>
					<de>Löschen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="{ due = $milestone.get(`tl.demo.projectManagement:Milestone#dueDate`); #('Delete milestone {0}?\nDue: {1}\nTickets: {2}'@en, 'Meilenstein {0} löschen?\nFällig: {1}\nTickets: {2}'@de).fill($milestone.get(`tl.demo.projectManagement:Milestone#name`), if($due == null, '–', dateFormat('dd.MM.yyyy').format($due)), $milestone.get(`tl.demo.projectManagement:Milestone#tickets`).size()) }"/>
				<delete-object/>
				<write-channel name="milestone"
					clear="true"
				/>
			</generic-command>
			<generic-command
				image="css:bi bi-patch-check"
				inputs="milestone"
			>
				<label>
					<en>Approve</en>
					<de>Freigeben</de>
				</label>
				<access>
					<operation name="Approve"
						object="$milestone.container()"
						type="tl.demo.projectManagement:ProjectScope"
					/>
				</access>
				<executability>
					<null-input-disabled/>
				</executability>
				<with-transaction>
					<execute-script function="approveMilestone($milestone)"/>
				</with-transaction>
			</generic-command>
		</floating-action>
	</panel>
</view>