<?xml version="1.0" encoding="utf-8" ?>

<!--
	One card of the repeater grid, instantiated per flow node.
	
	The card is a view of its own because it needs a channel of its own: the picture of the element
	is derived from it, and channels are declared per view. The repeater binds its element channel
	to the "element" channel below, so the derivation runs per card.
	
	The thumbnail is left to the browser to load when the card comes into view; a grid of cards far
	down the page is what lazy loading is for.
	
	The button of the card computes its label, tooltip and icon from the flow node: it is labeled
	with the name of the node, explains its marker as tooltip (the fixed tooltip where the node has
	none), and shows a box for a node built from nothing and a diagram for a node built from other
	nodes. It opens the edit dialog of the node; a rename stored there relabels the button right
	away, since the computed values follow the object the button works on.
-->
<view>
	<channels>
		<channel name="element"/>
		<derived-channel name="photo"
			expr="$element.get(`test.flowchart:FlowNode#image`)"
			inputs="element"
		/>
	</channels>
	<card>
		<overlay>
			<image
				aspect-ratio="16/9"
				input="photo"
				lazy="true"
				width="100%"
			/>
			<layer
				css-class="tlDemoBadge"
				position="bottom-right"
			>
				<text input="element"/>
			</layer>
		</overlay>
		<text
			css-class="tl-type-body-strong"
			input="element"
		/>
		<button>
			<action class="com.top_logic.layout.view.command.GenericViewCommand"
				image="css:bi bi-pencil"
				image-expr="$element.get(`test.flowchart:FlowNode#inputs`).isEmpty() ? 'css:bi bi-box' : 'css:bi bi-diagram-3'"
				inputs="element"
				label-expr="$element.get(`test.flowchart:FlowNode#name`)"
				tooltip-expr="$element.get(`test.flowchart:FlowNode#marker`)"
			>
				<label>
					<en>Edit</en>
					<de>Bearbeiten</de>
				</label>
				<tooltip>
					<en>Edit the build step.</en>
					<de>Den Bauschritt bearbeiten.</de>
				</tooltip>
				<open-dialog
					bind-input-to="model"
					close-on-backdrop="true"
					dialog-view="demo/edit-flow-step.view.xml"
				/>
			</action>
		</button>
	</card>
</view>