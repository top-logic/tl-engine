<?xml version="1.0" encoding="utf-8"?>

<!--
	Configuration options for testing tl-ai-demo with JUnit.
 -->
<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.ai.service.AIService">
			<instance class="com.top_logic.ai.service.AIService"
				default-model="mistral-large-latest"
			>
				<factories>
					<!-- Mistral AI models factory for ModelExplorer agent -->
					<factory
						class="com.top_logic.ai.service.providers.MistralChatModelFactory"
						api-key="unencrypted:xxx"
						base-url="https://api.mistral.ai/v1"
						max-pool-size="10"
						max-idle-models="5"
					/>
					<!-- Anthropic models factory for output scoring -->
					<factory
						class="com.top_logic.ai.service.providers.AnthropicChatModelFactory"
						models="claude-sonnet-4-5-20250929"
						api-key="unencrypted:xxx"
						base-url="https://api.anthropic.com/v1"
						max-pool-size="10"
						max-idle-models="5"
					/>
				</factories>
			</instance>
		</config>
	</services>
	<configs>
		<config config:interface="test.com.top_logic.basic.util.AbstractBasicTestAll$GlobalConfig"
			test-comment="true"
			test-layouts-normalized="true"
			test-jsp-content="true"
		/>
		
		<config config:interface="test.com.top_logic.basic.TestComment$Config">
				<ignore>
					<entry value="com.top_logic.ai.demo.test.agent.judge.messages" />
				</ignore>
			</config>
		
	</configs>
</application>
