<?xml version="1.0" encoding="utf-8"?>


<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance class="com.top_logic.basic.module.ModuleSystem">
				<modules>
		           <module key="com.top_logic.base.services.SearchFactory$Module" value="true" />
		           <module key="com.top_logic.ai.vector.index.VectorIndex$Module" value="true" />
		           <module key="com.top_logic.knowledge.analyze.DefaultAnalyzeService$Module" value="true" />
		           <module key="com.top_logic.ai.vector.index.VectorIndexingService$Module" value="true" />
				</modules>
			</instance>
		</config>
	
 		<config service-class="com.top_logic.base.services.SearchFactory">
			<instance>
				<dependencies>
					<dependency key="com.top_logic.ai.vector.index.VectorIndex$Module" value="true"/>
					<dependency key="com.top_logic.knowledge.service.PersistencyLayer$Module" value="true"/>
				</dependencies>
			</instance>
		</config>
	
        <config service-class="com.top_logic.util.monitor.ApplicationMonitor">
			<instance class="com.top_logic.util.monitor.ApplicationMonitor">
				<components>
					<component name="search" class="com.top_logic.ai.vector.index.VectorMonitor" />
				</components>
			</instance>
		</config>
		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="searchVectorMessages" />
				</bundles>
			</instance>
		</config>
		
		
		<config service-class="com.top_logic.knowledge.indexing.IndexingService" >
			<instance class="com.top_logic.ai.vector.index.VectorIndexingService">
				<protocols>
					<protocol value="knowledgerepository" />
					<protocol value="knowledge" />
					<protocol value="repository" />
				</protocols>
				<meta-objects>
					<meta-object value="Document" />
					<meta-object value="GenericObject" />
				</meta-objects>
			</instance>
		</config>
		<config service-class="com.top_logic.knowledge.service.migration.MigrationService">
			<instance>
				<modules>
					<module name="tl-ai-vector-index" />
				</modules>
			</instance>
		</config>
		<config service-class="com.top_logic.ai.vector.index.VectorIndex">
			<instance class="com.top_logic.ai.vector.index.VectorIndex"
				vector-store-type="qdrant"
				vector-store-host="localhost"
				vector-store-port="6334"
				vector-store-collection-name="toplogic-vectors"
				vector-dimension="1024"
				mistral-api-key="YOUR_MISTRAL_API_KEY_HERE"
				mistral-embed-model="mistral-embed"
				vector-index-models=""
				timeout-abort-indexing-for-shutdown="30000"
				warn-queue-size="1000"
			/>
		</config>
	</services>
</application>