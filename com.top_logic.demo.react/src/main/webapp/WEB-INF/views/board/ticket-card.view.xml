<?xml version="1.0" encoding="utf-8" ?>

<!--
	A ticket as a card of the board: its name, and its status as a pill in the colour of the
	status. The derived channels observe the ticket they are computed from, so an edit of the
	ticket reaches the card.
	
	The button beside the name drills down into the ticket: it opens a dialog with the ticket and
	its conversation. A click on the button is the button's own - it neither selects the card nor
	starts a drag.
-->
<view>
	<channels>
		<channel name="ticket"/>
		<derived-channel name="name"
			expr="t -> $t.get(`demo.tickets:Ticket#name`)"
			inputs="ticket"
		/>
		<derived-channel name="status"
			expr="t -> $t.get(`demo.tickets:Ticket#status`)"
			inputs="ticket"
		/>
	</channels>
	<stack gap="compact">
		<stack
			align="center"
			direction="row"
			justify="space-between"
		>
			<text
				input="name"
				variant="label"
			/>
			<button
				appearance="ghost"
				size="small"
			>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-box-arrow-up-right"
					input="ticket"
				>
					<label>
						<en>Details</en>
						<de>Details</de>
					</label>
					<open-dialog
						bind-input-to="ticket"
						close-on-backdrop="true"
						dialog-view="board/ticket-detail.view.xml"
					/>
				</action>
			</button>
		</stack>
		<stack direction="row">
			<text input="status"/>
		</stack>
	</stack>
</view>