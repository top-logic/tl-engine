<?xml version="1.0" encoding="utf-8" ?>

<!-- typed configuration for TestAgentDiscoveryService -->

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">

	<services>

		<config service-class="com.top_logic.base.discovery.AgentDiscoveryService">
			<instance
				summary="An application for testing the agent discovery."
			>
				<contributions>
					<contribution class="test.com.top_logic.base.discovery.TestAgentDiscoveryService$TestContribution"
						active="true"
						path="/test-endpoint"
						title="Test Endpoint"
					/>
					<contribution class="test.com.top_logic.base.discovery.TestAgentDiscoveryService$TestContribution"
						active="false"
						path="/inactive-endpoint"
						title="Inactive Endpoint"
					/>
				</contributions>
			</instance>
		</config>

	</services>

</application>
