<?xml version="1.0" encoding="utf-8" ?>
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
  <channels>
    <channel name="catalogue"/>
    <channel name="season"/>
  </channels>

  <object-list items="catalogue -&gt; season -&gt; [$catalogue, $season]">
    <inputs>
      <input channel="catalogue"/>
      <input channel="season"/>
    </inputs>
    <item>
      <text input="element"/>
    </item>
  </object-list>
</view>
