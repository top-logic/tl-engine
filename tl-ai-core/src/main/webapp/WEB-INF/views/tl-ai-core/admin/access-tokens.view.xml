<?xml version="1.0" encoding="utf-8" ?>

<!--
	Every personal access token of every account, for an administrator (Issue #671). Revoking one here
	is what to do when a token leaked or an account must lose MCP and A2A access at once; the hint column is
	what a token found in a file or a log is matched against.
-->
<view>
	<channels>
		<channel name="selectedToken"/>
	</channels>
	<panel>
		<title>
			<en>Access tokens</en>
			<de>Zugriffstokens</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-x-circle"
				input="selectedToken"
				placement="TOOLBAR"
			>
				<label>
					<en>Revoke</en>
					<de>Widerrufen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="t -> #('Revoke the token {0} of {1}? A client that uses it is refused from now on.'@en, 'Das Token {0} von {1} widerrufen? Ein Client, der es verwendet, wird ab sofort abgewiesen.'@de).fill($t.get(`tl.ai.access:AccessToken#name`), $t.get(`tl.ai.access:AccessToken#owner`))"/>
				<with-transaction>
					<execute-script function="t -> { aiAccessTokenRevoke($t); null; }"/>
				</with-transaction>
				<write-channel name="selectedToken"/>
			</generic-command>
		</commands>
		<table
			observed-types="tl.ai.access:AccessToken"
			selection="selectedToken"
			types="tl.ai.access:AccessToken"
		>
			<columns>
				<column attribute="owner" width="160"/>
				<column attribute="name" width="220"/>
				<column attribute="hint" width="110"/>
				<column attribute="createdAt" width="150"/>
				<column attribute="expiresAt" width="150"/>
				<column attribute="lastUsed" width="150"/>
			</columns>
			<rows><![CDATA[all(`tl.ai.access:AccessToken`)
				.sort((t -> $t.get(`tl.ai.access:AccessToken#createdAt`)).comparator().desc())]]></rows>
		</table>
	</panel>
</view>
