<?xml version="1.0" encoding="utf-8"?>

<application xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<services>
		<config service-class="com.top_logic.basic.module.ModuleSystem">
			<instance>
				<modules>
					<module key="com.top_logic.factory.workspace.WorkspaceService$Module" value="true"/>
					<module key="com.top_logic.factory.git.GitHostingService$Module" value="true"/>
					<module key="com.top_logic.factory.ci.CIService$Module" value="true"/>
					<module key="com.top_logic.factory.project.ProjectWorkspaces$Module" value="true"/>
					<module key="com.top_logic.factory.proxy.WorkspaceProxyService$Module" value="true"/>
					<module key="com.top_logic.factory.agent.WorkspaceAgentService$Module" value="true"/>
				</modules>
			</instance>
		</config>

		<config service-class="com.top_logic.factory.workspace.WorkspaceService">
			<instance class="com.top_logic.factory.workspace.WorkspaceService">
				<provider class="com.top_logic.factory.workspace.docker.DockerWorkspaceProvider"
					docker-host="%FACTORY_DOCKER_HOST%"
					network="%FACTORY_DOCKER_NETWORK%"
					public-host="%FACTORY_PUBLIC_HOST%"
					host-port-min="%FACTORY_HOST_PORT_MIN%"
					host-port-max="%FACTORY_HOST_PORT_MAX%"
					cpu-limit="%FACTORY_WORKSPACE_CPUS%"
					extra-hosts="%FACTORY_DOCKER_EXTRA_HOSTS%"
					host-ip="%FACTORY_HOST_IP%"
					isolate-workspaces="%FACTORY_DOCKER_ISOLATE%"
					memory-limit="%FACTORY_WORKSPACE_MEMORY%"
					pids-limit="%FACTORY_WORKSPACE_PIDS%"
				/>
				<applications
					engine-version="%FACTORY_ENGINE_VERSION%"
					image-repository="%FACTORY_IMAGE_REPOSITORY%"
					repository-url="%FACTORY_REPOSITORY_URL%"
					start-timeout="%FACTORY_START_TIMEOUT%"
					build-timeout="%FACTORY_BUILD_TIMEOUT%"
				/>
			</instance>
		</config>

		<!--
			The git hosting service of the project repositories, switched off: an installation configures
			a provider, e.g. the GiteaHostingProvider of the module tl-factory-gitea. The default branch of
			every project repository is protected with the protected files.
		-->
		<config service-class="com.top_logic.factory.git.GitHostingService">
			<instance class="com.top_logic.factory.git.GitHostingService"
				protected-files="%FACTORY_GIT_PROTECTED_FILES%"
			/>
		</config>

		<!--
			The CI server building the applications of the projects, switched off: an installation
			configures a provider, e.g. the JenkinsCIProvider of the module tl-factory-jenkins. A new
			application gets the pipeline-template as its pipeline definition.
		-->
		<config service-class="com.top_logic.factory.ci.CIService">
			<instance class="com.top_logic.factory.ci.CIService"/>
		</config>

		<config service-class="com.top_logic.factory.project.ProjectWorkspaces">
			<instance class="com.top_logic.factory.project.ProjectWorkspaces"
				log-flush-interval="%FACTORY_LOG_FLUSH_INTERVAL%"
				max-log-size="%FACTORY_MAX_LOG_SIZE%"
			/>
		</config>

		<!--
			The workspace proxy: the workspaces reach services through its routes, which add the
			credentials of the control application to their requests; no workspace container gets
			one. The LLM route adds the API key of the named provider of the LLMProviderService, the git
			route the credentials of the GitHostingService for the repository of the project of a
			workspace; without a git hosting provider, it answers every request with 404. The git route
			also gives every git process in a workspace the identity its commits are made with. The CI
			route lets the agent start and follow the builds of the CI job of its project; without a CI
			provider, it answers every request with 404.
		-->
		<config service-class="com.top_logic.factory.proxy.WorkspaceProxyService">
			<instance class="com.top_logic.factory.proxy.WorkspaceProxyService"
				allowed-sources="%FACTORY_PROXY_ALLOWED_SOURCES%"
				listen-address="%FACTORY_PROXY_ADDRESS%"
				listen-port="%FACTORY_PROXY_PORT%"
				proxy-url="%FACTORY_PROXY_URL%"
				rate-limit="%FACTORY_PROXY_RATE_LIMIT%"
				servlet-enabled="%FACTORY_PROXY_SERVLET%"
			>
				<routes>
					<route class="com.top_logic.factory.llm.LLMRoute"
						provider="%FACTORY_LLM_PROVIDER%"
					/>
					<route class="com.top_logic.factory.git.GitRoute"
						user-email="%FACTORY_GIT_USER_EMAIL%"
						user-name="%FACTORY_GIT_USER_NAME%"
					/>
					<route class="com.top_logic.factory.ci.CIRoute"/>
				</routes>
			</instance>
		</config>

		<!--
			The coding agent of the workspaces: Claude Code, one process per agent conversation,
			answering the chats whose subject is a tl.factory:AgentConversation.
		-->
		<config service-class="com.top_logic.factory.agent.WorkspaceAgentService">
			<instance class="com.top_logic.factory.agent.WorkspaceAgentService"
				idle-timeout="%FACTORY_AGENT_IDLE_TIMEOUT%"
				token-lifetime="%FACTORY_AGENT_TOKEN_LIFETIME%"
			>
				<harness class="com.top_logic.factory.agent.claude.ClaudeCodeHarness"
					extra-args="%FACTORY_AGENT_EXTRA_ARGS%"
					model="%FACTORY_AGENT_MODEL%"
					thinking-display="%FACTORY_AGENT_THINKING_DISPLAY%"
				/>
			</instance>
		</config>

		<config service-class="com.top_logic.ai.chat.backend.ConversationBackendService">
			<instance>
				<resolvers>
					<resolver class="com.top_logic.factory.agent.AgentConversationResolver"/>
				</resolvers>
			</instance>
		</config>

		<!-- The stylesheet of the views of the control application, in the engine's layer "tl". -->
		<config service-class="com.top_logic.layout.react.resource.ClientResources">
			<instance class="com.top_logic.layout.react.resource.ClientResources">
				<resources>
					<stylesheet name="tl-factory-css"
						layer="tl"
						requires="tl-design-system-components"
						resource="/style/tl-factory.css"
					/>
				</resources>
			</instance>
		</config>

		<config service-class="com.top_logic.util.model.ModelService">
			<instance class="com.top_logic.element.model.DynamicModelService">
				<declarations>
					<declaration file="/WEB-INF/model/tl.factory.model.xml"/>
				</declarations>
			</instance>
		</config>

		<!--
			The page of the tenants, for the operators: with no roles assigned, it is shown to the
			technical super user (root) only; the security administration assigns it to further roles,
			e.g. tl.factory.Operator.
		-->
		<config service-class="com.top_logic.layout.view.security.SecurityScopeService">
			<instance class="com.top_logic.layout.view.security.SecurityScopeService">
				<scopes>
					<scope id="tl.factory.tenants">
						<label>
							<en>Tenants</en>
							<de>Mandanten</de>
						</label>
					</scope>
				</scopes>
			</instance>
		</config>

		<config service-class="com.top_logic.basic.util.ResourcesModule">
			<instance>
				<bundles>
					<bundle name="model.tl.factory.messages"/>
				</bundles>
			</instance>
		</config>

		<!--
			The access to the tenants, their projects and the workspaces of the projects. The operators
			of the control application manage all of them: the role tl.factory.Operator, held on the
			security root, is passed on to every tenant and every project by the role parent rules
			below. The members of a tenant hold the role of the reference of the tenant they are in, on
			the tenant and, by the role parent rule of a project, on its projects: an administrator
			(tl.factory.Verwalter) manages the tenant and works on its projects, a developer
			(tl.factory.Entwickler) works on the projects, a reader (tl.factory.Leser) sees the tenant and
			its projects. A workspace is a part of its project and an agent conversation a part of its
			workspace, both decided by their container. The account of a member inherits the roles held
			on its tenant, so that the members of a tenant see each other.
		-->
		<config service-class="com.top_logic.base.services.InitialRolesManager">
			<instance>
				<roles>
					<role name="tl.factory.Operator"/>
					<role name="tl.factory.Verwalter"/>
					<role name="tl.factory.Entwickler"/>
					<role name="tl.factory.Leser"/>
				</roles>
			</instance>
		</config>

		<config service-class="com.top_logic.tool.boundsec.manager.AccessManager">
			<instance>
				<role-rules>
					<rules>
						<rule id="TenantAdministrators"
							meta-element="tl.factory:Tenant"
							role="tl.factory.Verwalter"
						>
							<path>
								<step attribute="tl.factory:Tenant#administrators"/>
							</path>
						</rule>
						<rule id="TenantDevelopers"
							meta-element="tl.factory:Tenant"
							role="tl.factory.Entwickler"
						>
							<path>
								<step attribute="tl.factory:Tenant#developers"/>
							</path>
						</rule>
						<rule id="TenantReaders"
							meta-element="tl.factory:Tenant"
							role="tl.factory.Leser"
						>
							<path>
								<step attribute="tl.factory:Tenant#readers"/>
							</path>
						</rule>
					</rules>
				</role-rules>
				<security-parents>
					<rule id="SecRootForFactoryTenant"
						inherit="true"
						meta-element="tl.factory:Tenant"
					>
						<singleton module="SecurityStructure"/>
					</rule>
					<rule id="SecRootForFactoryProject"
						inherit="true"
						meta-element="tl.factory:Project"
					>
						<singleton module="SecurityStructure"/>
					</rule>
					<!--
						A member of a tenant sees the accounts of the other members: an account inherits
						the roles held on the tenant it is a member of.
					-->
					<rule id="TenantForAdministrator"
						inherit="true"
						meta-element="tl.accounts:Person"
					>
						<path>
							<step
								attribute="tl.factory:Tenant#administrators"
								inverse="true"
							/>
						</path>
					</rule>
					<rule id="TenantForDeveloper"
						inherit="true"
						meta-element="tl.accounts:Person"
					>
						<path>
							<step
								attribute="tl.factory:Tenant#developers"
								inverse="true"
							/>
						</path>
					</rule>
					<rule id="TenantForReader"
						inherit="true"
						meta-element="tl.accounts:Person"
					>
						<path>
							<step
								attribute="tl.factory:Tenant#readers"
								inverse="true"
							/>
						</path>
					</rule>
					<rule id="TenantForFactoryProject"
						inherit="true"
						meta-element="tl.factory:Project"
					>
						<path>
							<step attribute="tl.factory:Project#tenant"/>
						</path>
					</rule>
				</security-parents>
			</instance>
		</config>

		<config service-class="com.top_logic.model.security.SecurityConfigurationService">
			<instance>
				<security-config>
					<!-- The operators create and delete tenants, their administrators manage them. -->
					<class name="tl.factory:Tenant">
						<grant
							operation="Read"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler, tl.factory.Leser"
						/>
						<grant
							operation="Write"
							roles="tl.factory.Operator, tl.factory.Verwalter"
						/>
						<grant
							operation="Create"
							roles="tl.factory.Operator"
						/>
						<grant
							operation="Delete"
							roles="tl.factory.Operator"
						/>
					</class>
					<!--
						The members of a tenant read the accounts of its members; the accounts are
						created, changed and deleted by the functions managing the members
						(com.top_logic.factory.tenant.TenantMembers).
					-->
					<class name="tl.accounts:Person">
						<grant
							inherit="true"
							operation="Read"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler, tl.factory.Leser"
						/>
					</class>
					<!-- The input of the dialogs managing the tenants, never stored. -->
					<module name="tl.factory.input"
						internal="true"
					/>
					<!--
						The developers and administrators of a tenant create, change and delete its
						projects, its readers see them. The workspaces and agent conversations follow
						their project.
					-->
					<class name="tl.factory:Project">
						<grant
							operation="Read"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler, tl.factory.Leser"
						/>
						<grant
							operation="Write"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler"
						/>
						<grant
							operation="Create"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler"
						/>
						<grant
							operation="Delete"
							roles="tl.factory.Operator, tl.factory.Verwalter, tl.factory.Entwickler"
						/>
					</class>
				</security-config>
			</instance>
		</config>
	</services>
</application>
