<?xml version="1.0" encoding="utf-8" ?>

<!--
	A screenshot is a part of the agent session it was taken in (Ticket #30054): the composition
	tl.ai.execution:AgentSession#screenshots, which the automatic model upgrade adds. Screenshots
	taken before belong to no session, and so to no conversation that could show or delete them;
	they are deleted.
-->
<migration config:interface="com.top_logic.knowledge.service.migration.MigrationConfig"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<version name="Ticket_30054_delete_screenshots_without_session"
		module="tl-ai-core"
	/>
	<dependencies>
		<dependency name="Issue_594_complete_agent_session_memory_removal"
			module="tl-ai-core"
		/>
		<dependency name="Ticket_29492_enlarge_layout_key"
			module="tl"
		/>
		<dependency name="Ticket_30079_Remove_comments"
			module="tl-element"
		/>
		<dependency name="Ticket_28710_Added_TLSearch"
			module="tl-model-search"
		/>
		<dependency name="Ticket_29741_hide_anonymous_in_options"
			module="tl-contact"
		/>
		<dependency name="Ticket_29092_multi_factor_authentication"
			module="tl-layout-formeditor"
		/>
		<dependency name="Ticket_29410_filename_binary"
			module="tl-model-wysiwyg"
		/>
		<dependency name="Ticket_28604_changelog"
			module="tl-doc"
		/>
		<dependency name="Ticket_29037_Update_diagram_attribute"
			module="tl-bpe"
		/>
		<dependency name="Ticket_27736_Upgrade_layout"
			module="tl-monitoring"
		/>
		<dependency name="Ticket_27442_Update_lucene_version_to_8_11_2"
			module="tl-search-lucene"
		/>
	</dependencies>
	<post-processors>
		<post-processor class="com.top_logic.knowledge.service.migration.processors.DeleteAllObjectsPostProcessor"
			table="Screenshot"
		/>
	</post-processors>
</migration>
