<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <relativePath>../tl-parent-core/internal</relativePath>
    <groupId>com.top-logic</groupId>
    <artifactId>tl-parent-core-internal</artifactId>
    <version>8.0.0-alpha13.829</version>
  </parent>

  <artifactId>tl-security-auth-pac4j</artifactId>
	<name>${project.artifactId}</name>
	<description>Single-sign-on through OpenID connect.</description>
	<url>https://github.com/top-logic/tl-engine/</url>

  <dependencies>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-basic</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-core</artifactId>
    </dependency>
    <dependency>
      <!-- The model of the identities of the accounts at external logins. -->
      <groupId>com.top-logic</groupId>
      <artifactId>tl-element</artifactId>
    </dependency>
    <dependency>
      <!-- The TL-Script functions about the external logins of the session's account. -->
      <groupId>com.top-logic</groupId>
      <artifactId>tl-model-search</artifactId>
    </dependency>
    <dependency>
      <!-- The e-mail address of an account lives in its contact. -->
      <groupId>com.top-logic</groupId>
      <artifactId>tl-contact</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!--
        The views of this module are overlays of views of tl-layout-view (settings-tabs.view.xml),
        which apply only in applications with the React view layer. Test scope, so that an
        application without it (e.g. one with the classic UI only) does not get it. The dependency
        still orders the web fragment of this module after the one of tl-layout-view, which an
        overlay needs: the order of the fragments follows the dependencies declared in the POMs of
        the modules, whatever their scope (DependencyResolver). It also lets TestViewScripts check
        the views of this module.
      -->
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.top-logic</groupId>
      <artifactId>tl-layout-view</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
		<groupId>com.nimbusds</groupId>
		<artifactId>nimbus-jose-jwt</artifactId>
	</dependency>
	<dependency>
	    <groupId>org.pac4j</groupId>
	    <artifactId>pac4j-oidc</artifactId>
	</dependency>
	<dependency>
	    <groupId>org.pac4j</groupId>
	    <artifactId>pac4j-jakartaee</artifactId>
	</dependency>
	<dependency>
	    <groupId>org.pac4j</groupId>
	    <artifactId>jakartaee-pac4j</artifactId>
	</dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.top-logic</groupId>
        <artifactId>tl-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-binding</id>
            <phase>none</phase>
            <goals>
              <goal>generate-java</goal>
            </goals>
            <configuration>
              <modules>tl.security.pac4j</modules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
