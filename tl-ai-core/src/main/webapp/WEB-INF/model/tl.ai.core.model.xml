<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.ai.core">
		<annotations>
			<package-binding
				implementation-package="com.top_logic.tl.ai.core.model.impl"
				interface-package="com.top_logic.tl.ai.core.model"
			/>
		</annotations>
		<!--
			The security mode an agent may declare for itself, stored as the name of the Java enum the
			framework already uses for the deployment-wide setting. A <datatype> with <enum-storage>
			rather than a TL <enum> with classifiers: the value has to reach Java code as an
			AiSecurityMode, and a classifier would have to be mapped back to one by hand - two places
			naming the same three modes, which is one place too many for a security decision.
		-->
		<datatype name="AiSecurityMode"
			db_type="string"
			kind="Custom"
		>
			<annotations>
				<config-type value="ENUM"/>
			</annotations>
			<enum-storage enum="com.top_logic.tl.ai.core.security.AiSecurityMode"/>
		</datatype>
		<class name="Agent">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<table name="AIAgent"/>
				<form-definition>
					<form>
						<field
							attribute="name"
							fullQualifiedName="tl.ai.core:Agent#name"
							type="tl.core:String"
						/>
						<field
							attribute="description"
							fullQualifiedName="tl.ai.core:Agent#description"
							type="tl.core:String"
						>
							<annotations>
								<label-position value="above-value"/>
								<render-whole-line/>
							</annotations>
						</field>
						<field
							attribute="systemPrompt"
							fullQualifiedName="tl.ai.core:Agent#systemPrompt"
							type="tl.core:Text"
						>
							<annotations>
								<label-position value="above-value"/>
								<render-whole-line/>
							</annotations>
						</field>
						<field
							attribute="tools"
							fullQualifiedName="tl.ai.core:Agent#tools"
							type="tl.core:String"
						/>
						<field
							attribute="mcpServers"
							fullQualifiedName="tl.ai.core:Agent#mcpServers"
							type="tl.core:String"
						/>
						<field
							attribute="skills"
							fullQualifiedName="tl.ai.core:Agent#skills"
							type="tl.core:String"
						/>
						<field
							attribute="delegations"
							fullQualifiedName="tl.ai.core:Agent#delegations"
							type="tl.core:String"
						/>
						<field
							attribute="securityMode"
							fullQualifiedName="tl.ai.core:Agent#securityMode"
							type="tl.ai.core:AiSecurityMode"
						/>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint class="com.top_logic.tl.ai.core.agent.ReservedPrefixConstraint"/>
							<constraint class="com.top_logic.tl.ai.core.agent.UniqueNameConstraint"/>
						</constraints>
					</annotations>
				</property>
				<property name="description"
					type="tl.core:String"
				>
					<annotations>
						<multi-line/>
						<size-constraint/>
					</annotations>
				</property>
				<property name="systemPrompt"
					type="tl.core:Text"
				>
					<annotations>
						<multi-line/>
						<size-constraint/>
					</annotations>
				</property>
				<property name="tools"
					multiple="true"
					type="tl.core:String"
				>
					<annotations>
						<options>
							<all-tool-names/>
						</options>
					</annotations>
				</property>
				<property name="mcpServers"
					multiple="true"
					type="tl.core:String"
				>
					<annotations>
						<options>
							<all-mcp-server-names/>
						</options>
					</annotations>
				</property>
				<property name="skills"
					multiple="true"
					type="tl.core:String"
				>
					<annotations>
						<options>
							<all-skill-names/>
						</options>
					</annotations>
				</property>
				<property name="delegations"
					multiple="true"
					type="tl.core:String"
				>
					<annotations>
						<options>
							<all-agent-names/>
						</options>
					</annotations>
				</property>
				<!--
					Optional on purpose: no value means "no floor", which is not the same statement as
					an explicitly chosen 'legacy'. See TopLogicAgentDefinitions.AgentConfig for the
					configuration counterpart of this attribute and why the value can only tighten.
				-->
				<property name="securityMode"
					type="AiSecurityMode"
				/>
			</attributes>
		</class>
		<class name="Skill">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<table name="AISkill"/>
				<form-definition>
					<form>
						<field
							attribute="name"
							fullQualifiedName="tl.ai.core:Skill#name"
							type="tl.core:String"
						/>
						<field
							attribute="description"
							fullQualifiedName="tl.ai.core:Skill#description"
							type="tl.core:String"
						>
							<annotations>
								<render-whole-line/>
								<label-position value="above-value"/>
							</annotations>
						</field>
						<field
							attribute="content"
							fullQualifiedName="tl.ai.core:Skill#content"
							type="tl.core:Text"
						>
							<annotations>
								<render-whole-line/>
								<label-position value="above-value"/>
							</annotations>
						</field>
						<field
							attribute="tools"
							fullQualifiedName="tl.ai.core:Skill#tools"
							type="tl.core:String"
						/>
					</form>
				</form-definition>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<constraints>
							<constraint class="com.top_logic.tl.ai.core.agent.ReservedPrefixConstraint"/>
							<constraint class="com.top_logic.tl.ai.core.agent.UniqueNameConstraint"/>
						</constraints>
					</annotations>
				</property>
				<property name="description"
					type="tl.core:String"
				>
					<annotations>
						<multi-line/>
						<size-constraint/>
					</annotations>
				</property>
				<property name="content"
					type="tl.core:Text"
				>
					<annotations>
						<multi-line/>
						<size-constraint/>
					</annotations>
				</property>
				<property name="tools"
					multiple="true"
					type="tl.core:String"
				>
					<annotations>
						<options>
							<all-tool-names/>
						</options>
					</annotations>
				</property>
			</attributes>
		</class>
	</module>
</model>
