<?xml version="1.0" encoding="utf-8" ?>

<!--
	Dialog of the workflow administration (workflows.view.xml) creating a workflow from the default
	diagram under the name the user enters (bpmlCreate). The created workflow is written to the
	selection channel bound to the selection of the administration.
-->
<view>
	<channels>
		<channel name="name"/>
		<channel name="selection"/>
	</channels>
	<window
		resizable="false"
		width="500px"
	>
		<title>
			<en>New workflow</en>
			<de>Neuer Workflow</de>
		</title>
		<fields
			label-position="top"
			max-columns="1"
			with-inset="true"
		>
			<value-input
				mandatory="true"
				type="tl.core:String"
				value="name"
			>
				<label>
					<en>Name</en>
					<de>Name</de>
				</label>
			</value-input>
		</fields>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					image="css:bi bi-check-lg"
					inputs="name"
				>
					<label>
						<en>Create</en>
						<de>Anlegen</de>
					</label>
					<access>
						<create type="tl.bpe.bpml:Collaboration"/>
					</access>
					<executability>
						<disabled-if expr="if($name == null, #('Enter a name first.'@en, 'Geben Sie zuerst einen Namen ein.'@de), null)"/>
					</executability>
					<with-transaction>
						<commitMessage>
							<en>Created workflow {0}.</en>
							<de>Workflow {0} angelegt.</de>
						</commitMessage>
						<execute-script function="bpmlCreate($name)"/>
						<with-result>
							<write-channel name="selection"/>
							<close-dialog/>
						</with-result>
					</with-transaction>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand"
					image="css:bi bi-x-lg"
				>
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>
