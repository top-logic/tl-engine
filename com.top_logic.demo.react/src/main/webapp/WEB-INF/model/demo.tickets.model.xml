<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="demo.tickets">
			<annotations>
				<package-binding
					implementation-package="com.top_logic.demo.react.model.tickets.impl"
					interface-package="com.top_logic.demo.react.model.tickets"
				/>
			</annotations>
			<enum name="TicketStatus">
				<classifier name="open">
					<annotations>
						<color role="warning"/>
					</annotations>
				</classifier>
				<classifier name="inProgress">
					<annotations>
						<color role="info"/>
					</annotations>
				</classifier>
				<classifier name="closed">
					<annotations>
						<color role="success"/>
					</annotations>
				</classifier>
			</enum>
			<class name="Ticket">
				<annotations>
					<dynamic-color>
						<color-by-expression color="t -> $t.get(`demo.tickets:Ticket#status`)"/>
					</dynamic-color>
					<main-properties properties="name"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<!--
						A resolution belongs to a closed ticket: closing a ticket without one proposes
						"Fixed", reopening it discards the resolution of the previous closing. The value
						listener does this in a form while the user edits the status. The change handlers
						react to every stored change of the status, also one made without a form (e.g.
						dropping a ticket into another column of the board): the first records the change
						as a comment of the ticket, the second discards the resolution of a reopened ticket.
					-->
					<reference name="status"
						kind="forwards"
						type="TicketStatus"
					>
						<annotations>
							<default-value>
								<classifier value="open"/>
							</default-value>
							<change-handlers>
								<script>
									<operation><![CDATA[ticket -> newValue -> oldValue -> attribute -> {
	from = if($oldValue == null, "–", label($oldValue));
	to = if($newValue == null, "–", label($newValue));
	comment = new(`demo.tickets:Comment`, $ticket);
	$comment.set(`demo.tickets:Comment#content`, "Status: " + $from + " → " + $to);
	$comment.set(`demo.tickets:Comment#author`, currentUser());
	$comment.set(`demo.tickets:Comment#date`, now());
	$ticket.add(`demo.tickets:Ticket#comments`, $comment);
}]]></operation>
								</script>
								<script>
									<operation><![CDATA[ticket -> newValue -> oldValue -> attribute ->
	if($oldValue == `demo.tickets:TicketStatus#closed` && !demoTicketsIsClosed($ticket),
		$ticket.set(`demo.tickets:Ticket#resolution`, null))]]></operation>
								</script>
							</change-handlers>
							<value-listeners>
								<script>
									<operation><![CDATA[t -> newValue -> oldValue ->
	if($newValue == `demo.tickets:TicketStatus#closed`,
		if($t.get(`demo.tickets:Ticket#resolution`) == null, $t.set(`demo.tickets:Ticket#resolution`, 'Fixed')),
		$t.set(`demo.tickets:Ticket#resolution`, null))]]></operation>
								</script>
							</value-listeners>
						</annotations>
					</reference>
					<property name="order"
						type="tl.core:Integer"
					/>
					<property name="statusLabel"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<query>
									<expr>t -&gt; label($t.get(`demo.tickets:Ticket#status`))</expr>
								</query>
							</storage-algorithm>
						</annotations>
					</property>
					<reference name="publicStatus"
						kind="forwards"
						type="TicketStatus"
					>
						<annotations>
							<storage-algorithm>
								<fallback-storage
									fallback-attribute="status"
									storage-attribute="customPublicStatus"
								/>
							</storage-algorithm>
						</annotations>
					</reference>
					<reference name="customPublicStatus"
						kind="forwards"
						type="TicketStatus"
					>
						<annotations>
							<visibility value="hidden"/>
						</annotations>
					</reference>
					<property name="headline"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<implementation class="com.top_logic.demo.react.model.tickets.HeadlineStorage"/>
							</storage-algorithm>
						</annotations>
					</property>
					<property name="resolution"
						type="tl.core:String"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="t -> editMode -> if(demoTicketsIsClosed($t), if($editMode, &quot;editable&quot;, &quot;read-only&quot;), &quot;hidden&quot;)"
								/>
							</dynamic-visibility>
						</annotations>
					</property>
					<reference name="comments"
						composite="true"
						kind="forwards"
						multiple="true"
						ordered="true"
						type="Comment"
					/>
					<property name="category"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<options-by-expression function="t -&gt; all(`demo.tickets:Ticket`).map(x -&gt; $x.get(`demo.tickets:Ticket#category`)).filter(c -&gt; $c != null).toSet()"/>
							</options>
							<free-entry/>
						</annotations>
					</property>
					<property name="tags"
						multiple="true"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<options-by-expression function="t -&gt; all(`demo.tickets:Ticket`).map(x -&gt; $x.get(`demo.tickets:Ticket#tags`)).flatten().toSet()"/>
							</options>
							<free-entry/>
						</annotations>
					</property>
					<reference name="keywords"
						kind="forwards"
						multiple="true"
						type="Keyword"
					>
						<annotations>
							<free-entry create="text -&gt; self -&gt; new(`demo.tickets:Keyword`, transient: true)..set(`demo.tickets:Keyword#name`, $text)"/>
						</annotations>
					</reference>
					<property name="estimate"
						type="tl.core:Long"
					>
						<annotations>
							<options>
								<options-by-expression
									alphabetic-order="false"
									function="t -&gt; all(`demo.tickets:Ticket`).map(x -&gt; $x.get(`demo.tickets:Ticket#estimate`)).filter(e -&gt; $e != null).toSet().sort()"
								/>
							</options>
							<free-entry/>
						</annotations>
					</property>
					<property name="channel"
						type="tl.core:String"
					>
						<annotations>
							<options>
								<options-by-expression function="t -&gt; ['email', 'phone', 'portal']">
									<option-labels class="com.top_logic.model.search.providers.LabelProviderByExpression"
										label="key -&gt; switch ($key) { 'email': #('E-mail'@en, 'E-Mail'@de); 'phone': #('Telephone'@en, 'Telefon'@de); 'portal': #('Customer portal'@en, 'Kundenportal'@de); default: $key; }"
									/>
								</options-by-expression>
							</options>
						</annotations>
					</property>
				</attributes>
			</class>
			<!--
				Deleting a keyword notes the deletion in each ticket that carried it. The deletion is
				reported before it is executed, while the keyword can still be read but nothing may be
				changed: the script reads the tickets and the name of the keyword and returns the
				function adding the comments, which runs after the keyword is removed.
			-->
			<class name="Keyword">
				<annotations>
					<main-properties properties="name"/>
					<lifecycle-handlers>
						<script>
							<deleting><![CDATA[keyword -> {
	tickets = $keyword.referers(`demo.tickets:Ticket#keywords`);
	text = #('Schlagwort „{0}“ wurde gelöscht.'@de, 'Keyword "{0}" was deleted.'@en)
		.fill($keyword.get(`demo.tickets:Keyword#name`))
		.localize();
	if($tickets.isEmpty(),
		null,
		x -> $tickets.foreach(ticket -> {
			comment = new(`demo.tickets:Comment`, $ticket);
			$comment.set(`demo.tickets:Comment#content`, $text);
			$comment.set(`demo.tickets:Comment#author`, currentUser());
			$comment.set(`demo.tickets:Comment#date`, now());
			$ticket.add(`demo.tickets:Ticket#comments`, $comment);
		}));
}]]></deleting>
						</script>
					</lifecycle-handlers>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
					<reference name="catalog"
						kind="forwards"
						type="KeywordCatalog"
					/>
				</attributes>
			</class>
			<class name="KeywordCatalog">
				<annotations>
					<main-properties properties="name"/>
				</annotations>
				<attributes>
					<property name="name"
						mandatory="true"
						type="tl.core:String"
					/>
				</attributes>
			</class>
			<class name="Comment">
				<annotations>
					<label>
						<label-provider class="com.top_logic.model.search.providers.LabelProviderByExpression"
							label="comment -> { a = $comment.get(`demo.tickets:Comment#author`); d = $comment.get(`demo.tickets:Comment#date`); if($a == null, #(&quot;Kommentar&quot;@de, &quot;Comment&quot;@en), label($a) + if($d != null, &quot; · &quot; + dateFormat(&quot;dd.MM.yyyy HH:mm&quot;).format($d), &quot;&quot;)); }"
						/>
					</label>
				</annotations>
				<attributes>
					<property name="content"
						mandatory="true"
						type="tl.model.wysiwyg:Html"
					/>
					<reference name="author"
						kind="forwards"
						type="tl.accounts:Person"
					/>
					<property name="date"
						type="tl.core:DateTime"
					/>
					<reference name="cited"
						kind="forwards"
						type="Comment"
					>
						<annotations>
							<dynamic-visibility>
								<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
									function="comment -> editMode -> if ($comment.get(`demo.tickets:Comment#cited`) != null, if($editMode, &quot;editable&quot;, &quot;read-only&quot;), &quot;hidden&quot;)"
								/>
							</dynamic-visibility>
							<options>
								<options-by-expression function="comment -> $comment.container().get(`demo.tickets:Ticket#comments`)"/>
							</options>
						</annotations>
					</reference>
					<reference name="attachments"
						composite="true"
						kind="forwards"
						multiple="true"
						ordered="true"
						type="Attachment"
					/>
				</attributes>
			</class>
			<class name="Attachment">
				<annotations>
					<main-properties properties="name, data"/>
				</annotations>
				<attributes>
					<property name="name"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<fallback-storage
									fallback-attribute="fileName"
									storage-attribute="customName"
								/>
							</storage-algorithm>
						</annotations>
					</property>
					<property name="customName"
						type="tl.core:String"
					>
						<annotations>
							<visibility value="hidden"/>
						</annotations>
					</property>
					<property name="fileName"
						type="tl.core:String"
					>
						<annotations>
							<storage-algorithm>
								<query>
									<expr>x -&gt; label($x.get(`demo.tickets:Attachment#data`))</expr>
								</query>
							</storage-algorithm>
							<visibility value="hidden"/>
						</annotations>
					</property>
					<property name="data"
						mandatory="true"
						type="tl.core:Binary"
					/>
				</attributes>
			</class>
		</module>
	</modules>
</model>