<?xml version="1.0" encoding="utf-8" ?>

<!--
	Tree grid demo: a tree table whose rows are edited in a form.
	
	Both tabs show the project scopes, their milestones and the tickets of each milestone in a
	<tree-table row-edit="..."> inside a <form>. "Edit" in the toolbar of the panel puts the form into
	edit mode, "Save" stores all changes made since, "Cancel" discards them.
	
	The columns are attribute columns of the three types: "Name" is held by scopes and milestones,
	"Due date" and "Approved" by milestones, "Title" and "Assignee" by tickets. Each cell is edited
	with the attribute of its row's type; a row whose type lacks the attribute shows an empty cell
	without input - a ticket has no name, a scope no due date.
	
	A row joins the edit when it is displayed: in edit mode, opening a milestone makes its tickets
	editable. The tree stays as it is while the form is edited - a change made elsewhere shows only
	after "Save" or "Cancel" - and the rows that were open before stay open across the switches between
	view and edit mode.
	
	- "All rows" (row-edit="ALL") edits every displayed row.
	- "Selected row" (row-edit="SELECTED") edits the selected row only; the selection is bound to a
	channel, so the selected row stays selected across the switches between view and edit mode.
-->
<view>
	<channels>
		<!-- Anchor object of the forms: the edit session locks on it. -->
		<derived-channel name="editAnchor"
			expr="currentUser()"
		/>
		<channel name="selected"/>
	</channels>
	<tab-bar active-tab="all-rows">
		<tabs>
			<tab id="all-rows"
				icon="css:bi bi-pencil-square"
			>
				<label>
					<en>All rows</en>
					<de>Alle Zeilen</de>
				</label>
				<panel>
					<title>
						<en>Editing all rows of a tree table</en>
						<de>Bearbeiten aller Zeilen einer Baumtabelle</de>
					</title>
					<form input="editAnchor">
						<tree-table
							personalization-key="tree-grid-demo-all"
							row-edit="ALL"
							types="tl.demo.projectManagement:ProjectScope,tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
						>
							<root>`tl.demo.projectManagement:ProjectScope`</root>
							<children>if($node == `tl.demo.projectManagement:ProjectScope`, all(`tl.demo.projectManagement:ProjectScope`), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), $node.get(`tl.demo.projectManagement:ProjectScope#milestones`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.get(`tl.demo.projectManagement:Milestone#tickets`), [])))</children>
							<columns>
								<column attribute="name"/>
								<column attribute="dueDate"/>
								<column attribute="approved"/>
								<column attribute="title"/>
								<column attribute="assignee"/>
							</columns>
						</tree-table>
					</form>
				</panel>
			</tab>
			<tab id="selected-row"
				icon="css:bi bi-cursor"
			>
				<label>
					<en>Selected row</en>
					<de>Ausgewählte Zeile</de>
				</label>
				<panel>
					<title>
						<en>Editing the selected row of a tree table</en>
						<de>Bearbeiten der ausgewählten Zeile einer Baumtabelle</de>
					</title>
					<form input="editAnchor">
						<tree-table
							observed-types="tl.demo.projectManagement:ProjectScope,tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
							personalization-key="tree-grid-demo-selected"
							row-edit="SELECTED"
							selection="selected"
							types="tl.demo.projectManagement:ProjectScope,tl.demo.projectManagement:Milestone,tl.demo.projectManagement:Ticket"
						>
							<root>`tl.demo.projectManagement:ProjectScope`</root>
							<children>if($node == `tl.demo.projectManagement:ProjectScope`, all(`tl.demo.projectManagement:ProjectScope`), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), $node.get(`tl.demo.projectManagement:ProjectScope#milestones`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.get(`tl.demo.projectManagement:Milestone#tickets`), [])))</children>
							<parents>if($node.instanceOf(`tl.demo.projectManagement:Ticket`), $node.get(`tl.demo.projectManagement:Ticket#milestone`), if($node.instanceOf(`tl.demo.projectManagement:Milestone`), $node.container(), if($node.instanceOf(`tl.demo.projectManagement:ProjectScope`), `tl.demo.projectManagement:ProjectScope`, null)))</parents>
							<columns>
								<column attribute="name"/>
								<column attribute="dueDate"/>
								<column attribute="approved"/>
								<column attribute="title"/>
								<column attribute="assignee"/>
							</columns>
						</tree-table>
					</form>
				</panel>
			</tab>
		</tabs>
	</tab-bar>
</view>