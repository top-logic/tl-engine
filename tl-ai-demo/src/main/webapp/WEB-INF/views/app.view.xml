<?xml version="1.0" encoding="utf-8" ?>

<!--
	Root view of the tl-ai demo, served under /view/ and resolved through ViewConfig#getDefaultView.
	
	An overlay of the engine's application shell (tl-layout-view, WEB-INF/views/app.view.xml): the
	engine brings the app bar with its development and user menus (designer, login, logout, theme,
	language), the system notices and the Administration item; this file adds what the demo is
	about. That is the agent chat, the start item, the event-management domain the agent works on
	(events, venues, invoices of the demo.events model), the user's settings for the agent, and the
	chat dock in the footer.
	
	Everything here is built from the standard view elements, the chat included, so the demo shows
	what an application gets for free rather than what this module wrote itself.
-->
<view xmlns:config="http://www.top-logic.com/ns/config/6.0">
	<channels>
		<!--
			What the page BEHIND the dock has open (Issue #494, #928). Declared in the shell, because
			the dock floats over every page. The pages do not <bind> it: <chat-channels> in the footer
			makes it reachable from the whole window, and a <page-selection> in a page writes into it
			while that page is on screen - also from a tile-stack frame, which no <bind> reaches. The
			dock binds it over the chat page's own "pageSelection", which states it to the agent while
			the rail's pane shows nothing.
			
			Only <page-selection> writes it, and no table uses it as its selection: a page states what
			it has open, it does not select rows on another page. When the page leaves the screen, the
			value goes, so on "My settings" the dock states "none".
		-->
		<channel name="pageSelection"/>
		<!--
			The chat composer's unsent text, declared at the top so that two *different* pages can
			reach it (Issue #440). Every <view-ref> gets its own channel namespace, so a page sees a
			channel of the enclosing view only where a <bind> hands it over - which is what the two
			nav items below do. See "Writing a channel across a view boundary" in tl-chat/CLAUDE.md.
		-->
		<channel name="chatDraft"/>
	</channels>

	<app-shell>
		<header>
			<app-bar>
				<title>
					<en>Albert</en>
					<de>Albert</de>
				</title>
			</app-bar>
		</header>
		<content>
			<sidebar active-item="chat">
				<header config:override="true">
					<text>
						<label>
							<en>Albert</en>
							<de>Albert</de>
						</label>
					</text>
				</header>
				<header-collapsed config:override="true">
					<text>
						<label>
							<en>A</en>
							<de>A</de>
						</label>
					</text>
				</header-collapsed>
				<section id="application">
					<!--
						The chat first and active on entry: this application exists to demonstrate the
						agent, and the events are the data it works on rather than the point. Every item
						goes into the application section of the engine's shell, ahead of its
						Administration.
						
						It is the chat page tl-chat ships, tl-chat/albert.view.xml: a <data-list> of this
						user's chats, a <chat-conversation>, and a <chat-rail> whose sections are
						configured. The demo's own parts - its facts, first questions, mentions, the
						"createInvoice" command and the "Veranstaltungen" section - are a same-path
						overlay, tl-chat/albert.view.xml of this module.
					-->
					<nav-item id="chat"
						icon="css:bi bi-chat-dots"
					>
						<label>
							<en>Chat</en>
							<de>Chat</de>
						</label>
						<!--
							The chat page declares a "chatDraft" of its own, so it also works standalone;
							this binding hands it *this* view's channel instead, which is the one the
							Events and Invoices pages below write.
						-->
						<view-ref view="tl-chat/albert.view.xml">
							<bind
								channel="chatDraft"
								to="chatDraft"
							/>
						</view-ref>
					</nav-item>

					<!--
						The event-management domain, one page per kind of thing the user looks for.
						Each page tells the dock's conversation what it has open with a <page-selection>
						in its detail view (Issue #928); the Events and Invoices pages also write the
						chat's draft with their "Ask about this" command (Issue #440). Venues is a tile
						stack: a double-click opens a venue as a frame over the list.
					-->
					<nav-item id="events"
						icon="css:bi bi-calendar-event"
					>
						<label>
							<en>Events</en>
							<de>Veranstaltungen</de>
						</label>
						<view-ref view="tl-ai-demo/events/events.view.xml">
							<bind
								channel="chatDraft"
								to="chatDraft"
							/>
						</view-ref>
					</nav-item>

					<nav-item id="venues"
						icon="css:bi bi-geo-alt"
					>
						<label>
							<en>Venues</en>
							<de>Veranstaltungsorte</de>
						</label>
						<view-ref view="tl-ai-demo/venues/venues-stack.view.xml"/>
					</nav-item>

					<nav-item id="invoices"
						icon="css:bi bi-receipt"
					>
						<label>
							<en>Invoices</en>
							<de>Rechnungen</de>
						</label>
						<view-ref view="tl-ai-demo/invoices/invoices.view.xml">
							<bind
								channel="chatDraft"
								to="chatDraft"
							/>
						</view-ref>
					</nav-item>

					<!--
						What this account tells every agent about itself (Issue #437): one free-text
						field on tl.accounts:Person, which the harness renders into the environment block
						of every run this user triggers.
					-->
					<nav-item id="profile"
						icon="css:bi bi-person-gear"
					>
						<label>
							<en>My settings</en>
							<de>Meine Einstellungen</de>
						</label>
						<view-ref view="tl-ai-demo/profile.view.xml"/>
					</nav-item>
				</section>
			</sidebar>
		</content>
		<!--
			The chat as a dock: a launcher in the corner of every page, and a panel over the page
			when it is opened (Issue #415).
			
			The <footer> is a mounting point and nothing more - the dock is fixed-position, so it
			takes no room in the shell's layout and every page keeps its full height.
			
			Three things about this are worth reading twice.
			
			The dock CONTAINS the chat page, so - unlike every other chat element - it cannot inherit
			a chat id: a chat scope reaches descendants only. Neither the dock nor the page names one,
			so both join the default conversation. A dock on another chat id writes it on the dock and
			on the <chat> inside, and the two must agree.
			
			The default conversation is the Chat page's own: this is the SAME conversation,
			reachable from every other page without leaving it. On the Chat page itself there is
			nothing for the dock to open, so it hides, and an open dock closes - showing it there would
			put two composers on one draft channel and two rails on one remembered layout.
			
			A conversation in a closed dock offers the agent nothing - no channel to present on, no
			page command, no facts - although the closed panel keeps it, hidden. What the agent
			presents goes to the pane of the place the user sees.
		-->
		<footer>
			<!--
				Makes "pageSelection" reachable from every page of this browser window, for the
				<page-selection> elements of the pages (Issue #928). It draws nothing.
			-->
			<chat-channels channels="pageSelection"/>
			<chat-dock icon="css:bi bi-stars">
				<label>
					<en>Albert</en>
					<de>Albert</de>
				</label>
				<!--
					The chat page tl-chat ships, with this demo's overlay, as on the Chat item. Its
					"chatDraft" is the shell's own, so "Dazu fragen" on the page behind the dock puts
					its question here (#440); its "pageSelection" is the shell's, so the conversation
					states what that page has open.
				-->
				<view-ref view="tl-chat/albert.view.xml">
					<bind
						channel="chatDraft"
						to="chatDraft"
					/>
					<bind
						channel="pageSelection"
						to="pageSelection"
					/>
				</view-ref>
			</chat-dock>
		</footer>
	</app-shell>
</view>