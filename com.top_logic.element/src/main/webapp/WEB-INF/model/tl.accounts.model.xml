<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.accounts">
		<datatype name="MfaRequirement"
			db_type="string"
			kind="Custom"
		>
			<annotations>
				<config-type value="ENUM"/>
			</annotations>
			<enum-storage enum="com.top_logic.knowledge.wrap.person.MfaRequirement"/>
		</datatype>
		<!--
			An access token: a credential a person creates for their own account and hands to a
			client, which sends it as "Authorization: Bearer <token>". What the token admits to is
			given by its permissions, see com.top_logic.element.accesstoken.AccessTokenPermissions.

			The token itself is never stored. What is kept is the SHA-256 of its secret, which is
			what a request is looked up by, and the token's first characters as a hint, so that a
			person can tell which row belongs to which client configuration. A token is shown
			exactly once, when it is created - see com.top_logic.element.accesstoken.AccessTokens.

			Revoking a token deletes it; deleting the account deletes its tokens.
		-->
		<class name="AccessToken">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<annotations>
				<implementation-binding class-name="com.top_logic.element.accesstoken.AccessTokenImpl"/>
				<table name="PersonalAccessToken"/>
				<main-properties properties="name,owner,hint,permissions,createdAt,expiresAt,lastUsed"/>
			</annotations>
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<reference name="owner"
					deletion-policy="delete-referer"
					mandatory="true"
					type="Person"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</reference>
				<property name="hint"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<!-- Lower-case hex SHA-256 of the whole token. Never shown. -->
				<property name="secretHash"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<!-- The names of the permissions the token grants, separated by spaces. -->
				<property name="permissions"
					mandatory="true"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<!--
					The key of the session the token was issued from. Set only for a token with a
					permission that binds to the session.
				-->
				<property name="sessionKey"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="hidden"/>
					</annotations>
				</property>
				<property name="createdAt"
					mandatory="true"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<!-- From this moment on the token is refused. Empty: it does not expire. -->
				<property name="expiresAt"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
				<!-- Written at most once a minute per token, see AccessTokens.LAST_USED_GRANULARITY. -->
				<property name="lastUsed"
					type="tl.core:DateTime"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
			</attributes>
		</class>
		<!--
			What the "New token" dialog asks for, and where it shows the token it created. Created
			with new(`tl.accounts:AccessTokenRequest`, transient: true) and never persisted, so no
			table is declared. The token lives in this object only for as long as the dialog that
			shows it once.
		-->
		<class name="AccessTokenRequest">
			<attributes>
				<property name="name"
					mandatory="true"
					type="tl.core:String"
				/>
				<!-- Empty: the token does not expire. -->
				<property name="validForDays"
					type="tl.core:Integer"
				/>
				<property name="token"
					type="tl.core:String"
				>
					<annotations>
						<visibility value="read-only"/>
					</annotations>
				</property>
			</attributes>
		</class>
