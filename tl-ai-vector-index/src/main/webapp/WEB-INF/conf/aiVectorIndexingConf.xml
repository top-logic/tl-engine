<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!-- 
		Vector Index Configuration
		
		This file configures the vector store backend for semantic search.
		Two implementations are supported:
		1. Qdrant - Remote vector database (requires running Qdrant server)
		2. JVector - Local file-based vector store (no external dependencies)
		
		To switch between implementations:
		- Comment out the current <instance> block
		- Uncomment the desired <instance> block
		- Restart the application
	-->
	
	<!-- ============================================ -->
	<!-- ACTIVE CONFIGURATION: Qdrant (Remote Store) -->
	<!-- ============================================ -->
	<instance class="com.top_logic.ai.vector.index.VectorIndex">
		<!-- Vector store type: "qdrant" or "jvector" -->
		<vector-store-type>qdrant</vector-store-type>
		
		<!-- Qdrant connection settings (required for Qdrant) -->
		<vector-store-host>localhost</vector-store-host>
		<vector-store-port>6334</vector-store-port>
		<vector-store-collection-name>toplogic-vectors</vector-store-collection-name>
		
		<!-- Vector dimension (default: 1024 for Mistral embeddings) -->
		<vector-dimension>1024</vector-dimension>
		
		<!-- Mistral AI embedding configuration -->
		<mistral-api-key>YOUR_MISTRAL_API_KEY_HERE</mistral-api-key>
		<mistral-embed-model>mistral-embed</mistral-embed-model>
		
		<!-- Models to include in vector indexing (comma-separated) -->
		<vector-index-models></vector-index-models>
		
		<!-- Timeout settings (milliseconds) -->
		<timeout-abort-indexing-for-shutdown>30000</timeout-abort-indexing-for-shutdown>
		<warn-queue-size>1000</warn-queue-size>
	</instance>
	
	<!-- ================================================ -->
	<!-- ALTERNATIVE CONFIGURATION: JVector (Local Store) -->
