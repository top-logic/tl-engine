// The CI pipeline of the application: builds it with Maven and runs its tests on every change of
// the default branch. The control application put this file into the first commit; it is a
// protected file, changed only through a reviewed pull request.
//
// Needs a Jenkins agent with a JDK 17 or newer and Maven ("mvn") on its path that reaches the
// TopLogic Maven repositories named in pom.xml.
pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn -B verify'
            }
        }
    }
}
