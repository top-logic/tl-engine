<?xml version="1.0" encoding="utf-8" ?>

<!--
	The access tokens of the logged-in account: a person creates one for a client - an agent driving
	the user interface, an MCP client, another agent over A2A - sees it exactly once, and revokes it
	here when the client no longer needs it. A request with the token acts as this account, with its
	rights, within the permissions of the token.

	Self-contained, so it works wherever it is referenced: the settings dialog's "Access tokens" tab
	(settings-tabs.view.xml) and any page of an application that has no settings dialog. The rows
	are filtered by owner, and the revoke command goes through accessTokenRevoke, which refuses a
	token of somebody else even when a channel happens to hold one.
-->
<view>
	<channels>
		<channel name="selectedToken"/>
	</channels>
	<panel>
		<title>
			<en>Access tokens</en>
			<de>Zugriffstokens</de>
		</title>
		<commands>
			<generic-command
				image="css:bi bi-plus-lg"
				placement="TOOLBAR"
			>
				<label>
					<en>New token</en>
					<de>Neues Token</de>
				</label>
				<execute-script function="new(`tl.accounts:AccessTokenRequest`, transient: true)">
					<with-result>
						<open-dialog
							bind-input-to="model"
							dialog-view="new-access-token.view.xml"
						/>
					</with-result>
				</execute-script>
			</generic-command>
			<generic-command
				image="css:bi bi-x-circle"
				inputs="selectedToken as token"
				placement="TOOLBAR"
			>
				<label>
					<en>Revoke</en>
					<de>Widerrufen</de>
				</label>
				<executability>
					<null-input-disabled/>
				</executability>
				<confirm expr="#('Revoke the token {0}? A client that uses it is refused from now on.'@en, 'Das Token {0} widerrufen? Ein Client, der es verwendet, wird ab sofort abgewiesen.'@de).fill($token.get(`tl.accounts:AccessToken#name`))"/>
				<with-transaction>
					<execute-script function="accessTokenRevoke($token)"/>
					<with-result>
						<write-channel name="selectedToken"
							clear="true"
						/>
					</with-result>
				</with-transaction>
			</generic-command>
		</commands>
		<table
			observed-types="tl.accounts:AccessToken"
			selection="selectedToken"
			types="tl.accounts:AccessToken"
		>
			<!-- Sized to fit the 560px settings dialog; further dates are one click away in the column selection. -->
			<columns>
				<column
					attribute="name"
					width="125"
				/>
				<column
					attribute="hint"
					width="95"
				/>
				<column
					attribute="permissions"
					width="140"
				/>
				<column
					attribute="expiresAt"
					width="140"
				/>
			</columns>
			<rows><![CDATA[all(`tl.accounts:AccessToken`)
				.filter(t -> $t.get(`tl.accounts:AccessToken#owner`) == currentUser())
				.sort((t -> $t.get(`tl.accounts:AccessToken#createdAt`)).comparator().desc())]]></rows>
		</table>
	</panel>
</view>
