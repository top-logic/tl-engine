<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<module name="tl.devtools">
		<!-- Kind of model type created through the model editor: a structured class or an enumeration. -->
		<enum name="TypeKind">
			<classifier name="class"/>
			<classifier name="enumeration"/>
		</enum>

		<!--
			Transient-only type holding the input of the "new module" dialog: the name of the model
			module to create. Instances are created with new(`tl.devtools:NewModule`, transient: true)
			and are never persisted (the action creates the module directly), so no table is declared.
		-->
		<class name="NewModule">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
			</attributes>
		</class>

		<!--
			Transient-only type holding the input of the "new type" dialog: the name and kind (class or
			enumeration) of the type to create in the selected module. Instances are created with
			new(`tl.devtools:NewType`, transient: true) and are never persisted (the action creates the
			type directly), so no table is declared.
		-->
		<class name="NewType">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<reference name="kind"
					kind="forwards"
					type="TypeKind"
				>
					<annotations>
						<default-value>
							<classifier value="class"/>
						</default-value>
					</annotations>
				</reference>
			</attributes>
		</class>

		<!--
			Transient-only type holding the input of the "new classifier" dialog: the name of the
			classifier to add to the selected enumeration. Instances are created with
			new(`tl.devtools:NewClassifier`, transient: true) and are never persisted (the action adds the
			classifier directly), so no table is declared.
		-->
		<class name="NewClassifier">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
			</attributes>
		</class>

		<!--
			Transient-only type holding the input of the "new attribute" dialog: the name, value type and
			cardinality of the attribute to add to the selected type (a property for a primitive value
			type, a reference for a class or enumeration). Instances are created with
			new(`tl.devtools:NewAttribute`, transient: true) and are never persisted (the action adds the
			attribute directly), so no table is declared.
		-->
		<class name="NewAttribute">
			<generalizations>
				<generalization type="tl.model:TLObject"/>
			</generalizations>
			<attributes>
				<property name="name"
					type="tl.core:String"
				/>
				<!--
					Offers the types an attribute can have: primitives, classes and enumerations declared in a
					module (no associations, no types local to another type).
				-->
				<reference name="type"
					kind="forwards"
					type="tl.model:TLType"
				>
					<annotations>
						<options>
							<options-by-expression function="obj -> all(`tl.model:TLType`).filter(t -> !$t.instanceOf(`tl.model:TLAssociation`) &amp;&amp; $t.get(`tl.model:TLType#scope`).instanceOf(`tl.model:TLModule`))"/>
						</options>
					</annotations>
				</reference>
				<property name="mandatory"
					type="tl.core:Boolean"
				/>
				<!--
					A primitive value type without the supports-multiple annotation cannot store several
					values. While such a type is chosen, the field is disabled once it is unchecked; a
					checked field stays editable, so the user can clear a value entered for another type.
				-->
				<property name="multiple"
					type="tl.core:Boolean"
				>
					<annotations>
						<dynamic-visibility>
							<mode-selector class="com.top_logic.model.search.providers.ModeSelectorByExpression"
								function="obj -> {type = $obj.get(`tl.devtools:NewAttribute#type`); unsupported = $type != null &amp;&amp; $type.instanceOf(`tl.model:TLPrimitive`) &amp;&amp; $type.get(`tl.model:TLModelPart#annotations`).filter(a -> $a['$tag'] == 'supports-multiple' &amp;&amp; $a['value']).isEmpty(); if($unsupported &amp;&amp; !$obj.get(`tl.devtools:NewAttribute#multiple`), 'disabled', 'default')}"
							/>
						</dynamic-visibility>
					</annotations>
				</property>
			</attributes>
		</class>
	</module>
</model>