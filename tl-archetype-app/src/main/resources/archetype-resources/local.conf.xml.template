<?xml version="1.0" encoding="utf-8"?>

<!--
	Template for the developer-local configuration overlay 'local.conf.xml'.

	Copy this file to 'local.conf.xml' (git-ignored) and enter developer-local
	settings as alias entries. The overlay is loaded last (overriding the
	application configuration) when the application is started via Maven
	('.mvn/jvm.config' points 'tl_config' at it) or via the Eclipse start launch.
	A missing 'local.conf.xml' is silently ignored, so a fresh checkout starts
	with the base configuration.

	Secrets (database passwords, API keys, client secrets, ...) are no aliases:
	the configuration references them by name (e.g. <api-key name="tl_openai_api_key"/>),
	and the secret store reads them from the environment variable or system
	property of that name, holding the plain value. A typed companion
	'local.conf.config.xml' next to 'local.conf.xml' may configure another secret
	store (service com.top_logic.basic.credential.SecretStoreService).
-->
<root>
	<alias>
		<!--
		<entry name="%MY_SERVICE_USER%" value="alice"/>
		<entry name="%MY_SERVICE_PASSWORD%" value="secret"/>
		-->
	</alias>
</root>
