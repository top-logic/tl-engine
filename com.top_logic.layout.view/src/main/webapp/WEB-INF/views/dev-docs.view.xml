<?xml version="1.0" encoding="utf-8" ?>

<!--
	Documentation side-window: the developer documentation the modules of the application ship
	(META-INF/tl-docs/**/*.md in their jars), as a tree of chapters and articles. A search input
	narrows the tree to the articles containing every word typed; the selected entry is displayed
	beside the tree. A link of an article to another one selects that one.
-->
<view>
	<channels>
		<channel name="search"/>
		<channel name="doc"/>
		<derived-channel name="docHtml"
			expr="doc -> devDocsHtml($doc)"
			inputs="doc"
		/>
	</channels>
	<adaptive-detail selection="doc">
		<selector>
			<panel>
				<title-content>
					<value-input
						clearable="true"
						icon="css:bi bi-search"
						label-position="hide-label"
						value="search"
					>
						<label>
							<en>Search</en>
							<de>Suche</de>
						</label>
						<placeholder>
							<en>Search</en>
							<de>Suche</de>
						</placeholder>
					</value-input>
				</title-content>
				<tree selection="doc">
					<inputs>
						<input channel="search"/>
					</inputs>
					<root>search -&gt; devDocsRoot()</root>
					<children>search -&gt; node -&gt; devDocsChildren($node, $search)</children>
					<parents>search -&gt; node -&gt; devDocsParent($node)</parents>
				</tree>
			</panel>
		</selector>
		<detail>
			<panel with-inset="true">
				<title-content>
					<text input="doc"/>
				</title-content>
				<html input="docHtml">
					<on-link class="com.top_logic.layout.view.command.GenericViewCommand">
						<execute-script function="link -> devDocsGet($link)"/>
						<write-channel name="doc"/>
					</on-link>
				</html>
			</panel>
		</detail>
	</adaptive-detail>
</view>