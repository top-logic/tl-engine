<?xml version="1.0" encoding="utf-8" ?>

<model xmlns="http://www.top-logic.com/ns/dynamic-types/6.0">
	<modules>
		<module name="TestTLScriptSecurity">
			<annotations>
				<singletons>
					<singleton name="HOME"
						type="PathHome"
					/>
					<singleton name="OFFICE"
						type="PathOffice"
					/>
				</singletons>
			</annotations>
			<types>
				<interface name="Record"/>

				<class name="Employee">
					<annotations>
						<table name="TLSecEmployee"/>
					</annotations>
					<generalizations>
						<generalization type="Record"/>
					</generalizations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						>
							<annotations>
								<storage-algorithm>
									<query expr="self -> $self.get(`TestTLScriptSecurity:Employee#account`).get(`tl.accounts:Person#name`)"/>
								</storage-algorithm>
							</annotations>
						</property>
						<property name="salary"
							type="tl.core:Integer"
						/>
						<reference name="account"
							mandatory="true"
							type="tl.accounts:Person"
						/>
					</attributes>
				</class>

				<class name="ExternalEmployee">
					<generalizations>
						<generalization type="Employee"/>
					</generalizations>
				</class>

				<class name="UnsecuredData">
					<annotations>
						<table name="TLSecUnsecuredData"/>
					</annotations>
					<generalizations>
						<generalization type="Record"/>
					</generalizations>
					<attributes>
						<property name="data"
							type="tl.core:String"
						/>
					</attributes>
				</class>

				<class name="UnsecuredDataSub">
					<generalizations>
						<generalization type="UnsecuredData"/>
					</generalizations>
				</class>

				<class name="Project">
					<annotations>
						<table name="TLSecProject"/>
					</annotations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<property name="budget"
							type="tl.core:Integer"
						/>
						<property name="secret"
							type="tl.core:String"
						/>
						<reference name="responsible"
							type="Employee"
						>
							<annotations>
								<storage-algorithm>
									<foreign-key-storage
										storage-attribute="responsible"
										storage-type="TLSecProject"
									/>
								</storage-algorithm>
							</annotations>
						</reference>
						<reference name="members"
							multiple="true"
							type="Employee"
						/>
						<!--
							The role rules of the application configuration layer assign the project
							roles directly to the referenced account.
						-->
						<reference name="responsibleAccount"
							type="tl.accounts:Person"
						/>
						<reference name="readerAccount"
							type="tl.accounts:Person"
						/>
						<reference name="auditorAccount"
							type="tl.accounts:Person"
						/>
						<reference name="viewerAccount"
							type="tl.accounts:Person"
						/>
						<property name="runningCosts"
							type="tl.core:Integer"
						>
							<annotations>
								<storage-algorithm>
									<query expr="self -> $self.get(`TestTLScriptSecurity:Project#members`).union($self.get(`TestTLScriptSecurity:Project#responsible`)).map(e -> $e.get(`TestTLScriptSecurity:Employee#salary`)).sum()"/>
								</storage-algorithm>
							</annotations>
						</property>
					</attributes>
				</class>

				<class name="SpecialProject">
					<generalizations>
						<generalization type="Project"/>
					</generalizations>
				</class>

				<!--
					The access parent of a task is computed by a script (see
					TestTLScriptSecurity-test.config.xml): the project its assignee is responsible
					for, reached backwards over a reference that is no composition, through an
					employee the users may not read.
				-->
				<class name="ProjectTask">
					<annotations>
						<table name="TLSecProjectTask"/>
					</annotations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
						<reference name="assignee"
							type="Employee"
						/>
					</attributes>
				</class>

				<!--
					The constraint on name reads the derived reference, whose value is an employee
					the users may not read: the commit check must see the value nevertheless.
				-->
				<class name="ConstrainedRecord">
					<attributes>
						<property name="name"
							type="tl.core:String"
						>
							<annotations>
								<constraints>
									<constraint-by-expression>
										<check>value -&gt; obj -&gt; if ($obj.get(`TestTLScriptSecurity:ConstrainedRecord#derivedRef`) == null, "empty", null)</check>
									</constraint-by-expression>
								</constraints>
							</annotations>
						</property>
						<reference name="stored"
							type="Employee"
						/>
						<reference name="derivedRef"
							type="Employee"
						>
							<annotations>
								<storage-algorithm>
									<query expr="t -> $t.get(`TestTLScriptSecurity:ConstrainedRecord#stored`)"/>
								</storage-algorithm>
							</annotations>
						</reference>
					</attributes>
				</class>

				<class name="PathNode">
					<annotations>
						<table name="TLSecPathNode"/>
					</annotations>
					<attributes>
						<property name="name"
							type="tl.core:String"
						/>
					</attributes>
				</class>

				<class name="PathRoot">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
					<attributes>
						<reference name="as"
							multiple="true"
							ordered="true"
							type="PathA"
						/>
					</attributes>
				</class>

				<class name="PathA">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
					<attributes>
						<reference name="bs"
							multiple="true"
							ordered="true"
							type="PathB"
						/>
					</attributes>
				</class>

				<class name="PathB">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
					<attributes>
						<reference name="cs"
							multiple="true"
							ordered="true"
							type="PathC"
						/>
						<reference name="notes"
							composite="true"
							multiple="true"
							type="PathNote"
						/>
						<reference name="writers"
							multiple="true"
							type="Employee"
						/>
						<reference name="editors"
							multiple="true"
							type="Employee"
						/>
					</attributes>
				</class>

				<class name="PathC">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
					<attributes>
						<reference name="readers"
							multiple="true"
							type="Employee"
						/>
					</attributes>
				</class>

				<class name="PathNote">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
				</class>

				<!--
					Singleton type whose class rights let a discoverable object read its attributes,
					while the rights of its singleton grant Write without Read.
				-->
				<class name="PathHome">
					<annotations>
						<!-- A table of its own, so that a filter on the title is compiled into SQL. -->
						<table name="TLSecPathHome"/>
					</annotations>
					<attributes>
						<property name="title"
							type="tl.core:String"
						/>
						<reference name="readers"
							multiple="true"
							type="Employee"
						/>
						<reference name="editors"
							multiple="true"
							type="Employee"
						/>
					</attributes>
				</class>

				<!--
					Singleton type with an attribute grant and a composition: both imply Discover on
					the singleton, besides the rights of the singleton.
				-->
				<class name="PathOffice">
					<generalizations>
						<generalization type="PathNode"/>
					</generalizations>
					<attributes>
						<property name="title"
							type="tl.core:String"
						/>
						<reference name="notes"
							composite="true"
							multiple="true"
							type="PathNote"
						/>
						<reference name="viewers"
							multiple="true"
							type="Employee"
						/>
						<reference name="writers"
							multiple="true"
							type="Employee"
						/>
					</attributes>
				</class>
			</types>
		</module>
	</modules>
</model>