<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="selectedObject"/>
		<channel name="normalizedValue"/>
	</channels>
	<split-panel
		orientation="horizontal"
		resizable="true"
	>
		<panes>
			<pane
				min-size="200"
				size="30"
				unit="%"
			>
				<panel>
					<title>
						<en>Constraint Test Objects</en>
						<de>Constraint-Test-Objekte</de>
					</title>
					<commands>
						<generic-command placement="TOOLBAR">
							<label>
								<en>New</en>
								<de>Neu</de>
							</label>
							<create-transient type="test.constraints:ConstraintTestType">
								<with-result>
									<open-dialog
										bind-input-to="model"
										dialog-view="demo/create-constraint-test.view.xml"
									>
										<bind
											channel="selection"
											to="selectedObject"
										/>
									</open-dialog>
								</with-result>
							</create-transient>
						</generic-command>
						<generic-command
							image="css:bi bi-pencil"
							inputs="selectedObject"
							placement="TOOLBAR"
						>
							<label>
								<en>Edit in dialog</en>
								<de>Im Dialog bearbeiten</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<open-dialog
								bind-input-to="model"
								dialog-view="demo/edit-constraint-test.view.xml"
							/>
						</generic-command>
						<generic-command
							image="css:bi bi-trash"
							inputs="selectedObject"
							placement="TOOLBAR"
						>
							<label>
								<en>Delete</en>
								<de>Löschen</de>
							</label>
							<executability>
								<null-input-disabled/>
							</executability>
							<confirm expr="if($selectedObject != null, #(&quot;Delete the selected object?&quot;@en, &quot;Das ausgewählte Objekt löschen?&quot;@de), null)"/>
							<delete-object/>
							<write-channel name="selectedObject"
								clear="true"
							/>
						</generic-command>
					</commands>
					<table
						observed-types="test.constraints:ConstraintTestType"
						selection="selectedObject"
						types="test.constraints:ConstraintTestType"
					>
						<columns>
							<column
								attribute="name"
								sort="ASC"
							/>
							<column attribute="uniqueName"/>
							<column attribute="sizedString"/>
							<column attribute="mandatorySizedString"/>
							<column attribute="unboundedSizedString"/>
							<column attribute="minSizedString"/>
							<column attribute="rangedInt"/>
							<column attribute="rangedDouble"/>
							<column attribute="uppercaseStart"/>
							<column attribute="freeText"/>
						</columns>
						<rows>all(`test.constraints:ConstraintTestType`)</rows>
					</table>
				</panel>
			</pane>
			<pane
				size="70"
				unit="%"
			>
				<panel with-inset="true">
					<title>
						<en>Constraint Test Form</en>
						<de>Constraint-Test-Formular</de>
					</title>
					<fields>
						<value-input
							type="tl.core:String"
							value="normalizedValue"
						>
							<label>
								<en>Normalized input (view value)</en>
								<de>Normalisierte Eingabe (Wert der View)</de>
							</label>
							<annotations>
								<value-normalizer>
									<normalize-by-expression function="value -> obj -> $value.trim()"/>
								</value-normalizer>
							</annotations>
						</value-input>
					</fields>
					<stack
						direction="row"
						gap="default"
					>
						<text variant="label">
							<label>
								<en>On the channel:</en>
								<de>Auf dem Kanal:</de>
							</label>
						</text>
						<text
							input="normalizedValue"
							tone="helper"
						/>
					</stack>
					<form input="selectedObject">
						<field attribute="name"/>
						<field attribute="uniqueName"/>
						<field attribute="sizedString"/>
						<field attribute="mandatorySizedString"/>
						<field attribute="unboundedSizedString"/>
						<field attribute="minSizedString"/>
						<field attribute="rangedInt"/>
						<field attribute="rangedDouble"/>
						<field attribute="uppercaseStart"/>
						<field attribute="warningField"/>
						<field attribute="normalizedText"/>
						<field attribute="freeText"/>
						<field attribute="category"/>
						<field attribute="codeInCategory"/>
						<composition-table attribute="items">
							<columns>
								<column attribute="name"/>
								<column attribute="quantity"/>
								<column attribute="unitPrice"/>
							</columns>
							<detail-dialog
								edit-mode-channel="editMode"
								height="300"
								input-channel="editedItem"
								layout="demo/edit-constraint-test-item.view.xml"
								width="500"
							/>
						</composition-table>
					</form>
				</panel>
			</pane>
		</panes>
	</split-panel>
</view>