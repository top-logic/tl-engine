<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="selectedPart"/>
	</channels>

	<switch input="selectedPart">
		<case test="$selectedPart != null &amp;&amp; $selectedPart.instanceOf(`tl.model:TLClass`)">
			<form input="selectedPart">
				<field attribute="name"/>
			</form>
		</case>
		<default>
			<form input="selectedPart">
				<field attribute="name"/>
			</form>
		</default>
	</switch>
</view>