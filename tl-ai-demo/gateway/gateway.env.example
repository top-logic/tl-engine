# Settings of the gateway, copied to .env (read by docker compose). No provider key goes here:
# the keys are files in ./secrets.

# The Keycloak realm issuing the tokens of the applications and developers.
OIDC_ISSUER_URL=https://login.example.com/realms/my-realm

# The client representing the gateway in the realm: a token must name it as audience and carry
# its client role GATEWAY_ROLE.
GATEWAY_CLIENT_ID=llm-gateway
GATEWAY_ROLE=llm-user
GATEWAY_CLIENT_SECRET=<secret of the llm-gateway client>

# Random 32-byte value, e.g. from: openssl rand -base64 32 | tr -- '+/' '-_'
GATEWAY_COOKIE_SECRET=<random value>

# Where nginx reaches oauth2-proxy.
OAUTH2_PROXY_URL=http://oauth2-proxy:4180

# The port the gateway is published on.
GATEWAY_PORT=8080

# The provider APIs, without trailing slash.
ANTHROPIC_UPSTREAM=https://api.anthropic.com
OPENAI_UPSTREAM=https://api.openai.com
MISTRAL_UPSTREAM=https://api.mistral.ai
