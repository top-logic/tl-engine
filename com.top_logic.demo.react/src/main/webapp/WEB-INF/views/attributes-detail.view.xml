<?xml version="1.0" encoding="utf-8" ?>

<view>
	<channels>
		<channel name="model"/>
	</channels>
	<window width="640px">
		<title>
			<en>Edit demo object</en>
			<de>Demo-Objekt bearbeiten</de>
		</title>
		<form
			initial-edit-mode="true"
			input="model"
			mode-switch="false"
		>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Text</en>
					<de>Text</de>
				</label>
				<field attribute="name"/>
				<field attribute="string"/>
				<field attribute="multiLine"/>
				<field attribute="html"/>
				<field attribute="i18n"/>
				<field attribute="i18nMultiline"/>
				<field attribute="i18nHtml"/>
				<field attribute="password"/>
			</group>
			<!-- The source editors take the most room and are wanted the least often, so this section starts folded. -->
			<group
				border="subtle"
				collapsed="true"
				collapsible="true"
			>
				<label>
					<en>Source code</en>
					<de>Quelltext</de>
				</label>
				<field attribute="xmlSource"/>
				<field attribute="jsonSource"/>
				<field attribute="cssSource"/>
				<field attribute="javascriptSource"/>
				<field attribute="htmlSource"/>
				<field attribute="markdownSource"/>
				<field attribute="plainSource"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Numbers</en>
					<de>Zahlen</de>
				</label>
				<field attribute="count"/>
				<field attribute="size"/>
				<field attribute="amount"/>
				<field attribute="price"/>
				<field attribute="ratio"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Choices</en>
					<de>Auswahl</de>
				</label>
				<field attribute="active"/>
				<field attribute="tri"/>
				<field attribute="activeRadio"/>
				<field attribute="activeSelect"/>
				<field attribute="priority"/>
				<field attribute="tags"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Dates and times</en>
					<de>Datum und Zeit</de>
				</label>
				<field attribute="date"/>
				<field attribute="dateTime"/>
				<field attribute="dateTimeShort"/>
				<field attribute="time"/>
				<field attribute="duration"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Lists</en>
					<de>Listen</de>
				</label>
				<field attribute="aliases"/>
				<field attribute="notes"/>
				<field attribute="scores"/>
				<field attribute="ratios"/>
				<field attribute="flags"/>
				<field attribute="deadlines"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>Formats and media</en>
					<de>Formate und Medien</de>
				</label>
				<field attribute="icon"/>
				<field attribute="color"/>
				<field attribute="country"/>
				<field attribute="language"/>
				<field attribute="timeZone"/>
				<field attribute="url"/>
				<field attribute="email"/>
				<field attribute="phone"/>
				<field attribute="json"/>
				<field attribute="image"/>
			</group>
			<group
				border="subtle"
				collapsible="true"
			>
				<label>
					<en>References</en>
					<de>Verweise</de>
				</label>
				<field attribute="owner"/>
				<field attribute="watchers"/>
				<field attribute="related"/>
			</group>
			<commands>
				<generic-command placement="BUTTON_BAR">
					<label>
						<en>Save</en>
						<de>Speichern</de>
					</label>
					<with-transaction>
						<store-form-state/>
					</with-transaction>
					<close-dialog/>
				</generic-command>
			</commands>
		</form>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>