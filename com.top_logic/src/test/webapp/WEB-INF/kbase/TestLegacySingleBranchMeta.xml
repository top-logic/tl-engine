<!--
	Redefinition of the branch attribute of a single branch system, as stored in the schema of
	databases created with a type system declaring it. Used by TestAlignTableLayoutProcessor.
-->
<objectlist
	xmlns="http://www.top-logic.com/ns/meta/5.8"
	xmlns:config="http://www.top-logic.com/ns/config/6.0"
>
	<metaobjects>
		<metaobject object_name="Item">
			<attributes>
				<mo_attribute class="com.top_logic.dob.attr.ComputedMOAttribute"
					att_name="_branch"
				>
					<storage class="com.top_logic.knowledge.service.db2.TrunkStorage"/>
				</mo_attribute>
			</attributes>
			<primary-key>
				<index-parts>
					<index_part name="_branch"
						config:operation="remove"
					/>
				</index-parts>
			</primary-key>
		</metaobject>
	</metaobjects>
</objectlist>
