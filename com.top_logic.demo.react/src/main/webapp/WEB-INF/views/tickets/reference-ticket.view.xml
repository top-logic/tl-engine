<?xml version="1.0" encoding="utf-8" ?>

<!--
	Picks the project ticket a comment refers to. Inserting appends a link to that ticket to the
	comment being written: the draft is replaced by one whose content ends with the link, so the
	composer's form shows the new content. The link is written exactly as displayed structured
	text expects it, so the posted comment offers it as a link to the ticket.
-->
<view>
	<channels>
		<channel name="draft"/>
		<channel name="ticket"/>
		<channel name="result"/>
	</channels>

	<window width="720px">
		<title>
			<en>Reference ticket</en>
			<de>Ticket referenzieren</de>
		</title>
		<table
			observed-types="tl.demo.projectManagement:Ticket"
			selection="ticket"
			types="tl.demo.projectManagement:Ticket"
		>
			<columns>
				<column attribute="title"/>
				<column attribute="milestone"/>
				<column attribute="assignee"/>
			</columns>
			<rows>all(`tl.demo.projectManagement:Ticket`)</rows>
		</table>
		<actions>
			<button>
				<action class="com.top_logic.layout.view.command.GenericViewCommand"
					input="ticket"
				>
					<label>
						<en>Insert</en>
						<de>Einfügen</de>
					</label>
					<executability>
						<null-input-disabled/>
					</executability>
					<execute-script function="draft -> ticket -> { next = $draft.copy(transient: true); $next.set(`demo.tickets:Comment#content`, htmlText(htmlSource($draft.get(`demo.tickets:Comment#content`)) + &quot;&lt;p>&quot; + htmlObjectLink($ticket) + &quot;&lt;/p>&quot;)); $next; }">
						<inputs>
							<input channel="draft"/>
						</inputs>
					</execute-script>
					<write-channel name="result"/>
					<close-dialog/>
				</action>
			</button>
			<button>
				<action class="com.top_logic.layout.view.command.CancelDialogCommand">
					<label>
						<en>Cancel</en>
						<de>Abbrechen</de>
					</label>
				</action>
			</button>
		</actions>
	</window>
</view>